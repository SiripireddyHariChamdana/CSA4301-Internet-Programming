<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AgriMart | Farmer Marketplace</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f4f8f2;color:#2d3c2d}header{background:#285b35;color:white;padding:17px 5%;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}h1{margin:0;font-size:25px}nav{display:flex;gap:5px;flex-wrap:wrap}button{border:0;border-radius:8px;padding:10px 14px;cursor:pointer;font-weight:bold;background:#e9f2e5;color:#285b35}nav button{background:transparent;color:white}nav button.active,nav button:hover{background:#4a8051}.page{display:none;max-width:1080px;margin:28px auto;padding:0 18px}.page.active{display:block}.hero{padding:42px 30px;border-radius:16px;background:linear-gradient(120deg,#285b35,#78a65b);color:white}.hero h2{font-size:34px;margin:0 0 10px}.card{background:white;padding:22px;border-radius:14px;margin:16px 0;box-shadow:0 5px 18px #23432210}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:15px}.field{margin:12px 0}.field label{display:block;font-weight:bold;margin-bottom:6px}input,select,textarea{width:100%;padding:11px;border:1px solid #ccd9c8;border-radius:8px;font:inherit}textarea{min-height:85px}.primary{background:#367b43;color:white}.muted{color:#748274}.tag{display:inline-block;padding:5px 9px;border-radius:16px;background:#e8f3e5;color:#397343;font-size:12px}.item{border:1px solid #e0eadc;padding:15px;border-radius:12px}.emoji{font-size:43px;background:#eef6eb;border-radius:10px;text-align:center;padding:16px}.price{font-weight:bold;color:#347544;font-size:19px}table{width:100%;border-collapse:collapse;margin-top:12px}td,th{text-align:left;padding:11px;border-bottom:1px solid #e4ece1}th{background:#edf5e9}.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}.stat{background:#edf5e9;padding:16px;border-radius:10px}.stat b{display:block;font-size:23px;color:#347544;margin-top:8px}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}footer{text-align:center;padding:25px;color:#778576}@media(max-width:600px){header{padding:15px}nav{width:100%}.hero h2{font-size:27px}}
</style></head><body>
<header><h1>🌾 AgriMart</h1><nav><button class="active" onclick="show('home',this)">Home</button><button onclick="show('market',this)">Marketplace</button><button onclick="show('sell',this)">Sell Produce</button><button onclick="show('orders',this)">Orders</button><button onclick="show('advice',this)">Farm Advice</button><button onclick="show('account',this)">Account</button><button onclick="show('admin',this)">Admin</button></nav></header>
<main>
<section id="home" class="page active"><div class="hero"><h2>From farm to market, made simple.</h2><p>Connect farmers and buyers. List fresh agricultural produce, discover products and manage orders in one place.</p><button class="primary" onclick="show('market')">Explore Marketplace →</button></div><div class="card"><h2>Explore AgriMart</h2><div class="grid"><div><h3>🌱 Fresh Produce</h3><p class="muted">Find vegetables, fruits, grains and other farm products.</p></div><div><h3>🧑‍🌾 Farmer Listings</h3><p class="muted">Farmers can add produce, price and available quantity.</p></div><div><h3>🚚 Order Management</h3><p class="muted">Buyers can place orders and check delivery status.</p></div></div></div></section>
<section id="market" class="page"><div class="card"><h2>Agricultural Marketplace</h2><div class="grid"><div class="field"><label>Search produce</label><input id="search" oninput="renderMarket()" placeholder="Search rice, tomato..."></div><div class="field"><label>Category</label><select id="category" onchange="renderMarket()"><option value="">All categories</option><option>Vegetables</option><option>Fruits</option><option>Grains</option><option>Dairy</option><option>Other</option></select></div></div><div id="products" class="grid"></div></div></section>
<section id="details" class="page"><div class="card" id="productDetails"></div></section>
<section id="sell" class="page"><div class="card"><h2>Farmer – List Produce</h2><form onsubmit="addProduce(event)"><div class="grid"><div class="field"><label>Produce name</label><input id="produceName" required></div><div class="field"><label>Category</label><select id="produceCategory"><option>Vegetables</option><option>Fruits</option><option>Grains</option><option>Dairy</option><option>Other</option></select></div><div class="field"><label>Price per unit (₹)</label><input id="producePrice" type="number" min="1" required></div><div class="field"><label>Available quantity (kg / units)</label><input id="quantity" type="number" min="1" required></div><div class="field"><label>Farmer name</label><input id="farmerName" required></div><div class="field"><label>Location</label><input id="farmLocation" required></div><div class="field"><label>Contact number</label><input id="contact" pattern="[0-9]{10}" maxlength="10" required></div></div><div class="field"><label>Product description</label><textarea id="description" required></textarea></div><button class="primary">Publish Produce</button></form><p id="sellMsg"></p></div></section>
<section id="cart" class="page"><div class="card"><h2>Selected Produce</h2><div id="cartRows"></div><h3 id="cartTotal"></h3><button class="primary" onclick="show('checkout')">Place Order</button></div></section>
<section id="checkout" class="page"><div class="card"><h2>Buyer Details & Checkout</h2><form onsubmit="placeOrder(event)"><div class="grid"><div class="field"><label>Buyer name</label><input id="buyerName" required></div><div class="field"><label>Email</label><input id="buyerEmail" type="email" required></div><div class="field"><label>Mobile number</label><input id="buyerPhone" pattern="[0-9]{10}" maxlength="10" required></div><div class="field"><label>Payment method</label><select id="payment"><option>Cash on Delivery</option><option>UPI (Demo)</option><option>Card (Demo)</option></select></div></div><div class="field"><label>Delivery address</label><textarea id="deliveryAddress" required></textarea></div><button class="primary">Confirm Order</button></form><p id="orderMsg"></p></div></section>
<section id="orders" class="page"><div class="card"><h2>Order History</h2><div id="orderRows"></div></div></section>
<section id="advice" class="page"><div class="card"><h2>Farmer Information & Tips</h2><div class="grid"><div class="item"><h3>🌿 Soil Health</h3><p>Use soil testing to understand nutrient levels and choose suitable fertilizers.</p></div><div class="item"><h3>💧 Water Management</h3><p>Use drip irrigation and water crops according to their growth stage.</p></div><div class="item"><h3>🐛 Pest Management</h3><p>Monitor crops regularly and use suitable integrated pest-management practices.</p></div><div class="item"><h3>🌦️ Weather Planning</h3><p>Check local weather forecasts before irrigation, spraying or harvesting.</p></div></div><p class="muted">General educational information only. Follow local agricultural department guidance for crop-specific advice.</p></div></section>
<section id="account" class="page"><div class="card"><h2>Farmer / Buyer Registration</h2><form onsubmit="register(event)"><div class="grid"><div class="field"><label>Full name</label><input id="userName" required></div><div class="field"><label>Email</label><input id="userEmail" type="email" required></div><div class="field"><label>Mobile number</label><input id="userMobile" pattern="[0-9]{10}" maxlength="10" required></div><div class="field"><label>Register as</label><select id="role"><option>Farmer</option><option>Buyer</option></select></div><div class="field"><label>Password</label><input id="password" type="password" minlength="4" required></div></div><button class="primary">Create Account</button></form><p id="accountMsg"></p></div></section>
<section id="admin" class="page"><div class="card"><h2>Admin Login</h2><p class="muted">Demo credentials: admin / admin123</p><form onsubmit="adminLogin(event)"><div class="field"><label>Username</label><input id="adminUser" required></div><div class="field"><label>Password</label><input id="adminPass" type="password" required></div><button class="primary">Login</button></form><p id="adminMsg"></p></div><div id="adminPanel" class="card" style="display:none"><h2>Admin Dashboard</h2><div class="stats"><div class="stat">Listed products<b id="productCount">0</b></div><div class="stat">Orders<b id="orderCount">0</b></div><div class="stat">Registered users<b id="userCount">0</b></div></div><h3>Manage Produce Listings</h3><div id="adminProducts"></div><h3>Manage Orders</h3><div id="adminOrders"></div></div></section>
</main><footer>AgriMart | Farmer and Agricultural Marketplace | Internet Programming Lab Demo</footer>
<script>
let products=[{id:1,name:'Fresh Tomatoes',cat:'Vegetables',price:35,qty:100,farmer:'Ramesh',location:'Kanchipuram',contact:'9876543210',desc:'Freshly harvested tomatoes.',icon:'🍅'},{id:2,name:'Basmati Rice',cat:'Grains',price:75,qty:200,farmer:'Suresh',location:'Thanjavur',contact:'9876543211',desc:'Quality rice from local farms.',icon:'🌾'},{id:3,name:'Banana',cat:'Fruits',price:45,qty:80,farmer:'Lakshmi',location:'Trichy',contact:'9876543212',desc:'Naturally ripened bananas.',icon:'🍌'},{id:4,name:'Fresh Spinach',cat:'Vegetables',price:25,qty:60,farmer:'Kumar',location:'Chennai',contact:'9876543213',desc:'Fresh green leafy vegetables.',icon:'🥬'}],cart=[],orders=JSON.parse(localStorage.getItem('agriOrders')||'[]'),users=JSON.parse(localStorage.getItem('agriUsers')||'[]'),admin=false;
function show(id,btn){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');if(id==='market')renderMarket();if(id==='cart')renderCart();if(id==='orders')renderOrders();if(id==='admin'&&admin)renderAdmin();window.scrollTo(0,0)}
function renderMarket(){let q=search.value.toLowerCase(),c=category.value;let a=products.filter(p=>p.name.toLowerCase().includes(q)&&(!c||p.cat===c));productsDiv=document.getElementById('products');productsDiv.innerHTML=a.map(p=>`<div class="item"><div class="emoji">${p.icon||'🌱'}</div><h3>${p.name}</h3><span class="tag">${p.cat}</span><p class="price">₹${p.price} / unit</p><p>Available: ${p.qty}</p><p class="muted">Farmer: ${p.farmer} · ${p.location}</p><div class="actions"><button onclick="viewProduct(${p.id})">Details</button><button class="primary" onclick="addCart(${p.id})">Add to Cart</button></div></div>`).join('')||'<p>No produce found.</p>'}
function viewProduct(id){let p=products.find(x=>x.id===id);productDetails.innerHTML=`<button onclick="show('market')">← Back</button><div class="emoji">${p.icon||'🌱'}</div><h2>${p.name}</h2><p class="price">₹${p.price} per unit</p><p>${p.desc}</p><p><b>Quantity:</b> ${p.qty}</p><p><b>Farmer:</b> ${p.farmer}</p><p><b>Location:</b> ${p.location}</p><p><b>Contact:</b> ${p.contact}</p><button class="primary" onclick="addCart(${p.id})">Add to Cart</button>`;show('details')}
function addProduce(e){e.preventDefault();products.push({id:Date.now(),name:produceName.value,cat:produceCategory.value,price:Number(producePrice.value),qty:Number(quantity.value),farmer:farmerName.value,location:farmLocation.value,contact:contact.value,desc:description.value,icon:'🌱'});sellMsg.textContent='Produce listed successfully.';e.target.reset();renderMarket()}
function addCart(id){let p=products.find(x=>x.id===id);let x=cart.find(x=>x.id===id);if(x)x.qty++;else cart.push({id,qty:1});alert('Added to selected produce.')}
function renderCart(){cartRows.innerHTML=cart.length?'<table><tr><th>Produce</th><th>Price</th><th>Quantity</th><th>Action</th></tr>'+cart.map(x=>{let p=products.find(a=>a.id===x.id);return `<tr><td>${p.name}</td><td>₹${p.price}</td><td><button onclick="changeQty(${p.id},-1)">−</button> ${x.qty} <button onclick="changeQty(${p.id},1)">+</button></td><td><button onclick="removeCart(${p.id})">Remove</button></td></tr>`}).join('')+'</table>':'No items selected.';cartTotal.textContent='Total: ₹'+cart.reduce((s,x)=>s+products.find(p=>p.id===x.id).price*x.qty,0)}
function changeQty(id,n){let x=cart.find(a=>a.id===id);x.qty+=n;if(x.qty<1)cart=cart.filter(a=>a.id!==id);renderCart()}
function removeCart(id){cart=cart.filter(x=>x.id!==id);renderCart()}
function placeOrder(e){e.preventDefault();if(!cart.length){orderMsg.textContent='Please add produce to your order first.';return}let total=cart.reduce((s,x)=>s+products.find(p=>p.id===x.id).price*x.qty,0);let o={id:'AG'+(1001+orders.length),buyer:buyerName.value,email:buyerEmail.value,phone:buyerPhone.value,address:deliveryAddress.value,payment:payment.value,total,items:cart.map(x=>({...x})),status:'Order Placed'};orders.push(o);localStorage.setItem('agriOrders',JSON.stringify(orders));cart=[];orderMsg.textContent='Order placed successfully. Order ID: '+o.id;e.target.reset()}
function renderOrders(){orderRows.innerHTML=orders.length?'<table><tr><th>Order ID</th><th>Buyer</th><th>Total</th><th>Status</th></tr>'+orders.map(o=>`<tr><td>${o.id}</td><td>${o.buyer}</td><td>₹${o.total}</td><td>${o.status}</td></tr>`).join('')+'</table>':'No orders placed yet.'}
function register(e){e.preventDefault();users.push({name:userName.value,email:userEmail.value,mobile:userMobile.value,role:role.value,password:password.value});localStorage.setItem('agriUsers',JSON.stringify(users));accountMsg.textContent='Registration successful.';e.target.reset()}
function adminLogin(e){e.preventDefault();if(adminUser.value==='admin'&&adminPass.value==='admin123'){admin=true;adminMsg.textContent='Login successful.';adminPanel.style.display='block';renderAdmin()}else adminMsg.textContent='Invalid login details.'}
function renderAdmin(){productCount.textContent=products.length;orderCount.textContent=orders.length;userCount.textContent=users.length;adminProducts.innerHTML='<table><tr><th>Produce</th><th>Farmer</th><th>Price</th><th>Action</th></tr>'+products.map(p=>`<tr><td>${p.name}</td><td>${p.farmer}</td><td>₹${p.price}</td><td><button onclick="deleteProduct(${p.id})">Remove</button></td></tr>`).join('')+'</table>';adminOrders.innerHTML=orders.length?'<table><tr><th>Order</th><th>Buyer</th><th>Status</th><th>Update</th></tr>'+orders.map((o,i)=>`<tr><td>${o.id}</td><td>${o.buyer}</td><td>${o.status}</td><td><select onchange="updateOrder(${i},this.value)"><option>Order Placed</option><option>Processing</option><option>Dispatched</option><option>Delivered</option><option>Cancelled</option></select></td></tr>`).join('')+'</table>':'No orders yet.'}
function deleteProduct(id){products=products.filter(p=>p.id!==id);renderAdmin();renderMarket()}
function updateOrder(i,s){orders[i].status=s;localStorage.setItem('agriOrders',JSON.stringify(orders));renderAdmin()}
renderMarket();
</script></body></html>
