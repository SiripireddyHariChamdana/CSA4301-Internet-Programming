<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f1f5f8"><title>Wayfare — Student & route bus pass</title>
<style>
:root{--ink:#243241;--muted:#71808d;--bg:#f1f5f8;--paper:#fff;--navy:#183d5a;--blue:#287daa;--teal:#18877d;--gold:#dda94c;--line:#dfe7ed}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.6 Arial,sans-serif}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button,.btn{border:0;border-radius:6px;padding:11px 15px;background:var(--blue);color:white;cursor:pointer;font-weight:bold;display:inline-block}button:hover,.btn:hover{background:var(--navy)}.outline{background:transparent;color:var(--navy);border:1px solid #ccd9e2}.teal{background:var(--teal)}header{position:sticky;top:0;z-index:5;background:#fffF;border-bottom:1px solid var(--line)}nav{max-width:1160px;margin:auto;min-height:70px;padding:12px 22px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{font-size:22px;font-weight:900;color:var(--navy)}.brand span{color:var(--teal)}.links{display:flex;gap:17px;align-items:center;flex-wrap:wrap}.links a{font-size:13px;font-weight:bold;color:#516473}.view{display:none;min-height:70vh}.view.active{display:block}.hero{max-width:1160px;margin:18px auto 0;min-height:360px;border-radius:9px;padding:45px 6%;display:flex;align-items:center;background:linear-gradient(115deg,#183e5b,#227ca0);color:white}.hero h1{font-size:clamp(39px,6vw,65px);line-height:1.04;margin:12px 0}.hero p{max-width:590px;color:#e0eef4}.hero .eyebrow{color:#f4d18c}.hero .outline{color:white;border-color:#d6e5ec}.wrap{max-width:1160px;margin:auto;padding:42px 22px}.eyebrow{text-transform:uppercase;letter-spacing:1.6px;color:var(--teal);font-size:11px;font-weight:bold}.title{font-size:clamp(29px,4vw,43px);line-height:1.1;margin:7px 0}.sub{color:var(--muted);max-width:740px}.row{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:18px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.panel,.stat{background:white;border:1px solid var(--line);border-radius:8px;padding:19px}.stat strong{font-size:27px;color:var(--navy)}.two{display:grid;grid-template-columns:1fr 1fr;gap:18px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:5px 12px}.field{display:block;width:100%;padding:11px;margin-top:5px;border:1px solid #d4dee6;border-radius:5px;color:var(--ink);background:white}label{display:block;font-size:13px;font-weight:bold;margin:10px 0}.notice{background:#e8f2f5;border-left:3px solid var(--teal);padding:12px;margin:12px 0}.meta{font-size:12px;color:var(--muted)}.status{min-height:22px;color:#23744f;font-weight:bold}.badge{background:#e3f2e7;color:#27734c;padding:4px 9px;border-radius:18px;font-size:11px;font-weight:bold}.badge.pending{background:#fff0d6;color:#885c16}.pass{background:linear-gradient(135deg,#123b5a,#187d85);color:white;border-radius:12px;padding:23px;max-width:670px;box-shadow:0 12px 30px #173a5530}.pass h2{font-size:25px;margin:0}.passrow{display:grid;grid-template-columns:1fr auto;gap:16px}.qr{width:124px;height:124px;background:white;color:#1c3650;padding:9px;display:grid;place-items:center;text-align:center;border:5px solid white;font-size:11px;font-weight:bold;word-break:break-all}.photo{width:88px;height:108px;object-fit:cover;background:#ffffff2e;border:1px solid #ffffff80;border-radius:5px}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:13px}th,td{text-align:left;padding:9px;border-bottom:1px solid var(--line)}th{background:#f3f6f8}.toast{position:fixed;right:20px;bottom:20px;background:var(--navy);color:white;padding:12px 16px;border-radius:5px;display:none;z-index:9}.empty{color:var(--muted);padding:14px}footer{background:#183a54;color:#eaf1f5;padding:22px}.foot{max-width:1160px;margin:auto;display:flex;justify-content:space-between;gap:13px;flex-wrap:wrap}.foot a{text-decoration:underline;text-underline-offset:3px}@media(max-width:760px){.grid,.two{grid-template-columns:1fr 1fr}.links{gap:10px}}@media(max-width:560px){nav{align-items:flex-start;flex-direction:column}.grid,.two,.formgrid{grid-template-columns:1fr}.wrap{padding:32px 16px}.hero{margin:10px;min-height:315px;padding:32px 22px}.passrow{grid-template-columns:1fr}.qr{width:100px;height:100px}}
</style></head><body>
<header><nav><a class="brand" href="#home">Way<span>fare</span> Pass</a><div class="links"><a href="#home">Home</a><a href="#apply">Apply / renew</a><a href="#my-pass">My pass</a><a href="#admin">Admin</a><a href="#conductor">Conductor</a></div></nav></header>
<main>
<section class="view" id="home"><div class="hero"><div><div class="eyebrow">Your journey, made simpler</div><h1>One pass.<br>A thousand places.</h1><p>Apply for a student or route bus pass, renew monthly, and keep your pass details close at hand.</p><div class="actions"><a class="btn" href="#apply">Apply for a pass</a><a class="btn outline" href="#my-pass">View my pass</a></div></div></div><div class="wrap"><div class="row"><div><div class="eyebrow">Designed for the daily commute</div><h2 class="title">A better way to ride.</h2></div></div><div class="grid"><article class="stat"><strong>Student</strong><p class="meta">School details, validity dates, and government-school fare eligibility.</p></article><article class="stat"><strong>Route</strong><p class="meta">Organization details and chosen route for regular travelers.</p></article><article class="stat"><strong>Monthly</strong><p class="meta">Choose validity and renew your pass when you need it.</p></article></div><div class="notice">Demo pass only: approvals, fares, and QR-style identifiers are simulated in this browser and are not valid for travel.</div></div></section>
<section class="view" id="apply"><div class="wrap"><div class="eyebrow">New application or monthly renewal</div><h1 class="title">Apply for your bus pass.</h1><div class="two"><form id="passForm" class="panel"><h2>Passenger details</h2><div class="formgrid"><label>Full name<input class="field" name="name" required></label><label>Date of birth<input class="field" name="dob" type="date" required></label><label>Email<input class="field" name="email" type="email" required></label><label>Phone<input class="field" name="phone" type="tel" required></label></div><label>Address<textarea class="field" name="address" rows="2" required></textarea></label><div class="formgrid"><label>Pass type<select class="field" id="passType" name="type"><option>Student Pass</option><option>Route Pass</option></select></label><label>Validity<select class="field" name="months"><option value="1">1 month</option><option value="2">2 months</option><option value="3">3 months</option><option value="6">6 months</option></select></label></div><label id="institutionLabel">School / college name<input class="field" name="institution" required></label><label id="govLabel"><input id="government" type="checkbox" name="government"> Government school student (eligible demo fare: free)</label><div class="formgrid"><label>From<input class="field" name="from" required></label><label>To<input class="field" name="to" required></label></div><label>Candidate photo<input class="field" name="photo" type="file" accept="image/*"></label><p class="meta">Photo is optional and kept locally in this browser.</p><div class="notice" id="farePreview"></div><button>Submit pass application</button><p id="applicationStatus" class="status" role="status"></p></form><div class="panel"><h2>Renew an existing pass</h2><p class="sub">Enter the pass ID from your approved demo pass and choose the renewal period.</p><form id="renewForm"><label>Pass ID<input class="field" name="id" required></label><label>Months to renew<select class="field" name="months"><option value="1">1 month</option><option value="2">2 months</option><option value="3">3 months</option></select></label><button class="outline">Request renewal</button><p id="renewStatus" class="status"></p></form><div class="notice">Student fare: ₹250 per month, or free for government school students. Route pass: ₹500 per month. Demo prices only.</div></div></div></div></section>
<section class="view" id="my-pass"><div class="wrap"><div class="eyebrow">Passenger wallet</div><h1 class="title">My bus pass.</h1><div class="two"><div class="panel"><h2>Find your pass</h2><form id="lookupForm"><label>Pass ID<input class="field" name="id" placeholder="e.g. WP-2026-123456" required></label><button>View pass</button></form><div id="passOutput" style="margin-top:16px"><p class="empty">Submit an application to create a demo pass record.</p></div></div><div class="panel"><h2>My applications</h2><div id="applications"></div></div></div></div></section>
<section class="view" id="admin"><div class="wrap"><div class="eyebrow">Pass administration · demo</div><h1 class="title">Review pass applications.</h1><p class="sub">Approve or reject passenger pass requests and manage demo conductor access.</p><div class="panel"><div class="row"><h2>Pending passes</h2><button id="addConductor" class="outline">Add demo conductor login</button></div><div id="adminList"></div><p class="status" id="adminStatus"></p></div><div class="panel" style="margin-top:18px"><h2>Conductors</h2><div id="conductorList"></div></div></div></section>
<section class="view" id="conductor"><div class="wrap"><div class="eyebrow">Bus conductor tools · demo</div><h1 class="title">Verify a passenger pass.</h1><div class="two"><form id="verifyForm" class="panel"><h2>Enter pass ID</h2><label>Pass ID<input class="field" name="id" required></label><button>Verify demo pass</button><p id="verifyStatus" class="status"></p></form><div class="panel"><h2>Verification result</h2><div id="verifyResult"><p class="empty">Enter a pass ID to check its demo status.</p></div></div></div></div></section>
</main><footer><div class="foot"><a class="brand" style="color:white" href="#home">Wayfare Pass</a><span>More ways to make the journey yours.</span><span>Experiment 27 · <a href="../Exp-26/TrafficSquad.html">← Traffic Squad</a> · <a href="../Exp-28/ArtistryHub.html">Next: ArtistryHub →</a></span></div></footer><div class="toast" id="toast" role="status"></div>
<script>
const $=s=>document.querySelector(s),baseFare={"Student Pass":250,"Route Pass":500};function load(k,f){try{return JSON.parse(localStorage.getItem("wayfare-"+k))??f}catch{return f}}function save(k,v){localStorage.setItem("wayfare-"+k,JSON.stringify(v))}let passes=load("passes",[]),conductors=load("conductors",["Demo Conductor"]),selectedPhoto="";
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}function toast(s){const t=$("#toast");t.textContent=s;t.style.display="block";setTimeout(()=>t.style.display="none",2200)}
function amount(type,months,gov){return type==="Student Pass"&&gov?0:(baseFare[type]||250)*Number(months)}
function updateType(){const t=$("#passType").value,student=t==="Student Pass";$("#institutionLabel").firstChild.textContent=student?"School / college name":"Workplace / organization name";$("#govLabel").hidden=!student;updateFare()}
function updateFare(){const t=$("#passType").value,m=$("#passForm").elements.months.value,gov=$("#government").checked,amt=amount(t,m,gov);$("#farePreview").textContent=amt===0?"Estimated fare: FREE · Government school student demo eligibility":`Estimated ${m}-month fare: ₹${amt.toLocaleString("en-IN")} (demo rates)`}
function endDate(months){const d=new Date();d.setMonth(d.getMonth()+Number(months));return d.toLocaleDateString("en-IN",{day:"2-digit",month:"short",year:"numeric"})}
function renderAdmin(){$("#adminList").innerHTML=passes.filter(p=>p.status==="Pending").map(p=>`<article class="panel" style="margin:10px 0"><div class="row"><b>${esc(p.name)} · ${esc(p.type)}</b><span class="badge pending">Pending</span></div><p>${esc(p.from)} → ${esc(p.to)} · ${p.months} month(s)</p><p>${esc(p.institution)} · Fare ₹${p.amount}</p><p class="meta">${esc(p.email)} · ${esc(p.phone)} · ID ${esc(p.id)}</p><button data-approve="${p.id}">Approve & generate pass</button> <button class="outline" data-reject="${p.id}">Reject</button></article>`).join("")||'<p class="empty">No pending applications.</p>';$("#conductorList").innerHTML=conductors.map(c=>`<div class="row">${esc(c)} <span class="badge">Demo access</span></div>`).join("")}
function renderPass(p){return `<article class="pass"><div class="row"><div><div class="eyebrow" style="color:#bde8df">WAYFARE · ${esc(p.type)}</div><h2>${esc(p.name)}</h2></div><span class="badge">${esc(p.status)}</span></div><div class="passrow"><div><p>${esc(p.from)} → ${esc(p.to)}</p><p>${esc(p.institution)}</p><p>Pass ID: <b>${esc(p.id)}</b></p><p>Valid until: ${esc(p.validUntil)} · Amount paid: ₹${p.amount}</p>${p.photo?`<img class="photo" src="${p.photo}" alt="Passenger photo">`:""}</div><div class="qr" aria-label="Demo pass code">DEMO PASS<br>${esc(p.id)}<br><small>NOT A VALID QR</small></div></div><p class="meta" style="color:#dce9e7">Demonstration pass only. This code is not valid for travel.</p></article><div class="actions"><button class="outline" data-print>Print demo pass</button></div>`}
function lookup(id){const p=passes.find(x=>x.id.toLowerCase()===id.toLowerCase());$("#passOutput").innerHTML=p?renderPass(p):'<p class="empty">Pass ID not found.</p>'}
function renderApplications(){$("#applications").innerHTML=passes.length?passes.slice().reverse().map(p=>`<div class="row"><div><b>${esc(p.type)}</b><div class="meta">${esc(p.from)} → ${esc(p.to)} · ${esc(p.id)}</div></div><span class="badge ${p.status==="Pending"?"pending":""}">${esc(p.status)}</span></div>`).join(""):'<p class="empty">You have no applications yet.</p>'}
$("#passType").addEventListener("change",updateType);$("#passForm").elements.months.addEventListener("change",updateFare);$("#government").addEventListener("change",updateFare);
$("#passForm").elements.photo.addEventListener("change",e=>{const f=e.target.files[0];if(!f){selectedPhoto="";return}if(f.size>1000000){e.target.value="";toast("Choose a photo smaller than 1 MB.");return}const r=new FileReader();r.onload=()=>selectedPhoto=r.result;r.onerror=()=>toast("Could not read that photo.");r.readAsDataURL(f)});
$("#passForm").addEventListener("submit",e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target)),id="WP-"+new Date().getFullYear()+"-"+String(Date.now()).slice(-6),p={...d,id,months:Number(d.months),amount:amount(d.type,d.months,$("#government").checked),status:"Pending",validUntil:endDate(d.months),photo:selectedPhoto};passes.push(p);save("passes",passes);$("#applicationStatus").textContent=`Application ${id} submitted. Admin approval is required.`;renderAdmin();renderApplications();e.target.reset();selectedPhoto="";updateType()});
$("#lookupForm").addEventListener("submit",e=>{e.preventDefault();lookup(new FormData(e.target).get("id"))});
$("#renewForm").addEventListener("submit",e=>{e.preventDefault();const d=new FormData(e.target),p=passes.find(x=>x.id.toLowerCase()===d.get("id").toLowerCase());if(!p){$("#renewStatus").textContent="Pass not found. Check the ID and try again.";return}const months=Number(d.get("months")),renewal={...p,id:"WP-"+new Date().getFullYear()+"-"+String(Date.now()).slice(-6),months,amount:p.type==="Student Pass"&&p.amount===0?0:baseFare[p.type]*months,status:"Pending renewal",validUntil:endDate(months)};passes.push(renewal);renewal.status="Pending";save("passes",passes);$("#renewStatus").textContent=`Renewal request ${renewal.id} submitted for approval.`;renderAdmin();renderApplications()});
document.addEventListener("click",e=>{const a=e.target.closest("[data-approve]");if(a){const p=passes.find(x=>x.id===a.dataset.approve);p.status="Approved";save("passes",passes);renderAdmin();renderApplications();$("#adminStatus").textContent=`Pass ${p.id} approved. Demo pass code generated.`;return}const r=e.target.closest("[data-reject]");if(r){const p=passes.find(x=>x.id===r.dataset.reject);p.status="Rejected";save("passes",passes);renderAdmin();renderApplications();return}if(e.target.closest("[data-print]"))window.print()});
$("#addConductor").addEventListener("click",()=>{const name=prompt("Enter a demo conductor name:");if(name&&name.trim()){conductors.push(name.trim());save("conductors",conductors);renderAdmin()}});
$("#verifyForm").addEventListener("submit",e=>{e.preventDefault();const id=new FormData(e.target).get("id"),p=passes.find(x=>x.id.toLowerCase()===id.toLowerCase());$("#verifyResult").innerHTML=p?`<div class="notice"><b>${esc(p.status==="Approved"?"PASS APPROVED":"PASS NOT VALID")}</b><br>${esc(p.name)} · ${esc(p.type)}<br>${esc(p.from)} → ${esc(p.to)}<br>Valid until ${esc(p.validUntil)}<br>Demo pass ID ${esc(p.id)}</div>`:'<p class="empty">No pass found for that ID.</p>'});
$("#admin").addEventListener("change",()=>renderAdmin());$("#passOutput").addEventListener("click",e=>{if(e.target.closest("[data-print]"))window.print()});
function route(){const id=location.hash.slice(1)||"home";if(!document.getElementById(id)?.classList.contains("view")){location.hash="#home";return}document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===id));if(id==="admin")renderAdmin();if(id==="my-pass")renderApplications();window.scrollTo(0,0)}window.addEventListener("hashchange",route);updateType();renderAdmin();route();
</script></body></html>
