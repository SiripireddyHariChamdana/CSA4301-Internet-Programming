<title>Everyday Goods — Useful things, chosen well</title>
<style>
:root{--ink:#222c28;--muted:#737d76;--bg:#f3f5f0;--paper:#fff;--green:#225747;--mint:#dcece4;--line:#e1e7e1;--orange:#ce8053}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.6 Arial,sans-serif}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button,.btn{border:0;background:var(--green);color:white;padding:11px 15px;border-radius:5px;cursor:pointer;font-weight:700;display:inline-block}button:hover,.btn:hover{background:#163d32}.outline{background:transparent;color:var(--green);border:1px solid var(--green)}header{position:sticky;top:0;z-index:5;background:#ffffffed;border-bottom:1px solid var(--line)}nav{max-width:1160px;margin:auto;padding:12px 23px;min-height:69px;display:flex;align-items:center;justify-content:space-between;gap:18px}.logo{font-size:20px;font-weight:900;letter-spacing:-.7px;color:var(--green)}.logo span{color:var(--orange)}.links{display:flex;gap:18px;align-items:center;flex-wrap:wrap}.links a{font-size:13px;font-weight:bold;color:#4e5e55}.links a:hover{color:var(--orange)}.cart{background:var(--mint);padding:5px 10px;border-radius:20px}.view{display:none;min-height:72vh}.view.active{display:block}.hero{max-width:1160px;margin:22px auto 0;min-height:375px;border-radius:8px;background:linear-gradient(100deg,#123b30e8,#123b3060),url('https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=1800&q=85') center/cover;color:white;display:flex;align-items:center}.hero-copy{max-width:650px;padding:45px 7%}.hero h1{font-size:clamp(39px,6vw,65px);line-height:1.03;margin:12px 0}.hero p{color:#e1ebe4;max-width:500px}.eyebrow{text-transform:uppercase;letter-spacing:2px;font-size:11px;color:var(--orange);font-weight:bold}.wrap{max-width:1160px;margin:auto;padding:46px 23px}.title{font-size:clamp(30px,4.4vw,45px);line-height:1.12;margin:8px 0}.sub{color:var(--muted);max-width:720px}.row{display:flex;align-items:end;justify-content:space-between;gap:15px;flex-wrap:wrap;margin-bottom:20px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.product{background:white;border:1px solid var(--line);border-radius:7px;overflow:hidden}.product-image{height:180px;display:grid;place-items:center;background:linear-gradient(145deg,#e7eee8,#c9d9cf);font-size:59px}.product:nth-child(4n+2) .product-image{background:linear-gradient(145deg,#f3e7d8,#dcc0a4)}.product:nth-child(4n+3) .product-image{background:linear-gradient(145deg,#e0e8f2,#c4d2e3)}.product:nth-child(4n) .product-image{background:linear-gradient(145deg,#efe2e4,#ddc3c4)}.product-body{padding:14px}.product h3{margin:3px 0;font-size:16px}.product-body p{margin:5px 0;color:var(--muted);font-size:12px}.price{font-weight:bold;color:var(--green)}.product-bottom{display:flex;justify-content:space-between;align-items:center;margin-top:11px}.product-bottom button{font-size:12px;padding:8px}.toolbar{display:flex;gap:9px;flex-wrap:wrap;margin:19px 0}.toolbar input,.toolbar select,.field{padding:10px 11px;border:1px solid #d6dfd8;border-radius:5px;background:white;color:var(--ink)}.toolbar input{flex:1;min-width:200px}.toolbar select{min-width:155px}.panel{background:white;border:1px solid var(--line);border-radius:7px;padding:21px}.two{display:grid;grid-template-columns:1fr 1fr;gap:18px}.cart-line{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:14px;padding:14px 0;border-bottom:1px solid var(--line)}.cart-line button{padding:4px 8px;margin:0 4px}.meta{font-size:12px;color:var(--muted)}label{display:block;font-size:13px;font-weight:bold;margin:10px 0}.field{display:block;width:100%;margin-top:5px}.notice{background:#edf5ef;border-left:3px solid var(--green);padding:13px;margin:12px 0}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.feature{padding:18px;background:#fff;border:1px solid var(--line);border-radius:7px}.feature b{color:var(--green)}.empty{color:var(--muted);padding:18px}.receipt{border:1px dashed #91a89b;padding:18px;margin-top:18px}footer{background:#203d32;color:#ecf4ed;padding:24px}.foot{max-width:1160px;margin:auto;display:flex;justify-content:space-between;gap:16px;align-items:center;flex-wrap:wrap}.foot a{text-decoration:underline;text-underline-offset:3px}.toast{position:fixed;right:20px;bottom:20px;background:#203d32;color:white;padding:12px 16px;border-radius:5px;display:none;z-index:9}@media(max-width:850px){.grid{grid-template-columns:repeat(2,1fr)}.links{gap:12px}}@media(max-width:580px){nav{align-items:flex-start;flex-direction:column}.grid,.two,.features{grid-template-columns:1fr}.wrap{padding:34px 18px}.hero{margin:12px;min-height:340px}.cart-line{grid-template-columns:1fr auto}}
</style>
</head>
<body>
<header><nav><a class="logo" href="#home">everyday<span>goods</span></a><div class="links"><a href="#home">Home</a><a href="#catalog">Shop all</a><a href="#about">Our story</a><a href="#help">Help</a><a class="cart" href="#cart">Bag <span id="cartCount">0</span></a></div></nav></header>
<main>
<section class="view" id="home"><div class="hero"><div class="hero-copy"><div class="eyebrow" style="color:#d6e5d7">Good things, for every day</div><h1>Useful things.<br>Chosen well.</h1><p>Thoughtful essentials for home, work, and everywhere in between. Made to be used, loved, and kept.</p><a class="btn" href="#catalog">Explore the collection</a></div></div><div class="wrap"><div class="row"><div><div class="eyebrow">Picked for you</div><h2 class="title">Everyday favorites</h2></div><a class="btn outline" href="#catalog">Shop everything</a></div><div class="grid" id="featured"></div></div><div class="wrap" style="padding-top:0"><div class="features"><div class="feature"><b>Thoughtful materials</b><p class="meta">Carefully selected for comfort, durability, and everyday use.</p></div><div class="feature"><b>Simple delivery</b><p class="meta">Clear order details and delivery updates in one place.</p></div><div class="feature"><b>Here to help</b><p class="meta">Questions about a product? Our team is happy to help.</p></div></div></div></section>
<section class="view" id="catalog"><div class="wrap"><div class="eyebrow">The collection</div><h1 class="title">Find your everyday essential.</h1><p class="sub">Search, filter by category, or sort by price and popularity.</p><div class="toolbar"><input id="search" placeholder="Search products" aria-label="Search products"><select id="category" aria-label="Filter by category"><option value="">All categories</option><option>Accessories</option><option>Home</option><option>Electronics</option><option>Apparel</option></select><select id="sort" aria-label="Sort products"><option value="featured">Featured</option><option value="low">Price: low to high</option><option value="high">Price: high to low</option><option value="popular">Most popular</option></select></div><p id="resultCount" class="meta"></p><div class="grid" id="products"></div></div></section>
<section class="view" id="about"><div class="wrap"><div class="eyebrow">A little less, a little better</div><h1 class="title">Everyday goods, considered.</h1><div class="two"><div><p class="sub">We believe the things you use every day should work beautifully and last. Everyday Goods is a small, independent shop curating useful, well-made essentials for home, work, and life on the move.</p><p class="sub">We look for practical details, timeless design, and materials that feel good to live with. No long list of things you don't need—just thoughtful choices, clearly described.</p><a class="btn" href="#catalog">Explore the collection</a></div><div class="panel"><div class="eyebrow">How we choose</div><h2>Useful first. Thoughtful always.</h2><p>Products chosen for their everyday purpose.</p><p>Clear descriptions and honest prices.</p><p>Friendly support when you need it.</p><p class="notice">This is a demonstration storefront. Product availability and order details are illustrative.</p></div></div></div></section>
<section class="view" id="cart"><div class="wrap"><div class="eyebrow">Your bag</div><h1 class="title">Ready when you are.</h1><div class="two"><div class="panel"><div id="cartItems"></div><p id="cartTotal" class="price"></p><a id="checkoutLink" class="btn" href="#checkout">Continue to checkout</a> <a class="btn outline" href="#catalog">Continue shopping</a></div><div class="panel"><h2>Delivery information</h2><p class="sub">Shipping options and estimated delivery are shown during checkout. This local demo does not connect to a fulfillment service.</p><p class="notice">Demo order only: no money is collected and no item is shipped.</p></div></div></div></section>
<section class="view" id="checkout"><div class="wrap"><div class="eyebrow">Secure checkout · demonstration</div><h1 class="title">Delivery and payment.</h1><div class="two"><form id="checkoutForm" class="panel"><h2>Shipping details</h2><label>Full name<input class="field" name="name" autocomplete="name" required></label><label>Email address<input class="field" name="email" type="email" autocomplete="email" required></label><label>Street address<input class="field" name="address" autocomplete="street-address" required></label><div class="two"><label>City<input class="field" name="city" autocomplete="address-level2" required></label><label>Postal code<input class="field" name="zip" autocomplete="postal-code" required></label></div><label>Payment method<select class="field" name="payment"><option>Card (demo only)</option><option>Digital wallet (demo only)</option><option>Pay on delivery (demo only)</option></select></label><button>Place demo order</button><p class="meta">Never enter actual payment details. No payment gateway is connected.</p></form><div class="panel"><h2>Order summary</h2><div id="summary"></div><p id="summaryTotal" class="price"></p></div></div><div id="orderReceipt" class="receipt" hidden></div></div></section>
<section class="view" id="help"><div class="wrap"><div class="eyebrow">We're happy to help</div><h1 class="title">Questions, answered.</h1><div class="two"><div class="panel"><details open><summary>How can I check an order?</summary><p class="sub">The confirmation on this demo page shows your order number and summary. Real order tracking would be connected to an account and shipping service.</p></details><details><summary>Can I change or cancel my order?</summary><p class="sub">Contact the shop promptly with your order number; changes depend on fulfillment status.</p></details><details><summary>How do product filters work?</summary><p class="sub">Use the category and sorting controls on the catalog page to narrow or reorder items.</p></details><details><summary>Is checkout real?</summary><p class="sub">No. This is a local demonstration. It does not collect card data, send orders, or process payments.</p></details></div><form id="contactForm" class="panel"><h2>Contact the shop</h2><label>Your name<input class="field" name="name" required></label><label>Email address<input class="field" name="email" type="email" required></label><label>Message<textarea class="field" name="message" rows="4" required></textarea></label><button>Send a message</button><p id="contactStatus" class="meta" role="status"></p><p class="meta">hello@everydaygoods.example · (555) 010-3970</p></form></div><div class="panel" style="margin-top:18px"><h2>Privacy</h2><p class="sub">Your cart is stored in this browser using local storage. This static demo has no server and does not send contact, shipping, or payment information anywhere. Clearing browser storage removes your cart.</p></div></div></section>
<section class="view" id="confirmation"><div class="wrap"><div class="panel"><div class="eyebrow">Order placed · demo</div><h1 class="title">Thanks for shopping with us.</h1><p id="confirmationText" class="sub"></p><a class="btn" href="#catalog">Continue shopping</a><a class="btn outline" href="#home">Home</a></div></div></section>
</main>
<footer><div class="foot"><a class="logo" style="color:white" href="#home">everyday goods</a><span>Useful things, chosen well. · <a href="#help">Contact & FAQs</a></span><span>Experiment 39 · <a href="../Exp-38/GourmetHaven.html">← Gourmet Haven</a> · <a href="../Exp-40/TravelJournal.html">Next: travel journal →</a></span></div></footer><div class="toast" id="toast" role="status"></div>
<script>
const products=[{id:1,name:"Field Notes Journal",cat:"Accessories",price:18,pop:9,icon:"📓",desc:"A cloth-bound notebook for ideas, lists, and everything in between."},{id:2,name:"Everyday Tote",cat:"Accessories",price:24,pop:8,icon:"👜",desc:"A sturdy cotton carryall with room for all the essentials."},{id:3,name:"Studio Mug",cat:"Home",price:16,pop:10,icon:"☕",desc:"A comfortable stoneware mug for a slower morning ritual."},{id:4,name:"Pocket Headphones",cat:"Electronics",price:48,pop:7,icon:"🎧",desc:"Lightweight everyday listening with a comfortable fit."},{id:5,name:"Desk Light",cat:"Home",price:42,pop:6,icon:"💡",desc:"A warm, adjustable glow for focused evenings at your desk."},{id:6,name:"Soft Knit Scarf",cat:"Apparel",price:32,pop:9,icon:"🧣",desc:"A soft layer made for cool mornings and late walks."},{id:7,name:"Travel Bottle",cat:"Accessories",price:21,pop:8,icon:"🧴",desc:"A reusable bottle that keeps water close wherever you go."},{id:8,name:"Canvas Apron",cat:"Apparel",price:29,pop:5,icon:"🧑‍🍳",desc:"A practical, comfortable apron for home cooks and makers."}];
const $=s=>document.querySelector(s),money=n=>new Intl.NumberFormat("en-US",{style:"currency",currency:"USD"}).format(n);let bag=JSON.parse(localStorage.getItem("everyday-goods-cart")||"[]");
function card(p){return `<article class="product"><div class="product-image" aria-label="${p.name}">${p.icon}</div><div class="product-body"><span class="meta">${p.cat} · In stock</span><h3>${p.name}</h3><p>${p.desc}</p><div class="product-bottom"><span class="price">${money(p.price)}</span><button data-add="${p.id}">Add to bag</button></div></div></article>`}
function renderCatalog(){let list=[...products],q=$("#search").value.trim().toLowerCase(),cat=$("#category").value,sort=$("#sort").value;list=list.filter(p=>(!q||`${p.name} ${p.cat} ${p.desc}`.toLowerCase().includes(q))&&(!cat||p.cat===cat));if(sort==="low")list.sort((a,b)=>a.price-b.price);if(sort==="high")list.sort((a,b)=>b.price-a.price);if(sort==="popular")list.sort((a,b)=>b.pop-a.pop);$("#resultCount").textContent=`${list.length} product${list.length===1?"":"s"} available`;$("#products").innerHTML=list.length?list.map(card).join(""):'<p class="empty">No products match. Try another search or category.</p>'}
function renderBag(){const lines=bag.map(i=>{const p=products.find(x=>x.id===i.id);return `<div class="cart-line"><div><b>${p.icon} ${p.name}</b><div class="meta">${money(p.price)} each</div></div><div><button class="outline" data-qty="${p.id}" data-change="-1" aria-label="Remove one">−</button>${i.qty}<button class="outline" data-qty="${p.id}" data-change="1" aria-label="Add one">+</button></div><b>${money(p.price*i.qty)}</b></div>`});const total=bag.reduce((n,i)=>n+products.find(p=>p.id===i.id).price*i.qty,0);$("#cartItems").innerHTML=lines.join("")||'<p class="empty">Your bag is empty. <a href="#catalog">Browse products →</a></p>';$("#cartTotal").textContent=`Total: ${money(total)}`;$("#summary").innerHTML=lines.join("")||'<p class="empty">No items yet.</p>';$("#summaryTotal").textContent=`Total: ${money(total)}`;$("#checkoutLink").hidden=!bag.length;$("#cartCount").textContent=bag.reduce((n,i)=>n+i.qty,0)}
function save(){localStorage.setItem("everyday-goods-cart",JSON.stringify(bag));renderBag()}
function route(){const id=location.hash.slice(1)||"home";if(!document.getElementById(id)?.classList.contains("view")){location.hash="#home";return}document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===id));if(id==="cart"||id==="checkout")renderBag();window.scrollTo(0,0)}window.addEventListener("hashchange",route);route();
function toast(text){const t=$("#toast");t.textContent=text;t.style.display="block";clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>t.style.display="none",2100)}
document.addEventListener("click",e=>{const add=e.target.closest("[data-add]");if(add){const id=Number(add.dataset.add),line=bag.find(x=>x.id===id);line?line.qty++:bag.push({id,qty:1});save();toast("Added to your bag.");return}const q=e.target.closest("[data-qty]");if(q){const line=bag.find(x=>x.id===Number(q.dataset.qty));line.qty+=Number(q.dataset.change);if(line.qty<1)bag=bag.filter(x=>x!==line);save()}});
["search","category","sort"].forEach(id=>$("#"+id).addEventListener("input",renderCatalog));$("#featured").innerHTML=products.slice(0,4).map(card).join("");renderCatalog();save();
$("#checkoutForm").addEventListener("submit",e=>{e.preventDefault();if(!bag.length){toast("Your bag is empty.");location.hash="#catalog";return}const d=new FormData(e.target),order="EG-"+Math.random().toString(36).slice(2,8).toUpperCase(),summary=bag.map(i=>`${products.find(p=>p.id===i.id).name} × ${i.qty}`).join(", "),total=bag.reduce((n,i)=>n+products.find(p=>p.id===i.id).price*i.qty,0);$("#confirmationText").textContent=`${d.get("name")}, your demo order ${order} includes ${summary}. Total: ${money(total)}. No payment was collected and no products will be shipped.`;bag=[];save();e.target.reset();location.hash="#confirmation"});
$("#contactForm").addEventListener("submit",e=>{e.preventDefault();$("#contactStatus").textContent="Thanks for your message. This local demonstration does not send it to a server.";e.target.reset()});
</script>
</body>
</html>
