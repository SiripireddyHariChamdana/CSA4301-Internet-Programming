<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>SweetCrumbs | Online Cake Store</title>
<style>
:root{--pink:#e85b83;--pink2:#fff0f5;--rose:#a82c54;--ink:#322630;--muted:#7d7078;--bg:#fff9fb;--line:#f0dfe6;--green:#21845b;--cream:#fff3e4}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,Segoe UI,Arial,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0;border-radius:10px;padding:10px 15px;font-weight:700}.primary{background:var(--pink);color:#fff}.secondary{background:#fff;color:var(--rose);border:1px solid var(--line)}.danger{background:#fff0f0;color:#b33340;border:1px solid #f3d0d0}.hidden{display:none!important}.header{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:10}.headinner{max-width:1200px;margin:auto;min-height:74px;padding:12px 22px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{display:flex;align-items:center;gap:10px;color:var(--rose);font-weight:900;font-size:22px;white-space:nowrap}.brandmark{width:40px;height:40px;display:grid;place-items:center;background:var(--pink2);border-radius:13px;font-size:22px}.nav{display:flex;gap:4px;align-items:center;flex-wrap:wrap}.nav button{background:transparent;color:#695761;padding:9px 10px;font-size:13px}.nav button.active,.nav button:hover{background:var(--pink2);color:var(--rose)}.nav .loginbtn{background:var(--rose);color:white}.wrap{max-width:1200px;width:92%;margin:28px auto 55px}.hero{background:linear-gradient(120deg,#7d2548,#e85b83);border-radius:24px;padding:40px;color:white;display:grid;grid-template-columns:1.2fr .8fr;align-items:center;gap:15px;overflow:hidden}.eyebrow{text-transform:uppercase;letter-spacing:1.7px;font-size:12px;font-weight:800;color:#ffdbe7}.hero h1{font-size:clamp(32px,4vw,51px);line-height:1.05;margin:12px 0}.hero p{max-width:510px;color:#ffe9ef;line-height:1.65}.hero-art{font-size:140px;text-align:center;filter:drop-shadow(0 14px 12px #42102433)}.hero .primary{background:white;color:var(--rose);margin-top:9px}.sectionhead{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:30px 0 16px}.sectionhead h2{margin:0;font-size:23px}.muted{color:var(--muted)}.small{font-size:12px}.searchpanel,.panel{background:#fff;border:1px solid var(--line);border-radius:17px;padding:20px}.searchgrid{display:grid;grid-template-columns:1.3fr 1fr 1fr auto;gap:12px;align-items:end}.field label{display:block;font-size:12px;font-weight:750;color:var(--muted);margin-bottom:7px}.field input,.field select,.field textarea{width:100%;padding:11px 12px;border:1px solid #e7dce1;border-radius:10px;outline:none;background:white;color:var(--ink);min-width:0}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--pink);box-shadow:0 0 0 3px #e85b8318}.categories{display:flex;gap:9px;flex-wrap:wrap}.chip{background:#fff;border:1px solid var(--line);color:#75515f}.chip.active{background:var(--rose);color:#fff}.products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:17px}.product{background:#fff;border:1px solid var(--line);border-radius:17px;overflow:hidden;transition:transform .15s,box-shadow .15s}.product:hover{transform:translateY(-3px);box-shadow:0 12px 26px #63213a12}.productimg{height:175px;display:grid;place-items:center;background:linear-gradient(135deg,#fff0f5,#fff9ed);font-size:78px;position:relative}.productimg img{width:100%;height:100%;object-fit:cover}.badge{position:absolute;left:11px;top:11px;border-radius:20px;padding:5px 9px;background:#fff;color:var(--rose);font-size:10px;font-weight:800}.productbody{padding:15px}.productbody h3{margin:0 0 6px;font-size:16px}.productbody p{margin:0;color:var(--muted);font-size:12px;line-height:1.5;min-height:36px}.productmeta{display:flex;align-items:center;justify-content:space-between;margin:13px 0}.price{font-weight:900;font-size:19px;color:var(--rose)}.productactions{display:flex;gap:8px}.productactions button{flex:1;padding:9px 7px;font-size:12px}.formgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.formgrid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:17px}.pageTitle{font-size:29px;margin:0 0 6px}.pageSub{color:var(--muted);margin:0 0 22px}.notice{background:#eff9f3;color:#206c4e;padding:12px 14px;border-radius:10px;margin:12px 0;font-size:13px}.error{background:#fff0f0;color:#a72c39}.empty{text-align:center;padding:32px;color:var(--muted)}.layout2{display:grid;grid-template-columns:1.1fr .9fr;gap:18px}.cartrow{display:grid;grid-template-columns:1fr auto auto;gap:12px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line)}.qty{display:flex;align-items:center;gap:8px}.qty button{padding:5px 10px;background:var(--pink2);color:var(--rose)}.totalrow{display:flex;justify-content:space-between;align-items:center;padding-top:16px;font-weight:850;font-size:18px}.orders{display:grid;gap:13px}.ordercard{border:1px solid var(--line);background:white;border-radius:15px;padding:18px}.orderhead{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.tag{display:inline-block;border-radius:20px;padding:5px 10px;font-size:11px;font-weight:800;background:#e7f8ef;color:var(--green)}.tag.wait{background:#fff2db;color:#966000}.tag.cancel{background:#fff0f0;color:#a72c39}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;margin-bottom:18px}.stat{border:1px solid var(--line);background:white;border-radius:14px;padding:17px}.stat span{display:block;color:var(--muted);font-size:12px}.stat strong{display:block;font-size:25px;margin-top:6px}.tablewrap{overflow:auto}table{border-collapse:collapse;width:100%;font-size:13px}th,td{padding:12px;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}th{background:#fff7fa;color:var(--muted);font-size:11px;text-transform:uppercase}.footer{background:#3d2030;color:#f6dfe8;text-align:center;padding:28px 5%;font-size:12px}.toast{position:fixed;right:18px;bottom:18px;background:#3d2030;color:#fff;padding:13px 18px;border-radius:12px;z-index:20;box-shadow:0 10px 30px #0002;max-width:90vw}.stars{display:flex;gap:5px}.stars button{font-size:24px;padding:0 4px;background:none;color:#d0c4ca}.stars button.on{color:#f0ad31}
@media(max-width:950px){.products{grid-template-columns:repeat(2,minmax(0,1fr))}.searchgrid{grid-template-columns:repeat(2,minmax(0,1fr))}.hero{padding:30px}.hero-art{font-size:105px}.headinner{align-items:flex-start;flex-direction:column;gap:8px}.nav{justify-content:flex-start}.layout2{grid-template-columns:1fr}}
@media(max-width:560px){.wrap{width:94%;margin-top:17px}.hero{grid-template-columns:1fr;padding:25px 21px}.hero-art{display:none}.products{grid-template-columns:1fr 1fr;gap:10px}.productimg{height:125px;font-size:57px}.productbody{padding:11px}.productbody h3{font-size:14px}.productactions{flex-direction:column}.searchgrid,.formgrid,.formgrid.three{grid-template-columns:1fr}.stats{grid-template-columns:1fr}.nav button{font-size:12px;padding:8px}.sectionhead{align-items:flex-start;flex-direction:column}.cartrow{grid-template-columns:1fr auto}.cartrow .qty{grid-column:1}.cartrow .lineprice{grid-column:2;grid-row:1}.pageTitle{font-size:25px}}
@media print{.header,.footer,.no-print,.toast{display:none!important}body{background:#fff}.wrap{width:100%;margin:0}.panel,.ordercard{border:1px solid #aaa}}
</style>
</head>
<body>
<header class="header"><div class="headinner"><div class="brand"><div class="brandmark">🎂</div>SweetCrumbs</div><nav class="nav" id="nav"><button data-page="home" class="active">Home</button><button data-page="shop">Shop Cakes</button><button data-page="cart">Cart <span id="cartCount">0</span></button><button data-page="orders">My Orders</button><button data-page="feedback">Feedback</button><button data-page="admin">Admin</button><button data-page="login" class="loginbtn" id="loginNav">Login / Register</button></nav></div></header>
<main class="wrap">
<section class="page" id="page-home">
 <div class="hero"><div><div class="eyebrow">Freshly baked · Made with love</div><h1>A little sweetness<br>for every occasion.</h1><p>Find your celebration cake, personalize the message, and get it delivered to your door.</p><button class="primary" onclick="showPage('shop')">Explore cakes →</button></div><div class="hero-art">🎂</div></div>
 <div class="sectionhead"><h2>Find your perfect cake</h2><span class="muted small">Browse by category, flavour or budget</span></div>
 <div class="searchpanel"><div class="searchgrid"><div class="field"><label>Search cake</label><input id="homeSearch" placeholder="Chocolate, birthday, red velvet…" oninput="syncSearch(this.value)"></div><div class="field"><label>Category</label><select id="homeCategory" onchange="syncCategory(this.value)"><option value="All">All categories</option><option>Birthday</option><option>Wedding</option><option>Anniversary</option><option>Kids</option><option>Classic</option></select></div><div class="field"><label>Maximum price</label><select id="homePrice" onchange="syncPrice(this.value)"><option value="5000">Any price</option><option value="500">Under ₹500</option><option value="800">Under ₹800</option><option value="1200">Under ₹1,200</option></select></div><button class="primary" onclick="showPage('shop');renderProducts()">Find cakes</button></div></div>
 <div class="sectionhead"><h2>Customer favourites</h2><button class="secondary" onclick="showPage('shop')">View all cakes</button></div><div class="products" id="homeProducts"></div>
 <div class="sectionhead"><h2>Why SweetCrumbs?</h2></div><div class="products"><div class="panel"><div class="featureicon">🍓</div><h3>Fresh ingredients</h3><p class="muted">Made fresh for your special moments.</p></div><div class="panel"><div class="featureicon">🎨</div><h3>Personalized cakes</h3><p class="muted">Add your message and choose your size.</p></div><div class="panel"><div class="featureicon">🚚</div><h3>Delivery updates</h3><p class="muted">Follow your order status from your account.</p></div><div class="panel"><div class="featureicon">💝</div><h3>For every occasion</h3><p class="muted">Birthdays, weddings, anniversaries and more.</p></div></div>
</section>

<section class="page hidden" id="page-shop"><h1 class="pageTitle">Shop cakes</h1><p class="pageSub">Search, filter, customize and order your favourite cakes.</p>
<div class="panel"><div class="formgrid three"><div class="field"><label>Search by name / flavour</label><input id="shopSearch" placeholder="Chocolate, vanilla…" oninput="renderProducts()"></div><div class="field"><label>Category</label><select id="shopCategory" onchange="renderProducts()"><option>All</option><option>Birthday</option><option>Wedding</option><option>Anniversary</option><option>Kids</option><option>Classic</option></select></div><div class="field"><label>Maximum price</label><select id="shopPrice" onchange="renderProducts()"><option value="5000">Any price</option><option value="500">Under ₹500</option><option value="800">Under ₹800</option><option value="1200">Under ₹1,200</option></select></div></div><div class="categories" style="margin-top:15px"><button class="chip active" onclick="setFlavor('All',this)">All flavours</button><button class="chip" onclick="setFlavor('Chocolate',this)">Chocolate</button><button class="chip" onclick="setFlavor('Vanilla',this)">Vanilla</button><button class="chip" onclick="setFlavor('Red Velvet',this)">Red Velvet</button><button class="chip" onclick="setFlavor('Fruit',this)">Fruit</button></div></div><div class="sectionhead"><h2 id="productCount">All cakes</h2><span class="muted small">Prices start at the displayed amount</span></div><div id="shopProducts" class="products"></div></section>

<section class="page hidden" id="page-login"><h1 class="pageTitle">Your account</h1><p class="pageSub">Register or sign in to manage orders and delivery details.</p><div class="panel" style="max-width:650px"><div class="formgrid"><div class="field"><label>Full name (for registration)</label><input id="userName" placeholder="Your name"></div><div class="field"><label>Email</label><input id="userEmail" type="email" placeholder="you@example.com"></div><div class="field"><label>Password</label><input id="userPassword" type="password" placeholder="At least 4 characters"></div><div class="field"><label>Action</label><select id="userAction"><option value="login">Login</option><option value="register">Register</option></select></div></div><div class="actions"><button class="primary" onclick="loginUser()">Continue</button><button class="secondary" onclick="showPage('forgot')">Forgot password?</button></div><p class="muted small">Demo accounts and orders are stored locally in this browser. This is not production authentication.</p><div id="loginMessage"></div></div></section>

<section class="page hidden" id="page-forgot"><h1 class="pageTitle">Forgot password</h1><p class="pageSub">Enter your registered email to request password reset instructions.</p><div class="panel" style="max-width:600px"><div class="field"><label>Email address</label><input id="resetEmail" type="email" placeholder="you@example.com"></div><div class="actions"><button class="primary" onclick="resetPassword()">Request reset</button><button class="secondary" onclick="showPage('login')">Back to login</button></div><div id="resetMessage"></div></div></section>

<section class="page hidden" id="page-product"><h1 class="pageTitle">Customize your cake</h1><p class="pageSub">Choose the size, add a message and select a delivery date.</p><div id="customProduct"></div></section>

<section class="page hidden" id="page-cart"><h1 class="pageTitle">Your cart</h1><p class="pageSub">Review your cakes before placing the order.</p><div class="layout2"><div class="panel"><div id="cartItems"></div></div><div class="panel"><h3>Order summary</h3><div class="field" style="margin-top:15px"><label>Promo code</label><input id="promo" placeholder="Try SWEET10"></div><div class="actions"><button class="secondary" onclick="applyPromo()">Apply code</button></div><div id="promoMessage"></div><div class="totalrow"><span>Subtotal</span><span id="cartSubtotal">₹0</span></div><div class="totalrow" style="font-size:14px;font-weight:500"><span>Delivery</span><span>₹50</span></div><div class="totalrow"><span>Total</span><span id="cartTotal">₹50</span></div><div class="actions"><button class="primary" style="width:100%" onclick="goCheckout()">Proceed to checkout</button></div></div></div></section>

<section class="page hidden" id="page-checkout"><h1 class="pageTitle">Delivery & payment</h1><p class="pageSub">Enter delivery details and choose a demo payment method.</p><div class="layout2"><div class="panel"><h3>Shipping address</h3><div class="formgrid"><div class="field"><label>Recipient name</label><input id="shipName" placeholder="Full name"></div><div class="field"><label>Phone</label><input id="shipPhone" placeholder="Phone number"></div><div class="field"><label>Delivery date</label><input id="shipDate" type="date"></div><div class="field"><label>PIN code</label><input id="shipPin" maxlength="6" placeholder="6-digit PIN"></div><div class="field" style="grid-column:1/-1"><label>Full address</label><textarea id="shipAddress" rows="3" placeholder="House, street, area, city"></textarea></div><div class="field" style="grid-column:1/-1"><label>Delivery note (optional)</label><input id="shipNote" placeholder="Gate code, landmark, message"></div></div></div><div class="panel"><h3>Payment</h3><div id="checkoutSummary"></div><div class="field" style="margin-top:18px"><label>Payment method</label><select id="paymentMethod"><option>UPI (demo)</option><option>Credit / debit card (demo)</option><option>Cash on delivery</option></select></div><div class="notice">Demo checkout only. No real payment is processed and no payment details are sent to a gateway.</div><button class="primary" style="width:100%" onclick="placeOrder()">Place order</button></div></div></section>

<section class="page hidden" id="page-orders"><h1 class="pageTitle">My orders</h1><p class="pageSub">View your order history and follow delivery status.</p><div id="myOrders"></div></section>
<section class="page hidden" id="page-orderdetail"><div class="sectionhead"><div><h1 class="pageTitle">Order confirmation</h1><p class="pageSub">Keep your order number for tracking.</p></div><button class="primary no-print" onclick="window.print()">Print order</button></div><div id="orderDetail"></div><div class="actions no-print"><button class="secondary" onclick="showPage('orders')">My orders</button><button class="danger" onclick="cancelOrder(currentOrderId)">Request cancellation</button></div></section>

<section class="page hidden" id="page-admin"><h1 class="pageTitle">Admin panel</h1><p class="pageSub">Manage cake products, orders, delivery statuses, customers and reports.</p><div class="panel"><h3>Administrator login</h3><div class="formgrid"><div class="field"><label>Username</label><input id="adminUsername" value="admin"></div><div class="field"><label>Password</label><input id="adminPassword" type="password" placeholder="Admin password"></div></div><div class="actions"><button class="primary" onclick="adminLogin()">Login to admin</button></div><p class="muted small">Demo credentials: admin / cakeadmin123</p><div id="adminMessage"></div></div><div id="adminArea" class="hidden">
<div class="stats"><div class="stat"><span>Products</span><strong id="statProducts">0</strong></div><div class="stat"><span>Orders</span><strong id="statOrders">0</strong></div><div class="stat"><span>Feedback</span><strong id="statFeedback">0</strong></div></div>
<div class="layout2"><div class="panel"><h3 id="productFormTitle">Post a cake</h3><input type="hidden" id="editProductId"><div class="formgrid"><div class="field"><label>Cake name</label><input id="adminCakeName" placeholder="Cake name"></div><div class="field"><label>Flavour</label><select id="adminFlavor"><option>Chocolate</option><option>Vanilla</option><option>Red Velvet</option><option>Fruit</option><option>Butterscotch</option><option>Coffee</option></select></div><div class="field"><label>Category</label><select id="adminCategory"><option>Birthday</option><option>Wedding</option><option>Anniversary</option><option>Kids</option><option>Classic</option></select></div><div class="field"><label>Starting price (₹)</label><input id="adminPrice" type="number" min="1" placeholder="599"></div><div class="field"><label>Stock available</label><input id="adminStock" type="number" min="0" value="10"></div><div class="field"><label>Image URL (optional)</label><input id="adminImage" placeholder="https://..."></div><div class="field" style="grid-column:1/-1"><label>Description</label><textarea id="adminDescription" rows="3" placeholder="Describe this cake"></textarea></div></div><div class="actions"><button class="primary" onclick="saveProduct()">Save cake</button><button class="secondary" onclick="clearProductForm()">Clear</button></div></div><div class="panel"><h3>Admin reports</h3><p class="muted small">Export order, inventory and feedback records from this demo.</p><div class="actions"><button class="primary" onclick="exportOrders()">Export orders CSV</button><button class="secondary" onclick="exportProducts()">Export inventory CSV</button><button class="secondary" onclick="exportFeedback()">Export feedback CSV</button></div><div class="notice">This standalone demo uses browser storage. Use a server/database and payment provider for production.</div></div></div>
<div class="panel"><div class="sectionhead"><h3>Manage products</h3></div><div id="adminProducts" class="tablewrap"></div></div><div class="panel"><div class="sectionhead"><h3>Manage orders</h3></div><div id="adminOrders" class="tablewrap"></div></div><div class="panel"><div class="sectionhead"><h3>Customer accounts</h3></div><div id="adminUsers" class="tablewrap"></div></div><div class="panel"><div class="sectionhead"><h3>Customer feedback</h3></div><div id="adminFeedback" class="tablewrap"></div></div>
</div></section>
<section class="page hidden" id="page-feedback"><h1 class="pageTitle">Customer feedback</h1><p class="pageSub">Tell us about your cake and delivery experience.</p><div class="panel" style="max-width:680px"><div class="field"><label>Your name</label><input id="feedbackName" placeholder="Your name"></div><div class="field" style="margin-top:14px"><label>Rating</label><div class="stars" id="starButtons"><button data-rating="1">★</button><button data-rating="2">★</button><button data-rating="3">★</button><button data-rating="4">★</button><button data-rating="5">★</button></div></div><div class="field" style="margin-top:14px"><label>Feedback</label><textarea id="feedbackText" rows="4" placeholder="Write your feedback"></textarea></div><div class="actions"><button class="primary" onclick="submitFeedback()">Submit feedback</button></div><div id="feedbackMessage"></div></div><div class="sectionhead"><h2>Recent reviews</h2></div><div id="feedbackCards"></div></section>
</main>
<footer class="footer">© 2026 SweetCrumbs · Online Cake Store demo · Fresh cakes for every celebration</footer><div class="toast hidden" id="toast"></div>
<script>
const $=id=>document.getElementById(id);
const db={get(k,f){try{return JSON.parse(localStorage.getItem('sweetcrumbs_'+k))??f}catch(e){return f}},set(k,v){localStorage.setItem('sweetcrumbs_'+k,JSON.stringify(v))}};
const seed=[
{id:1,name:'Chocolate Truffle',flavor:'Chocolate',category:'Birthday',price:699,stock:18,description:'Rich chocolate sponge layered with silky truffle ganache.',emoji:'🍫',image:''},
{id:2,name:'Classic Vanilla Dream',flavor:'Vanilla',category:'Classic',price:499,stock:22,description:'Soft vanilla sponge with smooth whipped cream.',emoji:'🍰',image:''},
{id:3,name:'Red Velvet Romance',flavor:'Red Velvet',category:'Anniversary',price:899,stock:12,description:'Velvety red cake with cream cheese frosting.',emoji:'❤️',image:''},
{id:4,name:'Berry Garden Cake',flavor:'Fruit',category:'Wedding',price:1099,stock:9,description:'Fresh berry flavours with light vanilla cream.',emoji:'🍓',image:''},
{id:5,name:'Rainbow Sprinkle',flavor:'Vanilla',category:'Kids',price:649,stock:14,description:'Colourful sprinkles on a soft celebration cake.',emoji:'🌈',image:''},
{id:6,name:'Butterscotch Crunch',flavor:'Butterscotch',category:'Birthday',price:749,stock:15,description:'Creamy butterscotch with a crunchy praline finish.',emoji:'🍮',image:''},
{id:7,name:'Coffee Mocha',flavor:'Coffee',category:'Classic',price:799,stock:8,description:'Coffee-infused sponge and chocolate mocha cream.',emoji:'☕',image:''},
{id:8,name:'Elegant Wedding Cake',flavor:'Vanilla',category:'Wedding',price:2499,stock:5,description:'Elegant vanilla layers for special celebrations.',emoji:'💍',image:''}
];
let products=db.get('products',seed),orders=db.get('orders',[]),users=db.get('users',[]),feedback=db.get('feedback',[]),cart=db.get('cart',[]),currentUser=db.get('user',null),adminOn=false,flavorFilter='All',customId=null,selectedRating=5,currentOrderId=null,discount=0;
function persist(){['products','orders','users','feedback','cart','user'].forEach(k=>db.set(k,({products,orders,users,feedback,cart,user:currentUser})[k]));}
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function toast(s){$('toast').textContent=s;$('toast').classList.remove('hidden');setTimeout(()=>$('toast').classList.add('hidden'),2800)}
function showPage(page){document.querySelectorAll('.page').forEach(p=>p.classList.add('hidden'));$('page-'+page)?.classList.remove('hidden');document.querySelectorAll('#nav [data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===page));if(page==='shop')renderProducts();if(page==='cart')renderCart();if(page==='orders')renderOrders();if(page==='feedback')renderFeedback();if(page==='admin'&&adminOn)renderAdmin();if(page==='checkout')renderCheckoutSummary();window.scrollTo({top:0,behavior:'smooth'})}
document.querySelectorAll('#nav [data-page]').forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.page)));
function syncSearch(v){$('shopSearch').value=v}function syncCategory(v){$('shopCategory').value=v}function syncPrice(v){$('shopPrice').value=v}
function productCard(p){return `<article class="product"><div class="productimg">${p.image?`<img src="${esc(p.image)}" alt="${esc(p.name)}" onerror="this.remove()">`:''}<span>${p.emoji||'🎂'}</span><span class="badge">${esc(p.category)}</span></div><div class="productbody"><h3>${esc(p.name)}</h3><p>${esc(p.description)}</p><div class="productmeta"><span class="price">₹${Number(p.price).toLocaleString('en-IN')}</span><span class="muted small">${p.stock>0?p.stock+' left':'Sold out'}</span></div><div class="productactions"><button class="secondary" onclick="openProduct(${p.id})">Customize</button><button class="primary" onclick="addQuick(${p.id})" ${p.stock<=0?'disabled':''}>Add to cart</button></div></div></article>`}
function renderProducts(){let q=($('shopSearch')?.value||'').toLowerCase(),cat=$('shopCategory')?.value||'All',max=Number($('shopPrice')?.value||5000);let list=products.filter(p=>(p.name+' '+p.flavor+' '+p.description).toLowerCase().includes(q)&&(cat==='All'||p.category===cat)&&p.price<=max&&(flavorFilter==='All'||p.flavor===flavorFilter));$('shopProducts').innerHTML=list.length?list.map(productCard).join(''):'<div class="panel empty" style="grid-column:1/-1">No cakes match these filters. Try a different category or price range.</div>';$('productCount').textContent=`${list.length} cake${list.length===1?'':'s'} found`}
function setFlavor(f,el){flavorFilter=f;document.querySelectorAll('.chip').forEach(b=>b.classList.remove('active'));el.classList.add('active');renderProducts()}
function openProduct(id){customId=id;let p=products.find(x=>x.id===id);if(!p)return;$('customProduct').innerHTML=`<div class="layout2"><div class="panel" style="text-align:center"><div style="font-size:120px;background:var(--pink2);border-radius:18px;padding:25px">${p.emoji||'🎂'}</div><h2>${esc(p.name)}</h2><p class="muted">${esc(p.description)}</p><strong class="price">From ₹${p.price}</strong></div><div class="panel"><h3>Customize your cake</h3><div class="field"><label>Size</label><select id="cakeSize" onchange="updateCustomPrice()"><option value="1">500 g — serves 4–6</option><option value="1.7">1 kg — serves 8–10 (+70%)</option><option value="2.5">2 kg — serves 15–20 (+150%)</option></select></div><div class="field" style="margin-top:14px"><label>Message on cake</label><input id="cakeMessage" maxlength="50" placeholder="Happy Birthday!"></div><div class="field" style="margin-top:14px"><label>Occasion</label><select id="cakeOccasion"><option>Birthday</option><option>Anniversary</option><option>Wedding</option><option>Congratulations</option><option>Just because</option></select></div><div class="field" style="margin-top:14px"><label>Quantity</label><select id="cakeQty"><option>1</option><option>2</option><option>3</option><option>4</option></select></div><div class="totalrow"><span>Price</span><span id="customPrice">₹${p.price}</span></div><div class="actions"><button class="primary" onclick="addCustomized()">Add to cart</button><button class="secondary" onclick="showPage('shop')">Back to shop</button></div></div></div>`;showPage('product')}
function updateCustomPrice(){let p=products.find(x=>x.id===customId);$('customPrice').textContent='₹'+Math.round(p.price*Number($('cakeSize').value)).toLocaleString('en-IN')}
function addQuick(id){addCartItem(id,'500 g','',1,'Birthday');}
function addCustomized(){addCartItem(customId,$('cakeSize').options[$('cakeSize').selectedIndex].text.split(' — ')[0],$('cakeMessage').value,Number($('cakeQty').value),$('cakeOccasion').value)}
function addCartItem(id,size,message,qty,occasion){let p=products.find(x=>x.id===id);if(!p||p.stock<=0){toast('This cake is currently unavailable.');return}let mult=size.startsWith('1 kg')?1.7:size.startsWith('2 kg')?2.5:1;cart.push({lineId:Date.now()+Math.random(),id,size,message,qty,occasion,unitPrice:Math.round(p.price*mult),name:p.name,emoji:p.emoji});persist();updateCartCount();toast('Cake added to cart');}
function updateCartCount(){$('cartCount').textContent=cart.reduce((s,x)=>s+x.qty,0)}
function renderCart(){if(!cart.length){$('cartItems').innerHTML='<div class="empty">Your cart is empty.<br><br><button class="primary" onclick="showPage(\'shop\')">Browse cakes</button></div>'}else $('cartItems').innerHTML=cart.map(c=>`<div class="cartrow"><div><strong>${c.emoji||'🎂'} ${esc(c.name)}</strong><div class="muted small">${esc(c.size)} · ${esc(c.occasion)}${c.message?' · Message: '+esc(c.message):''}</div><div class="muted small">₹${c.unitPrice.toLocaleString('en-IN')} each</div></div><div class="qty"><button onclick="changeQty(${c.lineId},-1)">−</button><strong>${c.qty}</strong><button onclick="changeQty(${c.lineId},1)">+</button></div><strong class="lineprice">₹${(c.unitPrice*c.qty).toLocaleString('en-IN')} <button class="danger" style="padding:4px 7px" onclick="removeCart(${c.lineId})">×</button></strong></div>`).join('');updateTotals()}
function changeQty(id,delta){let c=cart.find(x=>x.lineId===id);if(c){c.qty=Math.max(1,Math.min(10,c.qty+delta));persist();renderCart()}}
function removeCart(id){cart=cart.filter(x=>x.lineId!==id);persist();updateCartCount();renderCart()}
function subtotal(){return cart.reduce((s,x)=>s+x.unitPrice*x.qty,0)}
function updateTotals(){let sub=subtotal(),delivery=sub?50:0;$('cartSubtotal').textContent='₹'+sub.toLocaleString('en-IN');$('cartTotal').textContent='₹'+Math.max(0,sub+delivery-discount).toLocaleString('en-IN')}
function applyPromo(){if($('promo').value.trim().toUpperCase()==='SWEET10'&&subtotal()>0){discount=Math.round(subtotal()*.1);$('promoMessage').innerHTML='<div class="notice">10% demo discount applied.</div>'}else{discount=0;$('promoMessage').innerHTML='<div class="notice error">Invalid code or cart is empty. Try SWEET10.</div>'}updateTotals()}
function goCheckout(){if(!cart.length){toast('Add a cake to your cart first.');return}if(!currentUser){toast('Please login or register before checkout.');showPage('login');return}showPage('checkout');$('shipName').value=currentUser.name||'';$('shipDate').min=new Date().toISOString().slice(0,10)}
function renderCheckoutSummary(){$('checkoutSummary').innerHTML=`<div class="muted small">${cart.reduce((s,x)=>s+x.qty,0)} item(s) in your order</div><div class="totalrow"><span>Subtotal</span><span>₹${subtotal().toLocaleString('en-IN')}</span></div><div class="totalrow" style="font-size:14px;font-weight:500"><span>Delivery</span><span>₹${subtotal()?50:0}</span></div><div class="totalrow"><span>Total</span><span>₹${Math.max(0,subtotal()+(subtotal()?50:0)-discount).toLocaleString('en-IN')}</span></div>`}
function placeOrder(){let name=$('shipName').value.trim(),phone=$('shipPhone').value.trim(),date=$('shipDate').value,pin=$('shipPin').value.trim(),address=$('shipAddress').value.trim();if(!name||phone.length<7||!date||pin.length!==6||!address){toast('Please complete all required delivery details.');return}let order={id:'SC'+Math.random().toString(36).slice(2,8).toUpperCase(),email:currentUser.email,name,phone,date,pin,address,note:$('shipNote').value,items:cart.map(x=>({...x})),subtotal:subtotal(),delivery:50,discount,total:Math.max(0,subtotal()+50-discount),payment:$('paymentMethod').value,paymentStatus:$('paymentMethod').value==='Cash on delivery'?'Pay on delivery':'Demo payment successful',status:'Order received',created:new Date().toLocaleString()};orders.unshift(order);cart=[];discount=0;persist();updateCartCount();currentOrderId=order.id;renderOrderDetail(order);showPage('orderdetail');toast('Order placed successfully in demo mode.')}
function renderOrders(){if(!currentUser){$('myOrders').innerHTML='<div class="panel empty">Please <button class="primary" onclick="showPage(\'login\')">login</button> to view your orders.</div>';return}let mine=orders.filter(o=>o.email.toLowerCase()===currentUser.email.toLowerCase());$('myOrders').innerHTML=mine.length?`<div class="orders">${mine.map(o=>`<div class="ordercard"><div class="orderhead"><div><strong>Order ${esc(o.id)}</strong><div class="muted small">${esc(o.created)} · ${o.items.length} product line(s)</div><p>${o.items.map(i=>esc(i.name)+' × '+i.qty).join(', ')}</p><div class="muted small">Deliver to: ${esc(o.address)}, ${esc(o.pin)}</div></div><div><span class="tag ${o.status.includes('Cancelled')?'cancel':o.status==='Order received'?'wait':''}">${esc(o.status)}</span><div class="price" style="margin-top:10px">₹${o.total.toLocaleString('en-IN')}</div></div></div><div class="actions"><button class="primary" onclick="openOrder('${o.id}')">View order / print</button>${!o.status.includes('Cancelled')&&o.status!=='Delivered'?`<button class="danger" onclick="cancelOrder('${o.id}')">Cancel request</button>`:''}</div></div>`).join('')}</div>`:'<div class="panel empty">You have no orders yet. Browse cakes to place your first order.</div>'}
function renderOrderDetail(o){currentOrderId=o.id;$('orderDetail').innerHTML=`<div class="panel"><div class="sectionhead"><div><h2>Order ${esc(o.id)}</h2><p class="muted small">Placed ${esc(o.created)}</p></div><span class="tag ${o.status.includes('Cancelled')?'cancel':''}">${esc(o.status)}</span></div><div class="tablewrap"><table><thead><tr><th>Cake</th><th>Customization</th><th>Qty</th><th>Amount</th></tr></thead><tbody>${o.items.map(i=>`<tr><td>${esc(i.name)}</td><td>${esc(i.size)}${i.message?' · '+esc(i.message):''}</td><td>${i.qty}</td><td>₹${(i.unitPrice*i.qty).toLocaleString('en-IN')}</td></tr>`).join('')}</tbody></table></div><div class="layout2" style="margin-top:18px"><div><h3>Delivery details</h3><p>${esc(o.name)} · ${esc(o.phone)}</p><p>${esc(o.address)}, ${esc(o.pin)}</p><p>Delivery date: ${esc(o.date)}</p><p class="muted small">${esc(o.note)}</p></div><div><h3>Payment summary</h3><p>Subtotal: ₹${o.subtotal}</p><p>Delivery: ₹${o.delivery}</p><p>Discount: ₹${o.discount}</p><h2>Total: ₹${o.total.toLocaleString('en-IN')}</h2><span class="tag">${esc(o.paymentStatus)}</span></div></div><div class="notice">This is a sample order confirmation. No real email was sent.</div></div>`}
function openOrder(id){let o=orders.find(x=>x.id===id);if(o){renderOrderDetail(o);showPage('orderdetail')}}
function cancelOrder(id){let o=orders.find(x=>x.id===id);if(!o)return;if(o.status.includes('Cancelled')){toast('This order is already cancelled.');return}if(!confirm('Submit a cancellation request for order '+id+'?'))return;o.status='Cancellation requested';persist();if($('page-orderdetail')&&!$('page-orderdetail').classList.contains('hidden'))renderOrderDetail(o);renderOrders();renderAdminIfOpen();toast('Cancellation request submitted. Refund eligibility requires admin review.')}
function loginUser(){let email=$('userEmail').value.trim().toLowerCase(),password=$('userPassword').value,name=$('userName').value.trim();if(!email.includes('@')||password.length<4){$('loginMessage').innerHTML='<div class="notice error">Enter a valid email and password (minimum 4 characters).</div>';return}if($('userAction').value==='register'){if(!name){toast('Please enter your name to register.');return}if(users.some(u=>u.email===email)){toast('An account with this email already exists.');return}users.push({name,email,password});currentUser={name,email};}else{let user=users.find(u=>u.email===email&&u.password===password);if(!user){$('loginMessage').innerHTML='<div class="notice error">Account not found or password incorrect. Select Register to create an account.</div>';return}currentUser={name:user.name,email:user.email}}persist();$('loginNav').textContent=currentUser.name.split(' ')[0];toast('Welcome, '+currentUser.name+'!');showPage('orders')}
function resetPassword(){let email=$('resetEmail').value.trim();$('resetMessage').innerHTML=email.includes('@')?'<div class="notice">Demo only: reset instructions would be sent if email service were connected.</div>':'<div class="notice error">Please enter a valid email.</div>'}
function adminLogin(){if($('adminUsername').value==='admin'&&$('adminPassword').value==='cakeadmin123'){adminOn=true;$('adminArea').classList.remove('hidden');$('adminMessage').innerHTML='<div class="notice">Admin access granted in demo mode.</div>';renderAdmin()}else $('adminMessage').innerHTML='<div class="notice error">Incorrect username or password.</div>'}
function renderAdminIfOpen(){if(adminOn)renderAdmin()}
function saveProduct(){let id=$('editProductId').value,name=$('adminCakeName').value.trim(),price=Number($('adminPrice').value),stock=Number($('adminStock').value);if(!name||price<=0||stock<0){toast('Enter a cake name, valid price and stock.');return}let p={id:id?Number(id):Date.now(),name,flavor:$('adminFlavor').value,category:$('adminCategory').value,price,stock,image:$('adminImage').value.trim(),description:$('adminDescription').value.trim(),emoji:products.find(x=>x.id===Number(id))?.emoji||'🎂'};if(id)products=products.map(x=>x.id===Number(id)?p:x);else products.unshift(p);persist();clearProductForm();renderAdmin();renderProducts();renderHomeProducts();toast('Cake saved.')}
function editProduct(id){let p=products.find(x=>x.id===id);if(!p)return;$('editProductId').value=p.id;$('productFormTitle').textContent='Edit cake';$('adminCakeName').value=p.name;$('adminFlavor').value=p.flavor;$('adminCategory').value=p.category;$('adminPrice').value=p.price;$('adminStock').value=p.stock;$('adminImage').value=p.image||'';$('adminDescription').value=p.description;window.scrollTo({top:0,behavior:'smooth'})}
function clearProductForm(){['editProductId','adminCakeName','adminPrice','adminImage','adminDescription'].forEach(id=>$(id).value='');$('adminStock').value=10;$('productFormTitle').textContent='Post a cake'}
function deleteProduct(id){if(!confirm('Remove this cake from the store?'))return;products=products.filter(p=>p.id!==id);persist();renderAdmin();renderProducts();renderHomeProducts()}
function updateOrderStatus(id,status){let o=orders.find(x=>x.id===id);if(o){o.status=status;persist();renderAdmin();renderOrders();toast('Order status updated.')}}
function renderAdmin(){if(!adminOn)return;$('statProducts').textContent=products.length;$('statOrders').textContent=orders.length;$('statFeedback').textContent=feedback.length;
$('adminProducts').innerHTML=products.length?`<table><thead><tr><th>Cake</th><th>Category</th><th>Flavour</th><th>Price</th><th>Stock</th><th>Actions</th></tr></thead><tbody>${products.map(p=>`<tr><td>${esc(p.name)}</td><td>${esc(p.category)}</td><td>${esc(p.flavor)}</td><td>₹${p.price}</td><td>${p.stock}</td><td><button class="secondary" onclick="editProduct(${p.id})">Edit</button> <button class="danger" onclick="deleteProduct(${p.id})">Delete</button></td></tr>`).join('')}</tbody></table>`:'<div class="empty">No products.</div>';
$('adminOrders').innerHTML=orders.length?`<table><thead><tr><th>Order</th><th>Customer</th><th>Products</th><th>Total</th><th>Payment</th><th>Delivery status</th></tr></thead><tbody>${orders.map(o=>`<tr><td>${esc(o.id)}</td><td>${esc(o.name)}<br>${esc(o.email)}</td><td>${o.items.map(i=>esc(i.name)+' × '+i.qty).join(', ')}</td><td>₹${o.total}</td><td>${esc(o.payment)}<br>${esc(o.paymentStatus)}</td><td><select onchange="updateOrderStatus('${o.id}',this.value)">${['Order received','Preparing','Out for delivery','Delivered','Cancellation requested','Cancelled'].map(s=>`<option ${o.status===s?'selected':''}>${s}</option>`).join('')}</select></td></tr>`).join('')}</tbody></table>`:'<div class="empty">No orders yet.</div>';
$('adminUsers').innerHTML=users.length?`<table><thead><tr><th>Name</th><th>Email</th><th>Orders</th></tr></thead><tbody>${users.map(u=>`<tr><td>${esc(u.name)}</td><td>${esc(u.email)}</td><td>${orders.filter(o=>o.email===u.email).length}</td></tr>`).join('')}</tbody></table>`:'<div class="empty">No registered users in this browser.</div>';
$('adminFeedback').innerHTML=feedback.length?`<table><thead><tr><th>Customer</th><th>Rating</th><th>Feedback</th><th>Date</th></tr></thead><tbody>${feedback.map(f=>`<tr><td>${esc(f.name)}</td><td>${'★'.repeat(f.rating)}</td><td>${esc(f.text)}</td><td>${esc(f.date)}</td></tr>`).join('')}</tbody></table>`:'<div class="empty">No feedback yet.</div>'}
function csv(name,rows){let content=rows.map(r=>r.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(',')).join('\r\n'),a=document.createElement('a');a.href=URL.createObjectURL(new Blob([content],{type:'text/csv;charset=utf-8'}));a.download=name;a.click();URL.revokeObjectURL(a.href)}
function exportOrders(){csv('sweetcrumbs-orders.csv',[['Order ID','Customer','Email','Address','Date','Items','Total','Payment','Status'],...orders.map(o=>[o.id,o.name,o.email,o.address,o.date,o.items.map(i=>i.name+' x'+i.qty).join('; '),o.total,o.payment,o.status])])}
function exportProducts(){csv('sweetcrumbs-inventory.csv',[['ID','Name','Flavour','Category','Price','Stock'],...products.map(p=>[p.id,p.name,p.flavor,p.category,p.price,p.stock])])}
function exportFeedback(){csv('sweetcrumbs-feedback.csv',[['Name','Rating','Feedback','Date'],...feedback.map(f=>[f.name,f.rating,f.text,f.date])])}
document.querySelectorAll('#starButtons button').forEach(b=>b.addEventListener('click',()=>{selectedRating=Number(b.dataset.rating);document.querySelectorAll('#starButtons button').forEach(x=>x.classList.toggle('on',Number(x.dataset.rating)<=selectedRating))}));document.querySelectorAll('#starButtons button').forEach(x=>x.classList.toggle('on',Number(x.dataset.rating)<=selectedRating));
function submitFeedback(){let name=$('feedbackName').value.trim(),text=$('feedbackText').value.trim();if(!name||!text){$('feedbackMessage').innerHTML='<div class="notice error">Please enter your name and feedback.</div>';return}feedback.unshift({name,text,rating:selectedRating,date:new Date().toLocaleDateString()});persist();$('feedbackName').value='';$('feedbackText').value='';$('feedbackMessage').innerHTML='<div class="notice">Thanks for your feedback!</div>';renderFeedback();renderAdminIfOpen()}
function renderFeedback(){$('feedbackCards').innerHTML=feedback.length?feedback.slice(0,8).map(f=>`<div class="panel" style="margin-bottom:12px"><strong>${esc(f.name)}</strong> <span style="color:#e6a82e">${'★'.repeat(f.rating)}${'☆'.repeat(5-f.rating)}</span><p>${esc(f.text)}</p><span class="muted small">${esc(f.date)}</span></div>`).join(''):'<div class="panel empty">No feedback yet.</div>'}
function renderHomeProducts(){$('homeProducts').innerHTML=products.slice(0,4).map(productCard).join('')}
renderHomeProducts();renderProducts();updateCartCount();if(currentUser)$('loginNav').textContent=currentUser.name.split(' ')[0];
</script>
</body></html>
