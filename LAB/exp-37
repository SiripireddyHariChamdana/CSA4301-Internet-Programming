<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f7f3eb">
<title>BookHaven — Stories worth keeping</title>
<style>
:root{--ink:#252d27;--muted:#70766e;--paper:#f7f3eb;--card:#fffdf9;--green:#294d3a;--lime:#d8e6bf;--line:#e6e1d7;--rust:#bb684e;--serif:Georgia,"Times New Roman",serif}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.6 Arial,sans-serif}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button,.button{border:0;border-radius:4px;padding:12px 17px;background:var(--green);color:white;cursor:pointer;font-weight:700;display:inline-block}button:hover,.button:hover{background:#193627}.button.ghost,button.ghost{color:var(--green);background:transparent;border:1px solid var(--green)}header{background:#f7f3ebeF;backdrop-filter:blur(10px);position:sticky;top:0;z-index:5;border-bottom:1px solid var(--line)}nav{max-width:1160px;margin:auto;min-height:74px;padding:12px 24px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font:700 25px var(--serif);color:var(--green);white-space:nowrap}.brand span{color:var(--rust)}.links{display:flex;align-items:center;gap:22px;flex-wrap:wrap}.links a,.cart-link{font-size:13px;font-weight:700;color:#525c52}.links a:hover{color:var(--rust)}.cart-count{background:var(--lime);padding:3px 8px;border-radius:20px;margin-left:4px}.view{display:none;min-height:70vh}.view.active{display:block}.wrap{max-width:1160px;margin:auto;padding:52px 24px}.eyebrow{text-transform:uppercase;letter-spacing:2px;color:var(--rust);font-size:11px;font-weight:bold}.hero{max-width:1160px;margin:28px auto 0;padding:72px 8%;min-height:390px;background:linear-gradient(90deg,#182e23e8,#182e2360),url('https://images.unsplash.com/photo-1507842217343-583bb7270b66?auto=format&fit=crop&w=1800&q=85') center/cover;border-radius:7px;color:#fff;display:flex;align-items:center}.hero-copy{max-width:580px}.hero h1{font:500 clamp(42px,6vw,72px)/1.02 var(--serif);margin:14px 0}.hero p{max-width:470px;color:#f2eee5;line-height:1.8}.hero .eyebrow{color:var(--lime)}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.hero .ghost{color:white;border-color:#fff}.section-title{font:500 clamp(28px,4vw,40px)/1.1 var(--serif);margin:0 0 8px}.sub{color:var(--muted);max-width:670px}.row{display:flex;align-items:end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:23px}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.book-card,.panel,.article{background:var(--card);border:1px solid var(--line);border-radius:6px;overflow:hidden}.cover{height:235px;display:grid;place-items:center;padding:25px;background:linear-gradient(140deg,#d9e2d0,#f2e4d3);color:#284333}.cover span{display:grid;place-items:center;text-align:center;width:140px;height:185px;padding:15px;background:#325441;color:white;box-shadow:8px 8px 0 #0002;font:600 19px/1.2 var(--serif)}.book-card:nth-child(3n) .cover{background:linear-gradient(140deg,#ecd5c2,#e3b18d)}.book-card:nth-child(3n) .cover span{background:#873f32}.book-card:nth-child(3n+2) .cover{background:linear-gradient(140deg,#d2d7e5,#b4c6cf)}.book-card:nth-child(3n+2) .cover span{background:#344968}.book-info{padding:15px}.book-info h3{font:600 18px var(--serif);margin:2px 0 4px}.meta{color:var(--muted);font-size:12px}.rating{color:#a57527;letter-spacing:1px;font-size:12px}.price-row{display:flex;align-items:center;justify-content:space-between;margin-top:13px}.price{font-weight:bold;color:var(--green)}.price-row button{padding:8px 10px;font-size:12px}.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0}.toolbar input,.toolbar select{min-width:170px}.field,input,select,textarea{width:100%;padding:11px 12px;border:1px solid #dcd7ce;border-radius:4px;background:white;color:var(--ink)}label{display:block;font-size:13px;font-weight:bold;margin:10px 0}.panel{padding:22px}.two{display:grid;grid-template-columns:1fr 1fr;gap:20px}.cart-line{display:grid;grid-template-columns:1fr auto auto;gap:15px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line)}.cart-line button{padding:5px 9px;margin:0 3px}.notice{padding:13px;background:#edf2e8;border-left:3px solid var(--green);color:#435244}.faq details{background:white;border-bottom:1px solid var(--line);padding:16px}.faq summary{font-weight:bold;cursor:pointer}.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.article{padding:22px}.article h3{font:600 22px var(--serif)}footer{background:#203c2e;color:#f7f3eb;padding:28px 24px}.foot{max-width:1160px;margin:auto;display:flex;justify-content:space-between;gap:20px;align-items:center;flex-wrap:wrap}.foot a{text-decoration:underline;text-underline-offset:3px}.fine{font-size:12px;color:#d4dece}.toast{position:fixed;right:20px;bottom:20px;background:#203c2e;color:#fff;padding:12px 17px;border-radius:5px;display:none;z-index:9}.empty{color:var(--muted);padding:20px 0}@media(max-width:850px){.grid{grid-template-columns:repeat(2,1fr)}.links{gap:12px}.hero{margin:15px;padding:50px 7%}}@media(max-width:560px){nav{align-items:flex-start;flex-direction:column}.links{gap:10px}.grid,.two,.blog-grid{grid-template-columns:1fr}.wrap{padding:35px 18px}.hero{min-height:350px}.cover{height:210px}.cart-line{grid-template-columns:1fr auto}}
</style>
</head>
<body>
<header><nav><a class="brand" href="#home">Book<span>Haven</span></a><div class="links"><a href="#home">Home</a><a href="#catalog">Catalog</a><a href="#about">Our story</a><a href="#blog">Journal</a><a href="#help">Help</a><a class="cart-link" href="#cart">Bag <span class="cart-count" id="cartCount">0</span></a></div></nav></header>
<main>
<section class="view" id="home"><div class="hero"><div class="hero-copy"><div class="eyebrow">A little more wonder, page by page</div><h1>Find your next favorite story.</h1><p>Thoughtful reads, handpicked for curious minds. Browse new voices, timeless classics, and books you'll want to pass along.</p><div class="actions"><a class="button" href="#catalog">Explore the shelves</a><a class="button ghost" href="#about">Meet BookHaven</a></div></div></div><div class="wrap"><div class="row"><div><div class="eyebrow">Readers are loving</div><h2 class="section-title">This week's bookshelf</h2></div><a class="button ghost" href="#catalog">Browse all books</a></div><div class="grid" id="featured"></div></div></section>
<section class="view" id="catalog"><div class="wrap"><div class="eyebrow">The BookHaven catalog</div><h1 class="section-title">Make room for a new favorite.</h1><p class="sub">Browse by genre, search a title or author, and find your next read.</p><div class="toolbar"><input id="search" placeholder="Search title or author" aria-label="Search books"><select id="genre" aria-label="Filter by genre"><option value="">All genres</option><option>Fiction</option><option>Non-fiction</option><option>Fantasy</option><option>Wellbeing</option><option>Travel</option><option>Design</option></select><select id="sort" aria-label="Sort books"><option value="featured">Featured</option><option value="low">Price: low to high</option><option value="high">Price: high to low</option><option value="title">Title A–Z</option></select></div><p id="resultCount" class="meta"></p><div class="grid" id="catalogGrid"></div></div></section>
<section class="view" id="about"><div class="wrap"><div class="eyebrow">A neighborhood bookstore, online</div><h1 class="section-title">Books open doors. We help you find the right one.</h1><div class="two" style="margin-top:24px"><div><p class="sub">BookHaven began with a simple idea: finding a book should feel like a warm recommendation from a friend. Our small team of enthusiastic readers curates a welcoming mix of fiction, non-fiction, and unexpected discoveries.</p><p class="sub">We believe in independent voices, thoughtful service, and the enduring pleasure of a well-loved paperback. Every order is packed with care, and every reader is welcome.</p><a class="button" href="#catalog">Visit the catalog</a></div><div class="panel"><div class="eyebrow">Our values</div><h2 class="section-title">Read widely. Live curiously.</h2><p>Carefully chosen titles from new and established authors.</p><p>Helpful, human recommendations for every kind of reader.</p><p>Clear order, shipping, and returns information—always.</p><div class="notice">Need a recommendation? Write to <a href="mailto:hello@bookhaven.example">hello@bookhaven.example</a>.</div></div></div></div></section>
<section class="view" id="blog"><div class="wrap"><div class="eyebrow">From the reading room</div><h1 class="section-title">Notes for book lovers.</h1><p class="sub">Recommendations, reviews, and conversations with the people behind the pages.</p><div class="blog-grid"><article class="article"><div class="eyebrow">Reading list · 6 min</div><h3>Five books to take on a long weekend</h3><p class="sub">A little suspense, a little sunshine, and a story you'll keep thinking about.</p><a href="#catalog">Find your weekend read →</a></article><article class="article"><div class="eyebrow">Staff picks · 4 min</div><h3>Small books with very big ideas</h3><p class="sub">These slim volumes leave plenty to reflect on long after the last page.</p><a href="#catalog">See our picks →</a></article><article class="article"><div class="eyebrow">Author notes · 8 min</div><h3>How a first chapter finds its voice</h3><p class="sub">A look behind the scenes at the craft of building a memorable opening.</p><a href="#about">Meet the BookHaven team →</a></article></div></div></section>
<section class="view" id="cart"><div class="wrap"><div class="eyebrow">Your BookHaven bag</div><h1 class="section-title">A good story is on its way.</h1><div class="two"><div class="panel"><div id="cartItems"></div><p id="cartTotal" class="price"></p><a class="button" id="checkoutButton" href="#checkout">Continue to checkout</a> <a class="button ghost" href="#catalog">Keep browsing</a></div><div class="panel"><h2 class="section-title">Delivery, made simple.</h2><p class="sub">Standard delivery is complimentary on orders over $35. Orders are usually prepared within two business days.</p><p class="sub">Need to change or cancel an order? Contact our team within one hour of checkout.</p></div></div></div></section>
<section class="view" id="checkout"><div class="wrap"><div class="eyebrow">A few details and you're done</div><h1 class="section-title">Checkout</h1><div class="two"><form id="checkoutForm" class="panel"><label>Full name<input name="name" autocomplete="name" required></label><label>Email address<input name="email" type="email" autocomplete="email" required></label><label>Shipping address<input name="address" autocomplete="street-address" required></label><div class="two"><label>City<input name="city" autocomplete="address-level2" required></label><label>Postal code<input name="zip" autocomplete="postal-code" required></label></div><label>Payment method<select required><option>Credit or debit card (demo)</option><option>Digital wallet (demo)</option><option>Pay on delivery (demo)</option></select></label><button>Place demo order</button><p class="meta">This is a demonstration checkout. No payment is collected.</p></form><div class="panel"><h2 class="section-title">Order summary</h2><div id="checkoutSummary"></div><p id="checkoutTotal" class="price"></p></div></div><div id="orderMessage" class="notice" hidden></div></div></section>
<section class="view" id="help"><div class="wrap"><div class="eyebrow">We're here to help</div><h1 class="section-title">Good questions deserve clear answers.</h1><div class="two"><div class="faq"><details open><summary>How long does shipping take?</summary><p class="sub">Standard orders usually arrive within 3–6 business days after dispatch.</p></details><details><summary>Can I return a book?</summary><p class="sub">Unused books may be returned in their original condition within 30 days. Contact us to start a return.</p></details><details><summary>How do I manage my order?</summary><p class="sub">Use the confirmation details from checkout and email our support team for help.</p></details><details><summary>What information do you collect?</summary><p class="sub">This local demo stores only your shopping bag in your browser. The checkout does not submit personal or payment details to a server.</p></details></div><form id="contactForm" class="panel"><h2 class="section-title">Contact us</h2><label>Your name<input name="name" required></label><label>Email<input name="email" type="email" required></label><label>How can we help?<textarea name="message" rows="4" required></textarea></label><button>Send a message</button><p id="contactMsg" class="meta"></p><p class="meta">hello@bookhaven.example · (555) 010-2040 · 18 Cedar Lane</p></form></div><div class="panel" style="margin-top:22px"><h2 class="section-title">Privacy, in plain language</h2><p class="sub">This standalone demonstration does not connect to a backend or send your information to a server. Your bag is saved locally in this browser so it remains available on this device. Clearing browser storage removes it. No payment is processed.</p></div></div></section>
<section class="view" id="success"><div class="wrap"><div class="panel"><div class="eyebrow">Order received</div><h1 class="section-title">Thank you for shopping BookHaven.</h1><p id="successText" class="sub"></p><a class="button" href="#catalog">Find another book</a></div></div></section>
</main>
<footer><div class="foot"><div><a class="brand" style="color:white" href="#home">BookHaven</a><div class="fine">Stories worth keeping.</div></div><div><a href="#about">About</a> · <a href="#help">FAQ & contact</a> · <a href="#catalog">Shop books</a></div><div class="fine">BookHaven demonstration · <a href="../Exp-37/Portfolio.html">Next: professional portfolio →</a></div></div></footer><div class="toast" id="toast" role="status"></div>
<script>
const books=[{id:1,title:"The Quiet Atlas",author:"Mara Ellison",genre:"Travel",price:18.5,rating:"★★★★★",desc:"A beautifully observed journey through the places that stay with us."},{id:2,title:"A Garden of Small Things",author:"Noah Bennett",genre:"Fiction",price:16, rating:"★★★★☆",desc:"A tender novel about family, belonging, and tending what matters."},{id:3,title:"Designing for Humans",author:"Priya Shah",genre:"Design",price:24,rating:"★★★★★",desc:"A practical, thoughtful guide to making everyday experiences better."},{id:4,title:"The Open Sky",author:"E. R. Vale",genre:"Fantasy",price:21,rating:"★★★★☆",desc:"An unlikely map, a distant kingdom, and a very brave cartographer."},{id:5,title:"Good Days, Gently",author:"Sam Rivera",genre:"Wellbeing",price:15,rating:"★★★★★",desc:"Small, science-backed habits for a calmer and more present life."},{id:6,title:"Curious Minds",author:"Lena Okafor",genre:"Non-fiction",price:22,rating:"★★★★☆",desc:"Remarkable ideas and the people who dared to follow them."}];
const $=s=>document.querySelector(s), money=n=>new Intl.NumberFormat("en-US",{style:"currency",currency:"USD"}).format(n);
let bag=JSON.parse(localStorage.getItem("bookhaven-bag")||"[]");
function save(){localStorage.setItem("bookhaven-bag",JSON.stringify(bag));$("#cartCount").textContent=bag.reduce((n,x)=>n+x.qty,0);drawBag()}
function card(b){return `<article class="book-card"><div class="cover" aria-label="Decorative book cover"><span>${b.title}</span></div><div class="book-info"><div class="meta">${b.genre} · ${b.rating}</div><h3>${b.title}</h3><div class="meta">by ${b.author}</div><p class="meta">${b.desc}</p><div class="price-row"><span class="price">${money(b.price)}</span><button data-add="${b.id}">Add to bag</button></div></div></article>`}
function drawCatalog(){let list=[...books],q=$("#search").value.trim().toLowerCase(),g=$("#genre").value,sort=$("#sort").value;list=list.filter(b=>(!q||`${b.title} ${b.author} ${b.genre}`.toLowerCase().includes(q))&&(!g||b.genre===g));if(sort==="low")list.sort((a,b)=>a.price-b.price);if(sort==="high")list.sort((a,b)=>b.price-a.price);if(sort==="title")list.sort((a,b)=>a.title.localeCompare(b.title));$("#resultCount").textContent=`${list.length} book${list.length===1?"":"s"} to explore`;$("#catalogGrid").innerHTML=list.length?list.map(card).join(""):'<p class="empty">No books found. Try another search or genre.</p>'}
function drawBag(){const lines=bag.map(i=>{const b=books.find(x=>x.id===i.id);return `<div class="cart-line"><div><b>${b.title}</b><div class="meta">${money(b.price)} each</div></div><div><button class="ghost" data-qty="${b.id}" data-change="-1" aria-label="Remove one">−</button>${i.qty}<button class="ghost" data-qty="${b.id}" data-change="1" aria-label="Add one">+</button></div><b>${money(b.price*i.qty)}</b></div>`});$("#cartItems").innerHTML=lines.join("")||'<p class="empty">Your bag is waiting for a story. <a href="#catalog">Browse the catalog →</a></p>';const total=bag.reduce((n,i)=>n+books.find(b=>b.id===i.id).price*i.qty,0);$("#cartTotal").textContent=`Total: ${money(total)}`;$("#checkoutButton").hidden=!bag.length;$("#checkoutSummary").innerHTML=lines.join("")||'<p class="empty">Your bag is empty.</p>';$("#checkoutTotal").textContent=`Total: ${money(total)}`}
function route(){const id=location.hash.slice(1)||"home";document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===id));if(!document.getElementById(id)){location.hash="#home";return}if(id==="cart"||id==="checkout")drawBag();window.scrollTo(0,0)}
function toast(msg){const t=$("#toast");t.textContent=msg;t.style.display="block";clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>t.style.display="none",2200)}
document.addEventListener("click",e=>{const a=e.target.closest("[data-add]");if(a){const id=Number(a.dataset.add),line=bag.find(x=>x.id===id);line?line.qty++:bag.push({id,qty:1});save();toast("Added to your bag.");return}const q=e.target.closest("[data-qty]");if(q){const line=bag.find(x=>x.id===Number(q.dataset.qty));line.qty+=Number(q.dataset.change);if(line.qty<=0)bag=bag.filter(x=>x!==line);save()}});
["search","genre","sort"].forEach(id=>$("#"+id).addEventListener("input",drawCatalog));
$("#checkoutForm").addEventListener("submit",e=>{e.preventDefault();if(!bag.length){toast("Add a book to your bag before checking out.");location.hash="#catalog";return}const name=new FormData(e.target).get("name");$("#successText").textContent=`Your demo order has been prepared, ${name}. No payment was taken. Thanks for supporting thoughtful reading.`;bag=[];save();e.target.reset();location.hash="#success"});
$("#contactForm").addEventListener("submit",e=>{e.preventDefault();$("#contactMsg").textContent="Thanks for getting in touch. This demo message stays on this page and is not sent to a server.";e.target.reset()});
$("#featured").innerHTML=books.slice(0,4).map(card).join("");drawCatalog();save();window.addEventListener("hashchange",route);route();
</script>
</body>
</html>
