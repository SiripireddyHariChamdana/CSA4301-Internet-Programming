<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>ArtReview Gallery</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f6f7fb;color:#20283a}
header{background:#20243a;color:#fff;padding:16px 5%;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.logo{font-size:23px;font-weight:800}.logo span{color:#f5bd65}nav{display:flex;gap:7px;flex-wrap:wrap}nav button{background:transparent;color:#fff;border:1px solid #596078;border-radius:7px;padding:9px 12px;cursor:pointer}nav button:hover{background:#7c4dff}
main{max-width:1100px;margin:28px auto;padding:0 17px}.page{display:none}.page.active{display:block}
.hero{padding:38px;border-radius:16px;color:#fff;background:linear-gradient(120deg,#292c48,#7651c9);margin-bottom:20px}.hero h1{font-size:32px;margin:0 0 12px}.hero p{line-height:1.6;color:#eee8ff;max-width:720px}
.card{background:#fff;border:1px solid #e4e7ef;border-radius:13px;padding:22px;margin-bottom:18px;box-shadow:0 5px 18px #2222}
h2{margin:0 0 16px;color:#292c48}h3{margin:0 0 10px}.muted{color:#687187;font-size:14px;line-height:1.5}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.field{margin-bottom:14px}label{display:block;font-weight:600;font-size:14px;margin-bottom:7px}
input,select,textarea{width:100%;padding:11px;border:1px solid #cbd0dc;border-radius:7px;font:inherit;background:#fff}textarea{min-height:95px;resize:vertical}
.btn{background:#7651c9;color:white;border:0;border-radius:7px;padding:11px 16px;font-weight:700;cursor:pointer}.btn.alt{background:#e9e5f5;color:#39266b}.btn.dark{background:#303650}.btn:hover{filter:brightness(.95)}
.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:12px}.notice{padding:12px;background:#fff8e8;border:1px solid #f4d89b;border-radius:8px;color:#75531a;font-size:13px;line-height:1.5}
.painting{display:grid;grid-template-columns:240px 1fr;gap:20px;align-items:start}.painting img{width:100%;height:230px;object-fit:cover;border-radius:10px;background:#eee}.stars{color:#e5a000;font-size:20px;letter-spacing:2px}.pill{display:inline-block;background:#eee9fa;color:#553b9a;padding:5px 9px;border-radius:20px;font-size:12px;font-weight:700}
.review{border-top:1px solid #eceef3;padding:13px 0}.review:first-child{border-top:0}.review strong{color:#303650}.review small{color:#7a8192}.review p{margin:7px 0}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:15px 0}.stat{background:#f0edfa;border-radius:9px;padding:14px}.stat b{display:block;font-size:22px;color:#6543ad;margin-top:5px}
table{width:100%;border-collapse:collapse;margin-top:12px}td,th{text-align:left;padding:10px;border-bottom:1px solid #e7e9ef;font-size:14px}th{background:#f8f7fb}
.hidden{display:none!important}footer{text-align:center;color:#81889a;padding:25px;font-size:13px}
@media(max-width:650px){.grid,.stats{grid-template-columns:1fr}.painting{grid-template-columns:1fr}.hero{padding:25px}.hero h1{font-size:26px}}
</style></head>
<body>
<header><div class="logo">Art<span>Review</span> Gallery</div><nav>
<button onclick="go('home',this)">Home</button><button onclick="go('customerLogin',this)">Customer</button><button onclick="go('ownerLogin',this)">Painting Owner</button><button onclick="go('ownerRegister',this)">Owner Register</button><button onclick="go('adminLogin',this)">Admin</button>
</nav></header>
<main>
<section id="home" class="page active">
<div class="hero"><h1>Discover art. Share your perspective.</h1><p>Explore the featured painting, rate it from one to five stars, and share your feedback. Painting owners can submit artwork for scheduled gallery displays.</p><button class="btn" onclick="go('customerLogin')">View & Review Painting</button></div>
<div id="homePainting" class="card"></div>
<div class="card"><h2>How the gallery works</h2><div class="grid"><div><h3>For customers</h3><p class="muted">Sign in, view the current painting, submit a star rating and written review.</p></div><div><h3>For painting owners</h3><p class="muted">Register artwork, select a display package, record payment and track customer feedback.</p></div></div></div>

</section>

<section id="customerLogin" class="page"><div class="card" style="max-width:550px;margin:auto"><h2>Customer Login</h2><p class="muted">Demo authentication: enter any name and email. Social login buttons are illustrative only and do not connect to external providers.</p>
<form onsubmit="customerLogin(event)"><div class="field"><label>Your name</label><input id="customerName" required></div><div class="field"><label>Email address</label><input id="customerEmail" type="email" required></div><button class="btn">Continue</button></form>
<div class="actions"><button class="btn alt" onclick="socialDemo('Google')">Continue with Google (Demo)</button><button class="btn alt" onclick="socialDemo('Facebook')">Continue with Facebook (Demo)</button></div></div></section>

<section id="customer" class="page"><div id="customerPainting" class="card"></div><div class="card"><h2>Submit Your Review</h2><form onsubmit="submitReview(event)"><div class="field"><label>Your rating</label><select id="rating" required><option value="">Choose stars</option><option value="5">5 - Excellent</option><option value="4">4 - Very Good</option><option value="3">3 - Good</option><option value="2">2 - Fair</option><option value="1">1 - Poor</option></select></div><div class="field"><label>Your feedback</label><textarea id="reviewText" required placeholder="Write what you liked or disliked about this painting..."></textarea></div><button class="btn">Submit Review</button></form><p id="reviewMessage" class="muted"></p></div><div class="card"><h2>Customer Feedback</h2><div id="customerReviews"></div></div></section>

<section id="ownerRegister" class="page"><div class="card"><h2>Painting Owner Registration</h2><p class="muted">Submit your details, painting information, display package and demo payment information.</p>
<form onsubmit="registerOwner(event)"><div class="grid"><div class="field"><label>Owner name</label><input id="ownerName" required></div><div class="field"><label>Email</label><input id="ownerEmail" type="email" required></div><div class="field"><label>Create password</label><input id="ownerPassword" type="password" required></div><div class="field"><label>Painting title</label><input id="paintingTitle" required></div><div class="field"><label>Artist name</label><input id="artistName" required></div><div class="field"><label>Painting image URL (optional)</label><input id="paintingImage" type="url" placeholder="https://..."></div><div class="field"><label>Display package</label><select id="package" onchange="updatePrice()" required><option value="">Select duration</option><option value="3">3 days – ₹300</option><option value="7">7 days – ₹600</option><option value="15">15 days – ₹1,000</option><option value="30">30 days – ₹1,800</option></select></div><div class="field"><label>Payment mode</label><select id="paymentMode" required><option value="">Select payment mode</option><option>UPI</option><option>Credit / Debit Card</option><option>Net Banking</option><option>Wallet</option></select></div></div><p id="packagePrice" class="muted">Choose a package to see its amount.</p><button class="btn">Register, Submit Painting & Record Payment</button></form></div></section>

<section id="ownerLogin" class="page"><div class="card" style="max-width:550px;margin:auto"><h2>Painting Owner Login</h2><form onsubmit="ownerLogin(event)"><div class="field"><label>Email</label><input id="ownerLoginEmail" type="email" required></div><div class="field"><label>Password</label><input id="ownerLoginPassword" type="password" required></div><button class="btn">Login</button></form><p class="muted">Register first if you do not have an owner demo account.</p></div></section>

<section id="owner" class="page"><div class="card"><h2>Owner Dashboard</h2><p id="ownerWelcome" class="muted"></p><div id="ownerPainting"></div><h3 style="margin-top:22px">Reviews for your painting</h3><div id="ownerReviews"></div></div></section>

<section id="adminLogin" class="page"><div class="card" style="max-width:550px;margin:auto"><h2>Admin Login</h2><p class="muted">Demo credentials: <b>admin</b> / <b>admin123</b></p><form onsubmit="adminLogin(event)"><div class="field"><label>Username</label><input id="adminUser" required></div><div class="field"><label>Password</label><input id="adminPass" type="password" required></div><button class="btn">Login as Admin</button></form></div></section>

<section id="admin" class="page"><div class="card"><h2>Admin Dashboard</h2><div class="stats"><div class="stat">Total reviews<b id="totalReviews">0</b></div><div class="stat">Positive reviews (4–5)<b id="positiveCount">0</b></div><div class="stat">Negative reviews (1–2)<b id="negativeCount">0</b></div></div>
<h3>Current painting feedback</h3><div id="adminSummary"></div><h3 style="margin-top:22px">All customer reviews</h3><div id="adminReviews"></div></div>
<div class="card"><h2>Schedule / Upload New Painting</h2><div class="notice">Before activating a new painting, review the previous painting's positive and negative feedback above. The current painting will be archived when you activate the next one.</div>
<form onsubmit="schedulePainting(event)" style="margin-top:15px"><div class="grid"><div class="field"><label>Painting title</label><input id="newTitle" required></div><div class="field"><label>Artist name</label><input id="newArtist" required></div><div class="field"><label>Image URL (optional)</label><input id="newImage" type="url"></div><div class="field"><label>Start date</label><input id="startDate" type="date" required></div><div class="field"><label>End date</label><input id="endDate" type="date" required></div></div><button class="btn">Schedule New Painting</button></form><p id="adminMessage" class="muted"></p></div>
<div class="card"><h2>Owner Applications & Payments</h2><div id="ownerApplications"></div></div>
</section>
</main><footer>ArtReview Gallery | Internet Programming Lab Experiment</footer>
<script>
const samplePainting={title:"Colours of Serenity",artist:"Gallery Featured Artist",image:"",start:"",end:""};
let data=loadData(),currentCustomer=null,currentOwner=null;
function loadData(){try{return JSON.parse(localStorage.getItem('artReviewData'))||{painting:{...samplePainting},reviews:[],archive:[],owners:[]}}catch(e){return {painting:{...samplePainting},reviews:[],archive:[],owners:[]}}}
function save(){localStorage.setItem('artReviewData',JSON.stringify(data))}
function go(id,btn){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');window.scrollTo(0,0);if(id==='home')renderHome();if(id==='customer')renderCustomer();if(id==='admin')renderAdmin();if(id==='owner')renderOwner()}
function escapeHtml(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function stars(n){return '★'.repeat(n)+'☆'.repeat(5-n)}
function average(reviews){return reviews.length?(reviews.reduce((a,r)=>a+Number(r.rating),0)/reviews.length).toFixed(1):'No ratings'}
function paintingCard(p,reviews){let avg=average(reviews);return `<div class="painting"><div>${p.image?`<img src="${escapeHtml(p.image)}" alt="Painting" onerror="this.style.display='none'">`:'<div style="height:230px;border-radius:10px;background:linear-gradient(135deg,#f4d6b4,#9c83c8);display:grid;place-items:center;color:#fff;font-size:50px">🎨</div>'}</div><div><span class="pill">Currently on display</span><h2 style="margin-top:12px">${escapeHtml(p.title)}</h2><p class="muted">Artist: ${escapeHtml(p.artist)}</p><div class="stars">${typeof avg==='string'?'☆☆☆☆☆':stars(Math.round(Number(avg)))}</div><p><b>${avg}</b> average rating · ${reviews.length} reviews</p>${p.start?`<p class="muted">Display: ${escapeHtml(p.start)} to ${escapeHtml(p.end)}</p>`:''}</div></div>`}
function renderHome(){document.getElementById('homePainting').innerHTML=paintingCard(data.painting,data.reviews)}
function customerLogin(e){e.preventDefault();currentCustomer={name:document.getElementById('customerName').value,email:document.getElementById('customerEmail').value};go('customer')}
function socialDemo(provider){alert(provider+' authentication is a demo only. Please use the email form to continue.')}
function renderCustomer(){document.getElementById('customerPainting').innerHTML=paintingCard(data.painting,data.reviews);document.getElementById('customerReviews').innerHTML=reviewList(data.reviews)}
function reviewList(reviews){if(!reviews.length)return '<p class="muted">No reviews submitted yet. Be the first to review!</p>';return reviews.slice().reverse().map(r=>`<div class="review"><strong>${escapeHtml(r.name)}</strong> <span class="stars">${stars(Number(r.rating))}</span><small> · ${escapeHtml(r.date)}</small><p>${escapeHtml(r.text)}</p>${r.reply?`<p class="muted"><b>Admin response:</b> ${escapeHtml(r.reply)}</p>`:''}</div>`).join('')}
function submitReview(e){e.preventDefault();if(!currentCustomer){alert('Please log in first.');go('customerLogin');return}data.reviews.push({name:currentCustomer.name,email:currentCustomer.email,rating:Number(document.getElementById('rating').value),text:document.getElementById('reviewText').value,date:new Date().toLocaleDateString('en-IN'),reply:''});save();document.getElementById('reviewMessage').textContent='Thank you! Your review has been submitted.';document.getElementById('rating').value='';document.getElementById('reviewText').value='';renderCustomer()}
function updatePrice(){let days=Number(document.getElementById('package').value),prices={3:300,7:600,15:1000,30:1800};document.getElementById('packagePrice').textContent=days?`${days}-day display package: ₹${prices[days]}. Payment is recorded as a demo only.`:'Choose a package to see its amount.'}
function registerOwner(e){e.preventDefault();let days=Number(document.getElementById('package').value),prices={3:300,7:600,15:1000,30:1800};let owner={name:document.getElementById('ownerName').value,email:document.getElementById('ownerEmail').value,password:document.getElementById('ownerPassword').value,title:document.getElementById('paintingTitle').value,artist:document.getElementById('artistName').value,image:document.getElementById('paintingImage').value,days,amount:prices[days],mode:document.getElementById('paymentMode').value,status:'Pending admin approval'};if(data.owners.some(o=>o.email===owner.email)){alert('An owner with this email is already registered.');return}data.owners.push(owner);save();alert(`Registration saved. Demo payment of ₹${owner.amount} by ${owner.mode} recorded. Your painting is pending admin approval.`);currentOwner=owner;go('owner')}
function ownerLogin(e){e.preventDefault();let email=document.getElementById('ownerLoginEmail').value,pw=document.getElementById('ownerLoginPassword').value;currentOwner=data.owners.find(o=>o.email===email&&o.password===pw);if(!currentOwner){alert('Owner account not found. Register first or check your details.');return}go('owner')}
function renderOwner(){if(!currentOwner){go('ownerLogin');return}document.getElementById('ownerWelcome').textContent=`Welcome, ${currentOwner.name}. Application status: ${currentOwner.status}.`;document.getElementById('ownerPainting').innerHTML=`<h3>${escapeHtml(currentOwner.title)}</h3><p class="muted">Package: ${currentOwner.days} days · Amount: ₹${currentOwner.amount} · Payment mode: ${escapeHtml(currentOwner.mode)}</p><p class="muted">The owner dashboard shows feedback when this painting is selected as the current gallery display.</p>`;let matches=data.painting.title===currentOwner.title?data.reviews:[];document.getElementById('ownerReviews').innerHTML=reviewList(matches)}
function adminLogin(e){e.preventDefault();if(document.getElementById('adminUser').value==='admin'&&document.getElementById('adminPass').value==='admin123')go('admin');else alert('Incorrect admin credentials.')}
function renderAdmin(){let rs=data.reviews,pos=rs.filter(r=>r.rating>=4),neg=rs.filter(r=>r.rating<=2);document.getElementById('totalReviews').textContent=rs.length;document.getElementById('positiveCount').textContent=pos.length;document.getElementById('negativeCount').textContent=neg.length;document.getElementById('adminSummary').innerHTML=`<p><b>Painting:</b> ${escapeHtml(data.painting.title)} · <b>Average rating:</b> ${average(rs)}</p><div class="grid"><div><h3>Positive feedback</h3>${pos.length?pos.map(r=>`<p class="muted">• ${escapeHtml(r.text)}</p>`).join(''):'<p class="muted">No positive reviews yet.</p>'}</div><div><h3>Negative feedback</h3>${neg.length?neg.map(r=>`<p class="muted">• ${escapeHtml(r.text)}</p>`).join(''):'<p class="muted">No negative reviews yet.</p>'}</div></div>`;document.getElementById('adminReviews').innerHTML=rs.length?rs.map((r,i)=>`<div class="review"><b>${escapeHtml(r.name)}</b> · <span class="stars">${stars(Number(r.rating))}</span><p>${escapeHtml(r.text)}</p><div class="field"><label>Admin response</label><input id="reply${i}" value="${escapeHtml(r.reply||'')}" placeholder="Write a response"></div><button class="btn alt" onclick="replyReview(${i})">Save Response</button></div>`).join(''):'<p class="muted">No reviews yet.</p>';document.getElementById('ownerApplications').innerHTML=data.owners.length?`<table><tr><th>Owner</th><th>Painting</th><th>Package</th><th>Payment</th><th>Status</th><th>Action</th></tr>${data.owners.map((o,i)=>`<tr><td>${escapeHtml(o.name)}</td><td>${escapeHtml(o.title)}</td><td>${o.days} days</td><td>₹${o.amount} (${escapeHtml(o.mode)})</td><td>${escapeHtml(o.status)}</td><td><button class="btn alt" onclick="approveOwner(${i})">Approve</button></td></tr>`).join('')}</table>`:'<p class="muted">No owner applications yet.</p>'}
function replyReview(i){data.reviews[i].reply=document.getElementById('reply'+i).value;save();renderAdmin();alert('Admin response saved.')}
function approveOwner(i){data.owners[i].status='Approved';save();renderAdmin()}
function schedulePainting(e){e.preventDefault();let start=document.getElementById('startDate').value,end=document.getElementById('endDate').value;if(end<start){alert('End date must be on or after start date.');return}let old={painting:data.painting,reviews:data.reviews,archivedOn:new Date().toLocaleDateString('en-IN')};data.archive.push(old);data.painting={title:document.getElementById('newTitle').value,artist:document.getElementById('newArtist').value,image:document.getElementById('newImage').value,start,end};data.reviews=[];save();document.getElementById('adminMessage').textContent=`Previous painting "${old.painting.title}" and its ${old.reviews.length} reviews have been archived. New painting is now active.`;renderAdmin();renderHome()}
renderHome();
</script></body></html>
