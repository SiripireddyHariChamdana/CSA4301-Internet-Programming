<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>VoteOnline | E-Voting Portal</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f4f6fb;color:#26334a}header{background:#243d70;color:white;padding:17px 5%;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}h1{margin:0;font-size:25px}nav{display:flex;gap:5px;flex-wrap:wrap}button{border:0;border-radius:8px;padding:10px 14px;cursor:pointer;font-weight:bold;background:#e8eef9;color:#263f75}nav button{background:transparent;color:white}nav button.active,nav button:hover{background:#49649a}.page{display:none;max-width:1050px;margin:28px auto;padding:0 18px}.page.active{display:block}.hero{padding:42px 30px;border-radius:16px;background:linear-gradient(120deg,#243d70,#5679b5);color:white}.hero h2{font-size:34px;margin:0 0 10px}.card{background:white;padding:22px;border-radius:14px;margin:16px 0;box-shadow:0 5px 18px #25395b10}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:15px}.field{margin:12px 0}.field label{display:block;font-weight:bold;margin-bottom:6px}input,select,textarea{width:100%;padding:11px;border:1px solid #cbd5e2;border-radius:8px;font:inherit}.primary{background:#315b9c;color:white}.muted{color:#748096}.tag{display:inline-block;padding:5px 9px;border-radius:16px;background:#e8effb;color:#315b86;font-size:12px}.candidate{border:1px solid #dce4f0;padding:16px;border-radius:12px}.candidate h3{margin:6px 0}.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}.stat{background:#edf2fa;padding:16px;border-radius:10px}.stat b{display:block;font-size:23px;color:#315b9c;margin-top:8px}table{width:100%;border-collapse:collapse;margin-top:12px}td,th{text-align:left;padding:11px;border-bottom:1px solid #e5eaf1}th{background:#edf2fa}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}footer{text-align:center;padding:25px;color:#7a879b}.notice{background:#fff5df;padding:12px;border-radius:8px;color:#76551d;font-size:13px}@media(max-width:600px){header{padding:15px}nav{width:100%}.hero h2{font-size:27px}}
</style></head><body>
<header><h1>🗳️ VoteOnline</h1><nav><button class="active" onclick="show('home',this)">Home</button><button onclick="show('register',this)">Voter Registration</button><button onclick="show('vote',this)">Cast Vote</button><button onclick="show('status',this)">Election Status</button><button onclick="show('admin',this)">Admin</button></nav></header>
<main>
<section id="home" class="page active"><div class="hero"><h2>Your Vote. Your Voice.</h2><p>A simple electronic voting portal demonstration for voter registration, candidate selection and election result viewing.</p><button class="primary" onclick="show('register')">Register to Vote →</button></div><div class="card"><h2>Voting Process</h2><div class="grid"><div><h3>1. Register</h3><p class="muted">Enter your voter details and receive a voter ID.</p></div><div><h3>2. Cast Vote</h3><p class="muted">Verify your voter ID and select one candidate.</p></div><div><h3>3. View Results</h3><p class="muted">Check election status and published results.</p></div></div><p class="notice">This is an educational demo. It is not connected to an official election authority and must not be used for real elections.</p></div></section>
<section id="register" class="page"><div class="card"><h2>Voter Registration</h2><form onsubmit="registerVoter(event)"><div class="grid"><div class="field"><label>Full name</label><input id="vName" required></div><div class="field"><label>Email</label><input id="vEmail" type="email" required></div><div class="field"><label>Mobile number</label><input id="vMobile" pattern="[0-9]{10}" maxlength="10" required></div><div class="field"><label>Voter / Student ID</label><input id="identity" required></div></div><button class="primary">Register Voter</button></form><p id="regMsg"></p></div></section>
<section id="vote" class="page"><div class="card"><h2>Cast Your Vote</h2><form onsubmit="castVote(event)"><div class="field"><label>Voter ID</label><input id="voteId" required placeholder="Enter your registered voter ID"></div><h3>Select one candidate</h3><div id="candidates" class="grid"></div><div class="field"><label><input type="checkbox" id="confirm" required style="width:auto"> I confirm that my selection is final.</label></div><button class="primary">Submit Vote</button></form><p id="voteMsg"></p></div></section>
<section id="thanks" class="page"><div class="card"><h2>Vote Submitted</h2><p>Your vote has been recorded in this demo.</p><span class="tag">Submission successful</span><p id="thanksMsg"></p><button class="primary" onclick="show('home')">Return Home</button></div></section>
<section id="status" class="page"><div class="card"><h2>Election Status & Results</h2><p id="electionStatus" class="tag">Election is open</p><div id="results"></div><p class="muted">Results are visible only after the administrator publishes them.</p></div></section>
<section id="admin" class="page"><div class="card"><h2>Election Admin Login</h2><p class="muted">Demo credentials: admin / admin123</p><form onsubmit="adminLogin(event)"><div class="field"><label>Username</label><input id="adminUser" required></div><div class="field"><label>Password</label><input id="adminPass" type="password" required></div><button class="primary">Login</button></form><p id="adminMsg"></p></div><div id="adminPanel" class="card" style="display:none"><h2>Election Administration</h2><div class="stats"><div class="stat">Registered voters<b id="voterCount">0</b></div><div class="stat">Votes cast<b id="voteCount">0</b></div></div><h3>Manage Candidates</h3><form onsubmit="addCandidate(event)"><div class="grid"><div class="field"><label>Candidate name</label><input id="candidateName" required></div><div class="field"><label>Party / Group</label><input id="candidateParty" required></div></div><button class="primary">Add Candidate</button></form><div id="candidateAdmin"></div><h3>Registered Voters</h3><div id="voterAdmin"></div><div class="actions"><button onclick="toggleElection()">Open / Close Election</button><button onclick="publishResults()">Publish Results</button></div><p id="adminAction"></p></div></section>
</main><footer>VoteOnline | Electronic Voting Portal | Internet Programming Lab Demo</footer>
<script>
let voters=JSON.parse(localStorage.getItem('voVoters')||'[]'),votes=JSON.parse(localStorage.getItem('voVotes')||'[]'),candidates=JSON.parse(localStorage.getItem('voCandidates')||'null')||[{id:1,name:'Candidate A',party:'People First'},{id:2,name:'Candidate B',party:'Progress Group'},{id:3,name:'Candidate C',party:'Unity Team'}],admin=false,electionOpen=true,published=false;
function persist(){localStorage.setItem('voVoters',JSON.stringify(voters));localStorage.setItem('voVotes',JSON.stringify(votes));localStorage.setItem('voCandidates',JSON.stringify(candidates));localStorage.setItem('voOpen',String(electionOpen));localStorage.setItem('voPublished',String(published))}
electionOpen=localStorage.getItem('voOpen')!=='false';published=localStorage.getItem('voPublished')==='true';
function show(id,btn){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');if(id==='vote')renderCandidates();if(id==='status')renderResults();if(id==='admin'&&admin)renderAdmin();window.scrollTo(0,0)}
function registerVoter(e){e.preventDefault();if(voters.some(v=>v.id.toLowerCase()===identity.value.trim().toLowerCase())){regMsg.textContent='This voter ID is already registered.';return}let v={name:vName.value,email:vEmail.value,mobile:vMobile.value,id:identity.value.trim()};voters.push(v);persist();regMsg.textContent='Registration successful. Your voter ID is '+v.id;e.target.reset()}
function renderCandidates(){candidatesDiv=document.getElementById('candidates');candidatesDiv.innerHTML=candidates.map(c=>`<label class="candidate"><input type="radio" name="candidate" value="${c.id}" required style="width:auto"><h3>${c.name}</h3><span class="tag">${c.party}</span></label>`).join('');if(!electionOpen)candidatesDiv.innerHTML='<p>The election is currently closed.</p>'}
function castVote(e){e.preventDefault();if(!electionOpen){voteMsg.textContent='Voting is closed.';return}let id=voteId.value.trim().toLowerCase(),v=voters.find(x=>x.id.toLowerCase()===id);if(!v){voteMsg.textContent='Voter ID not found. Please register first.';return}if(votes.some(x=>x.voterId.toLowerCase()===id)){voteMsg.textContent='A vote has already been submitted using this voter ID.';return}let selected=document.querySelector('input[name="candidate"]:checked');if(!selected){voteMsg.textContent='Please select a candidate.';return}let c=candidates.find(x=>x.id===Number(selected.value));votes.push({voterId:v.id,candidateId:c.id});persist();thanksMsg.textContent='Thank you, '+v.name+'. Your vote for '+c.name+' has been recorded.';e.target.reset();show('thanks')}
function renderResults(){electionStatus.textContent=electionOpen?'Election is open':'Election is closed';if(!published){results.innerHTML='<p>Election results have not been published yet.</p>';return}let total=votes.length;results.innerHTML='<h3>Published Results</h3>'+candidates.map(c=>{let n=votes.filter(v=>v.candidateId===c.id).length;return `<p><b>${c.name}</b> (${c.party}) — ${n} vote(s) ${total?'('+Math.round(n/total*100)+'%)':''}</p><div style="background:#e7edf6;border-radius:8px;height:10px;overflow:hidden"><div style="height:10px;background:#426aa7;width:${total?n/total*100:0}%"></div></div>`}).join('')+`<p><b>Total votes:</b> ${total}</p>`}
function adminLogin(e){e.preventDefault();if(adminUser.value==='admin'&&adminPass.value==='admin123'){admin=true;adminMsg.textContent='Admin login successful.';adminPanel.style.display='block';renderAdmin()}else adminMsg.textContent='Invalid username or password.'}
function addCandidate(e){e.preventDefault();candidates.push({id:Date.now(),name:candidateName.value,party:candidateParty.value});published=false;persist();e.target.reset();renderAdmin()}
function renderAdmin(){voterCount.textContent=voters.length;voteCount.textContent=votes.length;candidateAdmin.innerHTML='<table><tr><th>Candidate</th><th>Party</th><th>Action</th></tr>'+candidates.map(c=>`<tr><td>${c.name}</td><td>${c.party}</td><td><button onclick="removeCandidate(${c.id})">Remove</button></td></tr>`).join('')+'</table>';voterAdmin.innerHTML=voters.length?'<table><tr><th>Name</th><th>Voter ID</th><th>Email</th><th>Vote Status</th></tr>'+voters.map(v=>`<tr><td>${v.name}</td><td>${v.id}</td><td>${v.email}</td><td>${votes.some(x=>x.voterId===v.id)?'Voted':'Not voted'}</td></tr>`).join('')+'</table>':'No registered voters.'}
function removeCandidate(id){if(votes.some(v=>v.candidateId===id)){adminAction.textContent='Cannot remove a candidate after votes have been cast for them.';return}candidates=candidates.filter(c=>c.id!==id);persist();renderAdmin()}
function toggleElection(){electionOpen=!electionOpen;persist();adminAction.textContent=electionOpen?'Election opened.':'Election closed.';renderAdmin()}
function publishResults(){if(electionOpen){adminAction.textContent='Close the election before publishing results.';return}published=true;persist();adminAction.textContent='Results published successfully.'}
</script></body></html>
