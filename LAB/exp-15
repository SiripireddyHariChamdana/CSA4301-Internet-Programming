<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>EasyToll | Online Toll Payment</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f3f6fa;color:#203047}header{background:#153e68;color:white;padding:17px 5%;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}h1{margin:0;font-size:25px}nav{display:flex;gap:5px;flex-wrap:wrap}button{border:0;border-radius:8px;padding:10px 14px;cursor:pointer;font-weight:bold;background:#e6eef8;color:#17436d}nav button{background:transparent;color:white}nav button.active,nav button:hover{background:#2e6598}.page{display:none;max-width:1050px;margin:28px auto;padding:0 18px}.page.active{display:block}.hero{padding:42px 30px;border-radius:16px;background:linear-gradient(120deg,#153e68,#347eb3);color:white}.hero h2{font-size:34px;margin:0 0 10px}.card{background:white;padding:22px;border-radius:14px;margin:16px 0;box-shadow:0 5px 18px #1b3d5b12}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:15px}.field{margin:12px 0}.field label{display:block;font-weight:bold;margin-bottom:6px}input,select,textarea{width:100%;padding:11px;border:1px solid #cbd7e3;border-radius:8px;font:inherit}textarea{min-height:75px}.primary{background:#1768a5;color:white}.muted{color:#718092}.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}.stat{background:#edf4fb;padding:16px;border-radius:10px}.stat b{display:block;font-size:23px;color:#175d91;margin-top:8px}table{width:100%;border-collapse:collapse;margin-top:12px}td,th{text-align:left;padding:11px;border-bottom:1px solid #e3eaf1}th{background:#edf4fb}.tag{display:inline-block;padding:5px 9px;border-radius:16px;background:#e5f2eb;color:#267148;font-size:12px}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}footer{text-align:center;padding:25px;color:#75849a}@media(max-width:600px){header{padding:15px}nav{width:100%}.hero h2{font-size:27px}}
</style></head><body>
<header><h1>🛣️ EasyToll</h1><nav><button class="active" onclick="show('home',this)">Home</button><button onclick="show('pay',this)">Pay Toll</button><button onclick="show('history',this)">Payment History</button><button onclick="show('vehicles',this)">My Vehicles</button><button onclick="show('account',this)">Account</button><button onclick="show('admin',this)">Admin</button></nav></header>
<main>
<section id="home" class="page active"><div class="hero"><h2>Travel smoothly. Pay tolls easily.</h2><p>Register your vehicle, calculate toll charges and make quick digital toll payments.</p><button class="primary" onclick="show('pay')">Make a Toll Payment →</button></div><div class="card"><h2>How EasyToll works</h2><div class="grid"><div><h3>1. Register Vehicle</h3><p class="muted">Add your vehicle registration number and type.</p></div><div><h3>2. Enter Journey</h3><p class="muted">Select the toll plaza and vehicle category.</p></div><div><h3>3. Pay Securely</h3><p class="muted">Choose a payment method and receive a receipt.</p></div></div></div></section>
<section id="pay" class="page"><div class="card"><h2>Toll Fee Payment</h2><form onsubmit="makePayment(event)"><div class="grid"><div class="field"><label>Vehicle registration number</label><input id="reg" placeholder="e.g. TN01AB1234" required></div><div class="field"><label>Vehicle type</label><select id="type" onchange="calculate()"><option value="50">Car / Jeep / Van</option><option value="80">LCV</option><option value="160">Bus / Truck</option><option value="250">Heavy Vehicle</option></select></div><div class="field"><label>Toll plaza</label><select id="plaza"><option>Chengalpattu Toll Plaza</option><option>Paranur Toll Plaza</option><option>Sriperumbudur Toll Plaza</option><option>Other Toll Plaza</option></select></div><div class="field"><label>Journey date</label><input id="journeyDate" type="date" required></div><div class="field"><label>Payment method</label><select id="method"><option>UPI</option><option>Debit Card</option><option>Credit Card</option><option>FASTag (Demo)</option></select></div><div class="field"><label>Number of trips</label><select id="trips" onchange="calculate()"><option value="1">Single</option><option value="2">Return (2 trips)</option></select></div></div><div class="card"><p class="muted">Estimated toll amount</p><h2 id="fee" style="color:#1768a5">₹50</h2></div><button class="primary">Pay Now</button></form><p id="payMsg"></p></div></section>
<section id="receipt" class="page"><div class="card"><h2>Payment Receipt</h2><div id="receiptInfo"></div><button onclick="window.print()">Print Receipt</button><button onclick="show('home')">Home</button></div></section>
<section id="history" class="page"><div class="card"><h2>Payment History</h2><div id="historyRows">No payments made yet.</div></div></section>
<section id="vehicles" class="page"><div class="card"><h2>Register a Vehicle</h2><form onsubmit="addVehicle(event)"><div class="grid"><div class="field"><label>Vehicle number</label><input id="vehicleNo" required></div><div class="field"><label>Vehicle type</label><select id="vehicleType"><option>Car / Jeep / Van</option><option>LCV</option><option>Bus / Truck</option><option>Heavy Vehicle</option></select></div><div class="field"><label>Owner name</label><input id="ownerName" required></div></div><button class="primary">Register Vehicle</button></form><p id="vehicleMsg"></p><h3>Registered Vehicles</h3><div id="vehicleRows"></div></div></section>
<section id="account" class="page"><div class="card"><h2>User Registration</h2><form onsubmit="register(event)"><div class="field"><label>Full name</label><input id="userName" required></div><div class="field"><label>Email</label><input id="userEmail" type="email" required></div><div class="field"><label>Mobile number</label><input id="userMobile" pattern="[0-9]{10}" maxlength="10" required></div><div class="field"><label>Password</label><input id="userPassword" type="password" minlength="4" required></div><button class="primary">Create Account</button></form><p id="accountMsg"></p></div></section>
<section id="admin" class="page"><div class="card"><h2>Admin Login</h2><p class="muted">Demo credentials: admin / admin123</p><form onsubmit="loginAdmin(event)"><div class="field"><label>Username</label><input id="adminUser" required></div><div class="field"><label>Password</label><input id="adminPass" type="password" required></div><button class="primary">Login</button></form><p id="adminMsg"></p></div><div id="adminPanel" class="card" style="display:none"><h2>Admin Dashboard</h2><div class="stats"><div class="stat">Total payments<b id="paymentCount">0</b></div><div class="stat">Collected amount<b id="collected">₹0</b></div><div class="stat">Registered vehicles<b id="vehicleCount">0</b></div></div><h3>All Toll Transactions</h3><div id="adminRows"></div></div></section>
</main><footer>EasyToll | Online Toll Payment System | Internet Programming Lab Demo</footer>
<script>
let payments=JSON.parse(localStorage.getItem('easyPayments')||'[]'),vehicles=JSON.parse(localStorage.getItem('easyVehicles')||'[]'),users=JSON.parse(localStorage.getItem('easyUsers')||'[]'),admin=false,lastReceipt=null;
function show(id,btn){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');if(id==='history')renderHistory();if(id==='vehicles')renderVehicles();if(id==='admin'&&admin)renderAdmin();window.scrollTo(0,0)}
function calculate(){fee.textContent='₹'+(Number(type.value)*Number(trips.value))}
function makePayment(e){e.preventDefault();let amount=Number(type.value)*Number(trips.value);let p={id:'ET'+(10001+payments.length),reg:reg.value.toUpperCase(),type:type.options[type.selectedIndex].text,plaza:plaza.value,date:journeyDate.value,method:method.value,trips:trips.value,amount,status:'Successful'};payments.push(p);localStorage.setItem('easyPayments',JSON.stringify(payments));lastReceipt=p;receiptInfo.innerHTML=`<p><b>Transaction ID:</b> ${p.id}</p><p><b>Vehicle:</b> ${p.reg}</p><p><b>Vehicle type:</b> ${p.type}</p><p><b>Toll plaza:</b> ${p.plaza}</p><p><b>Journey date:</b> ${p.date}</p><p><b>Payment method:</b> ${p.method}</p><p><b>Trips:</b> ${p.trips}</p><h2>Total Paid: ₹${p.amount}</h2><span class="tag">Payment Successful</span>`;e.target.reset();calculate();show('receipt')}
function renderHistory(){historyRows.innerHTML=payments.length?'<table><tr><th>Transaction ID</th><th>Vehicle</th><th>Toll Plaza</th><th>Date</th><th>Amount</th><th>Status</th></tr>'+payments.map(p=>`<tr><td>${p.id}</td><td>${p.reg}</td><td>${p.plaza}</td><td>${p.date}</td><td>₹${p.amount}</td><td>${p.status}</td></tr>`).join('')+'</table>':'No payments made yet.'}
function addVehicle(e){e.preventDefault();vehicles.push({no:vehicleNo.value.toUpperCase(),type:vehicleType.value,owner:ownerName.value});localStorage.setItem('easyVehicles',JSON.stringify(vehicles));vehicleMsg.textContent='Vehicle registered successfully.';e.target.reset();renderVehicles()}
function renderVehicles(){vehicleRows.innerHTML=vehicles.length?'<table><tr><th>Vehicle Number</th><th>Type</th><th>Owner</th></tr>'+vehicles.map(v=>`<tr><td>${v.no}</td><td>${v.type}</td><td>${v.owner}</td></tr>`).join('')+'</table>':'No vehicles registered.'}
function register(e){e.preventDefault();users.push({name:userName.value,email:userEmail.value,mobile:userMobile.value,password:userPassword.value});localStorage.setItem('easyUsers',JSON.stringify(users));accountMsg.textContent='Account created successfully.';e.target.reset()}
function loginAdmin(e){e.preventDefault();if(adminUser.value==='admin'&&adminPass.value==='admin123'){admin=true;adminMsg.textContent='Admin login successful.';adminPanel.style.display='block';renderAdmin()}else adminMsg.textContent='Invalid username or password.'}
function renderAdmin(){paymentCount.textContent=payments.length;collected.textContent='₹'+payments.reduce((s,p)=>s+p.amount,0);vehicleCount.textContent=vehicles.length;adminRows.innerHTML=payments.length?'<table><tr><th>ID</th><th>Vehicle</th><th>Plaza</th><th>Amount</th><th>Status</th></tr>'+payments.map(p=>`<tr><td>${p.id}</td><td>${p.reg}</td><td>${p.plaza}</td><td>₹${p.amount}</td><td>${p.status}</td></tr>`).join('')+'</table>':'No transactions yet.'}
calculate();
</script></body></html>
