<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#fcf3f2"><title>BloodConnect — A community for lifesaving donations</title>
<style>
:root{--ink:#382729;--muted:#827577;--bg:#fcf3f2;--paper:#fff;--red:#a63842;--rose:#f7dede;--dark:#541f2c;--line:#efdfdf;--green:#24744f}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.65 Arial,sans-serif}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button,.btn{border:0;border-radius:6px;padding:11px 15px;background:var(--red);color:white;cursor:pointer;font-weight:bold;display:inline-block}button:hover,.btn:hover{background:var(--dark)}.outline{background:transparent;color:var(--red);border:1px solid var(--red)}header{position:sticky;top:0;z-index:5;background:#fffF;border-bottom:1px solid var(--line)}nav,.wrap{max-width:1160px;margin:auto}nav{min-height:70px;padding:12px 22px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{font-size:21px;font-weight:900;color:var(--dark)}.brand span{color:var(--red)}.links{display:flex;gap:17px;align-items:center;flex-wrap:wrap}.links a{font-size:13px;font-weight:bold;color:#684e51}.view{display:none;min-height:72vh}.view.active{display:block}.hero{max-width:1160px;margin:18px auto 0;min-height:380px;border-radius:9px;padding:45px 6%;background:linear-gradient(105deg,#501e2de8,#501e2d55),url('https://images.unsplash.com/photo-1615461066841-6116e61058f4?auto=format&fit=crop&w=1800&q=85') center/cover;color:white;display:flex;align-items:center}.hero h1{font:500 clamp(39px,6vw,66px)/1.04 Georgia,serif;margin:13px 0}.hero p{max-width:580px;color:#f6e8e9}.hero .eyebrow{color:#f5c2c1}.hero .outline{color:white;border-color:white}.eyebrow{text-transform:uppercase;letter-spacing:1.6px;font-size:11px;color:var(--red);font-weight:bold}.wrap{padding:43px 22px}.title{font:500 clamp(30px,4vw,43px)/1.1 Georgia,serif;margin:7px 0}.sub{color:var(--muted);max-width:760px}.row{display:flex;align-items:center;justify-content:space-between;gap:13px;flex-wrap:wrap;margin-bottom:17px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.panel,.stat,.card{background:white;border:1px solid var(--line);border-radius:8px;padding:18px}.stat strong{font-size:27px;color:var(--red)}.two{display:grid;grid-template-columns:1fr 1fr;gap:18px}.field{display:block;width:100%;padding:11px;margin-top:5px;border:1px solid #e4d7d8;border-radius:5px;background:white;color:var(--ink)}label{display:block;font-size:13px;font-weight:bold;margin:10px 0}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:6px 12px}.toolbar{display:flex;gap:9px;flex-wrap:wrap;margin:17px 0}.toolbar input{flex:1;min-width:180px}.toolbar input,.toolbar select{padding:10px;border:1px solid #e4d7d8;border-radius:5px;background:white}.badge{display:inline-block;padding:4px 9px;border-radius:20px;background:#f9e3e1;color:#922e3b;font-size:11px;font-weight:bold}.badge.available{background:#e3f2e7;color:#28724d}.notice{background:#f8e9e7;border-left:3px solid var(--red);padding:12px;margin:12px 0}.meta{font-size:12px;color:var(--muted)}.status{min-height:22px;color:var(--green);font-weight:bold}.blood{font-size:25px;font-weight:900;color:var(--red);width:52px;height:52px;border-radius:50%;background:#fae3e1;display:grid;place-items:center}.card-top{display:flex;align-items:center;gap:12px}.empty{padding:14px;color:var(--muted)}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:13px}th,td{text-align:left;padding:9px;border-bottom:1px solid var(--line)}th{background:#fcf3f2}.toast{position:fixed;right:20px;bottom:20px;background:var(--dark);color:white;padding:12px 16px;border-radius:5px;display:none;z-index:10}footer{background:#54232e;color:#faeeee;padding:22px}.foot{max-width:1160px;margin:auto;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}.foot a{text-decoration:underline;text-underline-offset:3px}@media(max-width:760px){.grid,.two{grid-template-columns:1fr 1fr}.links{gap:10px}.hero{min-height:330px}}@media(max-width:560px){nav{align-items:flex-start;flex-direction:column}.grid,.two,.formgrid{grid-template-columns:1fr}.wrap{padding:32px 16px}.hero{margin:10px;min-height:320px}}
</style></head><body>
<header><nav><a class="brand" href="#home">Blood<span>Connect</span></a><div class="links"><a href="#home">Home</a><a href="#donors">Find donors</a><a href="#banks">Blood banks</a><a href="#donate">Register donor</a><a href="#hospital">Hospital portal</a><a href="#reports">Reports</a></div></nav></header>
<main>
<section class="view" id="home"><div class="hero"><div><div class="eyebrow">A community that gives hope</div><h1>A little of your time.<br>A lifetime for someone.</h1><p>Help connect eligible donors and hospitals with a directory of demo blood-bank availability. Share only information you are comfortable making visible.</p><div class="actions"><a class="btn" href="#donate">Become a donor</a><a class="btn outline" href="#donors">Find a donor</a></div></div></div><div class="wrap"><div class="row"><div><div class="eyebrow">When communities connect</div><h2 class="title">Make the next step easier.</h2></div></div><div class="grid"><article class="stat"><strong>Donors</strong><p class="meta">Search people who have opted to appear in this local demo directory.</p></article><article class="stat"><strong>Blood banks</strong><p class="meta">Review sample hospital stock availability by blood group and area.</p></article><article class="stat"><strong>Community</strong><p class="meta">Update demo availability and help keep the directory useful.</p></article></div><div class="notice"><b>Important:</b> This is a student demonstration, not an emergency service or clinical resource. For urgent transfusion needs, contact a licensed hospital directly. Availability and compatibility must be confirmed by medical professionals.</div></div></section>
<section class="view" id="donors"><div class="wrap"><div class="eyebrow">Opt-in donor directory</div><h1 class="title">Search available donors.</h1><p class="sub">Filter the sample directory by blood group and location. Contact details shown are fictional demo information.</p><div class="toolbar"><input id="donorSearch" placeholder="Search city or area"><select id="bloodFilter"><option value="">All blood groups</option><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select><button id="searchDonors">Search</button></div><div id="donorList" class="grid"></div></div></section>
<section class="view" id="banks"><div class="wrap"><div class="eyebrow">Hospital blood-bank directory</div><h1 class="title">Check demo stock availability.</h1><p class="sub">Sample inventory is illustrative and not suitable for treatment decisions. Contact the hospital directly to verify current stock.</p><div class="toolbar"><input id="bankSearch" placeholder="Search hospital or city"><select id="bankGroup"><option value="">All blood groups</option><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select></div><div id="bankList" class="grid"></div></div></section>
<section class="view" id="donate"><div class="wrap"><div class="eyebrow">Share your availability</div><h1 class="title">Register as a donor.</h1><p class="sub">Add an opt-in demo record to the local donor directory. Donor eligibility and suitability are determined by qualified healthcare professionals.</p><div class="two"><form id="donorForm" class="panel"><h2>Donor details</h2><label>Display name<input class="field" name="name" required></label><div class="formgrid"><label>Blood group<select class="field" name="group"><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select></label><label>City / area<input class="field" name="city" required></label></div><label>Contact email<input class="field" name="email" type="email" required></label><label>Contact phone<input class="field" name="phone" type="tel" required></label><label>Availability<select class="field" name="availability"><option>Available for contact</option><option>Not currently available</option></select></label><label><input type="checkbox" name="listed" required> I consent to show my display name, blood group, area, and contact details in this local demo directory.</label><button>Save opt-in donor record</button><p class="status" id="donorStatus"></p><p class="meta">Use fictional contact information. Records are stored in this browser only.</p></form><div class="panel"><h2>Before donating</h2><p class="sub">Please consult a licensed blood bank or healthcare professional. Eligibility criteria, donation intervals, and medical screening vary; this website does not make medical recommendations or determine donor eligibility.</p><div class="notice">In an emergency, contact local emergency services or a hospital directly. This directory is not monitored for emergencies.</div><a class="btn outline" href="#banks">View demo blood banks</a></div></div></div></section>
<section class="view" id="hospital"><div class="wrap"><div class="eyebrow">For hospital staff · demo portal</div><h1 class="title">Manage blood-bank information.</h1><p class="sub">Register a sample facility, update group-level stock indicators, and review donor-directory entries. Do not enter real patient or clinical data.</p><div class="two"><form id="hospitalForm" class="panel"><h2>Register a hospital / blood bank</h2><label>Facility name<input class="field" name="name" required></label><label>City / service area<input class="field" name="city" required></label><label>Contact email<input class="field" name="email" type="email" required></label><label>Contact phone<input class="field" name="phone" type="tel" required></label><button>Register facility locally</button><p class="status" id="hospitalStatus"></p></form><form id="stockForm" class="panel"><h2>Update demo stock status</h2><label>Facility<select class="field" id="facilitySelect" name="facility"></select></label><label>Blood group<select class="field" name="group"><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select></label><label>Demo availability<select class="field" name="status"><option>Available</option><option>Low</option><option>Not available</option></select></label><button>Update sample status</button><p class="status" id="stockStatus"></p></form></div><div class="panel" style="margin-top:18px"><h2>Donor directory management</h2><p class="meta">Review the public demo records and their opt-in availability.</p><div id="hospitalDonors"></div></div></div></section>
<section class="view" id="reports"><div class="wrap"><div class="eyebrow">Blood donation activity · demo analytics</div><h1 class="title">Directory summary.</h1><div class="grid"><div class="stat"><div class="meta">Opt-in donor records</div><strong id="reportDonors">0</strong></div><div class="stat"><div class="meta">Registered facilities</div><strong id="reportBanks">0</strong></div><div class="stat"><div class="meta">Stock updates</div><strong id="reportUpdates">0</strong></div></div><div class="panel" style="margin-top:18px"><h2>Donor records by blood group</h2><div id="groupReport"></div></div><div class="notice">Reports contain demo directory records only. No patient records, test results, or confidential medical reports belong in this static application.</div></div></section>
</main><footer><div class="foot"><a class="brand" style="color:white" href="#home">BloodConnect</a><span>Give with care. Verify with your hospital.</span><span>Experiment 23 · <a href="../Exp-22/CleanCity.html">← CleanCity</a> · <a href="../Exp-24/Wanderlust.html">Next: Wanderlust Travels →</a></span></div></footer><div class="toast" id="toast" role="status"></div>
<script>
const $=s=>document.querySelector(s),seedDonors=[{id:"d1",name:"Maya R.",group:"O+",city:"Chennai",email:"maya.demo@example.test",phone:"+91 90000 10001",availability:"Available for contact",listed:true},{id:"d2",name:"Arun K.",group:"A+",city:"Bengaluru",email:"arun.demo@example.test",phone:"+91 90000 10002",availability:"Available for contact",listed:true},{id:"d3",name:"Sam T.",group:"B-",city:"Chennai",email:"sam.demo@example.test",phone:"+91 90000 10003",availability:"Not currently available",listed:true},{id:"d4",name:"Nila P.",group:"AB+",city:"Coimbatore",email:"nila.demo@example.test",phone:"+91 90000 10004",availability:"Available for contact",listed:true}],seedBanks=[{id:"h1",name:"Central City Blood Centre",city:"Chennai",email:"bloodcentre@example.test",phone:"+91 80000 20001},{id:"h2",name:"Northside Medical Centre",city:"Bengaluru",email:"northside@example.test",phone:"+91 80000 20002},{id:"h3",name:"Community Health Hospital",city:"Coimbatore",email:"community@example.test",phone:"+91 80000 20003}],groups=["A+","A-","B+","B-","AB+","AB-","O+","O-"];
function load(k,f){try{return JSON.parse(localStorage.getItem("bloodconnect-"+k))??f}catch{return f}}function save(k,v){localStorage.setItem("bloodconnect-"+k,JSON.stringify(v))}let donors=load("donors",seedDonors),banks=load("banks",seedBanks),stock=load("stock",[{bank:"h1",group:"O+",status:"Available"},{bank:"h1",group:"A+",status:"Low"},{bank:"h2",group:"B+",status:"Available"},{bank:"h3",group:"AB+",status:"Low"}]);
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}function toast(s){const t=$("#toast");t.textContent=s;t.style.display="block";setTimeout(()=>t.style.display="none",2200)}
function donorCard(d){return `<article class="card"><div class="card-top"><div class="blood">${esc(d.group)}</div><div><b>${esc(d.name)}</b><div class="meta">${esc(d.city)}</div></div></div><p><span class="badge ${d.availability==="Available for contact"?"available":""}">${esc(d.availability)}</span></p><p class="meta">Opt-in demo directory entry. Confirm eligibility with a licensed blood bank.</p><a class="btn outline" href="mailto:${esc(d.email)}">Email donor</a> <a class="btn outline" href="tel:${esc(d.phone)}">Call</a></article>`}
function render(){const q=$("#donorSearch").value.trim().toLowerCase(),g=$("#bloodFilter").value,found=donors.filter(d=>d.listed&&(!q||d.city.toLowerCase().includes(q))&&(!g||d.group===g));$("#donorList").innerHTML=found.map(donorCard).join("")||'<p class="empty">No opted-in demo donors match your search.</p>';const bq=$("#bankSearch").value.trim().toLowerCase(),bg=$("#bankGroup").value,filtered=banks.filter(b=>(!bq||`${b.name} ${b.city}`.toLowerCase().includes(bq))&&(!bg||stock.some(s=>s.bank===b.id&&s.group===bg)));$("#bankList").innerHTML=filtered.map(b=>`<article class="card"><div class="eyebrow">Blood bank · ${esc(b.city)}</div><h3>${esc(b.name)}</h3><p class="meta">${esc(b.phone)} · ${esc(b.email)}</p><h4>Sample inventory statuses</h4>${stock.filter(s=>s.bank===b.id).map(s=>`<div class="row"><span class="blood" style="width:36px;height:36px;font-size:16px">${esc(s.group)}</span><span class="badge ${s.status==="Available"?"available":""}">${esc(s.status)}</span></div>`).join("")||'<p class="meta">No demo stock updates.</p>'}<p class="meta">Sample status only. Call the facility to confirm directly.</p><a href="tel:${esc(b.phone)}" class="btn outline">Contact facility</a></article>`).join("")||'<p class="empty">No facilities match those filters.</p>';$("#facilitySelect").innerHTML=banks.map(x=>`<option value="${esc(x.id)}">${esc(x.name)}</option>`).join("");$("#hospitalDonors").innerHTML=donors.map(d=>`<div class="row"><div><b>${esc(d.name)} · ${esc(d.group)}</b><div class="meta">${esc(d.city)} · ${esc(d.email)}</div></div><span class="badge ${d.availability==="Available for contact"?"available":""}">${esc(d.availability)}</span></div>`).join("")||'<p class="empty">No donor records.</p>';$("#reportDonors").textContent=donors.length;$("#reportBanks").textContent=banks.length;$("#reportUpdates").textContent=stock.length;$("#groupReport").innerHTML=groups.map(g=>`<div class="row"><span class="blood" style="width:36px;height:36px;font-size:16px">${g}</span><div style="flex:1;margin:0 12px"><div style="height:8px;background:#f4e8e7;border-radius:8px"><i style="display:block;width:${Math.min(100,donors.filter(d=>d.group===g).length*20)}%;height:100%;background:#b74a50;border-radius:8px"></i></div></div><b>${donors.filter(d=>d.group===g).length}</b></div>`).join("");[["donors",donors],["banks",banks],["stock",stock]].forEach(([k,v])=>save(k,v))}
["donorSearch","bloodFilter","bankSearch","bankGroup"].forEach(id=>$("#"+id).addEventListener("input",render));
$("#donorForm").addEventListener("submit",e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target));donors.push({...d,id:"donor-"+Date.now(),listed:true});save("donors",donors);$("#donorStatus").textContent="Your opt-in demo record is now listed in this browser.";e.target.reset();render()});
$("#hospitalForm").addEventListener("submit",e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target));banks.push({...d,id:"hospital-"+Date.now()});save("banks",banks);$("#hospitalStatus").textContent="Facility registered in the local demo directory.";e.target.reset();render()});
$("#stockForm").addEventListener("submit",e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target)),i=stock.findIndex(x=>x.bank===d.facility&&x.group===d.group);if(i<0)stock.push(d);else stock[i]=d;save("stock",stock);$("#stockStatus").textContent="Demo inventory status updated.";render()});
function route(){const id=location.hash.slice(1)||"home";if(!document.getElementById(id)?.classList.contains("view")){location.hash="#home";return}document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===id));render();window.scrollTo(0,0)}window.addEventListener("hashchange",route);render();route();
</script></body></html>
