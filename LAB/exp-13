<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>BlossomGifts | Online Gift Store</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#fff8f7;color:#382b32}header{background:#7b3151;color:#fff;padding:17px 5%;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}h1{margin:0;font-size:25px}nav{display:flex;flex-wrap:wrap;gap:5px}button{border:0;padding:10px 13px;border-radius:8px;cursor:pointer;font-weight:bold;background:#f4e5eb;color:#71304d}nav button{background:transparent;color:#fff}nav button:hover,nav button.active{background:#a95376}.page{display:none;max-width:1100px;margin:28px auto;padding:0 18px}.page.active{display:block}.hero{padding:48px 30px;border-radius:17px;background:linear-gradient(120deg,#7b3151,#c16d8e);color:white}.hero h2{font-size:36px;margin:0 0 12px}.card{background:white;padding:22px;border-radius:14px;box-shadow:0 5px 18px #6b354012;margin:16px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px}.product{border:1px solid #f0dce4;border-radius:12px;padding:17px}.emoji{font-size:52px;background:#fff0f4;border-radius:10px;text-align:center;padding:18px}.price{font-size:19px;font-weight:bold;color:#963e64}.field{margin:12px 0}.field label{display:block;font-weight:bold;margin-bottom:6px}input,select,textarea{width:100%;padding:11px;border:1px solid #decbd3;border-radius:8px;font:inherit}textarea{min-height:85px}.primary{background:#913d63;color:white}.muted{color:#846f79}.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:12px}table{width:100%;border-collapse:collapse;margin-top:12px}td,th{text-align:left;padding:11px;border-bottom:1px solid #f0e2e8}th{background:#fff0f4}.tag{font-size:12px;background:#f8e8ef;padding:5px 9px;border-radius:20px}footer{text-align:center;color:#947e88;padding:25px}@media(max-width:600px){header{padding:15px}nav{width:100%}.hero h2{font-size:28px}}
</style></head>
<body>
<header><h1>🌸 BlossomGifts</h1><nav>
<button class="active" onclick="show('home',this)">Home</button><button onclick="show('shop',this)">Shop Gifts</button><button onclick="show('cart',this)">Cart <span id="cartCount">0</span></button><button onclick="show('checkout',this)">Checkout</button><button onclick="show('orders',this)">My Orders</button><button onclick="show('contact',this)">Contact</button><button onclick="show('admin',this)">Admin</button>
</nav></header>
<main>
<section id="home" class="page active"><div class="hero"><h2>Make every moment bloom.</h2><p>Thoughtful gifts for birthdays, anniversaries, celebrations and every special occasion.</p><button class="primary" onclick="show('shop')">Explore Gifts →</button></div><div class="card"><h2>Shop by occasion</h2><div class="grid"><div class="product"><div class="emoji">🎂</div><h3>Birthdays</h3><button onclick="filterShop('Birthday')">View gifts</button></div><div class="product"><div class="emoji">💝</div><h3>Anniversaries</h3><button onclick="filterShop('Anniversary')">View gifts</button></div><div class="product"><div class="emoji">🌹</div><h3>Thank You</h3><button onclick="filterShop('Thank You')">View gifts</button></div><div class="product"><div class="emoji">🎉</div><h3>Celebrations</h3><button onclick="filterShop('Celebration')">View gifts</button></div></div></div></section>
<section id="shop" class="page"><div class="card"><h2>Gift Collection</h2><div class="grid"><div class="field"><label>Search gifts</label><input id="search" oninput="renderShop()" placeholder="Search by name"></div><div class="field"><label>Category</label><select id="category" onchange="renderShop()"><option value="">All categories</option><option>Birthday</option><option>Anniversary</option><option>Thank You</option><option>Celebration</option></select></div></div><div id="products" class="grid"></div></div></section>
<section id="details" class="page"><div class="card" id="detailContent"></div></section>
<section id="cart" class="page"><div class="card"><h2>Your Shopping Cart</h2><div id="cartItems"></div><h3 id="cartTotal"></h3><button class="primary" onclick="show('checkout')">Proceed to Checkout</button></div></section>
<section id="checkout" class="page"><div class="card"><h2>Delivery & Payment</h2><form onsubmit="placeOrder(event)"><div class="grid"><div class="field"><label>Full name</label><input id="buyer" required></div><div class="field"><label>Email</label><input id="email" type="email" required></div><div class="field"><label>Mobile number</label><input id="mobile" pattern="[0-9]{10}" maxlength="10" required></div><div class="field"><label>Delivery date</label><input id="delivery" type="date" required></div></div><div class="field"><label>Delivery address</label><textarea id="address" required></textarea></div><div class="field"><label>Gift message (optional)</label><textarea id="giftMessage" placeholder="Write a personal message to include with your gift"></textarea></div><div class="field"><label>Payment method</label><select id="payment"><option>Cash on Delivery</option><option>UPI (Demo)</option><option>Credit / Debit Card (Demo)</option></select></div><p id="checkoutSummary" class="muted"></p><button class="primary">Place Order</button></form><p id="orderMsg"></p></div></section>
<section id="orders" class="page"><div class="card"><h2>My Orders</h2><div id="orderList">No orders placed yet.</div></div></section>
<section id="contact" class="page"><div class="card"><h2>Contact BlossomGifts</h2><p>Email: support@blossomgifts.example | Phone: 9876543210</p><form onsubmit="contactSend(event)"><div class="field"><label>Name</label><input required></div><div class="field"><label>Email</label><input type="email" required></div><div class="field"><label>Message</label><textarea required></textarea></div><button class="primary">Send Message</button></form><p id="contactMsg"></p></div></section>
<section id="admin" class="page"><div class="card"><h2>Admin Login</h2><p class="muted">Demo username: admin | Password: admin123</p><form onsubmit="loginAdmin(event)"><div class="field"><label>Username</label><input id="adminUser" required></div><div class="field"><label>Password</label><input id="adminPass" type="password" required></div><button class="primary">Login</button></form><p id="adminError"></p></div><div id="adminPanel" class="card" style="display:none"><h2>Manage Gifts</h2><form onsubmit="addProduct(event)"><div class="grid"><div class="field"><label>Gift name</label><input id="newName" required></div><div class="field"><label>Price (₹)</label><input id="newPrice" type="number" min="1" required></div><div class="field"><label>Category</label><select id="newCat"><option>Birthday</option><option>Anniversary</option><option>Thank You</option><option>Celebration</option></select></div><div class="field"><label>Icon / Emoji</label><input id="newIcon" value="🎁"></div></div><button class="primary">Add Gift</button></form><h3>Product List</h3><div id="adminProducts"></div><h3>Customer Orders</h3><div id="adminOrders"></div></div></section>
</main><footer>BlossomGifts Online Gift Store | Internet Programming Lab Demonstration</footer>
<script>
let products=[{id:1,name:'Birthday Surprise Box',price:799,cat:'Birthday',icon:'🎁',desc:'A cheerful gift box with a greeting card and surprise treats.'},{id:2,name:'Rose Bouquet',price:599,cat:'Anniversary',icon:'💐',desc:'Fresh-style rose bouquet for a special person.'},{id:3,name:'Chocolate Hamper',price:499,cat:'Celebration',icon:'🍫',desc:'A sweet assortment packed for gifting.'},{id:4,name:'Personalised Mug',price:349,cat:'Thank You',icon:'☕',desc:'A memorable mug for everyday use.'},{id:5,name:'Love Keepsake',price:999,cat:'Anniversary',icon:'💝',desc:'A keepsake gift to celebrate togetherness.'},{id:6,name:'Party Balloon Set',price:299,cat:'Birthday',icon:'🎈',desc:'Colourful balloons for a joyful celebration.'}];
let cart=JSON.parse(localStorage.getItem('bgCart')||'[]'),orders=JSON.parse(localStorage.getItem('bgOrders')||'[]'),admin=false;
function show(id,btn){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');if(id==='cart')renderCart();if(id==='orders')renderOrders();if(id==='checkout')checkoutSummary.textContent='Order total: ₹'+total();if(id==='admin'&&admin)renderAdmin();window.scrollTo(0,0)}
function filterShop(cat){category.value=cat;show('shop');renderShop()}
function renderShop(){let q=search.value.toLowerCase(),c=category.value;products.filter(p=>p.name.toLowerCase().includes(q)&&(!c||p.cat===c)).forEach(()=>{});let list=products.filter(p=>p.name.toLowerCase().includes(q)&&(!c||p.cat===c));document.getElementById('products').innerHTML=list.map(p=>`<div class="product"><div class="emoji">${p.icon}</div><h3>${p.name}</h3><span class="tag">${p.cat}</span><p class="price">₹${p.price}</p><p class="muted">${p.desc}</p><div class="actions"><button onclick="details(${p.id})">Details</button><button class="primary" onclick="addCart(${p.id})">Add to Cart</button></div></div>`).join('')||'<p>No gifts found.</p>'}
function details(id){let p=products.find(x=>x.id===id);detailContent.innerHTML=`<button onclick="show('shop')">← Back to Shop</button><div class="emoji">${p.icon}</div><h2>${p.name}</h2><span class="tag">${p.cat}</span><h3 class="price">₹${p.price}</h3><p>${p.desc}</p><button class="primary" onclick="addCart(${p.id})">Add to Cart</button>`;show('details')}
function saveCart(){localStorage.setItem('bgCart',JSON.stringify(cart));cartCount.textContent=cart.reduce((s,x)=>s+x.qty,0)}
function addCart(id){let x=cart.find(a=>a.id===id);if(x)x.qty++;else cart.push({id,qty:1});saveCart();alert('Gift added to cart.')}
function total(){return cart.reduce((s,x)=>s+products.find(p=>p.id===x.id).price*x.qty,0)}
function renderCart(){cartItems.innerHTML=cart.length?'<table><tr><th>Gift</th><th>Price</th><th>Quantity</th><th>Action</th></tr>'+cart.map(x=>{let p=products.find(a=>a.id===x.id);return `<tr><td>${p.name}</td><td>₹${p.price}</td><td><button onclick="changeQty(${p.id},-1)">−</button> ${x.qty} <button onclick="changeQty(${p.id},1)">+</button></td><td><button onclick="removeItem(${p.id})">Remove</button></td></tr>`}).join('')+'</table>':'Your cart is empty.';cartTotal.textContent='Total: ₹'+total()}
function changeQty(id,n){let x=cart.find(a=>a.id===id);x.qty+=n;if(x.qty<1)cart=cart.filter(a=>a.id!==id);saveCart();renderCart()}
function removeItem(id){cart=cart.filter(a=>a.id!==id);saveCart();renderCart()}
function placeOrder(e){e.preventDefault();if(!cart.length){orderMsg.textContent='Your cart is empty.';return}let o={id:'BG'+(1001+orders.length),name:buyer.value,email:email.value,mobile:mobile.value,date:delivery.value,address:address.value,message:giftMessage.value,payment:payment.value,total:total(),items:cart.map(x=>({...x})),status:'Order Placed'};orders.push(o);localStorage.setItem('bgOrders',JSON.stringify(orders));cart=[];saveCart();orderMsg.textContent='Thank you! Your order ID is '+o.id;e.target.reset();checkoutSummary.textContent=''}
function renderOrders(){orderList.innerHTML=orders.length?'<table><tr><th>Order ID</th><th>Date</th><th>Total</th><th>Payment</th><th>Status</th></tr>'+orders.map(o=>`<tr><td>${o.id}</td><td>${o.date}</td><td>₹${o.total}</td><td>${o.payment}</td><td>${o.status}</td></tr>`).join('')+'</table>':'No orders placed yet.'}
function contactSend(e){e.preventDefault();contactMsg.textContent='Thank you. Your message has been recorded in this demo.';e.target.reset()}
function loginAdmin(e){e.preventDefault();if(adminUser.value==='admin'&&adminPass.value==='admin123'){admin=true;adminPanel.style.display='block';adminError.textContent='';renderAdmin()}else adminError.textContent='Invalid login details.'}
function addProduct(e){e.preventDefault();products.push({id:Date.now(),name:newName.value,price:Number(newPrice.value),cat:newCat.value,icon:newIcon.value,desc:'A thoughtful gift from BlossomGifts.'});e.target.reset();renderAdmin();renderShop()}
function renderAdmin(){adminProducts.innerHTML='<table><tr><th>Gift</th><th>Price</th><th>Category</th><th>Action</th></tr>'+products.map(p=>`<tr><td>${p.icon} ${p.name}</td><td>₹${p.price}</td><td>${p.cat}</td><td><button onclick="deleteProduct(${p.id})">Delete</button></td></tr>`).join('')+'</table>';adminOrders.innerHTML=orders.length?'<table><tr><th>Order</th><th>Customer</th><th>Address</th><th>Status</th><th>Update</th></tr>'+orders.map((o,i)=>`<tr><td>${o.id}</td><td>${o.name}</td><td>${o.address}</td><td>${o.status}</td><td><select onchange="updateOrder(${i},this.value)"><option>Order Placed</option><option>Packed</option><option>Shipped</option><option>Delivered</option></select></td></tr>`).join('')+'</table>':'No orders yet.'}
function deleteProduct(id){products=products.filter(p=>p.id!==id);renderAdmin();renderShop()}
function updateOrder(i,s){orders[i].status=s;localStorage.setItem('bgOrders',JSON.stringify(orders));renderAdmin()}
renderShop();saveCart();
</script></body></html>
