<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f4f6f6"><title>Wanderlust Travels — Your next story starts here</title>
<style>
:root{--ink:#263638;--muted:#718081;--bg:#f4f6f6;--paper:#fff;--teal:#176c68;--deep:#124542;--mint:#e2f0ed;--coral:#d17b62;--line:#dfe8e6;--serif:Georgia,"Times New Roman",serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.65 Arial,sans-serif}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button,.btn{border:0;border-radius:6px;padding:11px 15px;background:var(--teal);color:white;cursor:pointer;font-weight:bold;display:inline-block}button:hover,.btn:hover{background:var(--deep)}.outline{background:transparent;color:var(--teal);border:1px solid var(--teal)}header{position:sticky;top:0;z-index:5;background:#fffF;border-bottom:1px solid var(--line)}nav,.wrap{max-width:1160px;margin:auto}nav{min-height:70px;padding:12px 22px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{font-size:21px;font-weight:900;color:var(--deep)}.brand span{color:var(--coral)}.links{display:flex;align-items:center;gap:17px;flex-wrap:wrap}.links a{font-size:13px;font-weight:bold;color:#506364}.view{display:none;min-height:72vh}.view.active{display:block}.hero{max-width:1160px;margin:18px auto 0;border-radius:9px;min-height:405px;background:linear-gradient(100deg,#102f2cd9,#102f2c36),url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1900&q=88') center/cover;color:white;display:flex;align-items:center}.hero-copy{max-width:700px;padding:48px 7%}.eyebrow{text-transform:uppercase;letter-spacing:1.6px;font-size:11px;color:var(--coral);font-weight:bold}.hero .eyebrow{color:#c6eee1}.hero h1{font:500 clamp(44px,7vw,74px)/1.02 var(--serif);margin:14px 0}.hero p{max-width:550px;color:#e3efec}.hero .outline{color:white;border-color:white}.actions,.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.actions{margin-top:22px}.row{justify-content:space-between;margin-bottom:18px}.wrap{padding:44px 22px}.title{font:500 clamp(30px,4vw,44px)/1.12 var(--serif);margin:7px 0}.sub{color:var(--muted);max-width:770px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.trip{background:#fff;border:1px solid var(--line);border-radius:8px;overflow:hidden}.trip-img{height:190px;background-position:center;background-size:cover}.trip:nth-child(1) .trip-img{background-image:url('https://images.unsplash.com/photo-1516483638261-f4dbaf036963?auto=format&fit=crop&w=900&q=84')}.trip:nth-child(2) .trip-img{background-image:url('https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=900&q=84')}.trip:nth-child(3) .trip-img{background-image:url('https://images.unsplash.com/photo-1548013146-72479768bada?auto=format&fit=crop&w=900&q=84')}.trip:nth-child(4) .trip-img{background-image:url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=900&q=84')}.trip-body{padding:15px}.trip-body h3{font:500 22px var(--serif);margin:5px 0}.meta{font-size:12px;color:var(--muted)}.chip{display:inline-block;margin:2px;background:var(--mint);color:var(--teal);padding:4px 9px;border-radius:18px;font-size:11px}.panel,.stat{background:white;border:1px solid var(--line);border-radius:8px;padding:19px}.toolbar{display:flex;gap:9px;flex-wrap:wrap;margin:17px 0}.toolbar input{flex:1;min-width:180px}.toolbar input,.toolbar select,.field{padding:10px 11px;border:1px solid #d5e0de;border-radius:5px;background:white;color:var(--ink)}.two{display:grid;grid-template-columns:1fr 1fr;gap:18px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:5px 12px}label{display:block;font-size:13px;font-weight:bold;margin:10px 0}.field{display:block;width:100%;margin-top:5px}.notice{background:#e7f2ef;border-left:3px solid var(--teal);padding:12px;margin:12px 0}.status{min-height:22px;color:#28724d;font-weight:bold}.badge{background:#e3f1e8;color:#28714d;padding:4px 9px;border-radius:18px;font-size:11px;font-weight:bold}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:13px}th,td{text-align:left;padding:9px;border-bottom:1px solid var(--line)}th{background:#f2f7f5}.empty{padding:14px;color:var(--muted)}.map{min-height:260px;position:relative;overflow:hidden;background:linear-gradient(135deg,#d6e5d7,#e9e3d2,#c7dcda);border:1px solid var(--line);border-radius:8px}.map:before,.map:after{content:"";position:absolute;left:-10%;top:45%;height:3px;width:120%;background:#fff;transform:rotate(-14deg);box-shadow:0 45px #fff,0 90px #fff}.map:after{top:10%;transform:rotate(34deg);background:#a9c7ab;box-shadow:0 55px #a9c7ab,0 110px #a9c7ab}.pin{position:absolute;z-index:2;background:var(--coral);border-radius:50%;width:38px;height:38px;padding:0}.map-caption{position:absolute;z-index:3;bottom:11px;left:12px;background:#fffe;padding:7px 10px;border-radius:4px;font-size:12px}.toast{position:fixed;right:20px;bottom:20px;background:var(--deep);color:white;padding:12px 16px;border-radius:5px;display:none;z-index:10}footer{background:#153f3d;color:#eef6f2;padding:22px}.foot{max-width:1160px;margin:auto;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}.foot a{text-decoration:underline;text-underline-offset:3px}@media(max-width:760px){.grid,.two{grid-template-columns:1fr 1fr}.links{gap:10px}.hero{min-height:360px}}@media(max-width:560px){nav{align-items:flex-start;flex-direction:column}.grid,.two,.formgrid{grid-template-columns:1fr}.wrap{padding:32px 16px}.hero{margin:10px;min-height:340px}}
</style></head><body>
<header><nav><a class="brand" href="#home">wanderlust<span> travels</span></a><div class="links"><a href="#home">Home</a><a href="#explore">Explore</a><a href="#book">Book a trip</a><a href="#my-trips">My trips</a><a href="#guides">Travel guides</a><a href="#support">Support</a></div></nav></header>
<main>
<section class="view" id="home"><div class="hero"><div class="hero-copy"><div class="eyebrow">Go a little further</div><h1>Your next story starts here.</h1><p>Find your next destination, plan a stay, and make the arrangements for a trip worth remembering. Explore flights, hotels, car hire, and thoughtful getaways.</p><div class="actions"><a class="btn" href="#explore">Explore destinations</a><a class="btn outline" href="#book">Plan your trip</a></div></div></div><div class="wrap"><div class="row"><div><div class="eyebrow">A little inspiration</div><h2 class="title">Places worth the journey.</h2></div><a href="#explore">See all destinations →</a></div><div class="grid" id="featured"></div></div><div class="wrap" style="padding-top:0"><div class="two"><div class="panel"><div class="eyebrow">Travel, thoughtfully planned</div><h2 class="title">Everything in one itinerary.</h2><p class="sub">Explore a destination, find a stay, choose an experience, and keep the booking details together.</p><a class="btn" href="#book">Start an itinerary</a></div><div class="panel"><div class="eyebrow">Traveler note</div><p style="font:italic 24px/1.5 Georgia;color:#176c68">“Take the trip. The details can fall into place one step at a time.”</p></div></div></div></section>
<section class="view" id="explore"><div class="wrap"><div class="eyebrow">Find your somewhere</div><h1 class="title">Explore stays & getaways.</h1><p class="sub">Search destinations and filter the sample collection. All prices and availability are illustrative.</p><div class="toolbar"><input id="search" placeholder="Search a destination or experience"><select id="kind"><option value="">All trip types</option><option>City escape</option><option>Beach retreat</option><option>Nature & adventure</option><option>Culture & heritage</option></select><select id="sort"><option value="featured">Featured</option><option value="price">Price: low to high</option></select></div><p id="tripCount" class="meta"></p><div class="grid" id="tripList"></div></div></section>
<section class="view" id="book"><div class="wrap"><div class="eyebrow">Your trip, your way</div><h1 class="title">Build a travel plan.</h1><p class="sub">Request a demo itinerary for flights, accommodation, a rental car, or a getaway package.</p><div class="two"><form id="bookingForm" class="panel"><h2>Trip details</h2><div class="formgrid"><label>Full name<input class="field" name="name" required></label><label>Email<input class="field" name="email" type="email" required></label></div><label>Destination<input class="field" name="destination" placeholder="City, country, or package" required></label><div class="formgrid"><label>Departure<input class="field" name="departure" type="date" required></label><label>Return<input class="field" name="return" type="date" required></label></div><div class="formgrid"><label>Travelers<input class="field" name="travelers" type="number" min="1" max="20" value="2" required></label><label>Travel option<select class="field" name="option"><option>Flight + hotel</option><option>Hotel only</option><option>Car rental</option><option>Vacation package</option></select></label></div><label>Preferences<textarea class="field" name="preferences" rows="3" placeholder="Optional interests or accessibility needs"></textarea></label><label><input type="checkbox" required> I understand this creates a demo itinerary request, not a confirmed booking.</label><button>Prepare demo itinerary</button><p id="bookingStatus" class="status"></p></form><div class="panel"><h2>Helpful before you go</h2><p class="sub">Check entry requirements, travel advisories, local transport, cancellation policies, and accommodation details through official and provider sources before booking a real trip.</p><div class="notice">This static website does not sell tickets, confirm availability, or process payment.</div><a class="btn outline" href="#guides">Read travel guides</a><div id="bookingSummary" style="margin-top:15px"></div></div></div></div></section>
<section class="view" id="my-trips"><div class="wrap"><div class="eyebrow">Your itinerary folder</div><h1 class="title">My demo trips.</h1><form id="tripLookup" class="toolbar"><input name="email" type="email" placeholder="Email used for your request" required><button>Find my trips</button></form><div id="myTripsList" class="panel"><p class="empty">Enter your email to find itineraries saved in this browser.</p></div></div></section>
<section class="view" id="guides"><div class="wrap"><div class="eyebrow">Ideas for the road</div><h1 class="title">A few useful travel notes.</h1><div class="grid"><article class="panel"><span class="chip">BEFORE YOU GO</span><h3>Build a flexible itinerary</h3><p class="sub">Keep the must-see moments, then leave some space for a slower afternoon or a local recommendation.</p></article><article class="panel"><span class="chip">PACKING</span><h3>Pack for your actual plans</h3><p class="sub">Check the forecast, think through your activities, and pack versatile layers you will reach for.</p></article><article class="panel"><span class="chip">LOCAL NOTES</span><h3>Travel with curiosity</h3><p class="sub">Learn a greeting, follow local guidance, respect the places you visit, and ask before taking photos.</p></article></div><div class="notice">Travel tips are general suggestions, not official or live safety guidance. Check current information for your destination.</div></div></section>
<section class="view" id="support"><div class="wrap"><div class="eyebrow">We're here to help</div><h1 class="title">Questions before or after a trip?</h1><div class="two"><div class="panel"><h2>Travel support</h2><p><a href="mailto:hello@wanderlust.example">hello@wanderlust.example</a></p><p><a href="tel:+15550106288">(555) 010-6288</a></p><p class="meta">Sample contact details for this travel website demonstration.</p><details><summary>Is this a real booking site?</summary><p class="sub">No. This is a standalone student demo. It does not check live inventory, issue tickets, or collect payment.</p></details><details><summary>Where are my demo itineraries saved?</summary><p class="sub">Bookings are stored in local browser storage on this device. They are not sent to an agency.</p></details><details><summary>Can I cancel a demo trip?</summary><p class="sub">You may remove a local itinerary from My Trips. Real trips must be managed directly with the relevant provider.</p></details></div><form id="supportForm" class="panel"><h2>Send a support message</h2><label>Your name<input class="field" name="name" required></label><label>Email<input class="field" name="email" type="email" required></label><label>Topic<select class="field" name="topic"><option>Trip planning</option><option>Booking question</option><option>Change or cancellation</option><option>Other</option></select></label><label>Message<textarea class="field" name="message" rows="4" required></textarea></label><button>Send demo message</button><p id="supportStatus" class="status"></p><p class="meta">This form displays a local confirmation only.</p></form></div></div></section>
</main><footer><div class="foot"><a class="brand" style="color:white" href="#home">wanderlust travels</a><span>Find your way. Take your time.</span><span>Experiment 24 · <a href="../Exp-23/BloodConnect.html">← BloodConnect</a> · <a href="../Exp-25/RoadsideAssist.html">Next: RoadReady →</a></span></div></footer><div class="toast" id="toast" role="status"></div>
<script>
const $=s=>document.querySelector(s),trips=[{id:"cinque-terre",name:"Coastal Villages of Liguria",place:"Italy",type:"Culture & heritage",days:5,price:780,description:"A gentle coastal escape with village walks, slow lunches, and train rides along the sea."},{id:"mountain",name:"Highland Lakes & Trails",place:"Scotland",type:"Nature & adventure",days:6,price:940,description:"A restorative highland stay with lakeside paths and a flexible outdoor itinerary."},{id:"jaipur",name:"A Weekend in the Pink City",place:"Jaipur, India",type:"City escape",days:3,price:320,description:"Explore historic architecture, bustling markets, and a thoughtful city guide."},{id:"bali",name:"Island Days in Bali",place:"Indonesia",type:"Beach retreat",days:7,price:1120,description:"A relaxed island stay with open days for the coast, local food, and exploring."},{id:"kyoto",name:"Quiet Corners of Kyoto",place:"Japan",type:"Culture & heritage",days:5,price:890,description:"Temples, neighborhood lanes, and time to discover the city at your own pace."},{id:"coast",name:"Blue Coast Road Trip",place:"Portugal",type:"Nature & adventure",days:4,price:650,description:"A flexible coastal route with room for quiet coves and small-town stops."}];
function load(){try{return JSON.parse(localStorage.getItem("wanderlust-bookings")||"[]")}catch{return[]}}function save(v){localStorage.setItem("wanderlust-bookings",JSON.stringify(v))}let bookings=load();
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}function money(n){return"₹"+Number(n).toLocaleString("en-IN")}function toast(s){const t=$("#toast");t.textContent=s;t.style.display="block";setTimeout(()=>t.style.display="none",2200)}
function tripCard(t){return `<article class="trip"><div class="trip-img" role="img" aria-label="${esc(t.place)} destination"></div><div class="trip-body"><span class="chip">${esc(t.type)}</span><h3>${esc(t.name)}</h3><div class="meta">${esc(t.place)} · ${t.days} days</div><p>${esc(t.description)}</p><div class="row"><b>From ${money(t.price)} / person</b><button data-plan="${t.id}">Plan this trip</button></div></div></article>`}
function renderTrips(){let list=[...trips],q=$("#search").value.trim().toLowerCase(),type=$("#kind").value;if(q)list=list.filter(x=>`${x.name} ${x.place} ${x.type} ${x.description}`.toLowerCase().includes(q));if(type)list=list.filter(x=>x.type===type);if($("#sort").value==="price")list.sort((a,b)=>a.price-b.price);$("#tripCount").textContent=`${list.length} getaway${list.length===1?"":"s"} to explore`;$("#tripList").innerHTML=list.length?list.map(tripCard).join(""):'<p class="empty">No destinations match. Try another search.</p>'}
function renderFeatured(){$("#featured").innerHTML=trips.slice(0,3).map(tripCard).join("")}
$("#search").addEventListener("input",renderTrips);$("#kind").addEventListener("change",renderTrips);$("#sort").addEventListener("change",renderTrips);
document.addEventListener("click",e=>{const b=e.target.closest("[data-plan]");if(b){const t=trips.find(x=>x.id===b.dataset.plan);location.hash="#book";$("#bookingForm").elements.destination.value=`${t.name}, ${t.place}`;$("#bookingSummary").innerHTML=`<div class="notice"><b>${esc(t.name)}</b><br>${esc(t.days)} days · From ${money(t.price)} per person<br>${esc(t.description)}</div>`}});
$("#bookingForm").elements.departure.min=new Date().toISOString().slice(0,10);
$("#bookingForm").elements.departure.addEventListener("change",e=>{$("#bookingForm").elements.return.min=e.target.value;if($("#bookingForm").elements.return.value<e.target.value)$("#bookingForm").elements.return.value=e.target.value});
$("#bookingForm").addEventListener("submit",e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target)),id="WL-"+Date.now().toString().slice(-7);if(d.return<d.departure){$("#bookingStatus").textContent="Return date must be on or after your departure date.";return}const b={...d,id,status:"Request saved",date:new Date().toLocaleDateString()};bookings.push(b);save(bookings);$("#bookingStatus").textContent=`Itinerary request ${id} saved in this browser. No booking or payment was made.`;$("#bookingSummary").innerHTML=`<div class="notice"><b>${esc(b.destination)}</b><br>${esc(b.option)} · ${esc(b.departure)} to ${esc(b.return)} · ${esc(b.travelers)} traveler(s)<br>Reference: ${esc(id)}<br>Status: ${esc(b.status)}</div>`;e.target.reset()});
$("#tripLookup").addEventListener("submit",e=>{e.preventDefault();const email=new FormData(e.target).get("email").trim().toLowerCase(),list=bookings.filter(b=>b.email.toLowerCase()===email);$("#myTripsList").innerHTML=list.length?`<div class="tablewrap"><table><thead><tr><th>Reference</th><th>Destination</th><th>Dates</th><th>Option</th><th>Status</th><th></th></tr></thead><tbody>${list.map(b=>`<tr><td>${esc(b.id)}</td><td>${esc(b.destination)}</td><td>${esc(b.departure)} – ${esc(b.return)}</td><td>${esc(b.option)}</td><td>${esc(b.status)}</td><td><button class="outline" data-cancel="${esc(b.id)}">Remove demo request</button></td></tr>`).join("")}</tbody></table></div>`:'<p class="empty">No demo trips found for that email address.</p>'});
document.addEventListener("click",e=>{const b=e.target.closest("[data-cancel]");if(!b)return;bookings=bookings.filter(x=>x.id!==b.dataset.cancel);save(bookings);$("#tripLookup").requestSubmit()});
$("#supportForm").addEventListener("submit",e=>{e.preventDefault();$("#supportStatus").textContent="Thanks for your message. This demo does not send information to a server.";e.target.reset()});
function route(){const id=location.hash.slice(1)||"home";if(!document.getElementById(id)?.classList.contains("view")){location.hash="#home";return}document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===id));window.scrollTo(0,0)}window.addEventListener("hashchange",route);renderFeatured();renderTrips();route();
</script></body></html>
