<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>GlowStudio Beauty Booking</title>
<style>
:root{--pink:#c65f85;--pale:#f9eaf0;--ink:#352831;--muted:#786b73;--line:#eadce3}*{box-sizing:border-box}body{margin:0;background:#fffaf8;color:var(--ink);font:16px Arial,sans-serif;line-height:1.5}header{background:#fff;position:sticky;top:0;border-bottom:1px solid var(--line);z-index:3}.nav,main{max-width:1100px;margin:auto;padding:16px 20px}.nav{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}.brand{font-size:1.35rem;font-weight:900}.brand span{color:var(--pink)}button{border:0;border-radius:10px;padding:10px 14px;font-weight:bold;cursor:pointer;background:var(--pale);color:#813e5a}button.primary{background:var(--pink);color:white}button.danger{background:#ffeded;color:#a32d38}.nav button{background:transparent;color:var(--muted);padding:9px}.nav button:hover{background:var(--pale)}main{padding-top:26px;padding-bottom:60px}.page.hidden,.hidden{display:none!important}.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:25px;align-items:center;padding:30px 0 42px}.eyebrow{color:var(--pink);text-transform:uppercase;letter-spacing:2px;font-size:.75rem;font-weight:bold}h1{font-size:clamp(2.4rem,5vw,4.2rem);line-height:1.06;margin:12px 0}h2{margin:0 0 8px}p{margin:8px 0 15px}.muted{color:var(--muted)}.hero-art{min-height:280px;border-radius:26px;background:linear-gradient(135deg,#f5d3e0,#fff0df,#d7a1b8);display:grid;place-items:center;font-size:100px}.actions,.row,.tabs{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.row{justify-content:space-between}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.card,.panel{background:white;border:1px solid var(--line);border-radius:17px;padding:18px;margin:14px 0;box-shadow:0 8px 28px #4926340a}.art{background:linear-gradient(135deg,#f8dce7,#fff0e5);height:105px;border-radius:12px;display:grid;place-items:center;font-size:45px}.price{font-weight:900;color:var(--pink);font-size:1.15rem}.pill{background:var(--pale);border-radius:30px;padding:4px 9px;font-size:.78rem}.filters{display:flex;gap:10px;flex-wrap:wrap;margin:16px 0}.filters input,.filters select{flex:1;min-width:150px}input,select,textarea{width:100%;border:1px solid #dfcdd5;border-radius:10px;padding:11px;background:#fffdfd;font:inherit}label{font-size:.9rem;font-weight:bold;display:block;margin-bottom:5px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.field.full{grid-column:1/-1}.field{min-width:0}.field input[type=checkbox]{width:auto}.notice{padding:12px;border-radius:10px;background:#f0f8f2;color:#285d43;margin:14px 0}.small{font-size:.86rem}.calendar{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}.calendar button{padding:9px 1px;background:#fff4f8;border:1px solid var(--line);color:var(--ink)}.calendar button:disabled{opacity:.3}.calendar button.selected{background:var(--pink);color:#fff}.calendar .weekday{background:transparent;border:0;color:var(--muted)}.reservation{border:1px solid var(--line);border-radius:12px;padding:13px;margin:10px 0}.status{font-size:.78rem;padding:4px 8px;border-radius:30px;background:#e8f6ed;color:#286247}.status.Cancelled{background:#ffeded;color:#a32d38}.status.Pending{background:#fff0d4;color:#8a5c13}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.stat{background:var(--pale);padding:13px;border-radius:12px}.stat b{display:block;font-size:1.5rem}.empty{text-align:center;padding:25px;color:var(--muted)}footer{text-align:center;padding:25px;background:white;border-top:1px solid var(--line);color:var(--muted)}#toast{position:fixed;bottom:18px;right:18px;background:var(--ink);color:white;padding:13px 17px;border-radius:12px;z-index:9;max-width:330px}
@media(max-width:720px){.hero{grid-template-columns:1fr}.hero-art{min-height:190px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.formgrid{grid-template-columns:1fr}.field.full{grid-column:auto}.nav{align-items:flex-start}.navlinks{display:flex;flex-wrap:wrap}.stats{grid-template-columns:1fr 1fr}}
@media(max-width:460px){.grid{grid-template-columns:1fr}main{padding:18px 13px 45px}.card,.panel{padding:14px}.hero-art{font-size:75px}.nav{padding:12px}}
</style></head><body>
<header><div class="nav"><div class="brand">Glow<span>Studio</span> ✦</div><div class="navlinks"><button onclick="go('home')">Home</button><button onclick="go('services')">Services</button><button onclick="go('book')">Book</button><button onclick="go('account')">My Account</button><button onclick="go('feedback')">Feedback</button><button onclick="go('manager')">Manager</button><button onclick="go('login')">Login</button></div></div></header>
<main>
<section id="home" class="page"><div class="hero"><div><div class="eyebrow">A little time for you</div><h1>Feel beautiful.<br><span style="color:var(--pink)">Book your moment.</span></h1><p class="muted">Explore beauty services, choose your favourite stylist, and book a date and time that works for you.</p><div class="actions"><button class="primary" onclick="go('services')">Explore services</button><button onclick="go('book')">Book appointment</button></div></div><div class="hero-art">💇🏻‍♀️ ✨ 💅</div></div><div class="row"><div><div class="eyebrow">Customer favourites</div><h2>Popular services</h2></div><button onclick="go('services')">View all</button></div><div id="featured" class="grid"></div></section>
<section id="services" class="page hidden"><div class="eyebrow">Our menu</div><h1 style="font-size:2.6rem">Beauty services</h1><p class="muted">Browse the menu and choose a service to reserve.</p><div class="filters"><input id="search" placeholder="Search services..." oninput="renderServices()"><select id="category" onchange="renderServices()"><option value="">All categories</option><option>Hair</option><option>Skin</option><option>Nails</option><option>Makeup</option><option>Spa</option></select><select id="sort" onchange="renderServices()"><option value="">Sort by</option><option value="low">Price: low to high</option><option value="high">Price: high to low</option></select></div><div id="serviceGrid" class="grid"></div></section>
<section id="book" class="page hidden"><div class="eyebrow">Reserve a slot</div><h1 style="font-size:2.6rem">Book an appointment</h1><p class="muted">Select a service, stylist, date and available time. Booking data is saved in this browser.</p><div class="panel"><form id="bookingForm"><div class="formgrid">
<div class="field"><label for="name">Full name *</label><input id="name" required></div><div class="field"><label for="email">Email *</label><input id="email" type="email" required></div><div class="field"><label for="phone">Phone number *</label><input id="phone" type="tel" required></div><div class="field"><label for="service">Service *</label><select id="service" required></select></div><div class="field"><label for="stylist">Stylist *</label><select id="stylist" required><option value="">Choose stylist</option><option>Aanya Sharma</option><option>Meera Reddy</option><option>Riya Kapoor</option></select></div><div class="field"><label for="date">Date *</label><input id="date" type="date" required></div><div class="field"><label for="time">Available time *</label><select id="time" required><option value="">Choose date and stylist first</option></select></div><div class="field"><label for="payment">Payment choice *</label><select id="payment"><option value="deposit">20% deposit (demo)</option><option value="full">Full payment (demo)</option><option value="salon">Pay at salon</option></select></div><div class="field full"><label for="notes">Notes / preferences</label><textarea id="notes" rows="3"></textarea></div><div class="field full"><label><input id="agree" type="checkbox" required> I confirm these details and agree to the salon's booking policy.</label></div></div><div id="amount" class="notice">Choose a service to see the price.</div><button class="primary">Confirm appointment</button></form></div>
<div class="panel"><h2>Reservations calendar</h2><p class="muted small">Choose a date below. Dates in the past are unavailable; booked dates show a count.</p><div class="row"><button onclick="monthChange(-1)">← Previous</button><b id="monthTitle"></b><button onclick="monthChange(1)">Next →</button></div><div id="calendar" class="calendar"></div></div></section>
<section id="account" class="page hidden"><div class="eyebrow">Your space</div><h1 style="font-size:2.6rem">My appointments</h1><div class="panel"><p class="muted">Enter the email used for your booking to view upcoming reservations and history.</p><div class="row"><input id="accountEmail" type="email" placeholder="Your booking email"><button class="primary" onclick="loadAccount()">Find appointments</button></div></div><div class="tabs"><button class="primary" onclick="accountTab('upcoming',this)">Upcoming</button><button onclick="accountTab('history',this)">History</button><button onclick="accountTab('personal',this)">Personal details</button></div><div id="accountResults"></div></section>
<section id="login" class="page hidden"><div class="eyebrow">Welcome back</div><h1 style="font-size:2.6rem">Customer login</h1><div class="panel" style="max-width:550px"><p class="muted">This demo uses your email to find bookings; it does not create secure server accounts.</p><form id="loginForm"><label>Email</label><input id="loginEmail" type="email" required><label style="margin-top:12px">Password (demo only)</label><input id="loginPassword" type="password" required><button class="primary" style="margin-top:15px">Continue</button></form><p class="small muted">You can also <button onclick="go('book')">make a booking</button> without logging in.</p></div></section>
<section id="feedback" class="page hidden"><div class="eyebrow">Help us improve</div><h1 style="font-size:2.6rem">Customer feedback</h1><div class="panel"><form id="feedbackForm"><div class="formgrid"><div class="field"><label>Your name</label><input id="fbName" required></div><div class="field"><label>Email</label><input id="fbEmail" type="email" required></div><div class="field"><label>Service</label><select id="fbService"></select></div><div class="field"><label>Rating</label><select id="rating"><option value="5">★★★★★ Excellent</option><option value="4">★★★★ Very good</option><option value="3">★★★ Good</option><option value="2">★★ Fair</option><option value="1">★ Needs improvement</option></select></div><div class="field full"><label>Your feedback</label><textarea id="fbMessage" required rows="4"></textarea></div></div><button class="primary" style="margin-top:14px">Submit feedback</button></form></div><div id="feedbackList"></div></section>
<section id="manager" class="page hidden"><div class="eyebrow">Staff workspace</div><h1 style="font-size:2.6rem">Salon manager</h1><div class="panel"><p class="muted">Demo credentials: username <b>manager</b>, password <b>glow123</b>.</p><form id="managerLogin" class="row"><input id="managerUser" placeholder="Username" required><input id="managerPass" type="password" placeholder="Password" required><button class="primary">Login</button></form><div id="managerTools" class="hidden"><div id="stats" class="stats"></div><div class="tabs"><button onclick="managerTab('reservations',this)">Reservations</button><button onclick="managerTab('calendar',this)">Calendar</button><button onclick="managerTab('services',this)">Manage services</button><button onclick="managerTab('feedback',this)">Feedback</button><button class="danger" onclick="managerLogout()">Logout</button></div><div id="managerContent"></div></div></div></section>
</main><footer><b>GlowStudio</b> · Beauty appointments made simple.<br><span class="small">Demo only: no real payments, SMS, calls, emails or reminders are sent.</span></footer><div id="toast" class="hidden"></div>
<script>
const defaults=[{id:1,name:"Signature Haircut",cat:"Hair",price:650,duration:45,icon:"✂️",desc:"A tailored cut and finish for your personal style."},{id:2,name:"Hair Styling",cat:"Hair",price:850,duration:60,icon:"💇‍♀️",desc:"Blow-dry, curls or a polished style."},{id:3,name:"Glow Facial",cat:"Skin",price:1200,duration:60,icon:"🧖‍♀️",desc:"A refreshing facial for a healthy-looking glow."},{id:4,name:"Manicure",cat:"Nails",price:450,duration:40,icon:"💅",desc:"Nail shaping, cuticle care and polish."},{id:5,name:"Party Makeup",cat:"Makeup",price:1800,duration:75,icon:"💄",desc:"A party-ready look tailored to you."},{id:6,name:"Relaxing Head Spa",cat:"Spa",price:950,duration:50,icon:"🌸",desc:"A calming scalp and head massage."},{id:7,name:"Pedicure",cat:"Nails",price:600,duration:45,icon:"🦶",desc:"Foot soak, nail care and a relaxing finish."},{id:8,name:"Bridal Makeup Trial",cat:"Makeup",price:2500,duration:90,icon:"👰",desc:"Explore your bridal look with a personal trial."},{id:9,name:"Skin Clean-up",cat:"Skin",price:700,duration:35,icon:"✨",desc:"A quick skin refresh."}];
const get=(k,d)=>{try{return JSON.parse(localStorage.getItem(k))??d}catch(e){return d}},$=id=>document.getElementById(id),money=n=>"₹"+Number(n).toLocaleString("en-IN");
let services=get("glow_services",defaults),bookings=get("glow_bookings",[]),feedback=get("glow_feedback",[]),mgr=false,tab="upcoming",mtab="reservations",month=new Date();month.setDate(1);
function save(){localStorage.setItem("glow_services",JSON.stringify(services));localStorage.setItem("glow_bookings",JSON.stringify(bookings));localStorage.setItem("glow_feedback",JSON.stringify(feedback))}
function esc(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function dateStr(d){return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0")}
function toast(s){let t=$("toast");t.textContent=s;t.classList.remove("hidden");setTimeout(()=>t.classList.add("hidden"),2600)}
function go(id){document.querySelectorAll(".page").forEach(p=>p.classList.add("hidden"));$(id).classList.remove("hidden");window.scrollTo(0,0);if(id==="services")renderServices();if(id==="book"){fillOptions();priceUpdate();renderCalendar()}if(id==="account")loadAccount();if(id==="feedback")renderFeedback();if(id==="manager"&&mgr)renderManager()}
function svc(id){return services.find(s=>String(s.id)===String(id))}
function card(s){return `<div class="card"><div class="art">${s.icon||"✦"}</div><p><span class="pill">${esc(s.cat)}</span> <span class="muted small">${s.duration} min</span></p><h3>${esc(s.name)}</h3><p class="muted small">${esc(s.desc)}</p><div class="row"><span class="price">${money(s.price)}</span><button class="primary" onclick="choose(${s.id})">Book</button></div></div>`}
function renderFeatured(){$("featured").innerHTML=services.slice(0,3).map(card).join("")}
function renderServices(){let q=($("search")?.value||"").toLowerCase(),cat=$("category")?.value||"",a=services.filter(s=>(s.name+" "+s.cat+" "+s.desc).toLowerCase().includes(q)&&(!cat||s.cat===cat));if($("sort")?.value==="low")a.sort((x,y)=>x.price-y.price);if($("sort")?.value==="high")a.sort((x,y)=>y.price-x.price);$("serviceGrid").innerHTML=a.length?a.map(card).join(""):'<div class="empty">No services match your search.</div>'}
function fillOptions(){let options=services.map(s=>`<option value="${s.id}">${esc(s.name)} — ${money(s.price)}</option>`).join("");$("service").innerHTML='<option value="">Choose service</option>'+options;$("fbService").innerHTML=options;$("date").min=dateStr(new Date());if(!$("date").value||$("date").value<$("date").min)$("date").value=$("date").min;updateTimes()}
function choose(id){go("book");$("service").value=String(id);priceUpdate()}
function taken(d,t,st){return bookings.some(b=>b.date===d&&b.time===t&&b.stylist===st&&b.status!=="Cancelled")}
function past(d,t){return new Date(d+"T"+t+":00").getTime()<=Date.now()}
function updateTimes(){if(!$("time"))return;let d=$("date").value,st=$("stylist").value,old=$("time").value,slots=["09:00","10:00","11:00","12:00","13:00","14:00","15:00","16:00","17:00","18:00"].filter(t=>d&&st&&!past(d,t)&&!taken(d,t,st));$("time").innerHTML=slots.length?'<option value="">Choose available time</option>'+slots.map(t=>`<option>${t}</option>`).join(""):'<option value="">No slots available</option>';if(slots.includes(old))$("time").value=old;renderCalendar()}
function priceUpdate(){let s=svc($("service").value);$("amount").innerHTML=s?`<b>${esc(s.name)}</b> · ${s.duration} minutes · <b>${money(s.price)}</b><br>20% deposit: ${money(Math.ceil(s.price*.2))} · Full amount: ${money(s.price)}`:"Choose a service to see the price.";updateTimes()}
function renderCalendar(){if(!$("calendar"))return;let y=month.getFullYear(),m=month.getMonth(),sel=$("date").value,st=$("stylist").value;$("monthTitle").textContent=month.toLocaleDateString("en-IN",{month:"long",year:"numeric"});let out=["Sun","Mon","Tue","Wed","Thu","Fri","Sat"].map(x=>`<button class="weekday" disabled>${x}</button>`).join(""),offset=new Date(y,m,1).getDay(),n=new Date(y,m+1,0).getDate(),today=dateStr(new Date());for(let i=0;i<offset;i++)out+="<span></span>";for(let d=1;d<=n;d++){let ds=dateStr(new Date(y,m,d)),count=bookings.filter(b=>b.date===ds&&b.status!=="Cancelled"&&(!st||b.stylist===st)).length;out+=`<button ${ds<today?"disabled":""} class="${ds===sel?"selected":""}" title="${count} bookings" onclick="pickDate('${ds}')">${d}${count?`<small style="display:block">${count}•</small>`:""}</button>`}$("calendar").innerHTML=out}
function pickDate(d){$("date").value=d;month=new Date(d+"T12:00:00");month.setDate(1);updateTimes()}
function monthChange(n){month.setMonth(month.getMonth()+n);renderCalendar()}
$("service").addEventListener("change",priceUpdate);$("date").addEventListener("change",()=>{if($("date").value){month=new Date($("date").value+"T12:00:00");month.setDate(1)}updateTimes()});$("stylist").addEventListener("change",updateTimes);
$("bookingForm").addEventListener("submit",e=>{e.preventDefault();let s=svc($("service").value),d=$("date").value,t=$("time").value,st=$("stylist").value;if(!s||!t||!st||d<$("date").min||past(d,t)||taken(d,t,st)){toast("Please choose a valid available appointment slot.");updateTimes();return}let mode=$("payment").value,paid=mode==="full"?s.price:mode==="deposit"?Math.ceil(s.price*.2):0,b={id:"GS"+Date.now().toString().slice(-8),name:$("name").value.trim(),email:$("email").value.trim().toLowerCase(),phone:$("phone").value.trim(),serviceId:s.id,serviceName:s.name,price:s.price,stylist:st,date:d,time:t,notes:$("notes").value.trim(),payment:mode,paid,status:mode==="salon"?"Confirmed":"Pending payment"};bookings.push(b);save();$("accountEmail").value=b.email;alert(`Appointment saved!\\nReference: ${b.id}\\n${s.name} with ${st}\\n${d} at ${t}\\nBalance: ${money(s.price-paid)}\\n\\nDemo only: no real payment or confirmation email was sent.`);e.target.reset();fillOptions();go("account")});
$("loginForm").addEventListener("submit",e=>{e.preventDefault();$("accountEmail").value=$("loginEmail").value.trim().toLowerCase();toast("Demo login successful.");go("account")});
function loadAccount(){renderAccount()}
function accountTab(t,btn){tab=t;document.querySelectorAll("#account .tabs button").forEach(b=>b.classList.remove("primary"));btn.classList.add("primary");renderAccount()}
function amount(b){return Number(b.price||svc(b.serviceId)?.price||0)}
function bookingCard(b,staff=false){let pastBooking=b.status==="Cancelled"||b.status==="Completed"||b.date<dateStr(new Date());return `<div class="reservation"><div class="row"><b>${esc(b.serviceName)}</b><span class="status ${b.status==="Cancelled"?"Cancelled":b.status==="Pending payment"?"Pending":""}">${esc(b.status)}</span></div><p class="muted small">Ref ${esc(b.id)} · ${esc(b.date)} at ${esc(b.time)} · ${esc(b.stylist)}</p><p class="small">${esc(b.name)} · ${esc(b.email)} · ${esc(b.phone)}</p><p class="small">Price ${money(amount(b))} · Paid ${money(b.paid||0)} · Balance ${money(Math.max(0,amount(b)-(b.paid||0)))}</p>${b.notes?`<p>${esc(b.notes)}</p>`:""}<div class="actions">${!pastBooking?`<button onclick="reschedule('${b.id}')">Reschedule</button><button class="danger" onclick="cancelBooking('${b.id}')">Cancel</button>`:""}${staff?`<button onclick="statusChange('${b.id}')">Change status</button><button onclick="contact('${b.id}')">SMS / call info</button>`:""}<button onclick="printOne('${b.id}')">Print</button></div></div>`}
function renderAccount(){let email=($("accountEmail").value||"").trim().toLowerCase(),a=bookings.filter(b=>b.email===email);if(!email){$("accountResults").innerHTML='<div class="empty">Enter your booking email to see appointments.</div>';return}if(tab==="personal"){$("accountResults").innerHTML=a.length?`<div class="panel"><h2>Personal details</h2><p>Name: ${esc(a[a.length-1].name)}</p><p>Email: ${esc(email)}</p><p>Phone: ${esc(a[a.length-1].phone)}</p><p class="muted small">For this demo, create a new booking to use updated contact details.</p></div>`:'<div class="empty">No customer details found.</div>';return}a=a.filter(b=>tab==="history"?(b.status==="Cancelled"||b.status==="Completed"||b.date<dateStr(new Date())):(b.status!=="Cancelled"&&b.status!=="Completed"&&b.date>=dateStr(new Date()))).sort((x,y)=>(x.date+x.time).localeCompare(y.date+y.time));$("accountResults").innerHTML=a.length?a.map(b=>bookingCard(b)).join(""):'<div class="empty">No appointments in this section.</div>'}
function cancelBooking(id){let b=bookings.find(x=>x.id===id);if(!b||!confirm("Cancel this appointment?"))return;b.status="Cancelled";save();renderAccount();renderCalendar();if(mgr)renderManager();toast("Appointment cancelled.")}
function reschedule(id){let b=bookings.find(x=>x.id===id);if(!b)return;b.status="Cancelled";save();go("book");$("name").value=b.name;$("email").value=b.email;$("phone").value=b.phone;$("service").value=String(b.serviceId);$("stylist").value=b.stylist;$("notes").value=b.notes||"";priceUpdate();toast("Select a new date and time, then confirm a new booking.")}
function printOne(id){let b=bookings.find(x=>x.id===id);if(!b)return;let w=window.open("","_blank");if(!w){toast("Allow pop-ups to print.");return}w.document.write(`<h1>GlowStudio appointment</h1><p>Reference: ${esc(b.id)}</p><p>${esc(b.name)} · ${esc(b.email)} · ${esc(b.phone)}</p><p>${esc(b.serviceName)} with ${esc(b.stylist)}</p><p>${esc(b.date)} at ${esc(b.time)}</p><p>Status: ${esc(b.status)}</p><p>Price: ${money(amount(b))}</p>`);w.document.close();w.print()}
$("feedbackForm").addEventListener("submit",e=>{e.preventDefault();feedback.push({name:$("fbName").value.trim(),email:$("fbEmail").value.trim(),service:$("fbService").selectedOptions[0]?.textContent||"",rating:+$("rating").value,message:$("fbMessage").value.trim(),date:dateStr(new Date())});save();e.target.reset();renderFeedback();toast("Thanks for your feedback!")});
function renderFeedback(){$("feedbackList").innerHTML=feedback.length?'<h2>Recent feedback</h2>'+feedback.slice().reverse().map(f=>`<div class="reservation"><div class="row"><b>${esc(f.name)}</b><span>${"★".repeat(f.rating)}${"☆".repeat(5-f.rating)}</span></div><p class="muted small">${esc(f.service)} · ${esc(f.date)}</p><p>${esc(f.message)}</p></div>`).join(""):'<div class="empty">No feedback submitted yet.</div>'}
$("managerLogin").addEventListener("submit",e=>{e.preventDefault();if($("managerUser").value==="manager"&&$("managerPass").value==="glow123"){mgr=true;$("managerTools").classList.remove("hidden");renderManager();toast("Manager tools opened.")}else toast("Incorrect manager username or password.")});
function managerLogout(){mgr=false;$("managerTools").classList.add("hidden");$("managerUser").value="";$("managerPass").value="";toast("Logged out.")}
function managerTab(t,btn){mtab=t;document.querySelectorAll("#manager .tabs button").forEach(b=>b.classList.remove("primary"));btn.classList.add("primary");renderManager()}
function renderManager(){if(!mgr)return;let today=dateStr(new Date()),up=bookings.filter(b=>b.date>=today&&b.status!=="Cancelled"&&b.status!=="Completed");$("stats").innerHTML=`<div class="stat">Upcoming<b>${up.length}</b></div><div class="stat">All bookings<b>${bookings.length}</b></div><div class="stat">Feedback<b>${feedback.length}</b></div>`;let c=$("managerContent");if(mtab==="reservations"){c.innerHTML='<div class="row"><h2>Reservations</h2><button onclick="exportCSV()">Export CSV</button></div>'+(bookings.length?bookings.slice().sort((a,b)=>(a.date+a.time).localeCompare(b.date+b.time)).map(b=>bookingCard(b,true)).join(""):'<div class="empty">No reservations yet.</div>')}else if(mtab==="calendar"){let dates={};bookings.filter(b=>b.status!=="Cancelled").forEach(b=>dates[b.date]=(dates[b.date]||0)+1);c.innerHTML='<h2>Reservation calendar</h2>'+Object.keys(dates).sort().map(d=>`<div class="reservation row"><b>${d}</b><span>${dates[d]} booking(s)</span><button onclick="showDate('${d}')">View</button></div>`).join("")||'<div class="empty">No bookings yet.</div>'}else if(mtab==="services"){c.innerHTML=`<h2>Manage services</h2><form id="serviceAdmin"><div class="formgrid"><div><label>Name</label><input id="sn" required></div><div><label>Category</label><select id="sc"><option>Hair</option><option>Skin</option><option>Nails</option><option>Makeup</option><option>Spa</option></select></div><div><label>Price (₹)</label><input id="sp" type="number" min="1" required></div><div><label>Duration (minutes)</label><input id="sd" type="number" min="10" value="45" required></div><div><label>Icon</label><input id="si" value="✦"></div><div><label>Description</label><input id="sdesc" required></div></div><button class="primary" style="margin-top:12px">Add service</button></form>`+services.map(s=>`<div class="reservation row"><span><b>${esc(s.icon)} ${esc(s.name)}</b><br>${money(s.price)} · ${s.duration} min</span><button class="danger" onclick="deleteService(${s.id})">Delete</button></div>`).join("");$("serviceAdmin").addEventListener("submit",e=>{e.preventDefault();services.push({id:Date.now(),name:$("sn").value.trim(),cat:$("sc").value,price:+$("sp").value,duration:+$("sd").value,icon:$("si").value,desc:$("sdesc").value.trim()});save();fillOptions();renderFeatured();renderServices();renderManager();toast("Service added.")})}else{c.innerHTML='<h2>Customer feedback</h2>'+(feedback.length?feedback.slice().reverse().map(f=>`<div class="reservation"><b>${esc(f.name)}</b> · ${"★".repeat(f.rating)}<p>${esc(f.message)}</p><small>${esc(f.email)} · ${esc(f.date)}</small></div>`).join(""):'<div class="empty">No feedback yet.</div>')}}
function statusChange(id){let b=bookings.find(x=>x.id===id),s=prompt("Enter status: Confirmed, Pending payment, Completed, or Cancelled",b.status);if(!s)return;if(!["Confirmed","Pending payment","Completed","Cancelled"].includes(s)){toast("Invalid status.");return}b.status=s;save();renderManager();renderAccount();renderCalendar();toast("Reservation updated.")}
function contact(id){let b=bookings.find(x=>x.id===id);alert(`Customer contact details\\n${b.name}\\nPhone: ${b.phone}\\nEmail: ${b.email}\\n\\nThis demo cannot send SMS or place calls.`)}
function showDate(d){mtab="reservations";renderManager();$("managerContent").innerHTML=`<h2>Bookings on ${d}</h2>`+bookings.filter(b=>b.date===d).map(b=>bookingCard(b,true)).join("")}
function deleteService(id){if(!confirm("Delete this service?"))return;services=services.filter(s=>s.id!==id);save();fillOptions();renderFeatured();renderServices();renderManager();toast("Service deleted.")}
function exportCSV(){let rows=[["Reference","Name","Email","Phone","Service","Stylist","Date","Time","Status","Price","Paid"],...bookings.map(b=>[b.id,b.name,b.email,b.phone,b.serviceName,b.stylist,b.date,b.time,b.status,amount(b),b.paid||0])],csv=rows.map(r=>r.map(x=>'"'+String(x??"").replace(/"/g,'""')+'"').join(",")).join("\r\n"),url=URL.createObjectURL(new Blob([csv],{type:"text/csv"})),a=document.createElement("a");a.href=url;a.download="glowstudio-reservations.csv";a.click();URL.revokeObjectURL(url)}
renderFeatured();fillOptions();renderServices();renderFeedback();
</script></body></html>
