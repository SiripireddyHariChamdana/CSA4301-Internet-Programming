<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>TechSavvy | Gadget Store</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f4f6fa;color:#243247}header{background:#14243b;color:white;padding:15px 5%;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.logo{font-size:23px;font-weight:800}.logo span{color:#65c5ff}nav{display:flex;gap:6px;flex-wrap:wrap}button{cursor:pointer;border:0;border-radius:6px;padding:10px 14px;font-weight:700;background:#2674b9;color:white}nav button{background:transparent;color:white;border:1px solid #52647b;font-size:13px}nav button:hover,nav button.active{background:#2674b9}.sub{background:#e7edf5;padding:9px 5%;display:flex;gap:7px;flex-wrap:wrap}.sub button{background:#fff;color:#244a70;border:1px solid #d2dce8;font-size:12px}main{max-width:1150px;margin:25px auto;padding:0 16px}.page{display:none}.page.active{display:block}.hero{background:linear-gradient(115deg,#14243b,#236eaa);padding:38px;border-radius:14px;color:white;margin-bottom:18px}.hero h1{font-size:34px;margin:0 0 10px}.hero p{max-width:700px;line-height:1.6;color:#e3effa}.card{background:white;border:1px solid #e1e7ef;border-radius:11px;padding:20px;margin-bottom:17px;box-shadow:0 4px 14px #1c34500a}h2{color:#1e456d;margin:0 0 16px}h3{margin:0 0 9px;color:#294e72}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.products{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.product{border:1px solid #e1e7ef;border-radius:10px;padding:15px;background:#fff}.emoji{font-size:48px;background:#eef4fa;text-align:center;padding:17px;border-radius:8px;margin-bottom:12px}.price{font-weight:800;color:#1769a6;font-size:19px}.muted{color:#718096;font-size:14px;line-height:1.5}.field{margin-bottom:13px}label{display:block;font-size:14px;font-weight:700;margin-bottom:6px}input,select,textarea{width:100%;padding:11px;border:1px solid #cbd5e1;border-radius:6px;font:inherit}textarea{min-height:80px}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.row>*{flex:1}.light{background:#e8f0f8;color:#244c73}.danger{background:#b23d49}.pill{display:inline-block;background:#e6f1fb;color:#246293;padding:4px 9px;border-radius:18px;font-size:12px;font-weight:700}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}table{width:100%;border-collapse:collapse;margin-top:12px}th,td{text-align:left;padding:10px;border-bottom:1px solid #e5eaf0;font-size:14px}th{background:#edf3f9;color:#2c5277}.notice{padding:12px;background:#eef5fb;border-radius:7px;margin-top:12px;font-size:14px}.empty{text-align:center;padding:25px;color:#77869a}.searchrow{display:grid;grid-template-columns:2fr 1fr 1fr;gap:10px;margin-bottom:15px}footer{text-align:center;color:#7b8798;padding:22px;font-size:13px}@media(max-width:750px){.grid,.products{grid-template-columns:1fr 1fr}.hero h1{font-size:27px}}@media(max-width:520px){.grid,.products,.searchrow{grid-template-columns:1fr}.hero{padding:24px}}
</style></head><body>
<header><div class="logo">Tech<span>Savvy</span> ⚡</div><nav><button class="active" onclick="go('home',this)">Home</button><button onclick="go('shop',this)">Shop</button><button onclick="go('cart',this)">Cart (<span id="cartCount">0</span>)</button><button onclick="go('orders',this)">My Orders</button><button onclick="go('login',this)">Login</button></nav></header>
<div class="sub"><button onclick="go('wishlist')">♡ Wishlist</button><button onclick="go('deals')">Special Offers</button><button onclick="go('orderStatus')">Track Order</button><button onclick="go('about')">About Us</button><button onclick="go('contact')">Contact</button><button onclick="go('adminLogin')">Admin</button></div>
<main>
<section id="home" class="page active"><div class="hero"><span class="pill">Latest gadgets · Great deals</span><h1>Upgrade Your Everyday.</h1><p>Discover smartphones, laptops, tablets and accessories at TechSavvy. Browse popular categories, compare product details and shop your favourites.</p><div class="actions"><button onclick="go('shop')">Explore Products</button><button class="light" onclick="go('deals')">View Offers</button></div></div><div class="card"><h2>Shop by Category</h2><div class="grid"><div class="product"><div class="emoji">📱</div><h3>Smartphones</h3><button onclick="categoryShop('Smartphones')">Explore</button></div><div class="product"><div class="emoji">💻</div><h3>Laptops</h3><button onclick="categoryShop('Laptops')">Explore</button></div><div class="product"><div class="emoji">📟</div><h3>Tablets</h3><button onclick="categoryShop('Tablets')">Explore</button></div><div class="product"><div class="emoji">🎧</div><h3>Accessories</h3><button onclick="categoryShop('Accessories')">Explore</button></div><div class="product"><div class="emoji">⌚</div><h3>Wearables</h3><button onclick="categoryShop('Wearables')">Explore</button></div><div class="product"><div class="emoji">🔥</div><h3>Popular Deals</h3><button onclick="go('deals')">View Deals</button></div></div></div><div class="card"><h2>Popular Products</h2><div id="homeProducts" class="products"></div></div></section>
<section id="shop" class="page"><div class="card"><h2>Online Gadget Store</h2><div class="searchrow"><input id="searchBox" placeholder="Search products..." oninput="renderShop()"><select id="catFilter" onchange="renderShop()"><option value="">All Categories</option><option>Smartphones</option><option>Laptops</option><option>Tablets</option><option>Accessories</option><option>Wearables</option></select><select id="sortFilter" onchange="renderShop()"><option value="">Sort by</option><option value="low">Price: Low to High</option><option value="high">Price: High to Low</option></select></div><div id="shopProducts" class="products"></div></div></section>
<section id="details" class="page"><div class="card" id="productDetails"></div></section>
<section id="login" class="page"><div class="card"><h2>Customer Login</h2><form onsubmit="loginCustomer(event)"><div class="field"><label>Email</label><input id="loginEmail" type="email" required></div><div class="field"><label>Password</label><input id="loginPassword" type="password" required></div><button>Login</button></form><p class="muted">Demo login: customer@demo.com / demo123</p><button class="light" onclick="go('register')">Create Account</button></div></section>
<section id="register" class="page"><div class="card"><h2>Customer Registration</h2><form onsubmit="registerCustomer(event)"><div class="grid"><div class="field"><label>Full Name</label><input id="regName" required></div><div class="field"><label>Email</label><input id="regEmail" type="email" required></div><div class="field"><label>Phone</label><input id="regPhone" required></div></div><div class="field"><label>Password</label><input id="regPassword" type="password" required></div><button>Create Account</button></form></div></section>
<section id="cart" class="page"><div class="card"><h2>Shopping Cart</h2><div id="cartItems"></div><div id="cartTotal"></div><div class="actions"><button onclick="go('shop')">Continue Shopping</button><button onclick="go('checkout')">Proceed to Checkout</button></div></div></section>
<section id="checkout" class="page"><div class="card"><h2>Checkout</h2><form onsubmit="checkout(event)"><div class="grid"><div class="field"><label>Customer Name</label><input id="checkoutName" required></div><div class="field"><label>Email</label><input id="checkoutEmail" type="email" required></div><div class="field"><label>Phone</label><input id="checkoutPhone" required></div></div><div class="field"><label>Delivery Address</label><textarea id="checkoutAddress" required></textarea></div><div class="field"><label>Payment Method</label><select id="paymentMethod"><option>Cash on Delivery</option><option>UPI (Demo)</option><option>Credit / Debit Card (Demo)</option><option>Net Banking (Demo)</option></select></div><div id="checkoutSummary" class="notice"></div><button>Place Order</button></form></div></section>
<section id="orders" class="page"><div class="card"><h2>My Order History</h2><div id="orderHistory"></div></div></section>
<section id="orderStatus" class="page"><div class="card"><h2>Check Order Status</h2><form onsubmit="trackOrder(event)"><div class="field"><label>Order ID</label><input id="trackId" required placeholder="Enter order ID"></div><button>Track Order</button></form><div id="trackingResult"></div></div></section>
<section id="wishlist" class="page"><div class="card"><h2>My Wishlist</h2><div id="wishItems" class="products"></div></div></section>
<section id="deals" class="page"><div class="card"><h2>Special Offers & Promotions</h2><p class="muted">Explore selected gadgets with special online prices.</p><div id="dealProducts" class="products"></div></div></section>
<section id="about" class="page"><div class="card"><h2>About TechSavvy</h2><p>TechSavvy is an online electronics store offering a convenient way to discover and purchase modern gadgets. Our catalogue includes smartphones, laptops, tablets, wearables and accessories.</p><h3>Our Mission</h3><p class="muted">To make technology accessible through clear product information, easy shopping and helpful customer support.</p></div></section>
<section id="contact" class="page"><div class="card"><h2>Contact Us</h2><p class="muted">Email: support@techsavvy.demo · Phone: +91 98765 43210</p><form onsubmit="event.preventDefault();alert('Thank you. Your message has been recorded in this demo.');this.reset()"><div class="field"><label>Name</label><input required></div><div class="field"><label>Email</label><input type="email" required></div><div class="field"><label>Message</label><textarea required></textarea></div><button>Send Message</button></form></div></section>
<section id="adminLogin" class="page"><div class="card"><h2>Administrator Login</h2><form onsubmit="adminLogin(event)"><div class="field"><label>Username</label><input id="adminUser" required></div><div class="field"><label>Password</label><input id="adminPassword" type="password" required></div><button>Login</button></form><p class="muted">Demo admin: admin / admin123</p></div></section>
<section id="admin" class="page"><div class="card"><h2>Admin Dashboard</h2><div class="grid"><div class="product"><h3>Products</h3><div id="adminProductCount" class="price"></div></div><div class="product"><h3>Orders</h3><div id="adminOrderCount" class="price"></div></div><div class="product"><h3>Customers</h3><div id="adminCustomerCount" class="price"></div></div></div><div class="actions"><button onclick="go('manageProducts')">Manage Products</button><button onclick="go('manageOrders')">Manage Orders</button></div></div></section>
<section id="manageProducts" class="page"><div class="card"><h2>Add / Update Product</h2><form onsubmit="saveProduct(event)"><input type="hidden" id="editId"><div class="grid"><div class="field"><label>Product Name</label><input id="pName" required></div><div class="field"><label>Category</label><select id="pCategory"><option>Smartphones</option><option>Laptops</option><option>Tablets</option><option>Accessories</option><option>Wearables</option></select></div><div class="field"><label>Subcategory</label><input id="pSubcategory" placeholder="e.g. Android, Gaming, Audio"></div><div class="field"><label>Price (₹)</label><input id="pPrice" type="number" min="1" required></div><div class="field"><label>Stock Quantity</label><input id="pStock" type="number" min="0" required></div><div class="field"><label>Product Icon / Emoji</label><input id="pIcon" placeholder="📱"></div></div><div class="field"><label>Description</label><textarea id="pDescription" required></textarea></div><button>Save Product</button></form><h3 style="margin-top:24px">Current Catalogue</h3><div id="adminProducts"></div></div></section>
<section id="manageOrders" class="page"><div class="card"><h2>Manage Customer Orders</h2><div id="adminOrders"></div></div></section>
</main><footer>TechSavvy Online Gadget Store · Single-file website demonstration</footer>
<script>
const seed=[{id:1,name:'Nova X Smartphone',cat:'Smartphones',sub:'Android Phones',price:24999,stock:12,icon:'📱',desc:'A powerful smartphone with a bright display, capable camera and all-day battery.',deal:true},{id:2,name:'ProBook 15 Laptop',cat:'Laptops',sub:'Everyday Laptops',price:58999,stock:7,icon:'💻',desc:'A versatile laptop for study, office work and entertainment.',deal:true},{id:3,name:'TabPlus 10 Tablet',cat:'Tablets',sub:'Android Tablets',price:18999,stock:9,icon:'📟',desc:'A lightweight tablet for reading, streaming and productivity.'},{id:4,name:'Wireless Headphones',cat:'Accessories',sub:'Audio',price:2999,stock:25,icon:'🎧',desc:'Comfortable wireless headphones with clear sound.',deal:true},{id:5,name:'Smart Watch S',cat:'Wearables',sub:'Smart Watches',price:4499,stock:15,icon:'⌚',desc:'Track daily activity and receive notifications from your wrist.'},{id:6,name:'USB-C Fast Charger',cat:'Accessories',sub:'Chargers',price:999,stock:30,icon:'🔌',desc:'Compact fast charger for compatible devices.'}];
let db;try{db=JSON.parse(localStorage.getItem('techSavvyDB'))||{products:seed,customers:[{name:'Demo Customer',email:'customer@demo.com',phone:'9999999999',password:'demo123'}],orders:[]}}catch(e){db={products:seed,customers:[],orders:[]}}
let user=null,cart=[],wishlist=[],selected=null;
function persist(){localStorage.setItem('techSavvyDB',JSON.stringify(db))}
function money(n){return '₹'+Number(n).toLocaleString('en-IN')}
function go(id,btn){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));document.getElementById(id)?.classList.add('active');document.querySelectorAll('nav button').forEach(x=>x.classList.remove('active'));if(btn)btn.classList.add('active');window.scrollTo(0,0);if(id==='shop')renderShop();if(id==='cart')renderCart();if(id==='orders')renderOrders();if(id==='wishlist')renderWishlist();if(id==='deals')renderDeals();if(id==='admin')renderAdmin();if(id==='manageProducts')renderAdminProducts();if(id==='manageOrders')renderAdminOrders();if(id==='checkout')renderCheckout()}
function productCard(p){return `<div class="product"><div class="emoji">${p.icon||'📦'}</div><span class="pill">${p.cat}</span><h3>${p.name}</h3><p class="muted">${p.sub||''}</p><div class="price">${money(p.price)}</div><p class="muted">${p.stock>0?'In stock: '+p.stock:'Out of stock'}</p><div class="actions"><button onclick="viewProduct(${p.id})">Details</button><button class="light" onclick="addCart(${p.id})">Add to Cart</button><button class="light" onclick="toggleWish(${p.id})">♡</button></div></div>`}
function renderHome(){homeProducts.innerHTML=db.products.slice(0,3).map(productCard).join('')}
function renderShop(){let q=(searchBox.value||'').toLowerCase(),cat=catFilter.value,arr=db.products.filter(p=>(!cat||p.cat===cat)&&(`${p.name} ${p.cat} ${p.sub} ${p.desc}`.toLowerCase().includes(q)));if(sortFilter.value==='low')arr.sort((a,b)=>a.price-b.price);if(sortFilter.value==='high')arr.sort((a,b)=>b.price-a.price);shopProducts.innerHTML=arr.length?arr.map(productCard).join(''):'<div class="empty">No matching products found.</div>'}
function categoryShop(c){go('shop');catFilter.value=c;renderShop()}
function viewProduct(id){selected=id;let p=db.products.find(x=>x.id===id);productDetails.innerHTML=`<div class="emoji">${p.icon}</div><span class="pill">${p.cat} · ${p.sub}</span><h2 style="margin-top:12px">${p.name}</h2><div class="price">${money(p.price)}</div><p>${p.desc}</p><p class="muted">Availability: ${p.stock>0?p.stock+' units in stock':'Currently unavailable'}</p><h3>Customer Reviews</h3><p class="muted">★★★★☆ Customer feedback: Good product quality and value for money.</p><div class="actions"><button onclick="addCart(${p.id})">Add to Cart</button><button class="light" onclick="toggleWish(${p.id})">Add to Wishlist</button><button class="light" onclick="go('shop')">Back to Shop</button></div>`;go('details')}
function addCart(id){let p=db.products.find(x=>x.id===id);if(!p||p.stock<1){alert('Product is out of stock.');return}let item=cart.find(x=>x.id===id);if(item){if(item.qty>=p.stock){alert('Maximum available stock reached.');return}item.qty++}else cart.push({id,qty:1});updateCount();alert('Item added to cart.')}
function updateCount(){cartCount.textContent=cart.reduce((s,x)=>s+x.qty,0)}
function renderCart(){if(!cart.length){cartItems.innerHTML='<div class="empty">Your cart is empty.</div>';cartTotal.innerHTML='';return}cartItems.innerHTML=`<table><tr><th>Item</th><th>Price</th><th>Quantity</th><th>Total</th><th>Action</th></tr>${cart.map(x=>{let p=db.products.find(z=>z.id===x.id);return `<tr><td>${p?.name||'Product'}</td><td>${money(p?.price||0)}</td><td><button class="light" onclick="changeQty(${x.id},-1)">−</button> ${x.qty} <button class="light" onclick="changeQty(${x.id},1)">+</button></td><td>${money((p?.price||0)*x.qty)}</td><td><button class="danger" onclick="removeCart(${x.id})">Remove</button></td></tr>`}).join('')}</table>`;cartTotal=`<h3>Cart Total: ${money(cart.reduce((s,x)=>s+(db.products.find(p=>p.id===x.id)?.price||0)*x.qty,0))}</h3>`}
function changeQty(id,n){let x=cart.find(z=>z.id===id),p=db.products.find(z=>z.id===id);if(!x)return;if(x.qty+n<1){removeCart(id);return}if(x.qty+n>p.stock){alert('Not enough stock.');return}x.qty+=n;renderCart();updateCount()}
function removeCart(id){cart=cart.filter(x=>x.id!==id);renderCart();updateCount()}
function checkout(e){e.preventDefault();if(!cart.length){alert('Your cart is empty.');go('shop');return}for(let x of cart){let p=db.products.find(z=>z.id===x.id);if(!p||p.stock<x.qty){alert('Stock changed. Please update your cart.');return}}let order={id:'TS'+Date.now().toString().slice(-8),customer:checkoutName.value,email:checkoutEmail.value,phone:checkoutPhone.value,address:checkoutAddress.value,payment:paymentMethod.value,items:cart.map(x=>({...x})),total:cart.reduce((s,x)=>s+db.products.find(p=>p.id===x.id).price*x.qty,0),status:'Order Placed',date:new Date().toLocaleDateString('en-IN')};cart.forEach(x=>db.products.find(p=>p.id===x.id).stock-=x.qty);db.orders.push(order);persist();cart=[];updateCount();alert('Order placed! Your Order ID is '+order.id);trackingResult.innerHTML='';trackId.value=order.id;go('orders')}
function renderCheckout(){let total=cart.reduce((s,x)=>s+(db.products.find(p=>p.id===x.id)?.price||0)*x.qty,0);checkoutSummary.textContent='Order total: '+money(total);if(user){checkoutName.value=user.name;checkoutEmail.value=user.email;checkoutPhone.value=user.phone||''}}
function loginCustomer(e){e.preventDefault();let c=db.customers.find(x=>x.email===loginEmail.value&&x.password===loginPassword.value);if(!c){alert('Invalid login details.');return}user=c;alert('Login successful.');go('home')}
function registerCustomer(e){e.preventDefault();if(db.customers.some(c=>c.email===regEmail.value)){alert('Email already registered.');return}let c={name:regName.value,email:regEmail.value,phone:regPhone.value,password:regPassword.value};db.customers.push(c);persist();user=c;alert('Registration successful.');go('home')}
function renderOrders(){let arr=db.orders.filter(o=>!user||o.email===user.email);orderHistory.innerHTML=arr.length?`<table><tr><th>Order ID</th><th>Date</th><th>Total</th><th>Status</th><th>Action</th></tr>${arr.map(o=>`<tr><td>${o.id}</td><td>${o.date}</td><td>${money(o.total)}</td><td>${o.status}</td><td><button onclick="showTrack('${o.id}')">Track</button></td></tr>`).join('')}</table>`:'<p class="empty">No orders found. Login to view your order history.</p>'}
function showTrack(id){trackId.value=id;go('orderStatus');trackOrder({preventDefault(){}})}
function trackOrder(e){e.preventDefault();let o=db.orders.find(x=>x.id===trackId.value.trim());trackingResult.innerHTML=o?`<div class="notice"><h3>Order ${o.id}</h3><p>Status: <b>${o.status}</b></p><p>Order date: ${o.date} · Total: ${money(o.total)}</p><p>Items: ${o.items.map(i=>db.products.find(p=>p.id===i.id)?.name+' × '+i.qty).join(', ')}</p></div>`:'<p class="notice">Order not found. Please check the order ID.</p>'}
function toggleWish(id){if(wishlist.includes(id))wishlist=wishlist.filter(x=>x!==id);else wishlist.push(id);alert('Wishlist updated.')}
function renderWishlist(){wishItems.innerHTML=wishlist.length?wishlist.map(id=>db.products.find(p=>p.id===id)).filter(Boolean).map(productCard).join(''):'<p class="empty">Your wishlist is empty.</p>'}
function renderDeals(){dealProducts.innerHTML=db.products.filter(p=>p.deal).map(productCard).join('')||'<p>No offers currently available.</p>'}
function adminLogin(e){e.preventDefault();if(adminUser.value==='admin'&&adminPassword.value==='admin123'){alert('Admin login successful.');go('admin')}else alert('Invalid admin credentials.')}
function renderAdmin(){adminProductCount.textContent=db.products.length;adminOrderCount.textContent=db.orders.length;adminCustomerCount.textContent=db.customers.length}
function saveProduct(e){e.preventDefault();let id=Number(editId.value);let data={name:pName.value,cat:pCategory.value,sub:pSubcategory.value,price:Number(pPrice.value),stock:Number(pStock.value),icon:pIcon.value||'📦',desc:pDescription.value};if(id){Object.assign(db.products.find(p=>p.id===id),data)}else{data.id=Math.max(0,...db.products.map(p=>p.id))+1;db.products.push(data)}persist();e.target.reset();editId.value='';renderAdminProducts();renderHome();alert('Product saved successfully.')}
function renderAdminProducts(){adminProducts.innerHTML=`<table><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr>${db.products.map(p=>`<tr><td>${p.name}</td><td>${p.cat}</td><td>${money(p.price)}</td><td>${p.stock}</td><td><button class="light" onclick="editProduct(${p.id})">Edit</button> <button class="danger" onclick="deleteProduct(${p.id})">Delete</button></td></tr>`).join('')}</table>`}
function editProduct(id){let p=db.products.find(x=>x.id===id);editId.value=p.id;pName.value=p.name;pCategory.value=p.cat;pSubcategory.value=p.sub;pPrice.value=p.price;pStock.value=p.stock;pIcon.value=p.icon;pDescription.value=p.desc;window.scrollTo(0,0)}
function deleteProduct(id){if(confirm('Remove this product from the catalogue?')){db.products=db.products.filter(p=>p.id!==id);persist();renderAdminProducts();renderHome()}}
function renderAdminOrders(){adminOrders.innerHTML=db.orders.length?`<table><tr><th>Order ID</th><th>Customer</th><th>Total</th><th>Status</th><th>Update</th></tr>${db.orders.map(o=>`<tr><td>${o.id}</td><td>${o.customer}</td><td>${money(o.total)}</td><td>${o.status}</td><td><select onchange="updateOrder('${o.id}',this.value)"><option ${o.status==='Order Placed'?'selected':''}>Order Placed</option><option ${o.status==='Processing'?'selected':''}>Processing</option><option ${o.status==='Shipped'?'selected':''}>Shipped</option><option ${o.status==='Delivered'?'selected':''}>Delivered</option><option ${o.status==='Cancelled'?'selected':''}>Cancelled</option></select></td></tr>`).join('')}</table>`:'<p class="empty">No customer orders yet.</p>'}
function updateOrder(id,status){let o=db.orders.find(x=>x.id===id);if(o){o.status=status;persist();renderAdminOrders()}}
renderHome();updateCount();
</script></body></html>
