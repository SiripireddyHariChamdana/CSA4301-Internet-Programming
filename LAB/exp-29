<script>
const $=s=>document.querySelector(s);function load(){try{return JSON.parse(localStorage.getItem("creativefutures-attendees")||"[]")}catch{return[]}}function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
$("#registerForm").addEventListener("submit",e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target)),attendees=load(),registration={...d,id:"CF-"+Date.now().toString().slice(-7),date:new Date().toLocaleString()};attendees.push(registration);localStorage.setItem("creativefutures-attendees",JSON.stringify(attendees));$("#registerStatus").textContent="Registration complete. Your local demo ticket is ready.";$("#ticket").hidden=false;$("#ticket").innerHTML=`<div class="eyebrow">Creative Futures · Demo attendee ticket</div><h3>${esc(registration.name)}</h3><p>${esc(registration.ticket)}</p><p>Saturday, October 16, 2027 · Foundry Hall, Bengaluru</p><p>Registration ID: <b>${esc(registration.id)}</b></p><p class="meta">This is not a paid or official event ticket.</p><button type="button" class="darkoutline" id="printTicket">Print demo ticket</button>`;e.target.reset()});
$("#ticket").addEventListener("click",e=>{if(e.target.id==="printTicket")window.print()});
function route(){const id=location.hash.slice(1)||"home";if(!document.getElementById(id)?.classList.contains("view")){location.hash="#home";return}document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===id));window.scrollTo(0,0)}window.addEventListener("hashchange",route);route();
</script></body></html>
