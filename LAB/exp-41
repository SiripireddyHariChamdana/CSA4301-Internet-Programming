<style>
:root{--ink:#28342c;--muted:#758078;--paper:#fbfaf6;--bg:#f4f2eb;--green:#365d48;--pale:#e7efe4;--orange:#c8794c;--line:#e6e3da;--serif:Georgia,"Times New Roman",serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.65 Arial,sans-serif}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button,.btn{border:0;border-radius:4px;padding:11px 15px;background:var(--green);color:white;cursor:pointer;font-weight:bold;display:inline-block}button:hover,.btn:hover{background:#244834}.outline{background:transparent;color:var(--green);border:1px solid var(--green)}.soft{background:var(--pale);color:var(--green)}header{position:sticky;top:0;z-index:5;background:#fbfaf6ed;backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}nav,.wrap{max-width:1160px;margin:auto}nav{padding:13px 22px;min-height:70px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{font:700 23px var(--serif);color:var(--green)}.brand span{color:var(--orange)}.links{display:flex;align-items:center;gap:18px;flex-wrap:wrap}.links a{font-size:13px;font-weight:bold;color:#526257}.links a:hover{color:var(--orange)}.badge{background:var(--pale);padding:3px 8px;border-radius:16px}.view{display:none;min-height:70vh}.view.active{display:block}.hero{max-width:1160px;margin:18px auto 0;border-radius:8px;min-height:400px;background:linear-gradient(90deg,#1d3429de,#1d342945),url('https://images.unsplash.com/photo-1490645935967-10de6ba17061?auto=format&fit=crop&w=1800&q=85') center/cover;color:#fff;display:flex;align-items:center}.hero-copy{max-width:630px;padding:52px 7%}.eyebrow{text-transform:uppercase;letter-spacing:2px;color:var(--orange);font-size:11px;font-weight:bold}.hero .eyebrow{color:#e5c494}.hero h1{font:500 clamp(43px,7vw,73px)/1.02 var(--serif);margin:14px 0}.hero p{max-width:510px;color:#f0eee7}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.hero .outline{color:white;border-color:white}.wrap{padding:45px 22px}.title{font:500 clamp(30px,4.5vw,47px)/1.12 var(--serif);margin:7px 0}.sub{color:var(--muted);max-width:720px}.row{display:flex;align-items:end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:20px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.recipe{background:var(--paper);border:1px solid var(--line);border-radius:7px;overflow:hidden}.food-photo{height:190px;background-position:center;background-size:cover;position:relative}.recipe:nth-child(1) .food-photo{background-image:url('https://images.unsplash.com/photo-1476224203421-9ac39bcb3327?auto=format&fit=crop&w=900&q=82')}.recipe:nth-child(2) .food-photo{background-image:url('https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=900&q=82')}.recipe:nth-child(3) .food-photo{background-image:url('https://images.unsplash.com/photo-1490645935967-10de6ba17061?auto=format&fit=crop&w=900&q=82')}.recipe:nth-child(4) .food-photo{background-image:url('https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=900&q=82')}.recipe:nth-child(5) .food-photo{background-image:url('https://images.unsplash.com/photo-1473093295043-cdd812d0e601?auto=format&fit=crop&w=900&q=82')}.recipe:nth-child(6) .food-photo{background-image:url('https://images.unsplash.com/photo-1488477181946-6428a0291777?auto=format&fit=crop&w=900&q=82')}.favorite{position:absolute;top:10px;right:10px;border-radius:50%;width:38px;height:38px;padding:0;background:#fff;color:#44544a;font-size:19px}.favorite.on{color:#bf5646}.recipe-body{padding:15px}.recipe-body h3{font:500 22px var(--serif);margin:4px 0}.meta{font-size:12px;color:var(--muted)}.recipe-bottom{display:flex;justify-content:space-between;align-items:center;margin-top:12px}.recipe-bottom button{padding:8px 11px;font-size:12px}.toolbar{display:flex;gap:9px;flex-wrap:wrap;margin:20px 0}.field{width:100%;padding:11px 12px;border:1px solid #dcd9cf;border-radius:4px;background:white;color:var(--ink);margin-top:5px}label{display:block;font-size:13px;font-weight:bold;margin:10px 0}.toolbar input{flex:1;min-width:190px}.toolbar select{min-width:145px}.two{display:grid;grid-template-columns:1fr 1fr;gap:20px}.panel{background:var(--paper);border:1px solid var(--line);border-radius:7px;padding:21px}.chips{display:flex;gap:7px;flex-wrap:wrap}.chip{background:var(--pale);color:var(--green);padding:4px 9px;border-radius:18px;font-size:12px}.steps{padding-left:22px}.steps li{padding:4px 0}.ingredient{display:flex;gap:10px;padding:5px 0;border-bottom:1px solid var(--line)}.ingredient input{width:auto}.serving-control{display:flex;align-items:center;gap:10px;margin:12px 0}.serving-control button{padding:6px 11px}.planner-row{display:grid;grid-template-columns:130px 1fr auto;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}.list-item{display:flex;gap:9px;align-items:center;padding:8px 0;border-bottom:1px solid var(--line)}.notice{background:#eef3eb;border-left:3px solid var(--green);padding:12px;margin:12px 0}.toast{position:fixed;right:20px;bottom:20px;background:#233e30;color:white;padding:12px 16px;border-radius:5px;display:none;z-index:10}.modal{position:fixed;inset:0;background:#17231ccc;display:none;place-items:center;z-index:11;padding:18px}.modal.open{display:grid}.modal-card{max-width:540px;width:100%;max-height:90vh;overflow:auto;background:var(--paper);padding:22px;border-radius:8px}.rating{display:flex;gap:6px}.rating button{background:transparent;color:#c58b32;padding:2px;font-size:24px}.comment{padding:10px 0;border-bottom:1px solid var(--line)}footer{background:#244333;color:#f4f2e8;padding:22px}.foot{max-width:1160px;margin:auto;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}.foot a{text-decoration:underline;text-underline-offset:3px}.empty{color:var(--muted);padding:18px}@media(max-width:760px){.grid{grid-template-columns:repeat(2,1fr)}.two{grid-template-columns:1fr}.hero{min-height:360px}.links{gap:11px}}@media(max-width:550px){nav{align-items:flex-start;flex-direction:column}.grid{grid-template-columns:1fr}.wrap{padding:35px 17px}.hero{margin:10px;min-height:340px}.planner-row{grid-template-columns:90px 1fr}.planner-row button{grid-column:2}}
</style>
