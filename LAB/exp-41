<body>
<header><nav><a class="brand" href="#home">gather <span>&amp;</span> grain</a><div class="links"><a href="#home">Home</a><a href="#recipes">Recipes</a><a href="#planner">Meal planner</a><a href="#shopping">Shopping list <span class="badge" id="listCount">0</span></a><a href="#community">Community</a></div></nav></header>
<main>
<section class="view" id="home"><div class="hero"><div class="hero-copy"><div class="eyebrow">Good food, shared generously</div><h1>A little inspiration for your table.</h1><p>Browse recipes made for real kitchens, save the ones you love, and make a plan for the week ahead.</p><div class="actions"><a class="btn" href="#recipes">Find a recipe</a><a class="btn outline" href="#planner">Plan this week</a></div></div></div><div class="wrap"><div class="row"><div><div class="eyebrow">Loved by home cooks</div><h2 class="title">Popular this week</h2></div><a class="btn outline" href="#recipes">Browse every recipe</a></div><div class="grid" id="featured"></div></div><div class="wrap" style="padding-top:0"><div class="two"><div class="panel"><div class="eyebrow">Cook what you have</div><h2 class="title">A good meal starts with a good idea.</h2><p class="sub">Search by recipe, ingredient, cuisine, or dietary preference. Scale servings and make a shopping list as you go.</p><a class="btn" href="#recipes">Explore the recipe book</a></div><div class="panel"><div class="eyebrow">At the table</div><p style="font:italic 24px/1.5 Georgia;color:#365d48">“The best recipes are the ones that bring everyone a little closer.”</p><a href="#community">Share what you're cooking →</a></div></div></div></section>
<section class="view" id="recipes"><div class="wrap"><div class="eyebrow">Find something delicious</div><h1 class="title">The recipe book.</h1><p class="sub">Search by name or ingredient, then filter by cuisine, diet, and cooking time.</p><div class="toolbar"><input id="search" placeholder="Search recipe or ingredient" aria-label="Search recipes"><select id="cuisine"><option value="">All cuisines</option><option>Italian</option><option>Mediterranean</option><option>Indian</option><option>American</option></select><select id="diet"><option value="">All diets</option><option>Vegetarian</option><option>Vegan</option><option>Gluten-free</option></select><select id="time"><option value="">Any cook time</option><option value="20">Under 20 min</option><option value="40">Under 40 min</option></select></div><p id="resultCount" class="meta"></p><div class="grid" id="recipeGrid"></div></div></section>
<section class="view" id="detail"><div class="wrap"><a class="read" href="#recipes">← Back to recipes</a><div class="two" style="margin-top:18px"><article class="panel"><div class="eyebrow" id="detailTags"></div><h1 class="title" id="detailTitle"></h1><p class="sub" id="detailDescription"></p><p class="meta" id="detailMeta"></p><div class="serving-control"><b>Servings</b><button class="soft" id="lessServing">−</button><span id="servingCount"></span><button class="soft" id="moreServing">+</button></div><h2>Ingredients</h2><div id="ingredients"></div><div class="actions"><button id="addIngredients">Add ingredients to shopping list</button><button class="outline" id="printRecipe">Print recipe</button><button class="outline" id="shareRecipe">Share</button></div></article><aside class="panel"><h2>How to make it</h2><ol class="steps" id="instructions"></ol><div class="notice" id="recipeTip"></div><h2>Cook's notes</h2><div id="reviews"></div><form id="reviewForm"><label>Your name<input class="field" name="name" required></label><label>Your rating<select class="field" name="rating"><option value="5">★★★★★ — Loved it</option><option value="4">★★★★☆ — Really good</option><option value="3">★★★☆☆ — Good</option><option value="2">★★☆☆☆ — Could improve</option><option value="1">★☆☆☆☆ — Not for me</option></select></label><label>Your note<textarea class="field" name="text" rows="3" required></textarea></label><button>Post a review</button></form></aside></div></div></section>
<section class="view" id="planner"><div class="wrap"><div class="eyebrow">A little structure, lots of flexibility</div><h1 class="title">Your weekly meal plan.</h1><p class="sub">Choose recipes for the week. Your plan stays in this browser.</p><div class="two"><div class="panel"><h2>This week</h2><div id="planGrid"></div><button id="clearPlan" class="outline">Clear meal plan</button></div><div class="panel"><h2>Ready to cook?</h2><p class="sub">Add the ingredients from a recipe to your shopping list, then check items off as you shop.</p><a class="btn" href="#recipes">Choose a recipe</a><a class="btn outline" href="#shopping">Open shopping list</a></div></div></div></section>
<section class="view" id="shopping"><div class="wrap"><div class="eyebrow">Everything for the next good meal</div><h1 class="title">Your shopping list.</h1><div class="two"><div class="panel"><form id="addItemForm"><label>Add an item<input class="field" name="item" placeholder="e.g. fresh basil" required></label><button>Add to list</button></form><div id="shoppingList"></div><div class="actions"><button class="outline" id="clearList">Clear completed</button><button id="printList">Print list</button></div></div><div class="panel"><h2>A list made from your recipes</h2><p class="sub">Open a recipe, choose the serving size, and add its ingredients here. You can also add your own items.</p><a class="btn" href="#recipes">Find a recipe</a></div></div></div></section>
<section class="view" id="community"><div class="wrap"><div class="eyebrow">Pass a good recipe along</div><h1 class="title">Community kitchen.</h1><p class="sub">Have a recipe you make again and again? Share it with the Gather &amp; Grain community.</p><div class="two"><form id="submitRecipe" class="panel"><h2>Share a recipe</h2><label>Recipe name<input class="field" name="name" required></label><label>Your name<input class="field" name="author" required></label><label>Short description<textarea class="field" name="description" rows="2" required></textarea></label><div class="two"><label>Cuisine<input class="field" name="cuisine" placeholder="e.g. Indian"></label><label>Diet<select class="field" name="diet"><option>Vegetarian</option><option>Vegan</option><option>Gluten-free</option><option>Any</option></select></label></div><label>Ingredients, one per line<textarea class="field" name="ingredients" rows="3" placeholder="1 cup rice&#10;2 cups water" required></textarea></label><label>Cooking steps<textarea class="field" name="steps" rows="4" required></textarea></label><button>Save recipe locally</button><p class="meta">Your recipe is saved only in this browser; it is not published to a server.</p></form><div><div class="panel"><div class="eyebrow">Favorites</div><h2>Saved for later</h2><div id="favorites"></div><a class="btn outline" href="#recipes">Browse recipes</a></div><div class="panel" style="margin-top:16px"><div class="eyebrow">About the kitchen</div><p class="sub">Gather &amp; Grain is a recipe-book demonstration built around approachable food, flexible meal planning, and sharing what works in your kitchen.</p></div></div></div></div></section>
</main>
<footer><div class="foot"><a class="brand" style="color:white" href="#home">gather &amp; grain</a><span>Recipes to bring people together · <a href="#community">Share a recipe</a></span><span>Experiment 41 · <a href="../Exp-40/TravelJournal.html">← Elsewhere Journal</a> · <a href="../Exp-42/Electricity.html">Next: electricity portal →</a></span></div></footer><div class="toast" id="toast" role="status"></div>
<script>
const recipes=[
{id:"pasta",name:"Lemon Garden Pasta",author:"Gather & Grain",cuisine:"Italian",diet:"Vegetarian",minutes:25,rating:4.9,description:"Silky lemon, sweet peas, fresh herbs, and a little parmesan make this weeknight pasta feel like sunshine.",ingredients:[["pasta","320","g"],["frozen peas","150","g"],["lemon","1",""],["parmesan","50","g"],["olive oil","2","tbsp"],["fresh parsley","15","g"]],steps:["Bring a large pot of salted water to a boil. Cook the pasta until just al dente; save a mug of the pasta water.","Warm olive oil in a wide pan. Add the peas and cook for 3 minutes until bright and tender.","Add lemon zest, a squeeze of lemon juice, and a splash of reserved pasta water.","Toss in the drained pasta and parmesan. Add more pasta water until glossy, then finish with chopped parsley."],tip:"Swap the peas for asparagus in spring, or stir in baby spinach just before serving.",photo:"pasta"},
{id:"salad",name:"Roasted Chickpea Bowl",author:"Asha Nair",cuisine:"Mediterranean",diet:"Vegan",minutes:35,rating:4.8,description:"Crisp spiced chickpeas, crunchy vegetables, and a creamy lemon-tahini dressing.",ingredients:[["chickpeas","1","400 g can"],["cucumber","1",""],["cherry tomatoes","200","g"],["tahini","3","tbsp"],["lemon","1",""],["baby greens","100","g"]],steps:["Heat the oven to 220°C / 425°F. Drain and dry the chickpeas, toss with oil and cumin, and roast until crisp.","Whisk tahini, lemon juice, a pinch of salt, and water into a pourable dressing.","Slice the cucumber and tomatoes and arrange over a bed of greens.","Scatter the warm chickpeas over the vegetables. Drizzle generously with dressing."],tip:"For extra crunch, roast the chickpeas for 5 minutes longer. Keep the dressing separate until serving.",photo:"salad"},
{id:"oats",name:"Maple Morning Oats",author:"Theo Brooks",cuisine:"American",diet:"Vegetarian",minutes:12,rating:4.7,description:"A creamy one-pot breakfast with warm cinnamon, maple, and fruit.",ingredients:[["rolled oats","160","g"],["milk or oat milk","500","ml"],["maple syrup","2","tbsp"],["ground cinnamon","1/2","tsp"],["banana","1",""],["toasted walnuts","30","g"]],steps:["Combine the oats, milk, and cinnamon in a small saucepan.","Bring to a gentle simmer, stirring often, and cook for 5–7 minutes until creamy.","Slice the banana while the oats finish cooking.","Divide into bowls; top with maple syrup, banana, and walnuts."],tip:"Add a splash more milk to loosen the oats, or top with berries when they are in season.",photo:"oats"},
{id:"curry",name:"Cozy Coconut Lentil Curry",author:"Gather & Grain",cuisine:"Indian",diet:"Vegan",minutes:40,rating:4.9,description:"Red lentils simmered with coconut milk, ginger, and mellow spices.",ingredients:[["red lentils","200","g"],["coconut milk","400","ml"],["vegetable stock","400","ml"],["onion","1",""],["fresh ginger","20","g"],["curry powder","2","tsp"],["baby spinach","80","g"]],steps:["Rinse the lentils in cool water until it runs clear. Dice the onion and finely grate the ginger.","Soften the onion in a little oil over medium heat. Stir in ginger and curry powder for 30 seconds.","Add the lentils, coconut milk, and stock. Simmer gently for 25 minutes, stirring occasionally.","Fold through the spinach until just wilted. Taste, season, and serve with rice."],tip:"Add a squeeze of lime before serving. For a thicker curry, simmer uncovered for the last few minutes.",photo:"curry"},
{id:"soup",name:"Weeknight Tomato Soup",author:"Mina Cole",cuisine:"Italian",diet:"Gluten-free",minutes:30,rating:4.6,description:"A simple, velvety tomato soup finished with basil and a drizzle of good olive oil.",ingredients:[["crushed tomatoes","800","g"],["vegetable stock","350","ml"],["onion","1",""],["garlic cloves","2",""],["fresh basil","15","g"],["olive oil","1","tbsp"]],steps:["Warm the oil in a saucepan. Add the diced onion and cook until soft.","Add garlic and stir for 30 seconds, then pour in the tomatoes and stock.","Simmer gently for 20 minutes. Blend carefully until smooth, then season to taste.","Serve warm with torn basil leaves and a little olive oil."],tip:"Use a splash of cream or coconut milk for a softer finish. Take care when blending hot soup.",photo:"soup"},
{id:"yogurt",name:"Honey & Berry Yogurt Cups",author:"Sam Rivera",cuisine:"American",diet:"Gluten-free",minutes:10,rating:4.8,description:"Cool creamy yogurt, bright seasonal fruit, and crunchy honeyed oats.",ingredients:[["thick yogurt","400","g"],["mixed berries","200","g"],["rolled oats","50","g"],["honey","2","tbsp"],["lemon zest","1","tsp"]],steps:["Toast the oats in a dry pan over medium heat until fragrant and lightly golden.","Stir the lemon zest into the yogurt and divide it between glasses.","Add a layer of berries and a scatter of toasted oats.","Drizzle with honey and serve straight away."],tip:"Keep the oats separate until serving so they stay crunchy. Use maple syrup for a vegan option.",photo:"yogurt"}
];
const $=s=>document.querySelector(s),store={get(k,fallback){try{return JSON.parse(localStorage.getItem("gg-"+k))??fallback}catch{return fallback}},set(k,v){localStorage.setItem("gg-"+k,JSON.stringify(v))}};
let saved=store.get("favorites",[]),shopping=store.get("shopping",[]),plan=store.get("plan",{}),reviews=store.get("reviews",{}),community=store.get("community",[]),current=recipes[0],servings=4;
function toast(s){const t=$("#toast");t.textContent=s;t.style.display="block";clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>t.style.display="none",2200)}
function findRecipe(id){return [...recipes,...community].find(r=>r.id===id)}
function safe(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function card(r){return `<article class="recipe"><div class="food-photo" role="img" aria-label="${safe(r.name)}"><button class="favorite ${saved.includes(r.id)?"on":""}" data-favorite="${safe(r.id)}" aria-label="${saved.includes(r.id)?"Remove from":"Save to"} favorites">${saved.includes(r.id)?"♥":"♡"}</button></div><div class="recipe-body"><div class="meta">${safe(r.cuisine||"Community")} · ${safe(r.diet||"Any diet")} · ${Number(r.minutes)||30} min</div><h3>${safe(r.name)}</h3><div class="meta">★★★★★ ${r.rating||"New"} · by ${safe(r.author||"Community cook")}</div><p>${safe(r.description)}</p><div class="recipe-bottom"><span class="chips"><span class="chip">${safe(r.diet||"Any diet")}</span></span><button data-recipe="${safe(r.id)}">View recipe</button></div></div></article>`}
function renderCatalog(){const q=$("#search").value.trim().toLowerCase(),c=$("#cuisine").value,d=$("#diet").value,t=Number($("#time").value)||Infinity;const list=[...community,...recipes].filter(r=>(!q||`${r.name} ${r.description} ${(r.ingredients||[]).map(x=>x[0]).join(" ")}`.toLowerCase().includes(q))&&(!c||r.cuisine===c)&&(!d||r.diet===d)&&(Number(r.minutes)||30)<=t);$("#resultCount").textContent=`${list.length} recipe${list.length===1?"":"s"} to try`;$("#recipeGrid").innerHTML=list.length?list.map(card).join(""):'<p class="empty">No recipes match those filters. Try broadening your search.</p>'}
function renderFavorites(){$("#favorites").innerHTML=saved.length?saved.map(id=>findRecipe(id)).filter(Boolean).map(r=>`<div class="list-item"><span>♥</span><a href="#detail" data-recipe="${safe(r.id)}">${safe(r.name)}</a></div>`).join(""):'<p class="meta">No saved recipes yet. Tap the heart on a recipe to save it.</p>'}
function ingredientText(item,scale){const [name,amount,unit]=item;const n=Number(amount);let quantity=Number.isFinite(n)?Math.round(n*scale*100)/100:amount;return `${quantity}${unit?" "+unit:""} ${name}`}
function openRecipe(id){const r=findRecipe(id);if(!r)return;current=r;servings=Number(r.servings)||4;$("#detailTags").textContent=`${r.cuisine||"Community"} · ${r.diet||"Any diet"}`;$("#detailTitle").textContent=r.name;$("#detailDescription").textContent=r.description;$("#detailMeta").textContent=`${r.minutes||30} min · ${r.rating||"New"} rating · by ${r.author||"Community cook"}`;$("#servingCount").textContent=servings;$("#ingredients").innerHTML=(r.ingredients||[]).map((x,i)=>`<label class="ingredient"><input type="checkbox" data-ingredient-check="${i}"><span data-ingredient="${i}">${safe(ingredientText(x,servings/(Number(r.servings)||4)))}</span></label>`).join("");$("#instructions").innerHTML=(r.steps||[]).map(x=>`<li>${safe(x)}</li>`).join("");$("#recipeTip").textContent=r.tip||"Make it your own and season to taste.";renderReviews(r.id);location.hash="#detail"}
function renderReviews(id){const list=reviews[id]||[];$("#reviews").innerHTML=list.map(x=>`<div class="comment"><b>${safe(x.name)}</b> <span class="meta">${"★".repeat(x.rating)}${"☆".repeat(5-x.rating)}</span><p>${safe(x.text)}</p></div>`).join("")||'<p class="meta">No cook notes yet. Add the first review.</p>'}
function renderList(){const count=shopping.filter(x=>!x.done).length;$("#listCount").textContent=count;$("#shoppingList").innerHTML=shopping.length?shopping.map((x,i)=>`<div class="list-item"><input type="checkbox" data-check-item="${i}" ${x.done?"checked":""}><span style="${x.done?"text-decoration:line-through;color:#899189":""}">${safe(x.name)}</span><button class="outline" data-remove-item="${i}" style="margin-left:auto;padding:5px 9px" aria-label="Remove ${safe(x.name)}">×</button></div>`).join(""):'<p class="empty">Your shopping list is empty.</p>';store.set("shopping",shopping)}
function renderPlan(){const days=["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"];$("#planGrid").innerHTML=days.map(day=>`<div class="planner-row"><b>${day}</b><select class="field" data-plan-day="${day}"><option value="">Choose a recipe</option>${[...recipes,...community].map(r=>`<option value="${safe(r.id)}" ${plan[day]===r.id?"selected":""}>${safe(r.name)}</option>`).join("")}</select>${plan[day]?`<a class="read" href="#detail" data-recipe="${safe(plan[day])}">View</a>`:""}</div>`).join("");store.set("plan",plan)}
function route(){const id=location.hash.slice(1)||"home";if(!document.getElementById(id)?.classList.contains("view")){location.hash="#home";return}document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===id));if(id==="shopping")renderList();if(id==="planner")renderPlan();if(id==="community")renderFavorites();window.scrollTo(0,0)}
window.addEventListener("hashchange",route);
["search","cuisine","diet","time"].forEach(id=>$("#"+id).addEventListener("input",renderCatalog));
document.addEventListener("click",e=>{const b=e.target.closest("[data-recipe]");if(b){e.preventDefault();openRecipe(b.dataset.recipe);return}const f=e.target.closest("[data-favorite]");if(f){const id=f.dataset.favorite;saved=saved.includes(id)?saved.filter(x=>x!==id):[...saved,id];store.set("favorites",saved);renderCatalog();renderFavorites();return}const rem=e.target.closest("[data-remove-item]");if(rem){shopping.splice(Number(rem.dataset.removeItem),1);renderList()}});
$("#lessServing").addEventListener("click",()=>{servings=Math.max(1,servings-1);$("#servingCount").textContent=servings;$("#ingredients").querySelectorAll("[data-ingredient]").forEach(el=>{el.textContent=ingredientText(current.ingredients[Number(el.dataset.ingredient)],servings/(Number(current.servings)||4))})});
$("#moreServing").addEventListener("click",()=>{servings=Math.min(24,servings+1);$("#servingCount").textContent=servings;$("#ingredients").querySelectorAll("[data-ingredient]").forEach(el=>{el.textContent=ingredientText(current.ingredients[Number(el.dataset.ingredient)],servings/(Number(current.servings)||4))})});
$("#addIngredients").addEventListener("click",()=>{const checks=[...$("#ingredients").querySelectorAll("[data-ingredient-check]")];checks.forEach((c,i)=>{if(!c.checked){const item=ingredientText(current.ingredients[i],servings/(Number(current.servings)||4));const existing=shopping.find(x=>x.name.toLowerCase()===item.toLowerCase());if(!existing)shopping.push({name:item,done:false})}});renderList();toast("Ingredients added to your shopping list.")});
$("#printRecipe").addEventListener("click",()=>window.print());
$("#shareRecipe").addEventListener("click",async()=>{try{if(navigator.share)await navigator.share({title:current.name,text:current.description,url:location.href});else if(navigator.clipboard){await navigator.clipboard.writeText(location.href);toast("Recipe link copied.")}else toast("Copy the page address to share this recipe.")}catch(e){if(e.name!=="AbortError")toast("Sharing is unavailable here.")}});
$("#reviewForm").addEventListener("submit",e=>{e.preventDefault();const d=new FormData(e.target),list=reviews[current.id]||[];list.push({name:d.get("name"),rating:Number(d.get("rating")),text:d.get("text")});reviews[current.id]=list;store.set("reviews",reviews);renderReviews(current.id);e.target.reset()});
$("#addItemForm").addEventListener("submit",e=>{e.preventDefault();const d=new FormData(e.target),name=d.get("item").trim();if(name)shopping.push({name,done:false});renderList();e.target.reset()});
$("#shoppingList").addEventListener("change",e=>{const i=Number(e.target.dataset.checkItem);if(Number.isInteger(i)){shopping[i].done=e.target.checked;renderList()}});
$("#clearList").addEventListener("click",()=>{shopping=shopping.filter(x=>!x.done);renderList()});$("#printList").addEventListener("click",()=>window.print());
$("#planGrid").addEventListener("change",e=>{const day=e.target.dataset.planDay;if(day){if(e.target.value)plan[day]=e.target.value;else delete plan[day];renderPlan()}});
$("#clearPlan").addEventListener("click",()=>{plan={};renderPlan()});
$("#submitRecipe").addEventListener("submit",e=>{e.preventDefault();const d=new FormData(e.target),id="community-"+Date.now(),ingredients=d.get("ingredients").split(/\r?\n/).map(x=>{const m=x.trim().match(/^([\d.\/]+)\s+(.+)$/);return m?[m[2],m[1],""]:[x.trim(),"",""]}).filter(x=>x[0]);const steps=d.get("steps").split(/\r?\n/).map(x=>x.trim()).filter(Boolean);community.push({id,name:d.get("name"),author:d.get("author"),description:d.get("description"),cuisine:d.get("cuisine")||"Community",diet:d.get("diet"),minutes:30,rating:"New",servings:4,ingredients,steps,tip:"Shared by a Gather & Grain home cook."});store.set("community",community);renderCatalog();toast("Your recipe has been saved in this browser.");e.target.reset()});
$("#featured").innerHTML=recipes.slice(0,3).map(card).join("");renderCatalog();renderFavorites();renderList();route();
</script>
</body>
</html>
