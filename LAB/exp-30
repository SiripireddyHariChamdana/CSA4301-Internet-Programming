<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IJSSE | International Journal of Scientific and Social Excellence</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f4f6fa;color:#263247}
header{background:#142744;color:#fff;padding:17px 5%;display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}
.brand{font-size:21px;font-weight:800;line-height:1.25}.brand small{display:block;font-size:11px;letter-spacing:1.2px;color:#b9cbe2;margin-top:4px}
nav{display:flex;gap:6px;flex-wrap:wrap}nav button{border:1px solid #52647e;background:transparent;color:#fff;padding:9px 11px;border-radius:6px;cursor:pointer;font-size:13px}nav button:hover,nav button.active{background:#2d65a0;border-color:#2d65a0}
.subnav{background:#e7edf5;padding:9px 5%;display:flex;gap:8px;flex-wrap:wrap}.subnav button{border:0;background:transparent;color:#244366;padding:7px 9px;cursor:pointer;border-radius:5px;font-size:13px}.subnav button:hover{background:#d4e1f1}
main{max-width:1160px;margin:25px auto;padding:0 17px}.page{display:none}.page.active{display:block}
.hero{background:linear-gradient(120deg,#17375e,#28649b);color:#fff;padding:36px;border-radius:13px;margin-bottom:19px}.hero h1{font-size:30px;margin:0 0 12px}.hero p{line-height:1.65;color:#e0ebf7;max-width:850px}
.card{background:#fff;border:1px solid #e1e6ee;border-radius:11px;padding:22px;margin-bottom:17px;box-shadow:0 4px 15px #1d355710}
h2{margin:0 0 15px;color:#17375e}h3{margin:0 0 9px;color:#24496e}.muted{color:#68778b;font-size:14px;line-height:1.55}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.three{grid-template-columns:repeat(3,minmax(0,1fr))}
.field{margin-bottom:13px}label{display:block;font-weight:600;font-size:14px;margin-bottom:7px}
input,select,textarea{width:100%;padding:11px;border:1px solid #cbd4e0;border-radius:6px;font:inherit;background:#fff;color:#263247}textarea{min-height:100px;resize:vertical}
.btn{background:#28649b;color:#fff;border:0;padding:10px 15px;border-radius:6px;font-weight:700;cursor:pointer}.btn:hover{filter:brightness(.94)}.btn.light{background:#e6eef7;color:#20496f}.btn.dark{background:#17375e}
.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:12px}
.tile{border:1px solid #e1e7ef;border-radius:9px;padding:17px;background:#fbfcfe}.tile p{margin-bottom:0}
table{width:100%;border-collapse:collapse;margin-top:10px}th,td{text-align:left;padding:11px;border-bottom:1px solid #e6eaf0;font-size:14px;vertical-align:top}th{background:#f0f4f8;color:#24496e}
.tag{display:inline-block;background:#e8f0f8;color:#24527d;border-radius:20px;padding:4px 9px;font-size:12px;font-weight:700}
.review{border-top:1px solid #e7ebf0;padding:12px 0}.review:first-child{border-top:0}
.hidden{display:none!important}.notice{padding:13px;border-radius:7px;background:#eef4fa;color:#365574;font-size:13px;line-height:1.5}
footer{text-align:center;padding:25px;color:#718096;font-size:13px}
@media(max-width:700px){.grid,.three{grid-template-columns:1fr}.hero{padding:25px}.hero h1{font-size:25px}header{align-items:flex-start}}
</style>
</head>
<body>
<header>
 <div class="brand">IJSSE <small>INTERNATIONAL JOURNAL OF SCIENTIFIC AND SOCIAL EXCELLENCE</small></div>
 <nav>
  <button class="active" onclick="go('home',this)">Home</button>
  <button onclick="go('about',this)">About Journal</button>
  <button onclick="go('articles',this)">Articles</button>
  <button onclick="go('call',this)">Call for Paper</button>
  <button onclick="go('contact',this)">Contact Us</button>
 </nav>
</header>
<div class="subnav">
 <button onclick="go('ethics')">Publication Ethics</button><button onclick="go('editorial')">Editorial Board</button>
 <button onclick="go('reviewerLogin')">Reviewers</button><button onclick="go('authorLogin')">Authors</button>
 <button onclick="go('editorLogin')">Editors</button><button onclick="go('instructions')">Author Instructions</button>
 <button onclick="go('charges')">Publication Charge</button><button onclick="go('feedback')">View Feedback</button>
</div>
<main>
<section id="home" class="page active">
 <div class="hero"><span class="tag">Academic Journal Portal</span><h1>International Journal of Scientific and Social Excellence</h1>
 <p>Welcome to IJSSE. Explore journal information, publication ethics, editorial resources, reviewer services and author submission facilities through one academic publishing portal.</p>
 <div class="actions"><button class="btn" onclick="go('submit')">Submit Manuscript</button><button class="btn light" onclick="go('authorRegister')">Author Registration</button><button class="btn light" onclick="go('articles')">Explore Articles</button></div></div>
 <div class="grid three">
  <div class="tile"><h3>Print ISSN</h3><p><b>2395-1443</b></p></div>
  <div class="tile"><h3>Online ISSN</h3><p><b>2395-1451</b></p></div>
  <div class="tile"><h3>Journal Resources</h3><p class="muted">Guidelines, templates, reviewer and editorial information.</p></div>
 </div>
 <div class="card"><h2>Explore IJSSE</h2><div class="grid">
  <div><h3>For Authors</h3><p class="muted">Register, submit manuscripts, track papers and access author guidelines and templates.</p><button class="btn light" onclick="go('authorLogin')">Author Portal</button></div>
  <div><h3>For Reviewers</h3><p class="muted">Register as a reviewer, access assigned articles and submit review recommendations.</p><button class="btn light" onclick="go('reviewerLogin')">Reviewer Portal</button></div>
  <div><h3>For Editors</h3><p class="muted">Manage submissions, coordinate peer reviews and oversee publication workflow.</p><button class="btn light" onclick="go('editorLogin')">Editor Portal</button></div>
  <div><h3>Latest Articles</h3><p class="muted">Browse current issue, archive and articles awaiting print publication.</p><button class="btn light" onclick="go('articles')">Browse Articles</button></div>
 </div></div>
</section>

<section id="about" class="page"><div class="card"><h2>About Journal</h2><p>The International Journal of Scientific and Social Excellence (IJSSE) provides a platform for scholarly communication and the dissemination of research in scientific, technical and social disciplines.</p><p class="muted">The journal aims to encourage research, support academic discussion and provide an organized process for manuscript submission, peer review and publication.</p><div class="grid"><div class="tile"><h3>Print ISSN</h3><b>2395-1443</b></div><div class="tile"><h3>Online ISSN</h3><b>2395-1451</b></div></div><h3 style="margin-top:20px">Journal Scope</h3><p class="muted">Research contributions across science, engineering, technology, management, humanities and social sciences.</p><h3>Our Mission</h3><p class="muted">To support the exchange of research knowledge and provide authors, reviewers and editors with a clear publication workflow.</p></div></section>

<section id="ethics" class="page"><div class="card"><h2>Publication Ethics</h2><p>IJSSE expects all participants in the publication process to maintain academic integrity and responsible research practices.</p><div class="grid"><div><h3>Authors</h3><ul><li>Submit original work and avoid plagiarism.</li><li>Ensure all listed authors have contributed.</li><li>Disclose conflicts of interest and funding.</li><li>Correct errors when identified.</li></ul></div><div><h3>Reviewers</h3><ul><li>Maintain confidentiality of manuscripts.</li><li>Provide objective and constructive feedback.</li><li>Declare conflicts of interest.</li><li>Complete reviews within the agreed timeline.</li></ul></div><div><h3>Editors</h3><ul><li>Make fair and unbiased decisions.</li><li>Protect confidential submission details.</li><li>Manage conflicts of interest.</li><li>Ensure consistent editorial standards.</li></ul></div><div><h3>Publication process</h3><ul><li>Use peer review to evaluate submissions.</li><li>Address suspected misconduct appropriately.</li><li>Maintain transparent publication records.</li></ul></div></div></div></section>

<section id="editorial" class="page"><div class="card"><h2>Editorial Board</h2><p class="muted">Editorial board information and role-based registration.</p><div class="grid three"><div class="tile"><h3>Editor Registration</h3><p class="muted">Create an editor profile.</p><button class="btn light" onclick="go('editorRegister')">Register</button></div><div class="tile"><h3>Editor Login</h3><p class="muted">Access editorial dashboard.</p><button class="btn light" onclick="go('editorLogin')">Login</button></div><div class="tile"><h3>Editorial Committee</h3><p class="muted">View committee details.</p><button class="btn light" onclick="go('committee')">View Committee</button></div></div><h3 style="margin-top:22px">Editor Responsibility</h3><ul><li>Check submissions for completeness and scope.</li><li>Assign suitable reviewers.</li><li>Monitor peer-review progress.</li><li>Communicate editorial decisions.</li><li>Coordinate accepted articles for publication.</li></ul></div></section>

<section id="committee" class="page"><div class="card"><h2>Editorial Committee</h2><table><tr><th>Position</th><th>Responsibility</th></tr><tr><td>Editor-in-Chief</td><td>Overall editorial direction and final publication decisions.</td></tr><tr><td>Associate Editor</td><td>Coordinates manuscript assessment and reviewer assignments.</td></tr><tr><td>Section Editor</td><td>Manages submissions in assigned subject areas.</td></tr><tr><td>Editorial Member</td><td>Supports editorial quality and journal development.</td></tr></table></div></section>

<section id="editorRegister" class="page"><div class="card"><h2>Editor Registration</h2><form onsubmit="registerRole(event,'editor')"><div class="grid"><div class="field"><label>Full name</label><input id="editorName" required></div><div class="field"><label>Email</label><input id="editorEmail" type="email" required></div><div class="field"><label>Institution</label><input id="editorInstitution" required></div><div class="field"><label>Area of expertise</label><input id="editorExpertise" required></div><div class="field"><label>Password</label><input id="editorPassword" type="password" required></div></div><button class="btn">Register as Editor</button></form></div></section>

<section id="editorLogin" class="page"><div class="card narrow"><h2>Editor Login</h2><form onsubmit="loginRole(event,'editor')"><div class="field"><label>Email</label><input id="editorLoginEmail" type="email" required></div><div class="field"><label>Password</label><input id="editorLoginPassword" type="password" required></div><button class="btn">Login</button></form><p class="muted">New editor? <a href="#" onclick="go('editorRegister');return false">Register here</a>.</p></div></section>

<section id="reviewerRegister" class="page"><div class="card"><h2>Reviewer Registration</h2><form onsubmit="registerRole(event,'reviewer')"><div class="grid"><div class="field"><label>Full name</label><input id="reviewerName" required></div><div class="field"><label>Email</label><input id="reviewerEmail" type="email" required></div><div class="field"><label>Institution</label><input id="reviewerInstitution" required></div><div class="field"><label>Expertise / research area</label><input id="reviewerExpertise" required></div><div class="field"><label>Password</label><input id="reviewerPassword" type="password" required></div></div><button class="btn">Register as Reviewer</button></form></div></section>

<section id="reviewerLogin" class="page"><div class="card"><h2>Reviewer Login</h2><form onsubmit="loginRole(event,'reviewer')"><div class="field"><label>Email</label><input id="reviewerLoginEmail" type="email" required></div><div class="field"><label>Password</label><input id="reviewerLoginPassword" type="password" required></div><button class="btn">Login</button></form><div class="actions"><button class="btn light" onclick="go('reviewerRegister')">Reviewer Registration</button><button class="btn light" onclick="go('reviewerList')">Reviewers for an Article</button></div></div></section>

<section id="reviewerList" class="page"><div class="card"><h2>Reviewers for Specific Article</h2><div class="field"><label>Select article</label><select id="reviewArticle" onchange="showArticleReviewers()"></select></div><div id="articleReviewers" class="muted"></div></div></section>

<section id="authorRegister" class="page"><div class="card"><h2>Author Registration</h2><form onsubmit="registerRole(event,'author')"><div class="grid"><div class="field"><label>Full name</label><input id="authorName" required></div><div class="field"><label>Email</label><input id="authorEmail" type="email" required></div><div class="field"><label>Institution / affiliation</label><input id="authorInstitution" required></div><div class="field"><label>Research area</label><input id="authorExpertise" required></div><div class="field"><label>Password</label><input id="authorPassword" type="password" required></div></div><button class="btn">Register as Author</button></form></div></section>

<section id="authorLogin" class="page"><div class="card"><h2>Author Login</h2><form onsubmit="loginRole(event,'author')"><div class="field"><label>Email</label><input id="authorLoginEmail" type="email" required></div><div class="field"><label>Password</label><input id="authorLoginPassword" type="password" required></div><button class="btn">Login</button></form><div class="actions"><button class="btn light" onclick="go('authorRegister')">Author Registration</button><button class="btn light" onclick="go('submit')">Submit Manuscript</button><button class="btn light" onclick="go('instructions')">Author Instructions</button></div></div></section>

<section id="author" class="page"><div class="card"><h2>Author Dashboard</h2><p id="authorWelcome" class="muted"></p><div class="actions"><button class="btn" onclick="go('submit')">Submit New Manuscript</button><button class="btn light" onclick="renderAuthorPapers()">Refresh Paper List</button></div><h3 style="margin-top:20px">Papers Under This Author</h3><div id="authorPapers"></div></div></section>

<section id="instructions" class="page"><div class="card"><h2>Author Instructions & Guidelines</h2><ol><li>Prepare an original manuscript relevant to the journal scope.</li><li>Use the article template and follow the prescribed structure.</li><li>Include title, abstract, keywords, main text, references and author details.</li><li>Ensure figures and tables are numbered and clearly labelled.</li><li>Check language, citations, originality and permissions before submission.</li><li>Upload the manuscript through the Submit Manuscript page.</li><li>Track the manuscript status from the author dashboard.</li></ol><h3>Author Guidelines</h3><p class="muted">Authors are responsible for accuracy, originality, ethical approvals where applicable, and obtaining permission to reproduce third-party material.</p><div class="actions"><button class="btn light" onclick="downloadTemplate('article')">Download Article Template</button><button class="btn light" onclick="downloadTemplate('copyright')">Download Copyright Form Template</button></div></div></section>

<section id="charges" class="page"><div class="card"><h2>Publication Charge</h2><p class="muted">Publication charges and payment instructions should be confirmed with the journal office before payment.</p><table><tr><th>Item</th><th>Details</th></tr><tr><td>Submission</td><td>Manuscript submission through the portal.</td></tr><tr><td>Publication charge</td><td>As communicated by the journal office after editorial assessment.</td></tr><tr><td>Payment proof</td><td>Authors should retain transaction confirmation for their records.</td></tr></table></div></section>

<section id="submit" class="page"><div class="card"><h2>Submit Manuscript</h2><form onsubmit="submitPaper(event)"><div class="grid"><div class="field"><label>Corresponding author email</label><input id="paperEmail" type="email" required></div><div class="field"><label>Article title</label><input id="paperTitle" required></div><div class="field"><label>Research area</label><input id="paperArea" required></div><div class="field"><label>Co-authors</label><input id="paperCoauthors" placeholder="Separate names with commas"></div><div class="field"><label>Manuscript file name</label><input id="paperFile" required placeholder="research-paper.docx"></div></div><div class="field"><label>Abstract</label><textarea id="paperAbstract" required></textarea></div><button class="btn">Submit Manuscript</button></form><p id="submitMessage" class="muted"></p></div></section>

<section id="articles" class="page"><div class="card"><h2>Articles</h2><div class="actions"><button class="btn light" onclick="articleTab('current')">Current Issue</button><button class="btn light" onclick="articleTab('archive')">Archive</button><button class="btn light" onclick="articleTab('viewed')">Most Viewed</button><button class="btn light" onclick="articleTab('cited')">Most Cited</button><button class="btn light" onclick="articleTab('print')">About to Print</button></div><div id="articleList"></div></div></section>

<section id="call" class="page"><div class="card"><h2>Call for Papers</h2><p>Researchers and academicians are invited to submit original research papers and scholarly articles for consideration.</p><div class="grid three"><div class="tile"><h3>Submit Manuscript</h3><p class="muted">Send your research through the online submission form.</p><button class="btn light" onclick="go('submit')">Submit</button></div><div class="tile"><h3>Indexed List</h3><p class="muted">View the journal indexing information provided by the publisher.</p><button class="btn light" onclick="go('indexed')">View List</button></div><div class="tile"><h3>Newsletter</h3><p class="muted">Subscribe to receive journal announcements.</p><button class="btn light" onclick="go('newsletter')">Subscribe</button></div></div></div></section>

<section id="indexed" class="page"><div class="card"><h2>Indexed List</h2><p class="muted">Indexing and abstracting information should be checked against the relevant database records and updated by the journal publisher.</p><table><tr><th>Database / Index</th><th>Information</th></tr><tr><td>Scopus</td><td>Refer to the official Scopus source title record for current coverage status.</td></tr><tr><td>Other indexing services</td><td>Publisher-maintained indexing details.</td></tr></table></div></section>

<section id="newsletter" class="page"><div class="card"><h2>Subscribe to Newsletter</h2><form onsubmit="subscribe(event)"><div class="field"><label>Name</label><input id="newsName" required></div><div class="field"><label>Email</label><input id="newsEmail" type="email" required></div><button class="btn">Subscribe</button></form><p id="newsMessage" class="muted"></p></div></section>

<section id="feedback" class="page"><div class="card"><h2>View Feedback</h2><div id="feedbackList" class="muted">No feedback has been posted yet.</div><h3 style="margin-top:20px">Send Feedback</h3><form onsubmit="sendFeedback(event)"><div class="field"><label>Your name</label><input id="feedbackName" required></div><div class="field"><label>Your feedback</label><textarea id="feedbackText" required></textarea></div><button class="btn">Submit Feedback</button></form></div></section>

<section id="contact" class="page"><div class="card"><h2>Contact Us</h2><p class="muted">For manuscript, review, editorial and publication enquiries, use the contact form.</p><form onsubmit="contact(event)"><div class="grid"><div class="field"><label>Name</label><input id="contactName" required></div><div class="field"><label>Email</label><input id="contactEmail" type="email" required></div></div><div class="field"><label>Subject</label><input id="contactSubject" required></div><div class="field"><label>Message</label><textarea id="contactMessage" required></textarea></div><button class="btn">Send Message</button></form><p id="contactStatus" class="muted"></p></div></section>
</main>
<footer>International Journal of Scientific and Social Excellence (IJSSE) · Print ISSN: 2395-1443 · Online ISSN: 2395-1451</footer>
<script>
let store=readStore(),logged={author:null,reviewer:null,editor:null};
function readStore(){try{return JSON.parse(localStorage.getItem('ijssePortal'))||{users:{author:[],reviewer:[],editor:[]},papers:[],feedback:[],subscribers:[]}}catch(e){return {users:{author:[],reviewer:[],editor:[]},papers:[],feedback:[],subscribers:[]}}}
function save(){localStorage.setItem('ijssePortal',JSON.stringify(store))}
function go(id,btn){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));let page=document.getElementById(id);if(page)page.classList.add('active');document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');window.scrollTo(0,0);if(id==='articles')articleTab('current');if(id==='reviewerList')loadReviewerArticles();if(id==='feedback')renderFeedback()}
function registerRole(e,role){e.preventDefault();let name=document.getElementById(role+'Name').value,email=document.getElementById(role+'Email').value,password=document.getElementById(role+'Password').value;let user={name,email,password,institution:document.getElementById(role+'Institution').value,expertise:document.getElementById(role+'Expertise').value};if(store.users[role].some(u=>u.email===email)){alert('This email is already registered.');return}store.users[role].push(user);save();alert(role+' registration completed. Please log in.');go(role+'Login')}
function loginRole(e,role){e.preventDefault();let email=document.getElementById(role+'LoginEmail').value,password=document.getElementById(role+'LoginPassword').value;let user=store.users[role].find(u=>u.email===email&&u.password===password);if(!user){alert('Account not found. Please register or check your login details.');return}logged[role]=user;if(role==='author'){document.getElementById('authorWelcome').textContent='Welcome, '+user.name+' ('+user.email+')';renderAuthorPapers();go('author')}else if(role==='editor'){alert('Welcome, '+user.name+'. Editor dashboard access granted.');go('editorBoard')}else{alert('Welcome, '+user.name+'. Reviewer portal opened.');go('reviewerBoard')}}
function submitPaper(e){e.preventDefault();let email=document.getElementById('paperEmail').value;let paper={email,title:document.getElementById('paperTitle').value,area:document.getElementById('paperArea').value,coauthors:document.getElementById('paperCoauthors').value,file:document.getElementById('paperFile').value,abstract:document.getElementById('paperAbstract').value,status:'Submitted',date:new Date().toLocaleDateString('en-IN'),reviewers:[]};store.papers.push(paper);save();document.getElementById('submitMessage').textContent='Manuscript submitted successfully. Submission status: Submitted.';e.target.reset()}
function renderAuthorPapers(){if(!logged.author)return;let papers=store.papers.filter(p=>p.email===logged.author.email);document.getElementById('authorPapers').innerHTML=papers.length?`<table><tr><th>Title</th><th>Submission date</th><th>Status</th></tr>${papers.map(p=>`<tr><td>${esc(p.title)}</td><td>${p.date}</td><td><span class="tag">${p.status}</span></td></tr>`).join('')}</table>`:'<p class="muted">No papers submitted under this author yet.</p>'}
function articleTab(tab){let samples={current:[['Research Trends in Applied Science','Current Issue · Research Article'],['Emerging Perspectives in Social Development','Current Issue · Review Article']],archive:[['Innovations in Science and Technology','Archived Issue'],['Studies in Society and Education','Archived Issue']],viewed:[['Recent Advances in Interdisciplinary Research','Most viewed sample article']],cited:[['A Review of Contemporary Research Methods','Most cited sample article']],print:[['Sustainable Development: New Research Directions','Accepted · About to print']]};let list=samples[tab]||[];document.getElementById('articleList').innerHTML=`<h3 style="margin-top:18px">${tab==='current'?'Current Issue':tab==='archive'?'Archive':tab==='viewed'?'Most Viewed Articles':tab==='cited'?'Most Cited Articles':'About to Print Articles'}</h3>`+list.map((a,i)=>`<div class="review"><b>${a[0]}</b><p class="muted">${a[1]}</p><span class="tag">Sample article entry</span></div>`).join('')}
function loadReviewerArticles(){let s=document.getElementById('reviewArticle');s.innerHTML=store.papers.map((p,i)=>`<option value="${i}">${esc(p.title)}</option>`).join('')||'<option value="">No submitted articles</option>';showArticleReviewers()}
function showArticleReviewers(){let i=Number(document.getElementById('reviewArticle').value),p=store.papers[i];document.getElementById('articleReviewers').textContent=p?(p.reviewers.length?p.reviewers.join(', '):'Reviewer assignments will appear here after editor allocation.'):'No article selected.'}
function downloadTemplate(type){let text=type==='article'?'IJSSE ARTICLE TEMPLATE\\n\\nTitle\\nAuthor name and affiliation\\nAbstract\\nKeywords\\n1. Introduction\\n2. Methodology\\n3. Results and Discussion\\n4. Conclusion\\nReferences':'IJSSE COPYRIGHT FORM TEMPLATE\\n\\nArticle title:\\nAuthor(s):\\nCorresponding author:\\n\\nThe author(s) confirm that the submitted work is original and grant the journal the agreed publication rights, subject to the journal policy.\\n\\nSignature:\\nDate:';let blob=new Blob([text],{type:'text/plain'}),a=document.createElement('a'),url=URL.createObjectURL(blob);a.href=url;a.download=type==='article'?'IJSSE_Article_Template.txt':'IJSSE_Copyright_Form_Template.txt';a.click();URL.revokeObjectURL(url)}
function subscribe(e){e.preventDefault();store.subscribers.push({name:newsName.value,email:newsEmail.value});save();newsMessage.textContent='Newsletter subscription saved.';e.target.reset()}
function sendFeedback(e){e.preventDefault();store.feedback.push({name:feedbackName.value,text:feedbackText.value,date:new Date().toLocaleDateString('en-IN')});save();e.target.reset();renderFeedback()}
function renderFeedback(){feedbackList.innerHTML=store.feedback.length?store.feedback.map(f=>`<div class="review"><b>${esc(f.name)}</b><small> · ${f.date}</small><p>${esc(f.text)}</p></div>`).join(''):'No feedback has been posted yet.'}
function contact(e){e.preventDefault();contactStatus.textContent='Thank you. Your message has been recorded in this demo.';e.target.reset()}
function esc(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
</script>
<!-- Role dashboards kept as separate page views in the same HTML file -->
<section id="editorBoard" class="page"><div class="card"><h2>Editor Dashboard</h2><p class="muted">Manage submitted manuscripts and update their editorial status.</p><div id="editorPapers"></div><button class="btn light" onclick="go('home')">Home</button></div></section>
<section id="reviewerBoard" class="page"><div class="card"><h2>Reviewer Dashboard</h2><p class="muted">Reviewer resources and assigned article list.</p><div id="reviewerAssigned" class="muted">No assignments are currently shown.</div><button class="btn light" onclick="go('home')">Home</button></div></section>
<script>
const originalLoginRole=loginRole;
loginRole=function(e,role){e.preventDefault();let email=document.getElementById(role+'LoginEmail').value,password=document.getElementById(role+'LoginPassword').value;let user=store.users[role].find(u=>u.email===email&&u.password===password);if(!user){alert('Account not found. Please register or check your login details.');return}logged[role]=user;if(role==='author'){authorWelcome.textContent='Welcome, '+user.name+' ('+user.email+')';renderAuthorPapers();go('author')}else if(role==='editor'){renderEditorBoard();go('editorBoard')}else{renderReviewerBoard();go('reviewerBoard')}};
function renderEditorBoard(){editorPapers.innerHTML=store.papers.length?`<table><tr><th>Paper</th><th>Author email</th><th>Status</th><th>Update status</th></tr>${store.papers.map((p,i)=>`<tr><td>${esc(p.title)}</td><td>${esc(p.email)}</td><td>${esc(p.status)}</td><td><select onchange="updatePaperStatus(${i},this.value)"><option ${p.status==='Submitted'?'selected':''}>Submitted</option><option ${p.status==='Under Review'?'selected':''}>Under Review</option><option ${p.status==='Revision Required'?'selected':''}>Revision Required</option><option ${p.status==='Accepted'?'selected':''}>Accepted</option><option ${p.status==='Rejected'?'selected':''}>Rejected</option></select></td></tr>`).join('')}</table>`:'<p class="muted">No manuscript submissions yet.</p>'}
function updatePaperStatus(i,status){store.papers[i].status=status;save();renderEditorBoard()}
function renderReviewerBoard(){reviewerAssigned.innerHTML=store.papers.length?store.papers.map((p,i)=>`<div class="review"><b>${esc(p.title)}</b><p class="muted">Status: ${esc(p.status)}</p><button class="btn light" onclick="submitReviewerComment(${i})">Submit Review Recommendation</button></div>`).join(''):'No manuscripts are available.'}
function submitReviewerComment(i){let comment=prompt('Enter your review recommendation or comments:');if(comment===null)return;store.papers[i].reviewers.push((logged.reviewer?logged.reviewer.name:'Reviewer')+': '+comment);save();alert('Review recommendation saved.')}
</script>
</body></html>
