<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f1f3f6"><title>Traffic Squad — Challan & case portal</title>
<style>
:root{--ink:#24303d;--muted:#74808d;--bg:#f1f3f6;--paper:#fff;--navy:#1d344c;--blue:#276b9a;--red:#b7453d;--pale:#e5edf3;--line:#dfe5e9}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.6 Arial,sans-serif}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button,.btn{border:0;border-radius:5px;padding:11px 15px;background:var(--blue);color:white;cursor:pointer;font-weight:bold;display:inline-block}button:hover,.btn:hover{background:var(--navy)}.outline{background:transparent;color:var(--navy);border:1px solid #c8d3db}.red{background:var(--red)}header{position:sticky;top:0;z-index:5;background:#fffF;border-bottom:1px solid var(--line)}nav,.wrap{max-width:1160px;margin:auto}nav{min-height:70px;padding:12px 22px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{font-size:20px;font-weight:900;letter-spacing:-.4px;color:var(--navy)}.brand span{color:var(--red)}.links{display:flex;gap:17px;align-items:center;flex-wrap:wrap}.links a{font-size:13px;font-weight:bold;color:#4f6271}.view{display:none;min-height:70vh}.view.active{display:block}.hero{background:linear-gradient(115deg,#18364f,#335f7e);color:white;border-radius:9px;max-width:1160px;min-height:370px;margin:18px auto 0;padding:48px 6%;display:flex;align-items:center;justify-content:space-between;gap:20px}.hero h1{font-size:clamp(38px,6vw,65px);line-height:1.05;margin:12px 0}.hero p{max-width:600px;color:#dfebf1}.hero .outline{color:white;border-color:#cddde6}.hero .eyebrow{color:#f1c57b}.heroicon{font-size:83px;color:#d9e8ef}.wrap{padding:42px 22px}.eyebrow{text-transform:uppercase;letter-spacing:1.6px;font-size:11px;color:var(--blue);font-weight:bold}.hero .eyebrow{color:#ebc987}.title{font-size:clamp(30px,4vw,44px);line-height:1.1;margin:7px 0}.sub{color:var(--muted);max-width:730px}.row{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:18px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.stat,.panel,.card{background:#fff;border:1px solid var(--line);border-radius:7px;padding:19px}.stat strong{font-size:26px;color:var(--navy)}.field{display:block;width:100%;padding:11px;margin-top:5px;border:1px solid #d3dbe1;border-radius:5px;color:var(--ink);background:#fff}label{display:block;font-size:13px;font-weight:bold;margin:10px 0}.two{display:grid;grid-template-columns:1fr 1fr;gap:18px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:6px 12px}.notice{background:#e8f0f5;border-left:3px solid var(--blue);padding:12px;margin:12px 0}.warn{background:#fff1e9;border-color:var(--red);color:#773e35}.status{min-height:22px;color:#277650;font-weight:bold}.meta{font-size:12px;color:var(--muted)}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:13px}th,td{text-align:left;padding:10px;border-bottom:1px solid var(--line)}th{background:#f3f6f8;color:#40576a}.badge{border-radius:15px;padding:4px 9px;font-size:11px;font-weight:bold;background:#e8f2eb;color:#28714d}.badge.due{background:#fff0db;color:#88621d}.badge.paid{background:#e5f1e8;color:#2e734d}.photo-preview{max-width:200px;max-height:140px;object-fit:cover;border-radius:5px;display:block;margin:10px 0}.receipt{border:1px dashed #91a1ac;padding:18px;margin-top:15px;background:#fbfcfd}.empty{padding:16px;color:var(--muted)}.toast{position:fixed;right:20px;bottom:20px;background:var(--navy);color:white;padding:12px 16px;border-radius:5px;display:none;z-index:10}footer{background:#1b344a;color:#ecf0f3;padding:22px}.foot{max-width:1160px;margin:auto;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}.foot a{text-decoration:underline;text-underline-offset:3px}@media(max-width:760px){.grid,.two{grid-template-columns:1fr 1fr}.heroicon{display:none}.links{gap:10px}}@media(max-width:560px){nav{align-items:flex-start;flex-direction:column}.grid,.two,.formgrid{grid-template-columns:1fr}.wrap{padding:32px 16px}.hero{margin:10px;min-height:320px;padding:32px 22px}}
</style></head><body>
<header><nav><a class="brand" href="#home">TRAFFIC<span>SQUAD</span></a><div class="links"><a href="#home">Home</a><a href="#lookup">Check challan</a><a href="#cases">My cases</a><a href="#police">Police desk</a><a href="#admin">Admin reports</a></div></nav></header>
<main>
<section class="view" id="home"><div class="hero"><div><div class="eyebrow">Road safety. Clear records.</div><h1>Every report.<br>Accountable.</h1><p>Check traffic challans, review case details, and see evidence submitted by the traffic squad. Police can create a demonstration FIR with a proof image and fine.</p><div class="actions"><a class="btn" href="#lookup">Check a challan</a><a class="btn outline" href="#police">Police desk</a></div></div><div class="heroicon" aria-hidden="true">⚑</div></div><div class="wrap"><div class="row"><div><div class="eyebrow">Digital traffic services</div><h2 class="title">One place to review a case.</h2></div></div><div class="grid"><article class="stat"><strong>01</strong><h3>Find a challan</h3><p class="meta">Look up demo penalties using a vehicle number or case ID.</p></article><article class="stat"><strong>02</strong><h3>Review evidence</h3><p class="meta">Police records include the violation, location, and optional proof photo.</p></article><article class="stat"><strong>03</strong><h3>Daily reporting</h3><p class="meta">Administrators can see recent cases and totals in the local demo report.</p></article></div><div class="notice warn"><b>Educational demo only:</b> Cases and fines here are not official legal notices. Do not upload sensitive or real case information.</div></div></section>
<section class="view" id="lookup"><div class="wrap"><div class="eyebrow">Vehicle owner portal</div><h1 class="title">Look up a challan or case.</h1><p class="sub">Enter a vehicle registration or case ID to view its demonstration details.</p><div class="two"><form id="lookupForm" class="panel"><label>Vehicle number or case ID<input class="field" name="query" placeholder="e.g. TN-01-AB-1234" required></label><button>Search records</button><p class="meta">Demo examples: TN-01-AB-1234 and KA-03-CD-5678.</p></form><div class="panel"><h2>Traffic rules</h2><p class="sub">Select the relevant rule when recording a violation. Fine amounts shown below are illustrative and must not be used as current legal advice.</p><div id="rules"></div></div></div><div id="lookupResults" class="panel" style="margin-top:18px"><p class="empty">Search by vehicle number or case ID to see a record.</p></div></div></section>
<section class="view" id="cases"><div class="wrap"><div class="eyebrow">Owner access</div><h1 class="title">Your registered cases.</h1><div class="two"><form id="ownerForm" class="panel"><h2>Register / find your vehicle</h2><label>Owner name<input class="field" name="name" required></label><label>Email<input class="field" name="email" type="email" required></label><label>Vehicle registration<input class="field" name="vehicle" required></label><button>Save owner details</button><p class="status" id="ownerStatus"></p></form><section class="panel"><h2>Case history</h2><div id="ownerCases"></div></section></div></div></section>
<section class="view" id="police"><div class="wrap"><div class="eyebrow">Traffic police workspace · demo</div><h1 class="title">Record a violation.</h1><p class="sub">Create a case record and attach an optional vehicle photo as evidence. This browser-only form does not create an official FIR.</p><div class="two"><form id="caseForm" class="panel"><h2>New case / challan</h2><div class="formgrid"><label>Officer name<input class="field" name="officer" required></label><label>Badge / ID<input class="field" name="badge" required></label><label>Vehicle number<input class="field" name="vehicle" required></label><label>Owner name<input class="field" name="owner" required></label><label>Violation<select class="field" name="violation" id="ruleSelect"></select></label><label>Fine amount (₹)<input class="field" name="fine" type="number" min="0" required></label><label>Date & time<input class="field" name="date" type="datetime-local" required></label><label>Location<input class="field" name="location" required></label></div><label>Case details<textarea class="field" name="details" rows="3" required></textarea></label><label>Proof photo<input class="field" name="photo" type="file" accept="image/*"></label><img id="photoPreview" class="photo-preview" alt="Proof image preview" hidden><label><input type="checkbox" required> I confirm this is demonstration data and not an official filing.</label><button>Create demo case</button><p class="status" id="caseStatus"></p></form><div class="panel"><h2>Recent traffic reports</h2><p class="meta">New updates from records stored in this browser.</p><div id="policeFeed"></div></div></div></div></section>
<section class="view" id="admin"><div class="wrap"><div class="eyebrow">Traffic administration · demo</div><h1 class="title">Daily case report.</h1><div class="grid"><div class="stat"><div class="meta">Cases recorded</div><strong id="caseCount">0</strong></div><div class="stat"><div class="meta">Outstanding fines</div><strong id="fineCount">₹0</strong></div><div class="stat"><div class="meta">Officers active</div><strong id="officerCount">0</strong></div></div><div class="panel" style="margin-top:18px"><div class="row"><h2>Case register</h2><button class="outline" id="downloadReport">Download report</button></div><div class="tablewrap" id="adminTable"></div></div><div class="panel" style="margin-top:18px"><h2>Police access list</h2><p class="sub">This demo lists officers who have created a case. Production authentication and access controls are not implemented.</p><div id="officerList"></div></div></div></section>
</main><footer><div class="foot"><a class="brand" style="color:white" href="#home">TRAFFIC SQUAD</a><span>Responsible roads start with clear information.</span><span>Experiment 26 · <a href="../Exp-25/RoadsideAssist.html">← RoadReady</a> · <a href="../Exp-27/BusPass.html">Next: digital bus pass →</a></span></div></footer><div class="toast" id="toast" role="status"></div>
<script>
const $=s=>document.querySelector(s),rules=[{name:"Signal violation",fine:1000},{name:"No helmet / seat belt",fine:500},{name:"Speed limit violation",fine:1500},{name:"Parking violation",fine:500},{name:"No valid documents",fine:1000},{name:"Other violation",fine:500}],seed=[{id:"TS-2026-1042",vehicle:"TN-01-AB-1234",owner:"Demo Vehicle Owner",violation:rules[0].name,fine:1000,location:"Anna Salai, Chennai",date:"2026-11-18T10:15",officer:"Officer Kumar",badge:"TN-204",details:"Signal violation at the junction. Demonstration record only.",photo:"",status:"Unpaid"},{id:"TS-2026-1043",vehicle:"KA-03-CD-5678",owner:"Sample Driver",violation:rules[1].name,fine:500,location:"MG Road, Bengaluru",date:"2026-11-19T15:40",officer:"Officer Rao",badge:"KA-118",details:"Safety equipment violation. Demonstration record only.",photo:"",status:"Unpaid"}];
function load(k,fb){try{return JSON.parse(localStorage.getItem("trafficsquad-"+k))??fb}catch{return fb}}function save(k,v){localStorage.setItem("trafficsquad-"+k,JSON.stringify(v))}let cases=load("cases",seed),owner=load("owner",null),photoData="";
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}function money(n){return"₹"+Number(n).toLocaleString("en-IN")}function toast(s){const t=$("#toast");t.textContent=s;t.style.display="block";setTimeout(()=>t.style.display="none",2200)}
function renderRules(){$("#rules").innerHTML=rules.map(r=>`<div class="row"><span>${esc(r.name)}</span><b>${money(r.fine)}*</b></div>`).join("")+'<p class="meta">*Illustrative demo amounts only.</p>';$("#ruleSelect").innerHTML=rules.map(r=>`<option value="${esc(r.name)}" data-fine="${r.fine}">${esc(r.name)} — ${money(r.fine)}</option>`).join("");$("#caseForm").elements.fine.value=rules[0].fine}
function caseCard(c){return `<article class="card"><div class="row"><b>${esc(c.id)}</b><span class="badge ${c.status==="Paid"?"paid":"due"}">${esc(c.status)}</span></div><h3>${esc(c.vehicle)} · ${esc(c.violation)}</h3><p>${esc(c.owner)} · ${esc(c.location)}</p><p class="meta">${esc(c.date)} · Officer ${esc(c.officer)}</p><p>${esc(c.details)}</p>${c.photo?`<img class="photo-preview" src="${c.photo}" alt="Case evidence">`:""}<p><b>Fine: ${money(c.fine)}</b></p></article>`}
function lookup(q){q=q.trim().toLowerCase();const found=cases.filter(c=>c.id.toLowerCase()===q||c.vehicle.toLowerCase()===q);$("#lookupResults").innerHTML=found.length?found.map(caseCard).join(""):'<p class="empty">No matching record found. Check the vehicle number or case ID.</p>'}
function renderOwner(){const list=owner?cases.filter(c=>c.vehicle.toLowerCase()===owner.vehicle.toLowerCase()):[];$("#ownerCases").innerHTML=list.length?list.map(caseCard).join(""):'<p class="empty">Save a vehicle profile to see matching demo cases.</p>'}
function renderAdmin(){const day=new Date().toISOString().slice(0,10),today=cases.filter(c=>c.date.slice(0,10)===day);$("#caseCount").textContent=today.length;$("#fineCount").textContent=money(cases.filter(c=>c.status!=="Paid").reduce((n,c)=>n+Number(c.fine),0));$("#officerCount").textContent=new Set(cases.map(c=>c.badge)).size;$("#adminTable").innerHTML=cases.length?`<table><thead><tr><th>Case</th><th>Date</th><th>Vehicle / owner</th><th>Violation</th><th>Fine</th><th>Officer</th><th>Status</th></tr></thead><tbody>${cases.map(c=>`<tr><td>${esc(c.id)}</td><td>${esc(c.date)}</td><td>${esc(c.vehicle)}<br>${esc(c.owner)}</td><td>${esc(c.violation)}</td><td>${money(c.fine)}</td><td>${esc(c.officer)}</td><td>${esc(c.status)}</td></tr>`).join("")}</tbody></table>`:'<p class="empty">No cases recorded.</p>';const officers=[...new Map(cases.map(c=>[c.badge,{name:c.officer,badge:c.badge}])).values()];$("#officerList").innerHTML=officers.map(o=>`<div class="row">${esc(o.name)} <span class="meta">Badge ${esc(o.badge)}</span></div>`).join("")||'<p class="empty">No police records.</p>';$("#policeFeed").innerHTML=cases.slice(0,5).map(c=>`<div class="card" style="margin:8px 0"><b>${esc(c.id)}</b><div>${esc(c.vehicle)} · ${esc(c.violation)}</div><span class="meta">${esc(c.location)}</span></div>`).join("")||'<p class="empty">No recent reports.</p>'}
function route(){const id=location.hash.slice(1)||"home";if(!document.getElementById(id)?.classList.contains("view")){location.hash="#home";return}document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===id));if(id==="admin"||id==="police")renderAdmin();if(id==="cases")renderOwner();window.scrollTo(0,0)}window.addEventListener("hashchange",route);
$("#lookupForm").addEventListener("submit",e=>{e.preventDefault();lookup(new FormData(e.target).get("query"))});
$("#ownerForm").addEventListener("submit",e=>{e.preventDefault();owner=Object.fromEntries(new FormData(e.target));owner.vehicle=owner.vehicle.toUpperCase();save("owner",owner);$("#ownerStatus").textContent="Owner profile saved locally.";renderOwner()});
$("#ruleSelect").addEventListener("change",e=>{$("#caseForm").elements.fine.value=e.target.selectedOptions[0].dataset.fine});
$("#caseForm").elements.date.value=new Date(Date.now()-new Date().getTimezoneOffset()*60000).toISOString().slice(0,16);
$("#caseForm").elements.photo.addEventListener("change",e=>{const f=e.target.files[0];if(!f){photoData="";$("#photoPreview").hidden=true;return}if(f.size>1500000){e.target.value="";toast("Choose a proof image smaller than 1.5 MB.");return}const reader=new FileReader();reader.onload=()=>{photoData=reader.result;$("#photoPreview").src=photoData;$("#photoPreview").hidden=false};reader.onerror=()=>toast("Could not read the selected image.");reader.readAsDataURL(f)});
$("#caseForm").addEventListener("submit",e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target));d.id="TS-"+new Date().getFullYear()+"-"+String(Date.now()).slice(-6);d.vehicle=d.vehicle.toUpperCase();d.status="Unpaid";d.photo=photoData;cases.unshift(d);save("cases",cases);$("#caseStatus").textContent=`Demo case ${d.id} recorded. This is not an official FIR.`;e.target.reset();photoData="";$("#photoPreview").hidden=true;renderAdmin();});
$("#downloadReport").addEventListener("click",()=>{const csv=["Case,Date,Vehicle,Owner,Violation,Fine,Officer,Status",...cases.map(c=>[c.id,c.date,c.vehicle,c.owner,c.violation,c.fine,c.officer,c.status].map(x=>`"${String(x).replace(/"/g,'""')}"`).join(","))].join("\r\n"),a=document.createElement("a");a.href=URL.createObjectURL(new Blob([csv],{type:"text/csv"}));a.download="traffic-squad-demo-report.csv";a.click();URL.revokeObjectURL(a.href)});
renderRules();renderAdmin();route();
</script></body></html>
