<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ReNewMarket | Pre-loved Marketplace</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f3f7f4;color:#20352b}header{background:#174d3a;color:white;padding:17px 5%;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}h1{margin:0;font-size:25px}nav{display:flex;gap:5px;flex-wrap:wrap}button{border:0;border-radius:8px;padding:10px 13px;cursor:pointer;font-weight:bold;background:#e6f0e9;color:#174d3a}nav button{background:transparent;color:white}nav button.active,nav button:hover{background:#32775b}.page{display:none;max-width:1100px;margin:27px auto;padding:0 18px}.page.active{display:block}.hero{padding:42px 30px;border-radius:16px;background:linear-gradient(120deg,#174d3a,#52916e);color:white}.hero h2{font-size:34px;margin:0 0 12px}.card{background:white;padding:22px;border-radius:14px;margin:16px 0;box-shadow:0 5px 18px #163e2a10}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:15px}.item{border:1px solid #dce9df;border-radius:12px;padding:15px}.emoji{font-size:48px;text-align:center;background:#edf5ef;border-radius:10px;padding:18px}.price{font-weight:bold;font-size:19px;color:#26734d}.field{margin:12px 0}.field label{display:block;font-weight:bold;margin-bottom:6px}input,select,textarea{width:100%;padding:11px;border:1px solid #cbd9ce;border-radius:8px;font:inherit}textarea{min-height:85px}.primary{background:#23734d;color:white}.muted{color:#718177}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}table{width:100%;border-collapse:collapse;margin-top:12px}td,th{text-align:left;padding:11px;border-bottom:1px solid #e3ebe5}th{background:#edf5ef}.tag{display:inline-block;background:#e5f2e8;color:#286443;padding:5px 9px;border-radius:18px;font-size:12px}footer{text-align:center;padding:25px;color:#75847a}@media(max-width:600px){header{padding:15px}nav{width:100%}.hero h2{font-size:27px}}
</style></head><body>
<header><h1>♻️ ReNewMarket</h1><nav><button class="active" onclick="show('home',this)">Home</button><button onclick="show('browse',this)">Browse Items</button><button onclick="show('sell',this)">Sell an Item</button><button onclick="show('cart',this)">Cart <span id="count">0</span></button><button onclick="show('orders',this)">My Orders</button><button onclick="show('account',this)">Account</button><button onclick="show('admin',this)">Admin</button></nav></header>
<main>
<section id="home" class="page active"><div class="hero"><h2>Give pre-loved items a new life.</h2><p>Buy and sell quality second-hand products at affordable prices while reducing waste.</p><button class="primary" onclick="show('browse')">Explore Marketplace →</button></div><div class="card"><h2>Shop by category</h2><div class="grid"><div class="item"><div class="emoji">📱</div><h3>Electronics</h3><button onclick="filter('Electronics')">Browse</button></div><div class="item"><div class="emoji">🪑</div><h3>Furniture</h3><button onclick="filter('Furniture')">Browse</button></div><div class="item"><div class="emoji">👕</div><h3>Clothing</h3><button onclick="filter('Clothing')">Browse</button></div><div class="item"><div class="emoji">📚</div><h3>Books</h3><button onclick="filter('Books')">Browse</button></div></div></div></section>
<section id="browse" class="page"><div class="card"><h2>Available Second-hand Items</h2><div class="grid"><div class="field"><label>Search</label><input id="query" oninput="renderItems()" placeholder="Search item name"></div><div class="field"><label>Category</label><select id="cat" onchange="renderItems()"><option value="">All categories</option><option>Electronics</option><option>Furniture</option><option>Clothing</option><option>Books</option><option>Sports</option><option>Other</option></select></div><div class="field"><label>Condition</label><select id="condition" onchange="renderItems()"><option value="">Any condition</option><option>Like New</option><option>Good</option><option>Used</option></select></div></div><div id="items" class="grid"></div></div></section>
<section id="details" class="page"><div class="card" id="detail"></div></section>
<section id="sell" class="page"><div class="card"><h2>List an Item for Sale</h2><form onsubmit="listItem(event)"><div class="grid"><div class="field"><label>Item name</label><input id="itemName" required></div><div class="field"><label>Category</label><select id="itemCat"><option>Electronics</option><option>Furniture</option><option>Clothing</option><option>Books</option><option>Sports</option><option>Other</option></select></div><div class="field"><label>Price (₹)</label><input id="itemPrice" type="number" min="1" required></div><div class="field"><label>Condition</label><select id="itemCondition"><option>Like New</option><option>Good</option><option>Used</option></select></div><div class="field"><label>Seller name</label><input id="seller" required></div><div class="field"><label>Contact email</label><input id="sellerEmail" type="email" required></div><div class="field"><label>Icon / Emoji</label><input id="itemIcon" value="📦"></div></div><div class="field"><label>Description</label><textarea id="itemDesc" required></textarea></div><button class="primary">Submit Listing</button></form><p id="sellMsg" class="muted"></p></div></section>
<section id="cart" class="page"><div class="card"><h2>Shopping Cart</h2><div id="cartRows"></div><h3 id="total"></h3><button class="primary" onclick="show('checkout')">Continue to Checkout</button></div></section>
<section id="checkout" class="page"><div class="card"><h2>Checkout</h2><form onsubmit="checkout(event)"><div class="grid"><div class="field"><label>Buyer name</label><input id="buyer" required></div><div class="field"><label>Email</label><input id="buyerEmail" type="email" required></div><div class="field"><label>Mobile number</label><input id="buyerMobile" pattern="[0-9]{10}" maxlength="10" required></div><div class="field"><label>Payment method</label><select id="pay"><option>Cash on Delivery</option><option>UPI (Demo)</option><option>Card (Demo)</option></select></div></div><div class="field"><label>Delivery address</label><textarea id="address" required></textarea></div><p id="checkoutTotal" class="price"></p><button class="primary">Place Order</button></form><p id="checkoutMsg"></p></div></section>
<section id="orders" class="page"><div class="card"><h2>My Orders</h2><div id="orderRows">No orders yet.</div></div></section>
<section id="account" class="page"><div class="card"><h2>Customer Account</h2><p>Create a demo account to keep your marketplace contact details.</p><form onsubmit="register(event)"><div class="field"><label>Full name</label><input id="accountName" required></div><div class="field"><label>Email</label><input id="accountEmail" type="email" required></div><div class="field"><label>Password</label><input id="accountPass" type="password" minlength="4" required></div><button class="primary">Register</button></form><p id="accountMsg"></p></div></section>
<section id="admin" class="page"><div class="card"><h2>Admin Login</h2><p class="muted">Demo credentials: admin / admin123</p><form onsubmit="adminLogin(event)"><div class="field"><label>Username</label><input id="adminUser" required></div><div class="field"><label>Password</label><input id="adminPass" type="password" required></div><button class="primary">Login</button></form><p id="adminMsg"></p></div><div id="adminPanel" class="card" style="display:none"><h2>Marketplace Administration</h2><h3>Listings</h3><div id="adminItems"></div><h3>Orders</h3><div id="adminOrders"></div></div></section>
</main><footer>ReNewMarket | Second-hand Marketplace | Internet Programming Lab Demo</footer>
<script>
let products=[{id:1,name:'Smartphone',cat:'Electronics',price:6500,condition:'Good',icon:'📱',seller:'Arun',desc:'Fully working smartphone in good condition.'},{id:2,name:'Study Table',cat:'Furniture',price:1800,condition:'Used',icon:'🪑',seller:'Meena',desc:'Strong wooden study table with minor marks.'},{id:3,name:'Fiction Book Set',cat:'Books',price:450,condition:'Like New',icon:'📚',seller:'Ravi',desc:'A set of popular fiction books.'},{id:4,name:'Sports Shoes',cat:'Sports',price:900,condition:'Good',icon:'👟',seller:'Kiran',desc:'Comfortable shoes, gently used.'},{id:5,name:'Denim Jacket',cat:'Clothing',price:700,condition:'Like New',icon:'🧥',seller:'Anu',desc:'Stylish jacket in excellent condition.'}];
let cart=JSON.parse(localStorage.getItem('rnCart')||'[]'),orders=JSON.parse(localStorage.getItem('rnOrders')||'[]'),users=JSON.parse(localStorage.getItem('rnUsers')||'[]'),admin=false;
function show(id,btn){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');if(id==='browse')renderItems();if(id==='cart')renderCart();if(id==='orders')renderOrders();if(id==='checkout')checkoutTotal.textContent='Total: ₹'+sum();if(id==='admin'&&admin)renderAdmin();window.scrollTo(0,0)}
function filter(c){cat.value=c;show('browse');renderItems()}
function renderItems(){let q=query.value.toLowerCase(),c=cat.value,k=condition.value;let a=products.filter(p=>p.name.toLowerCase().includes(q)&&(!c||p.cat===c)&&(!k||p.condition===k));items.innerHTML=a.map(p=>`<div class="item"><div class="emoji">${p.icon}</div><h3>${p.name}</h3><span class="tag">${p.cat} · ${p.condition}</span><p class="price">₹${p.price}</p><p class="muted">${p.desc}</p><div class="actions"><button onclick="viewItem(${p.id})">View Details</button><button class="primary" onclick="addCart(${p.id})">Add to Cart</button></div></div>`).join('')||'<p>No matching items found.</p>'}
function viewItem(id){let p=products.find(x=>x.id===id);detail.innerHTML=`<button onclick="show('browse')">← Back</button><div class="emoji">${p.icon}</div><h2>${p.name}</h2><span class="tag">${p.cat} · ${p.condition}</span><h3 class="price">₹${p.price}</h3><p>${p.desc}</p><p>Seller: ${p.seller}</p><button class="primary" onclick="addCart(${p.id})">Add to Cart</button>`;show('details')}
function saveCart(){localStorage.setItem('rnCart',JSON.stringify(cart));count.textContent=cart.reduce((s,x)=>s+x.qty,0)}
function addCart(id){let x=cart.find(a=>a.id===id);if(x)x.qty++;else cart.push({id,qty:1});saveCart();alert('Item added to cart.')}
function sum(){return cart.reduce((s,x)=>s+products.find(p=>p.id===x.id).price*x.qty,0)}
function renderCart(){cartRows.innerHTML=cart.length?'<table><tr><th>Item</th><th>Price</th><th>Quantity</th><th>Action</th></tr>'+cart.map(x=>{let p=products.find(a=>a.id===x.id);return `<tr><td>${p.name}</td><td>₹${p.price}</td><td><button onclick="qty(${p.id},-1)">−</button> ${x.qty} <button onclick="qty(${p.id},1)">+</button></td><td><button onclick="removeItem(${p.id})">Remove</button></td></tr>`}).join('')+'</table>':'Your cart is empty.';total.textContent='Total: ₹'+sum()}
function qty(id,n){let x=cart.find(a=>a.id===id);x.qty+=n;if(x.qty<1)cart=cart.filter(a=>a.id!==id);saveCart();renderCart()}
function removeItem(id){cart=cart.filter(x=>x.id!==id);saveCart();renderCart()}
function listItem(e){e.preventDefault();products.push({id:Date.now(),name:itemName.value,cat:itemCat.value,price:Number(itemPrice.value),condition:itemCondition.value,icon:itemIcon.value||'📦',seller:seller.value,desc:itemDesc.value});sellMsg.textContent='Your item listing has been added to the marketplace.';e.target.reset();renderItems()}
function checkout(e){e.preventDefault();if(!cart.length){checkoutMsg.textContent='Your cart is empty.';return}let o={id:'RN'+(1001+orders.length),buyer:buyer.value,email:buyerEmail.value,mobile:buyerMobile.value,address:address.value,payment:pay.value,total:sum(),items:cart.map(x=>({...x})),status:'Order Placed'};orders.push(o);localStorage.setItem('rnOrders',JSON.stringify(orders));cart=[];saveCart();checkoutMsg.textContent='Order placed successfully. Order ID: '+o.id;e.target.reset();checkoutTotal.textContent=''}
function renderOrders(){orderRows.innerHTML=orders.length?'<table><tr><th>Order ID</th><th>Items</th><th>Total</th><th>Status</th></tr>'+orders.map(o=>`<tr><td>${o.id}</td><td>${o.items.map(x=>{let p=products.find(a=>a.id===x.id);return p?p.name+' × '+x.qty:'Item'}) .join(', ')}</td><td>₹${o.total}</td><td>${o.status}</td></tr>`).join('')+'</table>':'No orders yet.'}
function register(e){e.preventDefault();users.push({name:accountName.value,email:accountEmail.value,password:accountPass.value});localStorage.setItem('rnUsers',JSON.stringify(users));accountMsg.textContent='Account created successfully.';e.target.reset()}
function adminLogin(e){e.preventDefault();if(adminUser.value==='admin'&&adminPass.value==='admin123'){admin=true;adminPanel.style.display='block';adminMsg.textContent='Logged in successfully.';renderAdmin()}else adminMsg.textContent='Invalid admin credentials.'}
function renderAdmin(){adminItems.innerHTML='<table><tr><th>Item</th><th>Seller</th><th>Price</th><th>Action</th></tr>'+products.map(p=>`<tr><td>${p.name}</td><td>${p.seller}</td><td>₹${p.price}</td><td><button onclick="deleteListing(${p.id})">Remove</button></td></tr>`).join('')+'</table>';adminOrders.innerHTML=orders.length?'<table><tr><th>Order</th><th>Buyer</th><th>Status</th><th>Update</th></tr>'+orders.map((o,i)=>`<tr><td>${o.id}</td><td>${o.buyer}</td><td>${o.status}</td><td><select onchange="updateStatus(${i},this.value)"><option>Order Placed</option><option>Processing</option><option>Shipped</option><option>Delivered</option><option>Cancelled</option></select></td></tr>`).join('')+'</table>':'No orders yet.'}
function deleteListing(id){products=products.filter(p=>p.id!==id);renderAdmin();renderItems()}
function updateStatus(i,s){orders[i].status=s;localStorage.setItem('rnOrders',JSON.stringify(orders));renderAdmin()}
renderItems();saveCart();
</script></body></html>
