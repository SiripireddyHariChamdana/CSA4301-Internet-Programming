<style>
:root{--ink:#292c25;--muted:#74786f;--cream:#f7f4ed;--white:#fffdf8;--green:#26372b;--gold:#bd995c;--line:#e4dfd4;--serif:Georgia,"Times New Roman",serif}*{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--ink);font:15px/1.65 Arial,sans-serif}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button,.btn{border:1px solid var(--gold);background:var(--gold);color:#fff;padding:12px 18px;cursor:pointer;display:inline-block;font-weight:bold;letter-spacing:.2px}button:hover,.btn:hover{background:#9e7c44}.ghost{background:transparent;color:white}.darkbtn{background:var(--green);border-color:var(--green)}header{position:sticky;top:0;z-index:5;background:#f7f4edf2;backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}nav{max-width:1160px;margin:auto;padding:13px 24px;min-height:70px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font:500 24px var(--serif);letter-spacing:1px;color:var(--green)}.brand small{font:10px Arial,sans-serif;letter-spacing:3px;display:block;text-align:center;color:var(--gold);text-transform:uppercase}.links{display:flex;align-items:center;gap:20px;flex-wrap:wrap}.links a{font-size:12px;letter-spacing:1px;text-transform:uppercase}.links a:hover{color:#a77f42}.view{display:none;min-height:70vh}.view.active{display:block}.hero{min-height:590px;display:flex;align-items:center;position:relative;background:linear-gradient(90deg,#1d241edc,#1d241e40),url('https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=1900&q=88') center/cover;color:#fff}.hero-inner{max-width:1160px;width:100%;margin:auto;padding:65px 24px}.eyebrow{text-transform:uppercase;letter-spacing:3px;font-size:11px;color:var(--gold);font-weight:bold}.hero h1{font:500 clamp(49px,8vw,87px)/.98 var(--serif);max-width:690px;margin:17px 0}.hero p{color:#eee9df;max-width:500px;font-size:17px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:25px}.wrap{max-width:1160px;margin:auto;padding:56px 24px}.title{font:500 clamp(33px,5vw,53px)/1.08 var(--serif);margin:8px 0}.sub{color:var(--muted);max-width:700px}.row{display:flex;justify-content:space-between;align-items:end;gap:18px;flex-wrap:wrap;margin-bottom:24px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.dish{background:var(--white);border:1px solid var(--line)}.dish-image{height:190px;background-position:center;background-size:cover}.dish:nth-child(1) .dish-image{background-image:url('https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=900&q=82')}.dish:nth-child(2) .dish-image{background-image:url('https://images.unsplash.com/photo-1547592180-31f46f5c2d5a?auto=format&fit=crop&w=900&q=82')}.dish:nth-child(3) .dish-image{background-image:url('https://images.unsplash.com/photo-1576402187878-974f70c890a5?auto=format&fit=crop&w=900&q=82')}.dish:nth-child(4) .dish-image{background-image:url('https://images.unsplash.com/photo-1547592180-29f1f7e5bff8?auto=format&fit=crop&w=900&q=82')}.dish-copy{padding:17px}.dish-copy h3{font:500 21px var(--serif);margin:0}.dish-copy p{color:var(--muted);font-size:13px}.dish-bottom{display:flex;justify-content:space-between;align-items:center;color:#96723a;font-weight:bold}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:23px 0}.tabs button{background:transparent;color:var(--green);border-color:var(--line);padding:9px 14px}.tabs button.active,.tabs button:hover{background:var(--green);color:white;border-color:var(--green)}.panel{background:var(--white);border:1px solid var(--line);padding:23px}.two{display:grid;grid-template-columns:1fr 1fr;gap:23px}label{display:block;font-size:13px;font-weight:bold;margin:11px 0}.field{width:100%;padding:11px;border:1px solid #d8d2c7;border-radius:2px;background:#fff;color:var(--ink);margin-top:5px}.gallery{display:grid;grid-template-columns:1.15fr 1fr 1fr;gap:12px}.gallery img{width:100%;height:230px;object-fit:cover}.gallery img:first-child{grid-row:span 2;height:472px}.quote{font:italic 25px/1.5 var(--serif);color:var(--green)}.notice{padding:14px;background:#f2ede1;border-left:3px solid var(--gold)}.meta{color:var(--muted);font-size:12px}.toast{position:fixed;right:20px;bottom:20px;background:var(--green);color:white;padding:13px 18px;display:none;z-index:9}footer{background:#1d2c21;color:#eee9df;padding:28px 24px}.foot{max-width:1160px;margin:auto;display:flex;justify-content:space-between;align-items:center;gap:18px;flex-wrap:wrap}.foot a{text-decoration:underline;text-underline-offset:3px}.faq details{padding:14px;border-bottom:1px solid var(--line)}.faq summary{cursor:pointer;font-weight:bold}@media(max-width:760px){.grid,.two{grid-template-columns:1fr 1fr}.hero{min-height:500px}.gallery{grid-template-columns:1fr 1fr}.gallery img:first-child{grid-row:auto;height:230px}}@media(max-width:560px){nav{align-items:flex-start;flex-direction:column}.links{gap:11px}.grid,.two,.gallery{grid-template-columns:1fr}.wrap{padding:38px 18px}.hero{min-height:440px}.gallery img,.gallery img:first-child{height:230px}}
</style>
</head>
<body>
<header><nav><a class="brand" href="#home">Gourmet Haven<small>Seasonal · Considered · Yours</small></a><div class="links"><a href="#home">Home</a><a href="#menu">Menu</a><a href="#story">Our story</a><a href="#gallery">Gallery</a><a href="#contact">Contact</a></div><a class="btn darkbtn" href="#reserve">Reserve</a></nav></header>
<main>
<section class="view" id="home"><div class="hero"><div class="hero-inner"><div class="eyebrow">An invitation to linger</div><h1>An evening,<br>well spent.</h1><p>Seasonal ingredients, thoughtful cooking, and a table set for good company. Join us in the heart of the city.</p><div class="actions"><a class="btn" href="#reserve">Reserve a table</a><a class="btn ghost" href="#menu">Explore the menu</a></div></div></div><div class="wrap"><div class="row"><div><div class="eyebrow">A taste of the season</div><h2 class="title">From our kitchen</h2></div><a class="btn darkbtn" href="#menu">View full menu</a></div><div class="grid" id="homeDishes"></div></div><div class="wrap" style="padding-top:0"><div class="panel"><div class="eyebrow">An evening at Gourmet Haven</div><p class="quote">“The best meals leave room for conversation, another bite, and one more story.”</p><a href="#story">Get to know our kitchen →</a></div></div></section>
<section class="view" id="menu"><div class="wrap"><div class="eyebrow">The menu</div><h1 class="title">A little of what the season brings.</h1><p class="sub">Our menu changes with the market. Please tell your server about dietary needs; we’re happy to guide you.</p><div class="tabs" id="menuTabs"><button class="active" data-category="All">All</button><button data-category="Starters">Starters</button><button data-category="Mains">Mains</button><button data-category="Desserts">Desserts</button><button data-category="Drinks">Drinks</button></div><div class="grid" id="menuGrid"></div><p class="meta">Prices shown in USD. Menu is a seasonal demonstration.</p></div></section>
<section class="view" id="reserve"><div class="wrap"><div class="eyebrow">Your table is waiting</div><h1 class="title">Make a reservation.</h1><div class="two"><div class="panel"><p class="sub">For parties of seven or more, call (555) 010-6832. We’ll confirm your reservation by email.</p><p><b>Tuesday–Thursday</b> · 5:30–10 pm</p><p><b>Friday–Saturday</b> · 5–10:30 pm</p><p><b>Sunday</b> · 5–9 pm</p><div class="notice">Please let us know about allergies or accessibility needs when you book.</div></div><form id="reserveForm" class="panel"><label>Your name<input class="field" name="name" autocomplete="name" required></label><label>Email address<input class="field" type="email" name="email" autocomplete="email" required></label><div class="two"><label>Date<input class="field" name="date" type="date" required></label><label>Time<select class="field" name="time"><option>5:30 pm</option><option>6:00 pm</option><option>6:30 pm</option><option>7:00 pm</option><option>7:30 pm</option><option>8:00 pm</option><option>8:30 pm</option></select></label></div><label>Guests<select class="field" name="guests"><option>1 guest</option><option>2 guests</option><option>3 guests</option><option>4 guests</option><option>5 guests</option><option>6 guests</option></select></label><label>Notes or dietary requests<textarea class="field" name="notes" rows="3" placeholder="Optional"></textarea></label><button>Request a table</button><p id="reserveMsg" class="meta" role="status"></p><p class="meta">Demo only: this request is not transmitted to the restaurant.</p></form></div></div></section>
<section class="view" id="story"><div class="wrap"><div class="eyebrow">Our story</div><h1 class="title">Good food begins with good things.</h1><div class="two"><div><p class="sub">Gourmet Haven is a neighborhood dining room built around the idea that the best meals feel both considered and effortless. We cook with the seasons, work closely with growers and makers, and make space for the people around the table.</p><p class="sub">Our menu is guided by the market and shaped by our culinary team’s curiosity. Familiar ingredients meet a few unexpected details; nothing is there without a reason.</p><p class="sub">Come for a celebration, a quiet dinner, or simply a plate worth slowing down for. There’s always a seat for you.</p></div><div class="panel"><div class="eyebrow">Meet the kitchen</div><h2 class="title">Chef Elena Park</h2><p class="sub">Elena's cooking brings together seasonal produce, generous hospitality, and techniques learned in kitchens around the world. She leads a team that values craftsmanship, care, and letting ingredients speak.</p><div class="notice">Our promise: seasonal menus, thoughtfully sourced ingredients, and a warm welcome.</div></div></div></div></section>
<section class="view" id="gallery"><div class="wrap"><div class="eyebrow">Around the table</div><h1 class="title">A glimpse of the Haven.</h1><p class="sub">A few moments from the dining room and kitchen. Images are supplied by Unsplash and require an internet connection.</p><div class="gallery"><img alt="Dinner table in a warm restaurant" src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=1000&q=85"><img alt="Carefully plated seasonal dish" src="https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=900&q=82"><img alt="Restaurant dining room" src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=900&q=82"><img alt="Freshly prepared meal" src="https://images.unsplash.com/photo-1547592180-31f46f5c2d5a?auto=format&fit=crop&w=900&q=82"><img alt="A table ready for dinner" src="https://images.unsplash.com/photo-1515003197210-e0cd7184f8b5?auto=format&fit=crop&w=900&q=82"></div><div class="panel" style="margin-top:20px"><div class="eyebrow">A note from our guests</div><p class="quote">“The food was beautiful, the room felt intimate, and we were never rushed. We’ll be back.”</p><div class="meta">— A recent guest</div></div></div></section>
<section class="view" id="contact"><div class="wrap"><div class="eyebrow">Come find us</div><h1 class="title">We'd love to see you.</h1><div class="two"><div class="panel"><h2>Visit Gourmet Haven</h2><p>18 Garden Street<br>Portland, OR 97205</p><p><a href="tel:+15550106832">(555) 010-6832</a><br><a href="mailto:hello@gourmethaven.example">hello@gourmethaven.example</a></p><p><b>Tuesday–Thursday</b> · 5:30–10 pm<br><b>Friday–Saturday</b> · 5–10:30 pm<br><b>Sunday</b> · 5–9 pm</p><div class="notice">Map preview: 18 Garden Street, Portland. Use your preferred maps app for directions.</div><a class="btn darkbtn" href="https://maps.google.com/?q=18+Garden+Street+Portland+OR" target="_blank" rel="noopener noreferrer">Open map</a></div><form class="panel" id="contactForm"><h2>Send us a note</h2><label>Your name<input class="field" name="name" required></label><label>Email<input class="field" type="email" name="email" required></label><label>Message<textarea class="field" name="message" rows="4" required></textarea></label><button class="darkbtn">Send a message</button><p id="contactMsg" class="meta" role="status"></p><p class="meta">This demonstration form does not send information to a server.</p></form></div><div class="faq panel" style="margin-top:20px"><details><summary>Can you accommodate dietary needs?</summary><p class="sub">Please mention dietary requirements in your reservation request and speak with your server. Our team will help identify suitable options.</p></details><details><summary>Do you accept walk-ins?</summary><p class="sub">Walk-ins are welcome when space permits. Reservations are recommended for weekends.</p></details></div></div></section>
</main>
<footer><div class="foot"><a class="brand" href="#home" style="color:white">Gourmet Haven</a><span>Seasonal cooking · A warm welcome · <a href="#reserve">Reserve a table</a></span><span>Experiment 38 · <a href="../Exp-37/Portfolio.html">← Portfolio</a> · <a href="../Exp-39/Shop.html">Next: online shop →</a></span></div></footer><div class="toast" id="toast" role="status"></div>
<script>
const dishes=[{name:"Market greens",cat:"Starters",price:13,desc:"Tender leaves, late-season pear, toasted hazelnut, cider vinaigrette.",img:0},{name:"Roasted squash",cat:"Starters",price:15,desc:"Brown butter, crispy sage, whipped ricotta, warm sourdough.",img:1},{name:"Herb-roasted chicken",cat:"Mains",price:32,desc:"Free-range chicken, soft polenta, charred lemon, pan jus.",img:2},{name:"Wild mushroom risotto",cat:"Mains",price:28,desc:"Slow-stirred arborio rice, woodland mushrooms, aged parmesan.",img:3},{name:"Chocolate crémeux",cat:"Desserts",price:12,desc:"Dark chocolate, sea salt, olive oil, crisp almond tuile.",img:2},{name:"Pear & honey tart",cat:"Desserts",price:11,desc:"Seasonal pears, wildflower honey, cultured cream.",img:0},{name:"Garden spritz",cat:"Drinks",price:14,desc:"Bitter orange, garden herbs, sparkling wine, a little sunshine.",img:3},{name:"House lemonade",cat:"Drinks",price:7,desc:"Fresh lemon, rosemary syrup, soda. Zero-proof and refreshing.",img:1}];
const $=s=>document.querySelector(s);
function dishCard(d){return `<article class="dish"><div class="dish-image" role="img" aria-label="${d.name}"></div><div class="dish-copy"><div class="eyebrow">${d.cat}</div><h3>${d.name}</h3><p>${d.desc}</p><div class="dish-bottom"><span>Seasonal favorite</span><span>$${d.price}</span></div></div></article>`}
function renderMenu(cat="All"){$("#menuGrid").innerHTML=dishes.filter(d=>cat==="All"||d.cat===cat).map(dishCard).join("")}
$("#homeDishes").innerHTML=dishes.slice(0,3).map(dishCard).join("");renderMenu();
$("#menuTabs").addEventListener("click",e=>{const b=e.target.closest("[data-category]");if(!b)return;$("#menuTabs").querySelectorAll("button").forEach(x=>x.classList.toggle("active",x===b));renderMenu(b.dataset.category)});
function route(){const id=location.hash.slice(1)||"home";if(!document.getElementById(id)?.classList.contains("view")){location.hash="#home";return}document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===id));window.scrollTo(0,0)}window.addEventListener("hashchange",route);route();
const today=new Date();$("#reserveForm").elements.date.min=new Date(today.getTime()-today.getTimezoneOffset()*60000).toISOString().slice(0,10);
$("#reserveForm").addEventListener("submit",e=>{e.preventDefault();const d=new FormData(e.target);$("#reserveMsg").textContent=`Thank you, ${d.get("name")} — your table request for ${d.get("guests")} on ${d.get("date")} at ${d.get("time")} is noted. This is a demo, not a confirmed booking.`;e.target.reset()});
$("#contactForm").addEventListener("submit",e=>{e.preventDefault();$("#contactMsg").textContent="Thanks for your note. This demo message is not sent to a server.";e.target.reset()});
</script>
</body>
