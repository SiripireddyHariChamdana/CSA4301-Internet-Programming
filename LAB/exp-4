<script>
"use strict";
const CLASSES={SL:{name:"Sleeper",base:450}, "3A":{name:"AC 3 Tier",base:1050},"2A":{name:"AC 2 Tier",base:1550},"1A":{name:"First AC",base:2600},CC:{name:"Chair Car",base:650}};
const DEFAULT_TRAINS=[
{id:"t1",no:"12951",name:"Mumbai Rajdhani Express",type:"Rajdhani",from:"Mumbai Central",to:"New Delhi",departure:"16:35",arrival:"08:35",duration:"16h 00m",days:"Daily",fares:{SL:0,"3A":2450,"2A":3450,"1A":5750,CC:0},seats:{SL:0,"3A":18,"2A":10,"1A":4,CC:0}},
{id:"t2",no:"12657",name:"Chennai Mail",type:"Express",from:"Chennai Central",to:"Bengaluru City",departure:"22:50",arrival:"05:15",duration:"6h 25m",days:"Daily",fares:{SL:390,"3A":1050,"2A":1490,"1A":0,CC:550},seats:{SL:40,"3A":16,"2A":8,"1A":0,CC:12}},
{id:"t3",no:"12727",name:"Godavari Express",type:"Superfast",from:"Hyderabad Deccan",to:"Vijayawada",departure:"17:15",arrival:"23:10",duration:"5h 55m",days:"Daily",fares:{SL:300,"3A":850,"2A":1250,"1A":2100,CC:0},seats:{SL:36,"3A":12,"2A":6,"1A":2,CC:0}},
{id:"t4",no:"12303",name:"Poorva Express",type:"Express",from:"Kolkata",to:"New Delhi",departure:"08:00",arrival:"10:10",duration:"26h 10m",days:"Mon, Wed, Fri",fares:{SL:510,"3A":1380,"2A":2050,"1A":3450,CC:0},seats:{SL:48,"3A":20,"2A":10,"1A":3,CC:0}},
{id:"t5",no:"12027",name:"Shatabdi Express",type:"Shatabdi",from:"New Delhi",to:"Jaipur",departure:"06:10",arrival:"10:45",duration:"4h 35m",days:"Daily",fares:{SL:0,"3A":0,"2A":0,"1A":0,CC:890},seats:{SL:0,"3A":0,"2A":0,"1A":0,CC:32}},
{id:"t6",no:"11029",name:"Koyna Express",type:"Intercity",from:"Mumbai Central",to:"Pune Junction",departure:"08:40",arrival:"12:35",duration:"3h 55m",days:"Daily",fares:{SL:180,"3A":620,"2A":950,"1A":0,CC:420},seats:{SL:50,"3A":12,"2A":5,"1A":0,CC:18}},
{id:"t7",no:"20805",name:"Visakhapatnam Express",type:"Express",from:"Visakhapatnam",to:"Secunderabad",departure:"19:00",arrival:"07:20",duration:"12h 20m",days:"Daily",fares:{SL:360,"3A":980,"2A":1450,"1A":2400,CC:0},seats:{SL:35,"3A":14,"2A":7,"1A":2,CC:0}},
{id:"t8",no:"12933",name:"Karnavati Express",type:"Superfast",from:"Ahmedabad",to:"Mumbai Central",departure:"04:50",arrival:"13:10",duration:"8h 20m",days:"Daily",fares:{SL:0,"3A":0,"2A":0,"1A":0,CC:720},seats:{SL:0,"3A":0,"2A":0,"1A":0,CC:25}}
];
const $=id=>document.getElementById(id);
const safe=(s)=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const money=n=>"₹"+Number(n||0).toLocaleString("en-IN");
function load(key,fallback){try{const v=localStorage.getItem("railconnect_"+key);return v?JSON.parse(v):fallback}catch(e){return fallback}}
function save(key,value){localStorage.setItem("railconnect_"+key,JSON.stringify(value))}
let trains=load("trains",DEFAULT_TRAINS),users=load("users",[]),bookings=load("bookings",[]),comments=load("comments",[]),refundRules=load("refundRules",{days:2,percent:80}),currentUser=load("currentUser",null),selectedTrain=null,selectedClass="SL",selectedSeats=[],bookingPassengerCount=1,searchDateValue="",activePnr=null;
function seedDemo(){if(!users.some(u=>u.email==="user@railconnect.demo"))users.push({id:"u-demo",name:"Demo Passenger",email:"user@railconnect.demo",phone:"9000000000",password:"user123",role:"user"});if(!users.some(u=>u.email==="admin@railconnect.demo"))users.push({id:"a-demo",name:"System Admin",email:"admin@railconnect.demo",phone:"9000000001",password:"admin123",role:"admin"});save("users",users)}
function toast(msg){$("toast").textContent=msg;$("toast").classList.add("show");clearTimeout(toast.timer);toast.timer=setTimeout(()=>$("toast").classList.remove("show"),3200)}
function showPage(id){if(id==="dashboardPage"&&!currentUser){toast("Please log in to view your bookings.");id="loginPage"}if(id==="adminPage"&&currentUser?.role!=="admin"){id="adminPage"}document.querySelectorAll(".page").forEach(p=>p.classList.toggle("active",p.id===id));document.querySelectorAll("nav [data-page]").forEach(b=>b.classList.toggle("active",b.dataset.page===id));if(id==="dashboardPage")renderDashboard();if(id==="adminPage")renderAdmin();if(id==="commentsPage")renderComments();if(id==="trainsPage"&&!$("trainResults").innerHTML)searchTrains();window.scrollTo({top:0,behavior:"smooth"})}
document.querySelectorAll("nav [data-page]").forEach(b=>b.addEventListener("click",()=>showPage(b.dataset.page)));
function updateHeader(){$("topStatus").textContent=currentUser?`${currentUser.name} · ${currentUser.role==="admin"?"Administrator":"Passenger"}`:"Guest mode · Demo system";$("loginNav").textContent=currentUser?"Logout":"Login";$("loginNav").dataset.page=currentUser?"logout":"loginPage";$("registerNav").classList.toggle("hidden",!!currentUser);$("adminNav").classList.toggle("hidden",currentUser?.role!=="admin");$("loginNav").onclick=()=>{if(currentUser){currentUser=null;save("currentUser",null);updateHeader();toast("You have logged out.");showPage("homePage")}else showPage("loginPage")}}
function todayISO(){const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`}
["homeDate","searchDate"].forEach(id=>{ $(id).min=todayISO();$(id).value=todayISO() });
function searchFromHome(){$("searchFrom").value=$("homeFrom").value;$("searchTo").value=$("homeTo").value;$("searchDate").value=$("homeDate").value||todayISO();$("searchClass").value=$("homeClass").value;searchTrains();showPage("trainsPage")}
function quickRoute(from,to){$("searchFrom").value=from;$("searchTo").value=to;$("searchDate").value=todayISO();$("searchClass").value="all";searchTrains();showPage("trainsPage")}
function findTrain(id){return trains.find(t=>t.id===id)}
function searchTrains(){const from=$("searchFrom").value.trim().toLowerCase(),to=$("searchTo").value.trim().toLowerCase(),cls=$("searchClass").value;searchDateValue=$("searchDate").value||todayISO();const found=trains.filter(t=>(!from||t.from.toLowerCase().includes(from))&&(!to||t.to.toLowerCase().includes(to))&&(cls==="all"||Number(t.fares[cls])>0));const wrap=$("trainResults");if(!found.length){wrap.innerHTML='<div class="empty"><strong>No matching trains found</strong>Try a different station pair or select all classes.</div>';return}wrap.innerHTML=found.map(t=>`<article class="train-card"><div class="train-top"><div><div class="train-name">${safe(t.name)}</div><div class="train-no">Train no. ${safe(t.no)} · ${safe(t.type)} · ${safe(t.days)}</div></div><span class="tag">${safe(t.duration)}</span></div><div class="route"><div class="station"><strong>${safe(t.departure)}</strong><span>${safe(t.from)}</span></div><div class="route-line">Journey</div><div class="station"><strong>${safe(t.arrival)}</strong><span>${safe(t.to)}</span></div></div><div class="small muted">Journey date: ${safe(searchDateValue)}</div><div class="class-options">${Object.keys(CLASSES).filter(c=>t.fares[c]>0&&(cls==="all"||cls===c)).map(c=>`<button class="class-btn" onclick="startBooking('${t.id}','${c}',${Number($("searchPassengers").value||1)})"><strong>${c} · ${CLASSES[c].name}</strong><small>${t.seats[c]} seats · ${money(t.fares[c])}</small></button>`).join("")}</div><div class="train-bottom"><span class="small muted">Choose a class to continue</span><button class="btn btn-primary btn-small" onclick="startBooking('${t.id}','${(Object.keys(CLASSES).find(c=>t.fares[c]>0&&(cls==="all"||cls===c))||"SL")}',${Number($("searchPassengers").value||1)})">Book now →</button></div></article>`).join("")}
function startBooking(trainId,cls,count=1){if(!currentUser){toast("Please log in before reserving a ticket.");showPage("loginPage");return}if(!searchDateValue)searchDateValue=$("searchDate").value||todayISO();if(searchDateValue<todayISO()){toast("Choose today or a future journey date.");return}selectedTrain=findTrain(trainId);selectedClass=cls;bookingPassengerCount=Math.max(1,Math.min(6,Number(count)||1));selectedSeats=[];if(!selectedTrain||selectedTrain.seats[cls]<bookingPassengerCount){toast("Not enough seats available in this class.");return}renderBookingForm();showPage("bookingPage")}
function renderBookingForm(){const t=selectedTrain;$("bookingSummary").innerHTML=`<div class="train-top"><div><div class="train-name">${safe(t.name)}</div><div class="train-no">${safe(t.no)} · ${safe(t.type)}</div></div><span class="tag">${safe(searchDateValue)}</span></div><div class="route"><div class="station"><strong>${safe(t.departure)}</strong><span>${safe(t.from)}</span></div><div class="route-line">${safe(t.duration)}</div><div class="station"><strong>${safe(t.arrival)}</strong><span>${safe(t.to)}</span></div></div><p><strong>Class:</strong> ${selectedClass} — ${CLASSES[selectedClass].name} &nbsp; <strong>Fare per passenger:</strong> ${money(t.fares[selectedClass])}</p>`;const total=Math.min(40,Math.max(t.seats[selectedClass]+8,24));const booked=new Set(bookings.filter(b=>b.trainId===t.id&&b.date===searchDateValue&&b.class===selectedClass&&b.status!=="Cancelled").flatMap(b=>b.seats||[]));const unavailable=new Set();for(let i=1;i<=total;i++){if(booked.has(String(i))||i>t.seats[selectedClass]+booked.size)unavailable.add(String(i))}let grid="";for(let i=1;i<=total;i++){const n=String(i).padStart(2,"0");const off=unavailable.has(String(i));grid+=`<button type="button" class="seat ${off?"booked":""}" ${off?'disabled':""} onclick="toggleSeat('${n}',this)" aria-label="Seat ${n}">${n}</button>`}$("seatGrid").innerHTML=grid;$("seatCount").textContent=`Select ${bookingPassengerCount} seat(s). ${t.seats[selectedClass]} seat(s) currently listed as available.`;$("passengerFields").innerHTML=Array.from({length:bookingPassengerCount},(_,i)=>`<div style="padding:12px 0;border-bottom:1px solid var(--line)"><strong>Passenger ${i+1}</strong><div class="form-grid" style="margin-top:10px"><div class="field"><label>Full name</label><input name="pname${i}" required maxlength="80"></div><div class="field"><label>Age</label><input name="page${i}" type="number" min="1" max="120" required></div><div class="field"><label>Gender</label><select name="pgender${i}" required><option value="">Select</option><option>Female</option><option>Male</option><option>Other</option></select></div><div class="field"><label>Seat preference</label><select name="ppref${i}"><option>No preference</option><option>Window</option><option>Aisle</option></select></div></div></div>`).join("");$("bookingEmail").value=currentUser.email}
function toggleSeat(n,btn){if(selectedSeats.includes(n)){selectedSeats=selectedSeats.filter(x=>x!==n);btn.classList.remove("selected")}else if(selectedSeats.length>=bookingPassengerCount){toast(`You can select only ${bookingPassengerCount} seat(s).`);return}else{selectedSeats.push(n);btn.classList.add("selected")} $("seatCount").textContent=`Selected seats: ${selectedSeats.length}/${bookingPassengerCount} · ${selectedSeats.join(", ")||"None"} · Total fare: ${money(selectedTrain.fares[selectedClass]*bookingPassengerCount)}`}
$("loginForm").addEventListener("submit",e=>{e.preventDefault();const email=$("loginEmail").value.trim().toLowerCase(),pass=$("loginPassword").value;const user=users.find(u=>u.email.toLowerCase()===email&&u.password===pass);if(!user){toast("Invalid email or password.");return}currentUser={id:user.id,name:user.name,email:user.email,phone:user.phone,role:user.role};save("currentUser",currentUser);updateHeader();toast("Welcome, "+user.name+"!");showPage(user.role==="admin"?"adminPage":"dashboardPage")});
$("registerForm").addEventListener("submit",e=>{e.preventDefault();const email=$("regEmail").value.trim().toLowerCase();if(users.some(u=>u.email.toLowerCase()===email)){toast("An account with this email already exists.");return}const u={id:"u"+Date.now(),name:$("regName").value.trim(),email,phone:$("regPhone").value.trim(),password:$("regPassword").value,role:"user"};users.push(u);save("users",users);currentUser={id:u.id,name:u.name,email:u.email,phone:u.phone,role:u.role};save("currentUser",currentUser);updateHeader();toast("Registration successful.");showPage("dashboardPage")});
$("forgotForm").addEventListener("submit",e=>{e.preventDefault();const u=users.find(x=>x.email.toLowerCase()===$("forgotEmail").value.trim().toLowerCase());if(!u){toast("No account found for that email.");return}u.password=$("forgotPassword").value;save("users",users);toast("Demo password updated. Please log in.");showPage("loginPage")});
$("passengerForm").addEventListener("submit",e=>{e.preventDefault();if(!currentUser){toast("Please log in first.");showPage("loginPage");return}if(selectedSeats.length!==bookingPassengerCount){toast(`Please select exactly ${bookingPassengerCount} seat(s).`);return}const fd=new FormData(e.target),passengers=[];for(let i=0;i<bookingPassengerCount;i++)passengers.push({name:fd.get("pname"+i),age:Number(fd.get("page"+i)),gender:fd.get("pgender"+i),preference:fd.get("ppref"+i)});const pnr=String(Math.floor(1000000000+Math.random()*9000000000));const status=Math.random()<.1?"RAC":Math.random()<.08?"Waiting List":"Confirmed";const b={id:"b"+Date.now(),pnr,userId:currentUser.id,email:$("bookingEmail").value.trim(),passenger:passengers[0].name,passengers,trainId:selectedTrain.id,trainName:selectedTrain.name,trainNo:selectedTrain.no,from:selectedTrain.from,to:selectedTrain.to,date:searchDateValue,departure:selectedTrain.departure,arrival:selectedTrain.arrival,class:selectedClass,seats:[...selectedSeats],fare:selectedTrain.fares[selectedClass]*bookingPassengerCount,paymentMode:$("paymentMode").value,paymentStatus:$("paymentMode").value==="online"?"Demo successful":"Pending at counter",status,createdAt:new Date().toISOString(),cancelledAt:null,refund:0};bookings.push(b);save("bookings",bookings);activePnr=pnr;renderTicket(b);toast("Demo reservation created. PNR: "+pnr);showPage("ticketPage")});
function renderTicket(b){const t=findTrain(b.trainId)||b;$("ticketContent").innerHTML=`<div class="ticket"><div class="train-top"><div><div class="brand">🚆 Rail<span>Connect</span></div><p class="small muted">Electronic reservation receipt · DEMO</p></div><div><span class="tag">${safe(b.status)}</span></div></div><hr style="border:0;border-top:1px dashed #9dbbd5;margin:18px 0"><div class="ticket-pnr">${safe(b.pnr)}</div><p class="small muted">PNR NUMBER</p><div class="route"><div class="station"><strong>${safe(b.departure)}</strong><span>${safe(b.from)}</span></div><div class="route-line">${safe(b.trainNo)}</div><div class="station"><strong>${safe(b.arrival)}</strong><span>${safe(b.to)}</span></div></div><div class="ticket-grid"><div><span>TRAIN</span><strong>${safe(b.trainNo)} — ${safe(b.trainName)}</strong></div><div><span>JOURNEY DATE</span><strong>${safe(b.date)}</strong></div><div><span>PASSENGERS</span><strong>${(b.passengers||[{name:b.passenger}]).map(p=>safe(p.name)).join(", ")}</strong></div><div><span>CLASS / SEATS</span><strong>${safe(b.class)} / ${(b.seats||[]).map(s=>safe(s)).join(", ")}</strong></div><div><span>PAYMENT</span><strong>${safe(b.paymentMode)} · ${safe(b.paymentStatus)}</strong></div><div><span>TOTAL FARE</span><strong>${money(b.fare)}</strong></div></div><hr style="border:0;border-top:1px dashed #9dbbd5;margin:18px 0"><p class="small muted">Passenger: ${safe(b.passenger)} · Contact: ${safe(b.email)}<br>Keep your PNR for status checks and cancellation requests. This receipt is a demonstration only and is not valid for travel.</p></div>`}
$("pnrForm").addEventListener("submit",e=>{e.preventDefault();const pnr=$("pnrInput").value.trim(),b=bookings.find(x=>x.pnr===pnr);if(!b){$("pnrResult").innerHTML='<div class="empty"><strong>PNR not found</strong>Check the number or create a demo reservation first.</div>';return}const t=findTrain(b.trainId)||b;$("pnrResult").innerHTML=`<div class="panel"><div class="train-top"><div><h3>${safe(b.trainName)}</h3><p class="muted small">PNR ${safe(b.pnr)} · ${safe(b.date)}</p></div><span class="pill ${statusClass(b.status)}">${safe(b.status)}</span></div><p><strong>${safe(b.from)} → ${safe(b.to)}</strong></p><p>Class: ${safe(b.class)} · Seat(s): ${(b.seats||[]).map(s=>safe(s)).join(", ")||"Not assigned"} · Fare: ${money(b.fare)}</p><button class="btn btn-outline" onclick="viewTicket('${b.pnr}')">View ticket</button><button class="btn btn-outline" onclick="openCancel('${b.pnr}')">Cancel / refund</button></div>`});
function statusClass(s){return s==="Confirmed"?"confirmed":s==="RAC"?"rac":s==="Waiting List"?"waiting":"cancelled"}
function renderDashboard(){const wrap=$("dashboardContent");if(!currentUser){wrap.innerHTML='<div class="empty"><strong>Please log in</strong>Sign in to view your personal reservation history.</div>';return}const mine=bookings.filter(b=>b.userId===currentUser.id||b.email.toLowerCase()===currentUser.email.toLowerCase()).sort((a,b)=>b.createdAt.localeCompare(a.createdAt));wrap.innerHTML=`<div class="panel"><div class="train-top"><div><h3 style="margin:0">${safe(currentUser.name)}</h3><p class="muted small">${safe(currentUser.email)} · ${safe(currentUser.phone||"")}</p></div><span class="tag">Passenger account</span></div><div class="form-actions"><button class="btn btn-outline" onclick="showPage('pnrPage')">Check PNR</button><button class="btn btn-outline" onclick="showPage('cancelPage')">Cancel ticket</button><button class="btn btn-outline" onclick="showPage('commentsPage')">Post comments</button></div></div>${mine.length?`<div class="panel"><h3>Booking history (${mine.length})</h3><div class="table-wrap"><table><thead><tr><th>PNR</th><th>Train / route</th><th>Date</th><th>Class / seat</th><th>Fare</th><th>Status</th><th>Actions</th></tr></thead><tbody>${mine.map(b=>`<tr><td><strong>${safe(b.pnr)}</strong></td><td>${safe(b.trainName)}<br><span class="muted small">${safe(b.from)} → ${safe(b.to)}</span></td><td>${safe(b.date)}</td><td>${safe(b.class)} / ${(b.seats||[]).map(s=>safe(s)).join(", ")}</td><td>${money(b.fare)}</td><td><span class="pill ${statusClass(b.status)}">${safe(b.status)}</span>${b.refund?`<br><small>Refund: ${money(b.refund)}</small>`:""}</td><td><button class="btn btn-outline btn-small" onclick="viewTicket('${b.pnr}')">Ticket</button>${b.status!=="Cancelled"?`<button class="btn btn-danger btn-small" onclick="openCancel('${b.pnr}')">Cancel</button>`:""}</td></tr>`).join("")}</tbody></table></div></div>`:'<div class="empty"><strong>No bookings yet</strong>Search for a train and make your first demo reservation.</div>'}`}
function viewTicket(pnr){const b=bookings.find(x=>x.pnr===pnr);if(b){renderTicket(b);showPage("ticketPage")}}
function openCancel(pnr){$("cancelPnr").value=pnr||"";$("cancelResult").innerHTML="";showPage("cancelPage");if(pnr)showCancelResult(pnr)}
$("cancelForm").addEventListener("submit",e=>{e.preventDefault();showCancelResult($("cancelPnr").value.trim())});
function showCancelResult(pnr){const b=bookings.find(x=>x.pnr===pnr);if(!b){$("cancelResult").innerHTML='<div class="empty"><strong>Booking not found</strong>Check the PNR and try again.</div>';return}if(currentUser?.role!=="admin"&&currentUser&&b.userId!==currentUser.id&&b.email.toLowerCase()!==currentUser.email.toLowerCase()){$("cancelResult").innerHTML='<div class="notice">You can only cancel a reservation associated with your account.</div>';return}if(!currentUser){$("cancelResult").innerHTML='<div class="notice">Please log in to request a cancellation.</div>';return}const days=Math.ceil((new Date(b.date+"T00:00:00")-new Date(todayISO()+"T00:00:00"))/86400000),eligible=days>=Number(refundRules.days);const refund=eligible?Math.round(b.fare*Number(refundRules.percent)/100):0;$("cancelResult").innerHTML=`<div class="panel"><h3>${safe(b.trainName)}</h3><p>PNR: <strong>${safe(b.pnr)}</strong> · Journey: ${safe(b.date)}</p><p>${safe(b.from)} → ${safe(b.to)} · ${safe(b.class)} · ${money(b.fare)}</p><p>Current status: <span class="pill ${statusClass(b.status)}">${safe(b.status)}</span></p>${b.status==="Cancelled"?`<div class="notice success">This booking is already cancelled. Recorded refund: ${money(b.refund)}.</div>`:`<div class="notice ${eligible?"":" "}" >${eligible?`Estimated refund: ${money(refund)} (${refundRules.percent}%).`:`This demo rule requires cancellation at least ${refundRules.days} day(s) before departure. Estimated refund: ₹0.`} Days until journey: ${Math.max(0,days)}.</div><button class="btn btn-danger" onclick="cancelBooking('${b.pnr}')">Submit cancellation request</button>`}</div>`}
function cancelBooking(pnr){const b=bookings.find(x=>x.pnr===pnr);if(!b||b.status==="Cancelled")return;const days=Math.ceil((new Date(b.date+"T00:00:00")-new Date(todayISO()+"T00:00:00"))/86400000);if(days<Number(refundRules.days)){if(!confirm("This booking is inside the configured cancellation notice period. Cancel with no demo refund?"))return;b.refund=0}else b.refund=Math.round(b.fare*Number(refundRules.percent)/100);b.status="Cancelled";b.cancelledAt=new Date().toISOString();b.refundStatus=b.refund>0?"Refund pending admin approval":"No refund";save("bookings",bookings);showCancelResult(pnr);toast("Cancellation recorded. Refund status: "+b.refundStatus);if(currentUser?.role==="admin")renderAdmin()}
function renderAdmin(){const allowed=currentUser?.role==="admin";$("adminGate").classList.toggle("hidden",allowed);$("adminContent").classList.toggle("hidden",!allowed);if(!allowed)return;const cancelled=bookings.filter(b=>b.status==="Cancelled").length,revenue=bookings.filter(b=>b.status!=="Cancelled"&&b.paymentStatus==="Demo successful").reduce((s,b)=>s+b.fare,0);$("adminStats").innerHTML=[["Trains",trains.length],["Passengers",users.filter(u=>u.role!=="admin").length],["Reservations",bookings.length],["Demo paid fares",money(revenue)]].map(a=>`<div class="stat"><span>${a[0]}</span><strong>${a[1]}</strong></div>`).join("");$("adminInventory").innerHTML=trains.flatMap(t=>Object.keys(CLASSES).filter(c=>t.fares[c]>0).map(c=>`<tr><td>${safe(t.no)} · ${safe(t.name)}</td><td>${safe(t.from)} → ${safe(t.to)}</td><td>${c}</td><td><input aria-label="Fare ${c}" id="fare-${t.id}-${c}" type="number" min="1" value="${t.fares[c]}" style="width:95px;padding:7px;border:1px solid var(--line);border-radius:6px"></td><td><input aria-label="Seats ${c}" id="seats-${t.id}-${c}" type="number" min="0" max="1000" value="${t.seats[c]}" style="width:80px;padding:7px;border:1px solid var(--line);border-radius:6px"></td><td><button class="btn btn-primary btn-small" onclick="saveInventory('${t.id}','${c}')">Save</button></td></tr>`)).join("");$("adminTrains").innerHTML=trains.map(t=>`<tr><td>${safe(t.no)}</td><td>${safe(t.name)}<br><span class="muted small">${safe(t.type)} · ${safe(t.days)}</span></td><td>${safe(t.from)} → ${safe(t.to)}</td><td>${safe(t.departure)} / ${safe(t.arrival)}<br><span class="muted small">${safe(t.duration)}</span></td><td><button class="btn btn-outline btn-small" onclick="editTrain('${t.id}')">Edit</button><button class="btn btn-danger btn-small" onclick="deleteTrain('${t.id}')">Delete</button></td></tr>`).join("");$("adminUsers").innerHTML=users.map(u=>`<tr><td>${safe(u.name)}</td><td>${safe(u.email)}</td><td>${safe(u.phone||"—")}</td><td>${safe(u.role)}</td><td>${u.role!=="admin"?`<button class="btn btn-danger btn-small" onclick="deleteUser('${u.id}')">Remove</button>`:"Protected admin"}</td></tr>`).join("");$("adminBookings").innerHTML=bookings.slice().sort((a,b)=>b.createdAt.localeCompare(a.createdAt)).map(b=>`<tr><td><strong>${safe(b.pnr)}</strong></td><td>${safe(b.passenger)}<br><span class="muted small">${safe(b.email)}</span></td><td>${safe(b.trainNo)} ${safe(b.trainName)}<br>${safe(b.date)}</td><td>${safe(b.class)} / ${(b.seats||[]).map(s=>safe(s)).join(", ")}</td><td>${money(b.fare)}<br><span class="muted small">${money(b.refund)} refund</span></td><td>${safe(b.paymentMode)}<br>${safe(b.paymentStatus)}</td><td><span class="pill ${statusClass(b.status)}">${safe(b.status)}</span><br><small>${safe(b.refundStatus||"")}</small></td><td>${b.status!=="Cancelled"?`<button class="btn btn-danger btn-small" onclick="adminCancel('${b.pnr}')">Cancel</button>`:`<button class="btn btn-primary btn-small" onclick="approveRefund('${b.pnr}')">Approve refund</button>`}</td></tr>`).join("")||'<tr><td colspan="8">No reservations yet.</td></tr>';$("refundDays").value=refundRules.days;$("refundPercent").value=refundRules.percent;populateCommentTrains()}
function saveInventory(id,c){const t=findTrain(id);const fare=Number($(`fare-${id}-${c}`).value),seats=Number($(`seats-${id}-${c}`).value);if(!t||fare<1||seats<0||!Number.isFinite(fare)||!Number.isFinite(seats)){toast("Enter a valid fare and seat count.");return}t.fares[c]=fare;t.seats[c]=seats;save("trains",trains);renderAdmin();toast("Class fare and inventory updated.")}
function resetTrainForm(){$("trainAdminForm").reset();$("editTrainId").value="";$("adminDays").value="Daily"}
$("trainAdminForm").addEventListener("submit",e=>{e.preventDefault();const id=$("editTrainId").value,old=findTrain(id);const obj={id:id||"t"+Date.now(),no:$("adminTrainNo").value.trim(),name:$("adminTrainName").value.trim(),type:$("adminTrainType").value,from:$("adminFrom").value.trim(),to:$("adminTo").value.trim(),departure:$("adminDeparture").value,arrival:$("adminArrival").value,duration:$("adminDuration").value.trim(),days:$("adminDays").value.trim(),fares:old?old.fares:{SL:450,"3A":1050,"2A":1550,"1A":2600,CC:650},seats:old?old.seats:{SL:40,"3A":20,"2A":10,"1A":4,CC:20}};if(obj.from.toLowerCase()===obj.to.toLowerCase()){toast("Origin and destination must be different.");return}if(old)trains=trains.map(t=>t.id===id?obj:t);else trains.push(obj);save("trains",trains);resetTrainForm();renderAdmin();toast("Train information saved.")});
function editTrain(id){const t=findTrain(id);if(!t)return;$("editTrainId").value=t.id;$("adminTrainNo").value=t.no;$("adminTrainName").value=t.name;$("adminTrainType").value=t.type;$("adminFrom").value=t.from;$("adminTo").value=t.to;$("adminDeparture").value=t.departure;$("adminArrival").value=t.arrival;$("adminDuration").value=t.duration;$("adminDays").value=t.days;$("trainAdminForm").scrollIntoView({behavior:"smooth",block:"center"})}
function deleteTrain(id){const t=findTrain(id);if(!t||!confirm(`Delete ${t.name}? Existing booking records will remain in reports.`))return;trains=trains.filter(x=>x.id!==id);save("trains",trains);renderAdmin();toast("Train removed.")}
function deleteUser(id){const u=users.find(x=>x.id===id);if(!u||u.role==="admin"||!confirm(`Remove account ${u.email}?`))return;users=users.filter(x=>x.id!==id);save("users",users);renderAdmin();toast("User account removed from this browser.")}
function adminCancel(pnr){if(!confirm("Cancel this booking as administrator?"))return;const b=bookings.find(x=>x.pnr===pnr);if(!b)return;if(b.status!=="Cancelled"){b.status="Cancelled";b.cancelledAt=new Date().toISOString();const days=Math.ceil((new Date(b.date+"T00:00:00")-new Date(todayISO()+"T00:00:00"))/86400000);b.refund=days>=refundRules.days?Math.round(b.fare*refundRules.percent/100):0;b.refundStatus=b.refund?"Refund pending admin approval":"No refund";save("bookings",bookings)}renderAdmin();toast("Reservation cancelled.")}
function approveRefund(pnr){const b=bookings.find(x=>x.pnr===pnr);if(!b||b.status!=="Cancelled")return;b.refundStatus=b.refund>0?"Approved (demo only)":"No refund due";b.paymentStatus=b.refund>0?"Refund approved (demo only)":b.paymentStatus;save("bookings",bookings);renderAdmin();toast("Refund status updated in demo records.")}
$("refundRulesForm").addEventListener("submit",e=>{e.preventDefault();refundRules={days:Number($("refundDays").value),percent:Number($("refundPercent").value)};save("refundRules",refundRules);renderAdmin();toast("Refund rules saved.")});
function csvEscape(v){return '"'+String(v??"").replace(/"/g,'""')+'"'}
function downloadCSV(name,rows){const csv=rows.map(r=>r.map(csvEscape).join(",")).join("\r\n");const blob=new Blob(["\ufeff"+csv],{type:"text/csv;charset=utf-8;"});const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=name;a.click();URL.revokeObjectURL(a.href)}
function exportReport(type){if(currentUser?.role!=="admin"){toast("Admin access required.");return}if(type==="bookings")downloadCSV("railconnect-booking-report.csv",[["PNR","Passenger","Email","Train No","Train","Origin","Destination","Journey Date","Class","Seats","Fare","Payment Mode","Payment Status","Reservation Status","Refund","Refund Status"],...bookings.map(b=>[b.pnr,b.passenger,b.email,b.trainNo,b.trainName,b.from,b.to,b.date,b.class,(b.seats||[]).join(" "),b.fare,b.paymentMode,b.paymentStatus,b.status,b.refund,b.refundStatus])]);else if(type==="trains")downloadCSV("railconnect-train-report.csv",[["Train No","Train Name","Type","Origin","Destination","Departure","Arrival","Duration","Days","Class","Fare","Available Seats"],...trains.flatMap(t=>Object.keys(CLASSES).map(c=>[t.no,t.name,t.type,t.from,t.to,t.departure,t.arrival,t.duration,t.days,c,t.fares[c],t.seats[c]]))]);else if(type==="users")downloadCSV("railconnect-user-report.csv",[["Name","Email","Phone","Role"],...users.map(u=>[u.name,u.email,u.phone,u.role])]);else if(type==="payments")downloadCSV("railconnect-payment-report.csv",[["PNR","Email","Fare","Mode","Payment Status","Reservation Status","Refund","Refund Status"],...bookings.map(b=>[b.pnr,b.email,b.fare,b.paymentMode,b.paymentStatus,b.status,b.refund,b.refundStatus])]);toast("CSV report generated.")}
function populateCommentTrains(){$("commentTrain").innerHTML=trains.map(t=>`<option value="${t.id}">${safe(t.no)} — ${safe(t.name)}</option>`).join("")}
$("commentForm").addEventListener("submit",e=>{e.preventDefault();if(!currentUser){toast("Please log in to post a comment.");showPage("loginPage");return}const t=findTrain($("commentTrain").value);comments.unshift({id:"c"+Date.now(),userId:currentUser.id,name:currentUser.name,trainId:t?.id,trainName:t?.name,rating:Number($("commentRating").value),text:$("commentText").value.trim(),date:new Date().toISOString()});save("comments",comments);$("commentText").value="";renderComments();toast("Your comment was posted.")});
function renderComments(){populateCommentTrains();const list=$("commentsList");list.innerHTML=comments.length?comments.map(c=>`<div class="train-card"><div class="train-top"><div><strong>${safe(c.name)}</strong><div class="small muted">${safe(c.trainName)} · ${new Date(c.date).toLocaleDateString()}</div></div><span style="color:#d28b00">${"★".repeat(c.rating)}${"☆".repeat(5-c.rating)}</span></div><p>${safe(c.text)}</p>${currentUser?.role==="admin"?`<button class="btn btn-danger btn-small" onclick="deleteComment('${c.id}')">Remove comment</button>`:""}</div>`).join(""):'<div class="empty"><strong>No comments yet</strong>Be the first to share feedback.</div>'}
function deleteComment(id){comments=comments.filter(c=>c.id!==id);save("comments",comments);renderComments();toast("Comment removed.")}
seedDemo();updateHeader();populateCommentTrains();renderComments();
</script>
