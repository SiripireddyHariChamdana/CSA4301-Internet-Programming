<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f3f5fa">
<title>NextStep — Placement assessment portal</title>
<style>
:root{--ink:#202b3d;--muted:#6d798c;--bg:#f3f5fa;--white:#fff;--navy:#243b69;--blue:#4369bc;--pale:#e7edfb;--teal:#267d78;--line:#e1e6ef;--serif:Georgia,"Times New Roman",serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.6 Arial,sans-serif}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button,.btn{border:0;border-radius:6px;padding:11px 16px;background:var(--blue);color:white;cursor:pointer;font-weight:bold;display:inline-block}button:hover,.btn:hover{background:var(--navy)}.outline{background:transparent;color:var(--navy);border:1px solid var(--line)}.danger{background:#a83b48}.soft{background:var(--pale);color:var(--navy)}header{position:sticky;top:0;z-index:5;background:#fffF;border-bottom:1px solid var(--line)}nav{max-width:1160px;margin:auto;min-height:70px;padding:12px 22px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{font-size:21px;font-weight:900;color:var(--navy)}.brand span{color:var(--blue)}.links{display:flex;align-items:center;gap:17px;flex-wrap:wrap}.links a{font-size:13px;font-weight:bold;color:#596881}.links a:hover{color:var(--blue)}.view{display:none;min-height:72vh}.view.active{display:block}.wrap{max-width:1160px;margin:auto;padding:44px 22px}.hero{background:linear-gradient(115deg,#20365f,#4976be);color:#fff;border-radius:10px;padding:44px 6%;display:flex;justify-content:space-between;align-items:center;gap:25px}.hero h1{font:500 clamp(39px,6vw,66px)/1.03 var(--serif);margin:12px 0}.hero p{color:#e4eafb;max-width:580px}.hero .outline{border-color:#d9e3ff;color:white}.hero-icon{font-size:85px;color:#cfddff}.eyebrow{text-transform:uppercase;letter-spacing:1.7px;color:var(--blue);font-size:11px;font-weight:bold}.hero .eyebrow{color:#c6d6ff}.title{font:500 clamp(31px,4vw,45px)/1.12 var(--serif);margin:8px 0}.sub{color:var(--muted);max-width:750px}.row{display:flex;align-items:end;justify-content:space-between;gap:15px;flex-wrap:wrap;margin-bottom:18px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.stat,.panel,.card{background:white;border:1px solid var(--line);border-radius:8px;padding:19px;box-shadow:0 4px 16px #283b5d0a}.stat .value{font-size:26px;font-weight:800;color:var(--navy);margin:6px 0}.meta{font-size:12px;color:var(--muted)}.two{display:grid;grid-template-columns:1fr 1fr;gap:18px}.field{width:100%;padding:11px;border:1px solid #d4dce8;border-radius:5px;background:white;color:var(--ink);margin-top:5px}label{display:block;font-size:13px;font-weight:bold;margin:10px 0}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0}.tabs button{background:#e6ebf5;color:var(--navy)}.tabs button.active{background:var(--navy);color:white}.question-card{background:white;border:1px solid var(--line);border-radius:8px;padding:20px;margin:14px 0}.option{display:flex;gap:10px;align-items:flex-start;border:1px solid var(--line);padding:10px;border-radius:5px;margin:8px 0;cursor:pointer}.option:has(input:checked){background:#edf1fb;border-color:#97aad6}.option input{margin-top:4px}.timer{font-size:20px;font-weight:bold;color:var(--navy);background:var(--pale);padding:9px 14px;border-radius:8px}.notice{background:#edf1fa;border-left:3px solid var(--blue);padding:12px;margin:12px 0}.warning{background:#fff3e5;border-color:#d0913a;color:#72551f}.status{color:var(--teal);font-weight:bold;min-height:22px}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:13px}th,td{text-align:left;padding:10px;border-bottom:1px solid var(--line)}th{background:#f3f6fa;color:#425675}.result-score{font-size:42px;font-weight:800;color:var(--navy)}.rank{font-weight:bold;color:var(--teal)}.question-admin{padding:14px 0;border-bottom:1px solid var(--line)}.actions{display:flex;gap:9px;flex-wrap:wrap}.toast{position:fixed;right:20px;bottom:20px;background:var(--navy);color:white;padding:12px 16px;border-radius:5px;display:none;z-index:10}.empty{color:var(--muted);padding:15px}footer{background:#233653;color:#e8edf7;padding:23px}.foot{max-width:1160px;margin:auto;display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}.foot a{text-decoration:underline;text-underline-offset:3px}.timer-row{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}@media(max-width:760px){.grid,.two{grid-template-columns:1fr}.hero-icon{display:none}.links{gap:10px}}@media(max-width:540px){nav{align-items:flex-start;flex-direction:column}.wrap{padding:34px 17px}.hero{padding:30px 21px}}
</style>
</head>
<body>
<header><nav><a class="brand" href="#home">Next<span>Step</span> Assessments</a><div class="links"><a href="#home">Home</a><a href="#candidate">Candidate</a><a href="#exam">Take exam</a><a href="#results">Results</a><a href="#admin">Admin</a></div></nav></header>
<main>
<section class="view" id="home"><div class="wrap"><div class="hero"><div><div class="eyebrow">Placement readiness · Candidate portal</div><h1>Your next opportunity starts here.</h1><p>Sign in to check your exam schedule, attempt an assessment, and review your scorecard when results are published.</p><div class="actions"><a class="btn" href="#candidate">Candidate dashboard</a><a class="btn outline" href="#admin">Admin workspace</a></div></div><div class="hero-icon" aria-hidden="true">↗</div></div><div class="row" style="margin-top:36px"><div><div class="eyebrow">A clear path to your result</div><h2 class="title">From schedule to scorecard.</h2></div></div><div class="grid"><article class="stat"><div class="eyebrow">01 / Get ready</div><div class="value">Schedule</div><div class="meta">Find your allotted assessment and its start time.</div></article><article class="stat"><div class="eyebrow">02 / Demonstrate</div><div class="value">Assessment</div><div class="meta">Answer the questions and submit when you are ready.</div></article><article class="stat"><div class="eyebrow">03 / Learn</div><div class="value">Results</div><div class="meta">See your score, feedback, ranking, and review options.</div></article></div><div class="notice warning"><b>Single-file demonstration:</b> Candidate and admin screens run locally in this browser and do not provide real authentication, invigilation, or server-side result security.</div></div></section>
<section class="view" id="candidate"><div class="wrap"><div class="eyebrow">Candidate access</div><h1 class="title">Your assessment dashboard.</h1><p class="sub">Enter your name and email to open a local demo profile and check available exam schedules.</p><div class="two"><form id="candidateLogin" class="panel"><h2>Candidate sign in</h2><label>Full name<input class="field" name="name" required autocomplete="name"></label><label>Email address<input class="field" name="email" type="email" required autocomplete="email"></label><button>Continue to my dashboard</button><p class="status" id="candidateStatus" role="status"></p><p class="meta">Demo profile only; no password is requested or stored.</p></form><div class="panel"><div class="eyebrow">Your schedule</div><h2>Available assessment</h2><div id="candidateSchedule"></div><a class="btn" href="#exam">Open the exam</a></div></div><div class="panel" style="margin-top:18px"><div class="row"><div><div class="eyebrow">Your latest result</div><h2>Scorecard</h2></div><a class="btn outline" href="#results">Published results</a></div><div id="myResult"></div><form id="reevaluationForm" hidden><label>Reason for re-evaluation<textarea class="field" name="reason" rows="3" required></textarea></label><button class="outline">Request re-evaluation</button><p class="status" id="reevaluationStatus" role="status"></p></form></div></div></section>
<section class="view" id="exam"><div class="wrap"><div class="timer-row"><div><div class="eyebrow">Placement readiness assessment</div><h1 class="title">Candidate examination.</h1><p class="sub" id="examScheduleNote"></p></div><div class="timer" id="timer" hidden>20:00</div></div><div id="examStart" class="panel"><h2>Before you begin</h2><p class="sub">Choose an available schedule, read each question carefully, and submit your answers to receive a demo score and feedback.</p><div id="scheduleOptions"></div><button id="startExam">Start assessment</button><p class="meta">The exam has a browser-only timer. Do not refresh while an attempt is in progress.</p></div><form id="examForm" hidden><div id="questionList"></div><button>Submit assessment</button> <button type="button" class="outline" id="cancelExam">Cancel attempt</button></form><div id="examResult" class="panel" hidden></div></div></section>
<section class="view" id="results"><div class="wrap"><div class="eyebrow">Published assessment results</div><h1 class="title">The candidate leaderboard.</h1><p class="sub">Results appear here after the administrator publishes them.</p><div class="panel"><div id="leaderboard"></div></div><div class="panel" style="margin-top:18px"><h2>My scorecard</h2><div id="resultDetail"></div><a class="btn outline" href="#candidate">Candidate dashboard</a></div></div></section>
<section class="view" id="admin"><div class="wrap"><div class="eyebrow">Assessment administration · local demo</div><h1 class="title">Manage the placement exam.</h1><p class="sub">Configure the schedule, questions, candidate access, and result publication for this browser demonstration.</p><div class="notice warning">This page is a client-side prototype—not a secure admin area. Changes apply only in this browser.</div><div class="tabs" id="adminTabs"><button class="active" data-admin-tab="schedule">Schedule & access</button><button data-admin-tab="questions">Question bank</button><button data-admin-tab="results">Results & review</button></div><section id="admin-schedule" class="panel"><h2>Schedule the exam</h2><form id="scheduleForm" class="two"><label>Assessment title<input class="field" name="title" required></label><label>Exam date and time<input class="field" name="datetime" type="datetime-local" required></label><label>Duration (minutes)<input class="field" name="duration" type="number" min="1" max="180" required></label><label>Passing score (%)<input class="field" name="passMark" type="number" min="0" max="100" required></label><label>Candidate access<select class="field" name="access"><option value="open">Open to demo candidates</option><option value="closed">Closed</option></select></label><div style="align-self:end"><button>Save exam schedule</button></div></form><p class="status" id="scheduleStatus" role="status"></p><div id="accessList"></div></section><section id="admin-questions" class="panel" hidden><div class="row"><div><h2>Question bank</h2><p class="meta">Questions are scored automatically using one correct option.</p></div><button id="addQuestion" type="button">Add a question</button></div><div id="questionEditor"></div><button id="saveQuestions" type="button">Save question bank</button><p class="status" id="questionStatus" role="status"></p></section><section id="admin-results" class="panel" hidden><div class="row"><div><h2>Results & candidate review</h2><p class="meta">Publish or unpublish leaderboard results.</p></div><button id="publishResults" type="button">Publish results</button></div><p class="status" id="publishStatus" role="status"></p><div id="adminResults"></div></section></div></section>
</main>
<footer><div class="foot"><a class="brand" style="color:white" href="#home">NextStep Assessments</a><span>Prepare thoughtfully. Show what you know. · <a href="#candidate">Candidate access</a></span><span>Experiment 43 · <a href="../Exp-42/Electricity.html">← Current electricity portal</a></span></div></footer><div class="toast" id="toast" role="status"></div>
<script>
const $=s=>document.querySelector(s),seedQuestions=[
{id:"q1",text:"Which data structure follows the First In, First Out (FIFO) principle?",options:["Stack","Queue","Binary tree","Hash map"],answer:1,explanation:"A queue removes items in the same order they were added: First In, First Out."},
{id:"q2",text:"What is the time complexity of binary search on a sorted array?",options:["O(1)","O(n)","O(log n)","O(n²)"],answer:2,explanation:"Binary search halves the remaining search interval at each step, giving logarithmic time."},
{id:"q3",text:"Which HTML element is most appropriate for the main content of a page?",options:["<footer>","<main>","<aside>","<title>"],answer:1,explanation:"The semantic <main> element identifies the primary content of the document."},
{id:"q4",text:"What does HTTP status code 404 indicate?",options:["The request succeeded","The resource was not found","The server is redirecting","The user is authenticated"],answer:1,explanation:"A 404 response means the requested resource could not be found."},
{id:"q5",text:"Which SQL clause filters rows before grouping?",options:["ORDER BY","HAVING","WHERE","LIMIT"],answer:2,explanation:"WHERE filters individual rows; HAVING filters groups after aggregation."}
];
function load(k,fallback){try{return JSON.parse(localStorage.getItem("nextstep-"+k))??fallback}catch{return fallback}}
function save(k,v){localStorage.setItem("nextstep-"+k,JSON.stringify(v))}
let questions=load("questions",seedQuestions),schedule=load("schedule",{title:"Placement Readiness Test",datetime:"",duration:20,passMark:60,access:"open"}),candidates=load("candidates",[]),results=load("results",[]),published=load("published",false),current=load("current",null),attempt=null,timerInterval=null;
function safe(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function toast(s){const t=$("#toast");t.textContent=s;t.style.display="block";clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>t.style.display="none",2200)}
function formatSchedule(){if(!schedule.datetime)return"Schedule to be announced";const d=new Date(schedule.datetime);return Number.isNaN(+d)?"Schedule to be announced":d.toLocaleString()}
function renderCandidate(){const dt=schedule.datetime?new Date(schedule.datetime):null,open=schedule.access==="open"&&(!dt||Date.now()>=+dt);$("#candidateSchedule").innerHTML=`<div class="notice"><b>${safe(schedule.title)}</b><br>${formatSchedule()} · ${schedule.duration} minutes<br>${open?"Available for candidate access":"Not open yet"}</div>`;$("#examScheduleNote").textContent=`${schedule.title} · ${formatSchedule()} · ${schedule.duration} minutes`;$("#scheduleOptions").innerHTML=`<label class="option"><input type="radio" name="schedule" value="current" checked ${open?"":"disabled"}><span>${safe(schedule.title)} — ${formatSchedule()} (${schedule.duration} min)</span></label>`;renderMyResult()}
function myResult(){return current?results.find(r=>r.candidateId===current.id):null}
function renderMyResult(){const r=myResult();$("#myResult").innerHTML=r?`<div class="result-score">${r.score}%</div><p><b>${r.passed?"Passed":"Not passed yet"}</b> · ${r.correct}/${r.total} correct · ${safe(schedule.title)}</p><p class="sub">${safe(r.feedback)}</p><button id="downloadCard" class="outline">Download scorecard</button>`:'<p class="empty">Sign in and complete an assessment to see your scorecard.</p>';$("#reevaluationForm").hidden=!r}
function renderResults(){const rows=published?[...results].sort((a,b)=>b.score-a.score).map((r,i)=>`<tr><td>${i+1}</td><td>${safe(r.name)}</td><td>${r.score}%</td><td>${r.passed?"Passed":"Not passed"}</td></tr>`):[];$("#leaderboard").innerHTML=published?(rows.length?`<div class="table-wrap"><table><thead><tr><th>Rank</th><th>Candidate</th><th>Score</th><th>Status</th></tr></thead><tbody>${rows.join("")}</tbody></table></div>`:'<p class="empty">No exam attempts have been submitted yet.</p>'):'<div class="notice">Results have not been published yet. Please check back after the exam.</div>';const r=myResult();$("#resultDetail").innerHTML=r?`<p><b>${safe(current.name)}</b> · <span class="rank">${r.score}% — ${r.passed?"Passed":"Not passed"}</span></p><p>${safe(r.feedback)}</p><button class="outline" id="downloadCard2">Download scorecard</button>`:'<p class="empty">Sign in to view your own scorecard.</p>'}
function renderAccessList(){$("#accessList").innerHTML=`<h3>Candidate access list</h3>${candidates.length?`<div class="table-wrap"><table><thead><tr><th>Candidate</th><th>Email</th><th>Exam access</th></tr></thead><tbody>${candidates.map(c=>`<tr><td>${safe(c.name)}</td><td>${safe(c.email)}</td><td>${c.access?"Enabled":"Not enabled"}</td></tr>`).join("")}</tbody></table></div>`:'<p class="meta">Candidate profiles appear here when they sign in.</p>'}`}
function renderQuestionEditor(){$("#questionEditor").innerHTML=questions.map((q,i)=>`<article class="question-admin" data-qid="${safe(q.id)}"><div class="row"><b>Question ${i+1}</b><button class="danger" data-delete-q="${safe(q.id)}" type="button">Remove</button></div><label>Question text<textarea class="field" data-qtext rows="2">${safe(q.text)}</textarea></label><div class="two">${q.options.map((o,j)=>`<label>Option ${String.fromCharCode(65+j)}<input class="field" data-option="${j}" value="${safe(o)}"></label>`).join("")}</div><label>Correct answer<select class="field" data-answer>${q.options.map((o,j)=>`<option value="${j}" ${q.answer===j?"selected":""}>${String.fromCharCode(65+j)} — ${safe(o)}</option>`).join("")}</select></label><label>Explanation<textarea class="field" data-explanation rows="2">${safe(q.explanation||"")}</textarea></label></article>`).join("")||'<p class="empty">No questions yet. Add a question to build the exam.</p>'}
function renderAdmin(){const f=$("#scheduleForm");f.elements.title.value=schedule.title;f.elements.datetime.value=schedule.datetime;f.elements.duration.value=schedule.duration;f.elements.passMark.value=schedule.passMark;f.elements.access.value=schedule.access;renderAccessList();renderQuestionEditor();renderResults();$("#adminResults").innerHTML=results.length?`<div class="table-wrap"><table><thead><tr><th>Candidate</th><th>Score</th><th>Result</th><th>Re-evaluation</th><th>Review status</th></tr></thead><tbody>${results.map(r=>`<tr><td>${safe(r.name)}</td><td>${r.score}%</td><td>${r.passed?"Passed":"Not passed"}</td><td>${safe(r.reEvaluation||"—")}</td><td>${safe(r.reviewStatus||"—")}</td></tr>`).join("")}</tbody></table></div>`:'<p class="empty">No submitted results to review.</p>'}
function route(){const id=location.hash.slice(1)||"home";if(!document.getElementById(id)?.classList.contains("view")){location.hash="#home";return}document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===id));if(id==="candidate"||id==="exam"||id==="results")renderCandidate();if(id==="results")renderResults();if(id==="admin")renderAdmin();window.scrollTo(0,0)}
window.addEventListener("hashchange",route);
$("#candidateLogin").addEventListener("submit",e=>{e.preventDefault();const d=new FormData(e.target),email=d.get("email").trim().toLowerCase(),name=d.get("name").trim();current=candidates.find(c=>c.email.toLowerCase()===email)||{id:"cand-"+Date.now(),name,email,access:true};current.name=name;current.access=true;if(!candidates.some(c=>c.id===current.id))candidates.push(current);save("candidates",candidates);save("current",current);$("#candidateStatus").textContent=`Welcome, ${name}. Your local demo profile is ready.`;renderCandidate();e.target.reset()});
$("#scheduleForm").addEventListener("submit",e=>{e.preventDefault();const d=new FormData(e.target);schedule={title:d.get("title").trim(),datetime:d.get("datetime"),duration:Number(d.get("duration")),passMark:Number(d.get("passMark")),access:d.get("access")};save("schedule",schedule);$("#scheduleStatus").textContent="Exam schedule and candidate access saved.";renderCandidate()});
$("#adminTabs").addEventListener("click",e=>{const b=e.target.closest("[data-admin-tab]");if(!b)return;$("#adminTabs").querySelectorAll("button").forEach(x=>x.classList.toggle("active",x===b));["schedule","questions","results"].forEach(x=>$("#admin-"+x).hidden=x!==b.dataset.adminTab)});
$("#addQuestion").addEventListener("click",()=>{questions.push({id:"q-"+Date.now(),text:"New placement question",options:["Option A","Option B","Option C","Option D"],answer:0,explanation:"Add an explanation for the correct answer."});renderQuestionEditor()});
$("#questionEditor").addEventListener("click",e=>{const b=e.target.closest("[data-delete-q]");if(!b)return;questions=questions.filter(q=>q.id!==b.dataset.deleteQ);renderQuestionEditor()});
$("#saveQuestions").addEventListener("click",()=>{document.querySelectorAll("[data-qid]").forEach(el=>{const q=questions.find(x=>x.id===el.dataset.qid);if(!q)return;q.text=el.querySelector("[data-qtext]").value.trim();q.options=[...el.querySelectorAll("[data-option]")].map(x=>x.value.trim());q.answer=Number(el.querySelector("[data-answer]").value);q.explanation=el.querySelector("[data-explanation]").value.trim()});if(!questions.length||questions.some(q=>!q.text||q.options.length<2||q.options.some(x=>!x))){$("#questionStatus").textContent="Add at least one complete question with answer choices.";return}save("questions",questions);$("#questionStatus").textContent="Question bank saved.";renderQuestionEditor()});
$("#publishResults").addEventListener("click",()=>{published=!published;save("published",published);$("#publishResults").textContent=published?"Unpublish results":"Publish results";$("#publishStatus").textContent=published?"Results are now visible on the candidate results page.":"Results are hidden from candidates.";renderResults()});
function beginAttempt(){if(!current){$("#examResult").hidden=false;$("#examResult").textContent="Sign in to your candidate profile before starting the exam.";return}if(schedule.access!=="open"||(schedule.datetime&&Date.now()<new Date(schedule.datetime).getTime())){toast("This assessment is not open yet.");return}if(!questions.length){toast("The exam has no questions yet.");return}attempt={started:Date.now(),remaining:Math.max(1,Number(schedule.duration)||20)*60};$("#examStart").hidden=true;$("#examForm").hidden=false;$("#timer").hidden=false;$("#examResult").hidden=true;$("#questionList").innerHTML=questions.map((q,i)=>`<article class="question-card"><div class="eyebrow">Question ${i+1} of ${questions.length}</div><h2>${safe(q.text)}</h2>${q.options.map((o,j)=>`<label class="option"><input type="radio" name="${safe(q.id)}" value="${j}"><span>${String.fromCharCode(65+j)}. ${safe(o)}</span></label>`).join("")}</article>`).join("");updateTimer();timerInterval=setInterval(()=>{attempt.remaining--;updateTimer();if(attempt.remaining<=0)submitExam()},1000)}
function updateTimer(){$("#timer").textContent=`${String(Math.floor(attempt.remaining/60)).padStart(2,"0")}:${String(attempt.remaining%60).padStart(2,"0")}`}
function submitExam(){if(!attempt)return;clearInterval(timerInterval);const data=new FormData($("#examForm")),wrong=[],correct=questions.filter(q=>{const ok=Number(data.get(q.id))===q.answer;if(!ok)wrong.push(q);return ok}).length,score=Math.round(correct/questions.length*100),passed=score>=Number(schedule.passMark),feedback=wrong.length?wrong.map(q=>`${q.text} ${q.explanation||"Review this topic and try again."}`).join(" "):"Excellent work — all your answers are correct.";const result={candidateId:current.id,name:current.name,email:current.email,score,correct,total:questions.length,passed,feedback,date:new Date().toLocaleString(),answers:Object.fromEntries(questions.map(q=>[q.id,data.get(q.id)])),reEvaluation:"",reviewStatus:""};results=results.filter(r=>r.candidateId!==current.id);results.push(result);save("results",results);attempt=null;$("#examForm").hidden=true;$("#timer").hidden=true;$("#examStart").hidden=false;$("#examResult").hidden=false;$("#examResult").innerHTML=`<div class="eyebrow">Attempt submitted</div><h2>${passed?"Well done — you passed!":"Keep practicing — review your feedback."}</h2><div class="result-score">${score}%</div><p>${correct} of ${questions.length} correct · Passing score: ${schedule.passMark}%</p><p class="sub">${safe(feedback)}</p><a class="btn" href="#candidate">View candidate scorecard</a>`;renderCandidate();renderResults()}
$("#startExam").addEventListener("click",beginAttempt);$("#examForm").addEventListener("submit",e=>{e.preventDefault();submitExam()});$("#cancelExam").addEventListener("click",()=>{clearInterval(timerInterval);attempt=null;$("#examForm").hidden=true;$("#timer").hidden=true;$("#examStart").hidden=false;toast("Exam attempt cancelled.")});
$("#reevaluationForm").addEventListener("submit",e=>{e.preventDefault();const r=myResult();if(!r)return;r.reEvaluation=new FormData(e.target).get("reason");r.reviewStatus="Requested";save("results",results);$("#reevaluationStatus").textContent="Your re-evaluation request has been recorded in this browser.";renderAdmin()});
function downloadScorecard(){const r=myResult();if(!r||!current)return;const text=`NEXTSTEP PLACEMENT ASSESSMENT — DEMO SCORECARD\nCandidate: ${current.name}\nExam: ${schedule.title}\nDate: ${r.date}\nScore: ${r.score}% (${r.correct}/${r.total} correct)\nResult: ${r.passed?"Passed":"Not passed"}\nFeedback: ${r.feedback}\n\nThis is a browser-only demonstration scorecard.`;const url=URL.createObjectURL(new Blob([text],{type:"text/plain"}));const a=document.createElement("a");a.href=url;a.download="NextStep-demo-scorecard.txt";a.click();URL.revokeObjectURL(url)}
document.addEventListener("click",e=>{if(e.target.id==="downloadCard"||e.target.id==="downloadCard2")downloadScorecard()});
renderCandidate();route();
</script>
</body>
</html>
