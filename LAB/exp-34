<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>LearnWell Tuition Centre</title>
<style>
:root{--navy:#203b63;--blue:#356ca5;--gold:#efb65b;--bg:#f4f7fb;--ink:#243247}*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:var(--bg);color:var(--ink)}header{background:white;position:sticky;top:0;z-index:4;box-shadow:0 2px 12px #182d4612}nav{max-width:1120px;margin:auto;padding:16px 22px;display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap}.brand{font-size:23px;font-weight:800;color:var(--navy)}.brand span{color:#d99432}nav a{color:#34465e;text-decoration:none;font-size:14px;font-weight:bold;margin-left:15px}nav a:hover{color:var(--blue)}.hero{padding:70px 22px;background:linear-gradient(90deg,#142c4be8,#142c4b88),url('https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&fit=crop&w=1500&q=85') center/cover;color:white}.wrap{max-width:1120px;margin:auto}.tag{color:#f4c77f;letter-spacing:3px;text-transform:uppercase;font-size:12px;font-weight:bold}h1{font-size:clamp(38px,6vw,60px);max-width:680px;margin:14px 0}.hero p{max-width:600px;line-height:1.7;font-size:17px}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}button{background:var(--blue);color:white;border:0;border-radius:8px;padding:12px 17px;font-weight:bold;cursor:pointer}button:hover{background:var(--navy)}.gold{background:var(--gold);color:#243247}.section{max-width:1120px;margin:auto;padding:48px 22px}.head{margin-bottom:22px}h2{color:var(--navy);font-size:29px;margin:0 0 8px}.muted{color:#69788b;line-height:1.55}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card,.panel{background:white;border-radius:14px;padding:20px;box-shadow:0 5px 20px #1b35500c}.card h3,.panel h3{margin:0 0 8px;color:var(--navy)}.icon{width:42px;height:42px;border-radius:12px;background:#e9f0f8;display:grid;place-items:center;font-size:21px;margin-bottom:13px}.notice{border-left:4px solid var(--gold);padding:12px 14px;background:#fff9ed;border-radius:7px;margin:10px 0}.two{display:grid;grid-template-columns:1fr 1fr;gap:20px}form{display:grid;gap:12px}label{font-size:13px;font-weight:bold;color:#43546a}input,select,textarea{display:block;width:100%;margin-top:5px;padding:12px;border:1px solid #d9e1eb;border-radius:8px;font:inherit;color:var(--ink);background:white}.pair{display:grid;grid-template-columns:1fr 1fr;gap:12px}.tablewrap{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:14px}th,td{text-align:left;padding:12px;border-bottom:1px solid #e8edf3}th{color:var(--navy);background:#f4f7fb}.status{color:#26734e;font-weight:bold}.result{color:#26734e;font-weight:bold;margin-top:10px}.small{font-size:12px;color:#758398}footer{background:var(--navy);color:white;text-align:center;padding:30px 20px}footer .brand{color:white}@media(max-width:800px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.grid,.two,.pair{grid-template-columns:1fr}.section{padding:36px 18px}.hero{padding:52px 18px}nav a{margin:0 10px 0 0}}
</style></head><body>
<header><nav><div class="brand">Learn<span>Well</span> Tuition Centre</div><div><a href="#home">Home</a><a href="#announcements">Announcements</a><a href="#courses">Courses</a><a href="#register">Register</a><a href="#portal">Portal</a><a href="#contact">Contact</a></div></nav></header>
<section class="hero" id="home"><div class="wrap"><div class="tag">Learn • Grow • Succeed</div><h1>Build confidence. Achieve more.</h1><p>Quality tuition with supportive teachers, flexible learning options and clear progress updates for students and parents.</p><div class="actions"><button class="gold" onclick="document.getElementById('courses').scrollIntoView({behavior:'smooth'})">Explore courses</button><button onclick="document.getElementById('register').scrollIntoView({behavior:'smooth'})">Register now</button></div></div></section>
<section class="section" id="announcements"><div class="head"><h2>Latest announcements</h2><p class="muted">Important updates from LearnWell Tuition Centre.</p></div><div class="grid"><article class="card"><div class="icon">📅</div><h3>Class schedule update</h3><p class="muted">New weekday and weekend batches are available. Contact the office for the latest timetable.</p><span class="small">Academic notice</span></article><article class="card"><div class="icon">📝</div><h3>Monthly assessment</h3><p class="muted">Monthly assessments help students and parents track learning progress.</p><span class="small">Student update</span></article><article class="card"><div class="icon">🎓</div><h3>New batch admissions</h3><p class="muted">Registration is open for selected school subjects and foundation courses.</p><span class="small">Admissions</span></article></div></section>
<section class="section" id="courses"><div class="head"><h2>Course offerings</h2><p class="muted">Subjects, duration and sample course fees.</p></div><div class="tablewrap panel"><table><thead><tr><th>Subject</th><th>Duration</th><th>Mode</th><th>Sample fee / month</th></tr></thead><tbody><tr><td>Mathematics</td><td>3 months</td><td>Online / Offline</td><td>₹1,500</td></tr><tr><td>Science</td><td>3 months</td><td>Online / Offline</td><td>₹1,500</td></tr><tr><td>English</td><td>2 months</td><td>Online / Offline</td><td>₹1,200</td></tr><tr><td>Computer Science</td><td>3 months</td><td>Online</td><td>₹1,800</td></tr></tbody></table><p class="small">Fees and durations shown are sample values for this website demonstration.</p></div></section>
<section class="section" id="register"><div class="head"><h2>Online student registration</h2><p class="muted">Submit student details and choose a subject and learning mode.</p></div><div class="two"><div class="panel"><form id="registration"><div class="pair"><label>Student name<input id="studentName" required placeholder="Full name"></label><label>Parent / guardian<input id="parentName" required placeholder="Parent name"></label></div><div class="pair"><label>Email<input id="email" type="email" required placeholder="Email address"></label><label>Phone<input id="phone" type="tel" required placeholder="Mobile number"></label></div><div class="pair"><label>Class / Grade<input id="grade" required placeholder="e.g. Grade 10"></label><label>Subject<select id="subject"><option>Mathematics</option><option>Science</option><option>English</option><option>Computer Science</option></select></label></div><label>Tuition mode<select id="mode"><option>Offline</option><option>Online</option></select></label><button type="submit">Submit registration</button></form><p id="regMsg" class="result"></p></div><div class="panel"><h3>Learning options</h3><div class="notice"><b>Online tuition</b><p class="muted">Attend lessons remotely from home. Joining details are shared by the centre after enrolment.</p></div><div class="notice"><b>Offline tuition</b><p class="muted">Attend scheduled classroom sessions at the tuition centre.</p></div><p class="small">Registration submissions are saved in this browser for demonstration only.</p></div></div></section>
<section class="section" id="portal"><div class="head"><h2>Management portal</h2><p class="muted">Demo forms and student fee / progress records.</p></div><div class="two"><div class="panel"><h3>Admin login / registration</h3><form id="adminForm"><label>Admin username<input required placeholder="Admin username"></label><label>Password<input required type="password" placeholder="Password"></label><button>Admin login (demo)</button></form><p id="adminMsg" class="result"></p><hr><h3>Teacher registration</h3><form id="teacherForm"><label>Teacher name<input required placeholder="Full name"></label><div class="pair"><label>Email<input required type="email" placeholder="Email"></label><label>Subject<input required placeholder="Subject"></label></div><label>Password<input required type="password" placeholder="Create password"></label><button>Register teacher</button></form><p id="teacherMsg" class="result"></p></div><div class="panel"><h3>Teacher login</h3><form id="teacherLogin"><label>Email<input type="email" required placeholder="Registered email"></label><label>Password<input type="password" required placeholder="Password"></label><button>Login (demo)</button></form><p id="loginMsg" class="result"></p><hr><h3>Student fee record</h3><form id="feeForm"><label>Student name<input id="feeStudent" required placeholder="Student name"></label><div class="pair"><label>Amount paid (₹)<input id="amount" type="number" min="0" required></label><label>Payment month<input id="month" type="month" required></label></div><label>Payment note<input id="feeNote" placeholder="e.g. Mathematics tuition"></label><button>Save fee record</button></form><p id="feeMsg" class="result"></p></div></div>
<div class="panel" style="margin-top:20px"><h3>Student fee and progress report</h3><p class="muted">Sample report area. Fee records entered above appear below.</p><div class="tablewrap"><table><thead><tr><th>Student</th><th>Amount paid</th><th>Month</th><th>Note</th></tr></thead><tbody id="feeRows"><tr><td colspan="4">No fee records added yet.</td></tr></tbody></table></div><p class="small">Monthly and yearly reports can be prepared from these records in a connected backend system. Teacher feedback / student feedback form:</p><form id="feedback"><div class="pair"><label>Student name<input required placeholder="Student name"></label><label>Feedback type<select><option>Teacher feedback</option><option>Student feedback</option><option>Parent feedback</option></select></label></div><label>Comments<textarea rows="3" required placeholder="Write feedback"></textarea></label><button>Submit feedback</button></form><p id="feedbackMsg" class="result"></p></div></section>
<section class="section" id="maintenance"><div class="head"><h2>Maintenance requests</h2><p class="muted">Report a classroom, facility or learning-support issue.</p></div><div class="panel"><form id="maintenanceForm"><div class="pair"><label>Name<input required placeholder="Your name"></label><label>Request type<select><option>Classroom maintenance</option><option>Online class support</option><option>Study material</option><option>Other assistance</option></select></label></div><label>Details<textarea required rows="3" placeholder="Describe the issue"></textarea></label><button>Submit request</button></form><p id="maintMsg" class="result"></p></div></section>
<section class="section" id="contact"><div class="head"><h2>About us & contact</h2><p class="muted">Helping every learner take the next step.</p></div><div class="two"><div class="panel"><h3>About LearnWell</h3><p class="muted">LearnWell Tuition Centre is committed to providing supportive, student-focused education. Our goal is to strengthen subject knowledge, encourage curiosity and build confidence through regular practice and guidance.</p><h3>Our teaching team</h3><p class="muted">Experienced subject teachers guide students through lessons, assessments and feedback.</p></div><div class="panel"><h3>Contact us</h3><form id="contactForm"><label>Name<input required placeholder="Your name"></label><label>Email<input type="email" required placeholder="Email address"></label><label>Message<textarea rows="3" required placeholder="Your inquiry"></textarea></label><button>Send inquiry</button></form><p id="contactMsg" class="result"></p></div></div></section>
<footer><div class="brand">LearnWell Tuition Centre</div><p>Learn • Grow • Succeed</p><span class="small" style="color:#cbd7e5">Student learning and administration demo website</span></footer>
<script>
function bindForm(id,msg,text){document.getElementById(id).addEventListener('submit',e=>{e.preventDefault();document.getElementById(msg).textContent=text;e.target.reset()})}
bindForm('registration','regMsg','Registration submitted successfully in this demo.');
bindForm('adminForm','adminMsg','Demo admin form submitted. Real authentication requires a backend.');
bindForm('teacherForm','teacherMsg','Teacher registration submitted in this demo.');
bindForm('teacherLogin','loginMsg','Demo login submitted. Credentials are not verified.');
bindForm('feedback','feedbackMsg','Thank you. Feedback submitted in this demo.');
bindForm('maintenanceForm','maintMsg','Maintenance request submitted in this demo.');
bindForm('contactForm','contactMsg','Thank you. Your inquiry has been submitted in this demo.');
document.getElementById('feeForm').addEventListener('submit',e=>{e.preventDefault();let r=document.getElementById('feeRows');if(r.children.length===1&&r.innerText.includes('No fee'))r.innerHTML='';let tr=document.createElement('tr');[feeStudent.value,'₹'+amount.value,month.value,feeNote.value||'—'].forEach(v=>{let td=document.createElement('td');td.textContent=v;tr.appendChild(td)});r.appendChild(tr);document.getElementById('feeMsg').textContent='Fee record added to the report table.';e.target.reset()});
</script></body></html>
