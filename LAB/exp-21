<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f2f5f2"><title>CareerBridge — Find work that moves you forward</title>
<style>
:root{--ink:#24332d;--muted:#75817b;--bg:#f2f5f2;--paper:#fff;--green:#22624d;--mint:#e1eee7;--lime:#d8edaa;--orange:#ce8052;--line:#e1e8e2;--serif:Georgia,"Times New Roman",serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.6 Arial,sans-serif}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button,.btn{border:0;border-radius:6px;padding:11px 15px;background:var(--green);color:white;cursor:pointer;font-weight:bold;display:inline-block}button:hover,.btn:hover{background:#164734}.outline{background:transparent;color:var(--green);border:1px solid var(--green)}header{position:sticky;top:0;z-index:5;background:#fffF;border-bottom:1px solid var(--line)}nav,.wrap{max-width:1160px;margin:auto}nav{min-height:70px;padding:12px 22px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{font-size:21px;font-weight:900;color:var(--green)}.brand span{color:var(--orange)}.links{display:flex;gap:17px;align-items:center;flex-wrap:wrap}.links a{font-size:13px;font-weight:bold;color:#4c5c53}.links a:hover{color:var(--orange)}.view{display:none;min-height:72vh}.view.active{display:block}.hero{max-width:1160px;margin:18px auto 0;border-radius:9px;min-height:395px;background:linear-gradient(100deg,#123b30e6,#123b3050),url('https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=1800&q=85') center/cover;color:#fff;display:flex;align-items:center}.hero-copy{padding:48px 7%;max-width:720px}.eyebrow{text-transform:uppercase;letter-spacing:1.6px;font-size:11px;color:var(--orange);font-weight:bold}.hero .eyebrow{color:var(--lime)}.hero h1{font:500 clamp(41px,6.6vw,70px)/1.01 var(--serif);margin:14px 0}.hero p{max-width:560px;color:#e5eee8}.actions,.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.actions{margin-top:22px}.hero .outline{color:white;border-color:white}.wrap{padding:44px 22px}.title{font:500 clamp(30px,4vw,44px)/1.1 var(--serif);margin:7px 0}.sub{color:var(--muted);max-width:760px}.row{justify-content:space-between;margin-bottom:18px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.panel,.job,.stat{background:white;border:1px solid var(--line);border-radius:8px;padding:18px}.stat strong{font-size:27px;color:var(--green)}.job{margin:10px 0}.job h3{margin:4px 0}.meta{font-size:12px;color:var(--muted)}.chip{display:inline-block;margin:2px;background:#e8f0e9;color:#37664f;padding:4px 9px;border-radius:18px;font-size:11px}.toolbar{display:flex;gap:9px;flex-wrap:wrap;margin:18px 0}.toolbar input{flex:1;min-width:190px}.toolbar input,.toolbar select,.field{padding:10px 11px;border:1px solid #d5dfd8;border-radius:5px;background:white;color:var(--ink)}.two{display:grid;grid-template-columns:1fr 1fr;gap:18px}.field{width:100%;margin-top:5px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:5px 12px}label{display:block;font-size:13px;font-weight:bold;margin:10px 0}.notice{background:#e8f2e9;border-left:3px solid var(--green);padding:12px;margin:12px 0}.status{min-height:22px;color:#28744d;font-weight:bold}.badge{background:#e3f2e7;color:#28724c;border-radius:18px;padding:4px 9px;font-size:11px;font-weight:bold}.badge.wait{background:#fff0d6;color:#805d20}.empty{padding:15px;color:var(--muted)}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:13px}th,td{text-align:left;padding:9px;border-bottom:1px solid var(--line)}th{background:#f2f6f3}.toast{position:fixed;right:20px;bottom:20px;background:#214b3b;color:white;padding:12px 16px;border-radius:5px;display:none;z-index:10}footer{background:#203d32;color:#ecf3ed;padding:22px}.foot{max-width:1160px;margin:auto;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}.foot a{text-decoration:underline;text-underline-offset:3px}@media(max-width:760px){.grid,.two{grid-template-columns:1fr 1fr}.links{gap:10px}.hero{min-height:350px}}@media(max-width:560px){nav{align-items:flex-start;flex-direction:column}.grid,.two,.formgrid{grid-template-columns:1fr}.wrap{padding:32px 16px}.hero{margin:10px;min-height:340px}}
</style></head><body>
<header><nav><a class="brand" href="#home">Career<span>Bridge</span></a><div class="links"><a href="#home">Home</a><a href="#jobs">Find jobs</a><a href="#applications">My applications</a><a href="#profile">Profile & resume</a><a href="#director">Director</a><a href="#admin">Admin</a></div></nav></header>
<main>
<section class="view" id="home"><div class="hero"><div class="hero-copy"><div class="eyebrow">Good work starts with a good connection</div><h1>Your next opportunity is out there.</h1><p>Explore current vacancies, save the roles that interest you, and apply with your profile. Directors can share openings and review candidate applications.</p><div class="actions"><a class="btn" href="#jobs">Explore vacancies</a><a class="btn outline" href="#profile">Build your profile</a></div></div></div><div class="wrap"><div class="row"><div><div class="eyebrow">A clearer path to work</div><h2 class="title">One place to move forward.</h2></div></div><div class="grid"><article class="stat"><strong>Discover</strong><p class="meta">Filter openings by role, location, and work arrangement.</p></article><article class="stat"><strong>Prepare</strong><p class="meta">Add a resume and set your profile visibility preferences.</p></article><article class="stat"><strong>Connect</strong><p class="meta">Apply to a role and keep track of your application status.</p></article></div><div class="notice">CareerBridge is a browser-only demo. Use fictional contact information and resumes; it is not connected to real employers.</div></div></section>
<section class="view" id="jobs"><div class="wrap"><div class="eyebrow">Open opportunities</div><h1 class="title">Find your next role.</h1><p class="sub">Search vacancies by title, skill, company, or location. Save roles or submit an application.</p><div class="toolbar"><input id="search" placeholder="Job title, skill, company, or location"><select id="type"><option value="">All work types</option><option>Full-time</option><option>Part-time</option><option>Contract</option><option>Internship</option></select><select id="level"><option value="">All experience levels</option><option>Entry level</option><option>Mid level</option><option>Senior</option></select><select id="sort"><option value="recent">Most recent</option><option value="salary">Salary: high to low</option></select></div><p id="count" class="meta"></p><div id="jobList"></div></div></section>
<section class="view" id="profile"><div class="wrap"><div class="eyebrow">Applicant profile</div><h1 class="title">Put your experience forward.</h1><div class="two"><form id="profileForm" class="panel"><h2>Your profile</h2><label>Full name<input class="field" name="name" required></label><div class="formgrid"><label>Email<input class="field" name="email" type="email" required></label><label>Phone<input class="field" name="phone"></label></div><label>Skills<textarea class="field" name="skills" rows="2" placeholder="e.g. data analysis, communication"></textarea></label><label>Short introduction<textarea class="field" name="bio" rows="3"></textarea></label><label>Resume file<input class="field" name="resume" type="file" accept=".pdf,.doc,.docx,.txt"></label><label><input type="checkbox" name="public" checked> Allow approved directors to discover my resume in this demo</label><p class="meta">A local file name is stored; the selected resume itself is not uploaded.</p><button>Save profile</button><p class="status" id="profileStatus"></p></form><div class="panel"><div class="eyebrow">Your saved roles</div><h2>Jobs to revisit</h2><div id="savedJobs"></div><a class="btn outline" href="#jobs">Browse vacancies</a></div></div></div></section>
<section class="view" id="applications"><div class="wrap"><div class="eyebrow">Applicant dashboard</div><h1 class="title">Your applications.</h1><div class="panel"><div id="applicationList"></div></div></div></section>
<section class="view" id="director"><div class="wrap"><div class="eyebrow">For hiring directors · demo</div><h1 class="title">Share an opportunity.</h1><div class="two"><form id="directorForm" class="panel"><h2>Director registration</h2><label>Your name<input class="field" name="name" required></label><label>Company<input class="field" name="company" required></label><label>Work email<input class="field" name="email" type="email" required></label><label>Organization website<input class="field" name="website" type="url" placeholder="https://"></label><button>Submit for approval</button><p id="directorStatus" class="status"></p><p class="meta">New directors require demo admin approval before listing vacancies.</p></form><form id="vacancyForm" class="panel"><h2>Post a vacancy</h2><label>Approved company<select class="field" id="companySelect" name="company"></select></label><label>Job title<input class="field" name="title" required></label><div class="formgrid"><label>Location<input class="field" name="location" required></label><label>Work type<select class="field" name="type"><option>Full-time</option><option>Part-time</option><option>Contract</option><option>Internship</option></select></label></div><div class="formgrid"><label>Experience level<select class="field" name="level"><option>Entry level</option><option>Mid level</option><option>Senior</option></select></label><label>Annual salary (₹)<input class="field" name="salary" type="number" min="0"></label></div><label>Skills / keywords<input class="field" name="skills" placeholder="e.g. design, research"></label><label>Job description<textarea class="field" name="description" rows="3" required></textarea></label><button>Publish vacancy</button><p class="meta">Only an approved director can publish vacancies.</p><p id="vacancyStatus" class="status"></p></form></div><div class="panel" style="margin-top:18px"><h2>Candidate applications</h2><div id="directorApplications"></div></div></div></section>
<section class="view" id="admin"><div class="wrap"><div class="eyebrow">Administrator · local demo</div><h1 class="title">Manage the CareerBridge board.</h1><p class="sub">Review director applications and view vacancy, applicant, and application reports.</p><div class="grid"><div class="stat"><div class="meta">Vacancies</div><strong id="reportJobs">0</strong></div><div class="stat"><div class="meta">Applicant profiles</div><strong id="reportApplicants">0</strong></div><div class="stat"><div class="meta">Applications</div><strong id="reportApplications">0</strong></div></div><div class="panel" style="margin-top:18px"><h2>Director approvals</h2><div id="directorApprovals"></div></div><div class="panel" style="margin-top:18px"><h2>Recent applications</h2><div id="adminApplications"></div></div></div></section>
</main><footer><div class="foot"><a href="#home" class="brand" style="color:white">CareerBridge</a><span>Find a fit. Make a connection.</span><span>Experiment 21 · <a href="../Exp-20/rentride_vehicle_rental.html">← RentRide</a> · <a href="../Exp-22/CleanCity.html">Next: CleanCity →</a></span></div></footer><div class="toast" id="toast" role="status"></div>
<script>
const $=s=>document.querySelector(s),seed=[{id:"job1",title:"Junior Product Designer",company:"Northstar Studio",location:"Bengaluru",type:"Full-time",level:"Entry level",salary:720000,skills:"Figma, UI design, research, prototyping",description:"Help a small product team make clear, accessible experiences. Work with researchers and engineers from early sketches to launch.",date:"2026-11-18",approved:true},{id:"job2",title:"Community Program Coordinator",company:"Open Fields Collective",location:"Chennai · Hybrid",type:"Full-time",level:"Mid level",salary:650000,skills:"Communication, planning, community, events",description:"Coordinate programs, support partners, and help local initiatives grow with care.",date:"2026-11-16",approved:true},{id:"job3",title:"Data Analyst Intern",company:"BrightPath Labs",location:"Remote · India",type:"Internship",level:"Entry level",salary:360000,skills:"SQL, spreadsheets, Python, problem solving",description:"Explore real-world datasets and turn careful analysis into helpful insights for the team.",date:"2026-11-15",approved:true},{id:"job4",title:"Frontend Engineer",company:"Morrow Digital",location:"Pune · Remote friendly",type:"Contract",level:"Senior",salary:1600000,skills:"JavaScript, HTML, CSS, accessibility",description:"Build performant, accessible web interfaces alongside a thoughtful and collaborative team.",date:"2026-11-14",approved:true}];
function load(k,f){try{return JSON.parse(localStorage.getItem("careerbridge-"+k))??f}catch{return f}}function save(k,v){localStorage.setItem("careerbridge-"+k,JSON.stringify(v))}let jobs=load("jobs",seed),profile=load("profile",null),directors=load("directors",[{id:"dir1",name:"Northstar Hiring",company:"Northstar Studio",email:"hiring@northstar.example",approved:true},{id:"dir2",name:"BrightPath Team",company:"BrightPath Labs",email:"talent@brightpath.example",approved:true}]),applications=load("applications",[]),saved=load("saved",[]);
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}function toast(s){const t=$("#toast");t.textContent=s;t.style.display="block";setTimeout(()=>t.style.display="none",2200)}
function renderJobs(){let list=jobs.filter(j=>j.approved),q=$("#search").value.trim().toLowerCase(),type=$("#type").value,level=$("#level").value,sort=$("#sort").value;list=list.filter(j=>(!q||`${j.title} ${j.company} ${j.location} ${j.skills}`.toLowerCase().includes(q))&&(!type||j.type===type)&&(!level||j.level===level));if(sort==="salary")list.sort((a,b)=>b.salary-a.salary);else list.sort((a,b)=>b.date.localeCompare(a.date));$("#count").textContent=`${list.length} role${list.length===1?"":"s"} available`;$("#jobList").innerHTML=list.length?list.map(j=>`<article class="job"><div class="row"><div><div class="eyebrow">${esc(j.company)}</div><h3>${esc(j.title)}</h3><span class="meta">${esc(j.location)} · ${esc(j.type)} · ${esc(j.level)}</span></div><span class="badge">${j.salary?`₹${(j.salary/100000).toFixed(1)} LPA`:"Salary discussed"}</span></div><p>${esc(j.description)}</p><p>${j.skills.split(",").map(s=>`<span class="chip">${esc(s.trim())}</span>`).join("")}</p><div class="row"><span class="meta">Posted ${esc(j.date)}</span><div><button class="outline" data-save="${j.id}">${saved.includes(j.id)?"Saved ✓":"Save job"}</button> <button data-apply="${j.id}">Apply now</button></div></div></article>`).join(""):'<p class="empty">No vacancies match. Adjust your filters and try again.</p>'}
function render(){const pending=directors.filter(d=>!d.approved);$("#directorApprovals").innerHTML=pending.length?pending.map(d=>`<article class="panel" style="margin:9px 0"><b>${esc(d.company)}</b> · ${esc(d.name)} · ${esc(d.email)}<p><button data-approve="${d.id}">Approve director</button> <button class="outline" data-reject="${d.id}">Reject</button></p></article>`).join(""):'<p class="empty">No directors awaiting approval.</p>';$("#companySelect").innerHTML=directors.filter(d=>d.approved).map(d=>`<option value="${esc(d.company)}">${esc(d.company)}</option>`).join("")||'<option>No approved company</option>';$("#savedJobs").innerHTML=saved.map(id=>jobs.find(j=>j.id===id)).filter(Boolean).map(j=>`<div class="row"><span>${esc(j.title)} · ${esc(j.company)}</span><a class="chip" href="#jobs">View jobs</a></div>`).join("")||'<p class="empty">Save jobs from the vacancy board to revisit them here.</p>';const mine=profile?applications.filter(a=>a.email===profile.email):[];$("#applicationList").innerHTML=mine.length?mine.map(a=>`<div class="row"><div><b>${esc(a.title)}</b><div class="meta">${esc(a.company)} · ${esc(a.date)}</div></div><span class="badge ${a.status==="Submitted"?"wait":""}">${esc(a.status)}</span></div>`).join(""):'<p class="empty">No applications yet. Save your profile, then apply to a vacancy.</p>';$("#reportJobs").textContent=jobs.length;$("#reportApplicants").textContent=applications.length?new Set(applications.map(a=>a.email)).size:profile?1:0;$("#reportApplications").textContent=applications.length;$("#directorApplications").innerHTML=applications.length?applications.map(a=>`<div class="row"><div><b>${esc(a.title)}</b><div class="meta">${esc(a.name)} · ${esc(a.company)}</div><div class="meta">Resume: ${a.resume?esc(a.resume):"Not attached"} · ${a.privacy?"Visible to approved directors":"Private profile"}</div></div><select data-app-status="${a.id}" class="field" style="width:auto"><option ${a.status==="Submitted"?"selected":""}>Submitted</option><option ${a.status==="Under review"?"selected":""}>Under review</option><option ${a.status==="Interview"?"selected":""}>Interview</option><option ${a.status==="Not selected"?"selected":""}>Not selected</option></select></div>`).join(""):'<p class="empty">No applications received yet.</p>';$("#adminApplications").innerHTML=applications.slice(-8).reverse().map(a=>`<div class="row">${esc(a.name)} · ${esc(a.title)} <span class="badge">${esc(a.status)}</span></div>`).join("")||'<p class="empty">No applications yet.</p>'}
["search","type","level","sort"].forEach(x=>$("#"+x).addEventListener("input",renderJobs));
document.addEventListener("click",e=>{const s=e.target.closest("[data-save]");if(s){saved=saved.includes(s.dataset.save)?saved.filter(x=>x!==s.dataset.save):[...saved,s.dataset.save];save("saved",saved);renderJobs();render();return}const a=e.target.closest("[data-apply]");if(a){if(!profile){toast("Create your applicant profile before applying.");location.hash="#profile";return}const j=jobs.find(x=>x.id===a.dataset.apply);if(applications.some(x=>x.jobId===j.id&&x.email===profile.email)){toast("You have already applied for this role.");return}applications.push({id:"app-"+Date.now(),jobId:j.id,title:j.title,company:j.company,name:profile.name,email:profile.email,resume:profile.resume||"",privacy:profile.public,status:"Submitted",date:new Date().toLocaleDateString()});save("applications",applications);render();toast("Application submitted to the demo portal.");return}const ok=e.target.closest("[data-approve]");if(ok){const d=directors.find(x=>x.id===ok.dataset.approve);d.approved=true;save("directors",directors);render();toast("Director approved.");return}const no=e.target.closest("[data-reject]");if(no){directors=directors.filter(d=>d.id!==no.dataset.reject);save("directors",directors);render();return}});
$("#profileForm").elements.resume.addEventListener("change",e=>{const f=e.target.files[0];if(f)$("#profileForm").dataset.resume=f.name});
$("#profileForm").addEventListener("submit",e=>{e.preventDefault();profile=Object.fromEntries(new FormData(e.target));profile.resume=e.target.elements.resume.files[0]?.name||$("#profileForm").dataset.resume||"";profile.public=new FormData(e.target).has("public");save("profile",profile);$("#profileStatus").textContent="Profile saved in this browser. You can now apply to listed jobs.";render()});
$("#directorForm").addEventListener("submit",e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target));directors.push({...d,id:"dir-"+Date.now(),approved:false});save("directors",directors);$("#directorStatus").textContent="Director application submitted for admin approval.";render();e.target.reset()});
$("#vacancyForm").addEventListener("submit",e=>{e.preventDefault();if(!directors.some(d=>d.approved&&d.company===new FormData(e.target).get("company"))){$("#vacancyStatus").textContent="An approved director account is required to publish a vacancy.";return}const d=Object.fromEntries(new FormData(e.target));jobs.unshift({...d,id:"job-"+Date.now(),salary:Number(d.salary)||0,approved:true,date:new Date().toISOString().slice(0,10)});save("jobs",jobs);$("#vacancyStatus").textContent="Vacancy published to the demo board.";renderJobs();render();e.target.reset()});
$("#directorApplications").addEventListener("change",e=>{const id=e.target.dataset.appStatus;if(!id)return;const a=applications.find(x=>x.id===id);a.status=e.target.value;save("applications",applications);render()});
function route(){const id=location.hash.slice(1)||"home";if(!document.getElementById(id)?.classList.contains("view")){location.hash="#home";return}document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===id));if(["profile","applications","director","admin"].includes(id))render();if(id==="jobs")renderJobs();window.scrollTo(0,0)}window.addEventListener("hashchange",route);renderJobs();render();route();
</script></body></html>
