var(--muted)}.route{display:flex;align-items:center;gap:12px}.route strong{font-size:20px}.route .line{flex:1;border-top:1px dashed #aab8c9;text-align:center;position:relative}.route .line span{position:relative;top:-10px;background:white;padding:0 7px;color:var(--muted);font-size:11px}.price{font-size:21px;font-weight:850}.tag{display:inline-block;border-radius:20px;padding:5px 9px;font-size:11px;font-weight:800;background:#e9f8f0;color:var(--green)}.tag.wait{background:#fff4df;color:#9c6700}.table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:13px}th,td{text-align:left;padding:13px 12px;border-bottom:1px solid var(--line);white-space:nowrap}th{background:#f7f9fc;color:#65758a;font-size:11px;text-transform:uppercase;letter-spacing:.5px}.empty{padding:35px;text-align:center;color:var(--muted)}.dashboard-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:18px}.stat{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px}.stat span{display:block;color:var(--muted);font-size:12px}.stat strong{display:block;font-size:26px;margin-top:7px}.ticket{background:#fff;border:1px solid #dbe4ef;border-radius:18px;overflow:hidden;max-width:780px}.ticket-head{background:var(--navy);color:#fff;padding:20px 24px;display:flex;justify-content:space-between;align-items:center;gap:10px}.ticket-body{padding:24px}.ticket-route{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:18px 0 24px}.ticket-route strong{font-size:27px}.ticket-route .middle{text-align:center;color:var(--muted);font-size:12px;flex:1}.ticket-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;border-top:1px dashed var(--line);padding-top:18px}.ticket-grid span{display:block;color:var(--muted);font-size:11px;text-transform:uppercase;margin-bottom:5px}.ticket-grid strong{font-size:14px}.footer{padding:28px 5%;background:#102746;color:#d2deed;text-align:center;font-size:12px}.toast{position:fixed;right:20px;bottom:20px;background:#102746;color:#fff;padding:13px 18px;border-radius:12px;box-shadow:0 10px 30px #0002;z-index:30;max-width:90vw}.seat-grid{display:grid;grid-template-columns:repeat(6,42px);gap:8px;justify-content:center;margin:18px auto}.seat{height:38px;border-radius:8px;background:#e8f5ee;color:#176b4d;border:1px solid #c7e6d5;padding:0}.seat.selected{background:var(--blue);color:#fff}.seat.taken{background:#e6eaf0;color:#9aa5b4;border-color:#e6eaf0;cursor:not-allowed}.admin-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.feedback-stars{display:flex;gap:8px;font-size:24px;color:#c7d0dd}.feedback-stars button{padding:2px;background:none;color:inherit;font-size:25px}.feedback-stars button.chosen{color:var(--gold)}@media(max-width:900px){.searchgrid{grid-template-columns:repeat(2,1fr)}.searchgrid button{width:100%}.flight{grid-template-columns:1fr 1fr}.flight .pricebox{grid-column:1}.flight>button{grid-column:2;grid-row:2}.cards{grid-template-columns:1fr 1fr}.nav button{padding:8px}.topbar{height:auto;min-height:70px;padding:13px 4%;gap:10px;align-items:flex-start}.nav{justify-content:flex-end}.brand{font-size:19px}}@media(max-width:600px){.topbar{display:block}.nav{margin-top:10px;justify-content:flex-start}.nav button{font-size:12px;padding:8px}.container{margin-top:18px}.hero{padding:25px 20px;border-radius:18px}.hero:after{font-size:75px;right:0;top:35px}.searchbox{padding:14px}.searchgrid,.formgrid,.formgrid.three,.admin-grid{grid-template-columns:1fr}.cards{grid-template-columns:1fr}.flight{grid-template-columns:1fr;gap:12px}.flight>button,.flight .pricebox{grid-column:auto;grid-row:auto;width:100%}.dashboard-stats{grid-template-columns:1fr}.ticket-head{align-items:flex-start;flex-direction:column}.ticket-body{padding:17px}.ticket-route strong{font-size:22px}.ticket-grid{grid-template-columns:1fr 1fr}.section-head{align-items:flex-start;flex-direction:column}.seat-grid{grid-template-columns:repeat(6,35px);gap:6px}.seat{height:34px}}
@media print{.topbar,.footer,.no-print,.toast{display:none!important}body{background:#fff}.container{width:100%;margin:0}.ticket{max-width:100%;border:1px solid #aaa}.ticket-head{print-color-adjust:exact;-webkit-print-color-adjust:exact}}
</style>
</head>
<body>
<header class="topbar">
  <div class="brand"><div class="brand-mark">✈</div>SkyBook</div>
  <nav class="nav" id="nav">
    <button class="active" data-page="home">Home</button>
    <button data-page="search">Search Flights</button>
    <button data-page="mytickets">My Tickets</button>
    <button data-page="status">Booking Status</button>
    <button data-page="feedback">Feedback</button>
    <button data-page="admin">Admin</button>
    <button class="signin" data-page="login" id="loginNav">Sign in</button>
  </nav>
</header>
<main class="container">
<section id="page-home" class="page">
  <div class="hero">
    <div class="eyebrow">Your journey starts here</div>
    <h1>Fly farther. Travel smarter.</h1>
    <p>Compare flight options, choose your seat, and keep every trip in one simple place.</p>
    <div class="searchbox">
      <div class="searchgrid">
        <div class="field"><label>FROM</label><select id="homeFrom"><option value="Mumbai">Mumbai (BOM)</option><option value="Delhi">Delhi (DEL)</option><option value="Bengaluru">Bengaluru (BLR)</option><option value="Hyderabad">Hyderabad (HYD)</option><option value="Chennai">Chennai (MAA)</option><option value="Kolkata">Kolkata (CCU)</option><option value="Goa">Goa (GOI)</option></select></div>
        <div class="field"><label>TO</label><select id="homeTo"><option value="Delhi">Delhi (DEL)</option><option value="Mumbai">Mumbai (BOM)</option><option value="Bengaluru">Bengaluru (BLR)</option><option value="Hyderabad">Hyderabad (HYD)</option><option value="Chennai">Chennai (MAA)</option><option value="Kolkata">Kolkata (CCU)</option><option value="Goa">Goa (GOI)</option></select></div>
        <div class="field"><label>DEPARTURE</label><input type="date" id="homeDate"></div>
        <div class="field"><label>CLASS</label><select id="homeClass"><option>Economy</option><option>Business</option><option>First Class</option></select></div>
        <button class="primary" onclick="searchFromHome()">Search flights →</button>
      </div>
    </div>
  </div>
  <div class="section-head"><h2>Why book with SkyBook?</h2><span class="muted small">Simple booking, all in one place</span></div>
  <div class="cards">
    <div class="feature"><div class="feature-icon">🛫</div><h3>Compare flights</h3><p>Review sample airlines, departure times, travel duration and fares in one place.</p></div>
    <div class="feature"><div class="feature-icon">🎫</div><h3>Easy e-tickets</h3><p>Keep your booking reference, passenger details and itinerary ready to print.</p></div>
    <div class="feature"><div class="feature-icon">🧳</div><h3>Manage trips</h3><p>View booking history, check status and submit a cancellation request from your dashboard.</p></div>
  </div>
  <div class="section-head"><h2>Popular destinations</h2><span class="muted small">Explore India</span></div>
  <div class="cards">
    <div class="feature"><div class="feature-icon">🏙️</div><h3>Mumbai → Delhi</h3><p>Business trips and city breaks · From ₹4,299</p><button class="secondary" onclick="quickSearch('Mumbai','Delhi')">Explore flights</button></div>
    <div class="feature"><div class="feature-icon">🌴</div><h3>Bengaluru → Goa</h3><p>Plan a quick coastal escape · From ₹3,199</p><button class="secondary" onclick="quickSearch('Bengaluru','Goa')">Explore flights</button></div>
    <div class="feature"><div class="feature-icon">🌆</div><h3>Delhi → Hyderabad</h3><p>Discover food, culture and heritage · From ₹3,899</p><button class="secondary" onclick="quickSearch('Delhi','Hyderabad')">Explore flights</button></div>
  </div>
</section>

<section id="page-search" class="page hidden">
  <h1 class="page-title">Search flights</h1><p class="page-sub">Choose your route and travel preferences.</p>
  <div class="panel"><div class="formgrid three">
    <div class="field"><label>Origin</label><select id="from"><option>Mumbai</option><option>Delhi</option><option>Bengaluru</option><option>Hyderabad</option><option>Chennai</option><option>Kolkata</option><option>Goa</option></select></div>
    <div class="field"><label>Destination</label><select id="to"><option>Delhi</option><option>Mumbai</option><option>Bengaluru</option><option>Hyderabad</option><option>Chennai</option><option>Kolkata</option><option>Goa</option></select></div>
    <div class="field"><label>Departure date</label><input type="date" id="travelDate"></div>
    <div class="field"><label>Travel class</label><select id="travelClass"><option>Economy</option><option>Business</option><option>First Class</option></select></div>
    <div class="field"><label>Passengers</label><select id="passengers"><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option></select></div>
    <div class="field"><label>Sort by</label><select id="sortBy"><option value="price">Lowest fare</option><option value="time">Departure time</option></select></div>
  </div><div class="form-actions"><button class="primary" onclick="searchFlights()">Find flights</button><button class="secondary" onclick="swapRoute()">⇄ Swap route</button></div></div>
  <div id="flightResults"></div>
</section>

<section id="page-login" class="page hidden">
  <h1 class="page-title">Welcome to SkyBook</h1><p class="page-sub">Sign in or create a passenger account to manage your trips.</p>
  <div class="panel" style="max-width:650px">
    <div class="formgrid"><div class="field"><label>Full name (for registration)</label><input id="authName" placeholder="Your full name"></div><div class="field"><label>Email address</label><input id="authEmail" type="email" placeholder="you@example.com"></div><div class="field"><label>Password</label><input id="authPassword" type="password" placeholder="Enter password"></div><div class="field"><label>Account action</label><select id="authMode"><option value="login">Sign in</option><option value="register">Create account</option></select></div></div>
    <div class="form-actions"><button class="primary" onclick="authenticate()">Continue</button><button class="secondary" onclick="showPage('forgot')">Forgot password?</button></div>
    <p class="muted small">Demo only: account information is stored in this browser, not on a secure server.</p>
  </div>
</section>

<section id="page-forgot" class="page hidden">
  <h1 class="page-title">Forgot password</h1><p class="page-sub">Request a demo password reset for your account.</p>
  <div class="panel" style="max-width:600px"><div class="field"><label>Registered email</label><input id="forgotEmail" type="email" placeholder="you@example.com"></div><div class="form-actions"><button class="primary" onclick="resetPassword()">Send reset instructions</button><button class="secondary" onclick="showPage('login')">Back to sign in</button></div><div id="forgotMsg"></div></div>
</section>

<section id="page-book" class="page hidden">
  <h1 class="page-title">Complete your booking</h1><p class="page-sub">Confirm the flight, passenger details and seat selection.</p>
  <div class="panel" id="chosenFlight"></div>
  <div class="panel"><h3>Passenger details</h3><div class="formgrid"><div class="field"><label>Full name as on ID</label><input id="pName" placeholder="Passenger full name"></div><div class="field"><label>Email</label><input id="pEmail" type="email" placeholder="name@example.com"></div><div class="field"><label>Phone number</label><input id="pPhone" type="tel" placeholder="10-digit phone number"></div><div class="field"><label>Age</label><input id="pAge" type="number" min="1" max="110" placeholder="Age"></div></div>
    <h3 style="margin-top:24px">Choose a seat</h3><p class="muted small">Green = available · Blue = selected · Grey = unavailable</p><div id="seatGrid" class="seat-grid"></div><p id="seatMsg" class="muted small" style="text-align:center">Select one available seat.</p>
    <div class="form-actions"><button class="primary" onclick="continueToPayment()">Continue to payment</button><button class="secondary" onclick="showPage('search')">Back to flights</button></div>
  </div>
</section>

<section id="page-payment" class="page hidden">
  <h1 class="page-title">Ticket payment</h1><p class="page-sub">Review your fare and choose a demo payment method.</p>
  <div class="panel" style="max-width:760px"><div id="paymentSummary"></div><div class="field" style="margin-top:18px"><label>Payment method</label><select id="payMethod"><option>UPI (demo)</option><option>Credit / Debit Card (demo)</option><option>Net Banking (demo)</option><option>Pay at counter (offline demo)</option></select></div><div id="cardFields" class="formgrid hidden" style="margin-top:15px"><div class="field"><label>Cardholder name</label><input id="cardName" placeholder="Name on card"></div><div class="field"><label>Card number (demo only)</label><input id="cardNumber" placeholder="Do not enter real card details"></div></div><div class="notice">This is a front-end demonstration. No real payment is taken and no bank/card details should be entered.</div><div class="form-actions"><button class="primary" onclick="payAndBook()">Confirm demo booking</button><button class="secondary" onclick="showPage('book')">Back</button></div></div>
</section>

<section id="page-mytickets" class="page hidden">
  <h1 class="page-title">My tickets</h1><p class="page-sub">Your bookings and travel itineraries saved in this browser.</p><div id="ticketList"></div>
</section>

<section id="page-ticket" class="page hidden">
  <div class="section-head"><div><h1 class="page-title">E-ticket</h1><p class="page-sub">Keep your booking reference handy while travelling.</p></div><button class="primary no-print" onclick="window.print()">⎙ Print ticket</button></div>
  <div id="ticketDetail"></div><div class="form-actions no-print"><button class="secondary" onclick="showPage('mytickets')">My tickets</button><button class="danger" onclick="cancelCurrentTicket()">Request cancellation</button></div>
</section>

<section id="page-status" class="page hidden">
  <h1 class="page-title">View booking status</h1><p class="page-sub">Look up a reservation using its demo booking reference (PNR).</p>
  <div class="panel" style="max-width:720px"><div class="field"><label>Booking reference / PNR</label><input id="pnrSearch" placeholder="Example: SB123456"></div><div class="form-actions"><button class="primary" onclick="checkStatus()">Check status</button></div><div id="statusResult"></div></div>
</section>

<section id="page-cancel" class="page hidden">
  <h1 class="page-title">Cancel ticket</h1><p class="page-sub">Submit a cancellation request for an existing demo reservation.</p>
  <div class="panel" style="max-width:720px"><div class="field"><label>Booking reference / PNR</label><input id="cancelPnr" placeholder="Enter booking reference"></div><div class="field" style="margin-top:14px"><label>Reason (optional)</label><textarea id="cancelReason" rows="3" placeholder="Tell us why you need to cancel"></textarea></div><div class="notice">Refund eligibility is illustrative. Actual airline cancellation fees and refunds depend on fare rules and airline policy.</div><div class="form-actions"><button class="danger" onclick="submitCancellation()">Submit cancellation request</button><button class="secondary" onclick="showPage('mytickets')">Back to tickets</button></div><div id="cancelResult"></div></div>
</section>

<section id="page-feedback" class="page hidden">
  <h1 class="page-title">Customer feedback</h1><p class="page-sub">Share feedback to help improve the SkyBook experience.</p>
  <div class="panel" style="max-width:700px"><div class="field"><label>Your name</label><input id="fbName" placeholder="Name"></div><div class="field" style="margin-top:14px"><label>Rating</label><div class="feedback-stars" id="stars"><button data-star="1">★</button><button data-star="2">★</button><button data-star="3">★</button><button data-star="4">★</button><button data-star="5">★</button></div></div><div class="field" style="margin-top:14px"><label>Comments</label><textarea id="fbComment" rows="4" placeholder="Your comments..."></textarea></div><div class="form-actions"><button class="primary" onclick="submitFeedback()">Submit feedback</button></div><div id="feedbackMsg"></div></div><div class="section-head"><h2>Recent feedback</h2></div><div id="feedbackList"></div>
</section>

<section id="page-admin" class="page hidden">
  <h1 class="page-title">Administrator panel</h1><p class="page-sub">Manage sample flights, booking records, feedback and demo reports.</p>
  <div class="panel"><h3>Admin sign in</h3><div class="formgrid"><div class="field"><label>Admin username</label><input id="adminUser" value="admin"></div><div class="field"><label>Password</label><input id="adminPass" type="password" placeholder="Enter demo password"></div></div><div class="form-actions"><button class="primary" onclick="adminLogin()">Open admin panel</button></div><p class="muted small">Demo credentials: admin / skyadmin123</p><div id="adminMsg"></div></div>
  <div id="adminContent" class="hidden">
    <div class="dashboard-stats"><div class="stat"><span>Total bookings</span><strong id="statBookings">0</strong></div><div class="stat"><span>Cancellation requests</span><strong id="statCancels">0</strong></div><div class="stat"><span>Feedback entries</span><strong id="statFeedback">0</strong></div></div>
    <div class="admin-grid">
      <div class="panel"><h3>Add a flight</h3><div class="formgrid"><div class="field"><label>Airline</label><input id="newAirline" placeholder="e.g. SkyAir"></div><div class="field"><label>Flight number</label><input id="newCode" placeholder="SA 501"></div><div class="field"><label>Origin</label><select id="newFrom"><option>Mumbai</option><option>Delhi</option><option>Bengaluru</option><option>Hyderabad</option><option>Chennai</option><option>Kolkata</option><option>Goa</option></select></div><div class="field"><label>Destination</label><select id="newTo"><option>Delhi</option><option>Mumbai</option><option>Bengaluru</option><option>Hyderabad</option><option>Chennai</option><option>Kolkata</option><option>Goa</option></select></div><div class="field"><label>Departure</label><input id="newDeparture" value="10:00"></div><div class="field"><label>Arrival</label><input id="newArrival" value="12:00"></div><div class="field"><label>Duration</label><input id="newDuration" value="2h 00m"></div><div class="field"><label>Economy fare (₹)</label><input id="newFare" type="number" value="4500"></div></div><div class="form-actions"><button class="primary" onclick="addFlight()">Add flight</button></div></div>
      <div class="panel"><h3>Report summary</h3><p class="muted small">Download a simple CSV report of bookings stored in this browser.</p><button class="primary" onclick="downloadReport()">Download booking report</button><div style="height:12px"></div><button class="secondary" onclick="exportFeedback()">Export feedback CSV</button><div class="notice">Data is local to this browser. This demo is not connected to airline inventory or a live GDS.</div></div>
    </div>
    <div class="panel"><div class="section-head"><h3>Flight inventory</h3><span class="muted small">Sample schedule management</span></div><div class="table-wrap" id="adminFlights"></div></div>
    <div class="panel"><div class="section-head"><h3>Booking records</h3><span class="muted small">Passenger and payment demo records</span></div><div class="table-wrap" id="adminBookings"></div></div>
    <div class="panel"><div class="section-head"><h3>Cancellation / refund requests</h3></div><div class="table-wrap" id="adminCancels"></div></div>
    <div class="panel"><div class="section-head"><h3>Customer feedback</h3></div><div class="table-wrap" id="adminFeedback"></div></div>
  </div>
</section>
</main>
<footer class="footer">© 2026 SkyBook · Student project demo · No real airline inventory, payment processing, or email delivery is connected.</footer>
<div id="toast" class="toast hidden"></div>
<script>
const $=id=>document.getElementById(id);
const storage={
 get(k,f){try{return JSON.parse(localStorage.getItem('skybook_'+k))??f}catch(e){return f}},
 set(k,v){localStorage.setItem('skybook_'+k,JSON.stringify(v))}
};
const defaultFlights=[
{id:1,airline:'IndiGo',code:'6E 204',from:'Mumbai',to:'Delhi',departure:'06:20',arrival:'08:35',duration:'2h 15m',fare:4299,seats:24},
{id:2,airline:'Air India',code:'AI 672',from:'Mumbai',to:'Delhi',departure:'09:10',arrival:'11:25',duration:'2h 15m',fare:4890,seats:18},
{id:3,airline:'Akasa Air',code:'QP 1102',from:'Mumbai',to:'Delhi',departure:'13:40',arrival:'15:55',duration:'2h 15m',fare:3999,seats:12},
{id:4,airline:'IndiGo',code:'6E 532',from:'Bengaluru',to:'Goa',departure:'07:30',arrival:'08:45',duration:'1h 15m',fare:3199,seats:20},
{id:5,airline:'Air India Express',code:'IX 2874',from:'Delhi',to:'Hyderabad',departure:'11:00',arrival:'13:10',duration:'2h 10m',fare:3899,seats:16},
{id:6,airline:'IndiGo',code:'6E 611',from:'Chennai',to:'Bengaluru',departure:'17:15',arrival:'18:20',duration:'1h 05m',fare:2799,seats:14},
{id:7,airline:'SpiceJet',code:'SG 8152',from:'Kolkata',to:'Mumbai',departure:'15:30',arrival:'18:25',duration:'2h 55m',fare:5199,seats:10},
{id:8,airline:'Air India',code:'AI 541',from:'Hyderabad',to:'Chennai',departure:'19:00',arrival:'20:20',duration:'1h 20m',fare:2999,seats:19}
];
let flights=storage.get('flights',defaultFlights), bookings=storage.get('bookings',[]), cancels=storage.get('cancels',[]), feedback=storage.get('feedback',[]), currentUser=storage.get('user',null), selectedFlight=null, selectedSeat='', selectedTicket=null, stars=5, adminUnlocked=false;
const today=new Date();const iso=d=>{let x=new Date(d);x.setMinutes(x.getMinutes()-x.getTimezoneOffset());return x.toISOString().slice(0,10)};
['homeDate','travelDate'].forEach(id=>$(id).min=iso(today));$('homeDate').value=iso(today);$('travelDate').value=iso(today);
function saveAll(){storage.set('flights',flights);storage.set('bookings',bookings);storage.set('cancels',cancels);storage.set('feedback',feedback);storage.set('user',currentUser)}
function toast(msg){$('toast').textContent=msg;$('toast').classList.remove('hidden');setTimeout(()=>$('toast').classList.add('hidden'),3000)}
function showPage(page){document.querySelectorAll('.page').forEach(p=>p.classList.add('hidden'));$('page-'+page)?.classList.remove('hidden');document.querySelectorAll('#nav [data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===page));if(page==='mytickets')renderTickets();if(page==='feedback')renderFeedback();if(page==='admin'&&adminUnlocked)renderAdmin();window.scrollTo({top:0,behavior:'smooth'})}
document.querySelectorAll('#nav [data-page]').forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.page)));
function searchFromHome(){$('from').value=$('homeFrom').value;$('to').value=$('homeTo').value;$('travelDate').value=$('homeDate').value;$('travelClass').value=$('homeClass').value;showPage('search');searchFlights()}
function quickSearch(a,b){$('from').value=a;$('to').value=b;$('travelDate').value=iso(today);showPage('search');searchFlights()}
function swapRoute(){let a=$('from').value;$('from').value=$('to').value;$('to').value=a}
function searchFlights(){
 const from=$('from').value,to=$('to').value,date=$('travelDate').value,cls=$('travelClass').value;
 if(from===to){$('flightResults').innerHTML='<div class="notice error">Origin and destination must be different.</div>';return}
 let found=flights.filter(f=>f.from===from&&f.to===to);
 if(!found.length){$('flightResults').innerHTML=`<div class="panel empty"><strong>No sample flights found for ${esc(from)} → ${esc(to)}.</strong><p>Try another route, or add a flight from the Admin panel.</p><button class="secondary" onclick="showPage('home')">Back to home</button></div>`;return}
 if($('sortBy').value==='time')found.sort((a,b)=>a.departure.localeCompare(b.departure));else found.sort((a,b)=>a.fare-b.fare);
 const mult=cls==='Business'?2.3:cls==='First Class'?3.8:1;
 $('flightResults').innerHTML=`<div class="section-head"><h2>${found.length} flight options</h2><span class="muted small">${esc(from)} → ${esc(to)} · ${date||'Date not selected'} · ${cls}</span></div><div class="flight-list">${found.map(f=>`<div class="flight"><div class="airline"><div class="airline-logo">✈</div><div><strong>${esc(f.airline)}</strong><small>${esc(f.code)}</small></div></div><div class="route"><div><strong>${f.departure}</strong><div class="muted small">${esc(f.from)}</div></div><div class="line"><span>${esc(f.duration)}</span></div><div><strong>${f.arrival}</strong><div class="muted small">${esc(f.to)}</div></div></div><div class="pricebox"><div class="price">₹${Math.round(f.fare*mult).toLocaleString('en-IN')}</div><div class="muted small">${cls} · ${Math.max(1,f.seats)} seats left</div><span class="tag">${f.seats>5?'Available':'Limited seats'}</span></div><button class="primary" onclick="bookFlight(${f.id},'${escAttr(date)}','${escAttr(cls)}',${Math.round(f.fare*mult)})">Select flight</button></div>`).join('')}</div><p class="muted small">Flight results are sample data for a project demonstration and are not live airline inventory.</p>`;
}
function bookFlight(id,date,cls,price){selectedFlight=flights.find(f=>f.id===id)||flights.find(f=>f.id===id-1000);if(!selectedFlight)return;selectedFlight={...selectedFlight,from:$('from').value,to:$('to').value};selectedFlight.date=date||iso(today);selectedFlight.cls=cls;selectedFlight.price=price;selectedSeat='';$('chosenFlight').innerHTML=`<div class="airline"><div class="airline-logo">✈</div><div><strong>${esc(selectedFlight.airline)} · ${esc(selectedFlight.code)}</strong><div class="muted small">${esc(selectedFlight.from)} → ${esc(selectedFlight.to)} · ${selectedFlight.date} · ${cls}</div></div><div style="margin-left:auto;font-size:22px;font-weight:850">₹${price.toLocaleString('en-IN')}</div></div>`;renderSeats();showPage('book')}
function renderSeats(){let taken=[2,5,9,14,19,25,31,33,34,35,36,37].filter(n=>n<=36);$('seatGrid').innerHTML=Array.from({length:36},(_,i)=>{let n=i+1,disabled=taken.includes(n);return `<button class="seat ${disabled?'taken':''}" ${disabled?'disabled':''} onclick="chooseSeat(${n})" title="${disabled?'Unavailable':'Seat '+seatName(n)}">${seatName(n)}</button>`}).join('')}
function seatName(n){return String.fromCharCode(65+Math.floor((n-1)/6))+(((n-1)%6)+1)}
function chooseSeat(n){selectedSeat=n;document.querySelectorAll('.seat').forEach((b,i)=>b.classList.toggle('selected',i===n-1));$('seatMsg').textContent='Selected seat: '+seatName(n)}
function continueToPayment(){if(!$('pName').value.trim()||!$('pEmail').value.includes('@')||!$('pPhone').value.trim()||!$('pAge').value||!selectedSeat){toast('Please complete passenger details and select a seat.');return}if(!currentUser){currentUser={name:$('pName').value.trim(),email:$('pEmail').value.trim()};saveAll()}$('paymentSummary').innerHTML=`<div class="ticket-route"><div><div class="muted small">FROM</div><strong>${esc(selectedFlight.from)}</strong><div>${selectedFlight.departure}</div></div><div class="middle">✈<br>${esc(selectedFlight.duration)}<br>Non-stop (sample)</div><div style="text-align:right"><div class="muted small">TO</div><strong>${esc(selectedFlight.to)}</strong><div>${selectedFlight.arrival}</div></div></div><div class="ticket-grid"><div><span>Passenger</span><strong>${esc($('pName').value)}</strong></div><div><span>Seat / Class</span><strong>${seatName(selectedSeat)} · ${esc(selectedFlight.cls)}</strong></div><div><span>Total fare</span><strong>₹${selectedFlight.price.toLocaleString('en-IN')}</strong></div></div>`;showPage('payment')}
$('payMethod').addEventListener('change',()=> $('cardFields').classList.toggle('hidden',!$('payMethod').value.includes('Card')));
function payAndBook(){if(!selectedFlight){toast('Please select a flight first.');return}const pnr='SB'+Math.random().toString(36).slice(2,8).toUpperCase();const b={pnr,flight:{...selectedFlight},passenger:{name:$('pName').value.trim(),email:$('pEmail').value.trim(),phone:$('pPhone').value.trim(),age:$('pAge').value},seat:seatName(selectedSeat),price:selectedFlight.price,paymentMethod:$('payMethod').value,paymentStatus:$('payMethod').value.includes('counter')?'Pay at counter':'Demo paid',status:'Confirmed (demo)',createdAt:new Date().toLocaleString(),cancellation:'None'};bookings.unshift(b);saveAll();selectedTicket=pnr;renderTicket(b);showPage('ticket');toast('Demo booking created. Reference: '+pnr)}
function renderTickets(){if(!currentUser){$('ticketList').innerHTML='<div class="panel empty">Sign in to view your tickets.<br><br><button class="primary" onclick="showPage(\'login\')">Sign in / Register</button></div>';return}const mine=bookings.filter(b=>b.passenger.email.toLowerCase()===currentUser.email.toLowerCase());$('ticketList').innerHTML=mine.length?`<div class="flight-list">${mine.map(b=>`<div class="panel"><div class="section-head"><div><strong>${esc(b.flight.from)} → ${esc(b.flight.to)}</strong><div class="muted small">${esc(b.flight.date)} · ${esc(b.flight.airline)} · PNR ${esc(b.pnr)}</div></div><span class="tag ${b.status.includes('Cancelled')?'wait':''}">${esc(b.status)}</span></div><div class="form-actions"><button class="primary" onclick="openTicket('${b.pnr}')">View / Print ticket</button><button class="secondary" onclick="lookupPnr('${b.pnr}')">Booking status</button><button class="danger" onclick="goCancel('${b.pnr}')">Cancel ticket</button></div></div>`).join('')}</div>`:'<div class="panel empty">No bookings found for this account yet. Search flights to make your first booking.</div>'}
function renderTicket(b){selectedTicket=b.pnr;$('ticketDetail').innerHTML=`<div class="ticket"><div class="ticket-head"><div><strong>✈ SkyBook</strong><div class="small" style="color:#d6e6fb;margin-top:5px">ELECTRONIC FLIGHT TICKET</div></div><div><div class="small">BOOKING REFERENCE / PNR</div><strong style="font-size:22px;letter-spacing:1px">${esc(b.pnr)}</strong></div></div><div class="ticket-body"><div class="section-head"><div><strong>${esc(b.flight.airline)} · ${esc(b.flight.code)}</strong><div class="muted small">${esc(b.flight.date)} · ${esc(b.flight.cls)}</div></div><span class="tag">${esc(b.status)}</span></div><div class="ticket-route"><div><div class="muted small">${esc(b.flight.from).toUpperCase()}</div><strong>${b.flight.departure}</strong><div class="small">${esc(b.flight.from)}</div></div><div class="middle">✈<br>${esc(b.flight.duration)}<br>Direct flight (sample)</div><div style="text-align:right"><div class="muted small">${esc(b.flight.to).toUpperCase()}</div><strong>${b.flight.arrival}</strong><div class="small">${esc(b.flight.to)}</div></div></div><div class="ticket-grid"><div><span>Passenger name</span><strong>${esc(b.passenger.name)}</strong></div><div><span>Seat / class</span><strong>${esc(b.seat)} · ${esc(b.flight.cls)}</strong></div><div><span>Booking date</span><strong>${esc(b.createdAt)}</strong></div><div><span>Ticket fare</span><strong>₹${Number(b.price).toLocaleString('en-IN')}</strong></div><div><span>Payment</span><strong>${esc(b.paymentStatus)}</strong></div><div><span>Contact email</span><strong>${esc(b.passenger.email)}</strong></div></div><p class="muted small" style="margin-top:22px">This is a project-demo ticket, not a valid airline boarding pass. Confirmation emails are not sent by this standalone file.</p></div></div>`}
function openTicket(pnr){let b=bookings.find(x=>x.pnr===pnr);if(b){renderTicket(b);showPage('ticket')}}
function checkStatus(){let pnr=$('pnrSearch').value.trim().toUpperCase(),b=bookings.find(x=>x.pnr===pnr);$('statusResult').innerHTML=b?`<div class="notice" style="margin-top:18px"><strong>${esc(b.pnr)}</strong> · ${esc(b.status)}<br>${esc(b.flight.from)} → ${esc(b.flight.to)} · ${esc(b.flight.date)}<br>Passenger: ${esc(b.passenger.name)} · Seat: ${esc(b.seat)}<div style="margin-top:10px"><button class="secondary" onclick="openTicket('${b.pnr}')">View ticket</button></div></div>`:'<div class="notice error" style="margin-top:18px">No demo booking found for that reference.</div>'}
function lookupPnr(pnr){$('pnrSearch').value=pnr;showPage('status');checkStatus()}
function goCancel(pnr){$('cancelPnr').value=pnr;showPage('cancel')}
function cancelCurrentTicket(){goCancel(selectedTicket)}
function submitCancellation(){let pnr=$('cancelPnr').value.trim().toUpperCase(),b=bookings.find(x=>x.pnr===pnr);if(!b){$('cancelResult').innerHTML='<div class="notice error">Booking reference not found.</div>';return}if(b.status.includes('Cancelled')){$('cancelResult').innerHTML='<div class="notice">This booking has already been cancelled.</div>';return}if(cancels.some(c=>c.pnr===pnr&&c.status==='Pending')){$('cancelResult').innerHTML='<div class="notice">A cancellation request is already pending for this booking.</div>';return}let refund=Math.round(b.price*.8);cancels.unshift({pnr,reason:$('cancelReason').value||'Not specified',refund,status:'Pending',date:new Date().toLocaleString()});b.cancellation='Requested';saveAll();$('cancelResult').innerHTML=`<div class="notice">Cancellation request submitted for ${esc(pnr)}. Estimated demo refund: ₹${refund.toLocaleString('en-IN')} (80% illustrative rate). Refund is pending admin review.</div>`;renderAdminIfOpen()}
function authenticate(){let email=$('authEmail').value.trim().toLowerCase(),pass=$('authPassword').value,name=$('authName').value.trim();if(!email.includes('@')||pass.length<4){toast('Enter a valid email and a password of at least 4 characters.');return}if($('authMode').value==='register'&&!name){toast('Enter your name to create an account.');return}currentUser={name:name||email.split('@')[0],email};saveAll();$('loginNav').textContent=currentUser.name.split(' ')[0];toast('Signed in for this demo.');showPage('mytickets')}
function resetPassword(){let e=$('forgotEmail').value.trim();$('forgotMsg').innerHTML=e.includes('@')?'<div class="notice">If this were connected to an account service, reset instructions would be sent. No email was actually sent.</div>':'<div class="notice error">Enter a valid email address.</div>'}
function adminLogin(){if($('adminUser').value==='admin'&&$('adminPass').value==='skyadmin123'){adminUnlocked=true;$('adminContent').classList.remove('hidden');$('adminMsg').innerHTML='<div class="notice">Admin demo access granted.</div>';renderAdmin()}else $('adminMsg').innerHTML='<div class="notice error">Incorrect demo credentials.</div>'}
function renderAdminIfOpen(){if(adminUnlocked)renderAdmin()}
function renderAdmin(){ $('statBookings').textContent=bookings.length;$('statCancels').textContent=cancels.filter(c=>c.status==='Pending').length;$('statFeedback').textContent=feedback.length;
 $('adminFlights').innerHTML=`<table><thead><tr><th>Flight</th><th>Route</th><th>Time</th><th>Fare</th><th>Seats</th><th>Action</th></tr></thead><tbody>${flights.map(f=>`<tr><td>${esc(f.airline)}<br><span class="muted">${esc(f.code)}</span></td><td>${esc(f.from)} → ${esc(f.to)}</td><td>${f.departure}–${f.arrival}</td><td>₹${f.fare}</td><td>${f.seats}</td><td><button class="danger" onclick="deleteFlight(${f.id})">Remove</button></td></tr>`).join('')}</tbody></table>`;
 $('adminBookings').innerHTML=bookings.length?`<table><thead><tr><th>PNR</th><th>Passenger</th><th>Route</th><th>Payment</th><th>Fare</th><th>Status</th></tr></thead><tbody>${bookings.map(b=>`<tr><td>${esc(b.pnr)}</td><td>${esc(b.passenger.name)}<br>${esc(b.passenger.email)}</td><td>${esc(b.flight.from)} → ${esc(b.flight.to)}</td><td>${esc(b.paymentStatus)}<br>${esc(b.paymentMethod)}</td><td>₹${b.price}</td><td>${esc(b.status)}</td></tr>`).join('')}</tbody></table>`:'<div class="empty">No bookings yet.</div>';
 $('adminCancels').innerHTML=cancels.length?`<table><thead><tr><th>PNR</th><th>Reason</th><th>Estimated refund</th><th>Status</th><th>Action</th></tr></thead><tbody>${cancels.map(c=>`<tr><td>${esc(c.pnr)}</td><td>${esc(c.reason)}</td><td>₹${c.refund}</td><td>${esc(c.status)}</td><td>${c.status==='Pending'?`<button class="primary" onclick="processRefund('${c.pnr}')">Approve refund</button> <button class="secondary" onclick="rejectRefund('${c.pnr}')">Reject</button>`:'—'}</td></tr>`).join('')}</tbody></table>`:'<div class="empty">No cancellation requests.</div>';
 $('adminFeedback').innerHTML=feedback.length?`<table><thead><tr><th>Name</th><th>Rating</th><th>Comment</th><th>Date</th></tr></thead><tbody>${feedback.map(f=>`<tr><td>${esc(f.name)}</td><td>${'★'.repeat(f.rating)}</td><td>${esc(f.comment)}</td><td>${esc(f.date)}</td></tr>`).join('')}</tbody></table>`:'<div class="empty">No feedback yet.</div>';
}
function addFlight(){let airline=$('newAirline').value.trim(),code=$('newCode').value.trim(),from=$('newFrom').value,to=$('newTo').value,fare=Number($('newFare').value);if(!airline||!code||from===to||fare<=0){toast('Complete flight fields and use different origin/destination.');return}flights.push({id:Date.now(),airline,code,from,to,departure:$('newDeparture').value||'10:00',arrival:$('newArrival').value||'12:00',duration:$('newDuration').value||'2h',fare,seats:30});saveAll();renderAdmin();toast('Sample flight added.')}
function deleteFlight(id){flights=flights.filter(f=>f.id!==id);saveAll();renderAdmin();toast('Flight removed from sample inventory.')}
function processRefund(pnr){let c=cancels.find(x=>x.pnr===pnr),b=bookings.find(x=>x.pnr===pnr);if(c){c.status='Approved (demo)';if(b){b.status='Cancelled (demo)';b.paymentStatus='Refund approved (demo)'}saveAll();renderAdmin();toast('Demo refund approved; no money was transferred.')}}
function rejectRefund(pnr){let c=cancels.find(x=>x.pnr===pnr);if(c){c.status='Rejected';saveAll();renderAdmin();toast('Request marked rejected.')}}
function csvEscape(v){return '"'+String(v??'').replace(/"/g,'""')+'"'}
function downloadCSV(name,rows){let csv=rows.map(r=>r.map(csvEscape).join(',')).join('\r\n');let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8;'}));a.download=name;a.click();URL.revokeObjectURL(a.href)}
function downloadReport(){downloadCSV('skybook-booking-report.csv',[['PNR','Passenger','Email','Origin','Destination','Date','Flight','Seat','Fare','Payment method','Payment status','Booking status'],...bookings.map(b=>[b.pnr,b.passenger.name,b.passenger.email,b.flight.from,b.flight.to,b.flight.date,b.flight.code,b.seat,b.price,b.paymentMethod,b.paymentStatus,b.status])])}
function exportFeedback(){downloadCSV('skybook-feedback.csv',[['Name','Rating','Comment','Date'],...feedback.map(f=>[f.name,f.rating,f.comment,f.date])])}
document.querySelectorAll('#stars button').forEach(b=>b.addEventListener('click',()=>{stars=Number(b.dataset.star);document.querySelectorAll('#stars button').forEach(x=>x.classList.toggle('chosen',Number(x.dataset.star)<=stars))}));document.querySelectorAll('#stars button').forEach(b=>b.classList.toggle('chosen',Number(b.dataset.star)<=stars));
function submitFeedback(){let name=$('fbName').value.trim(),comment=$('fbComment').value.trim();if(!name||!comment){$('feedbackMsg').innerHTML='<div class="notice error">Please enter your name and comments.</div>';return}feedback.unshift({name,comment,rating:stars,date:new Date().toLocaleDateString()});saveAll();$('fbName').value='';$('fbComment').value='';$('feedbackMsg').innerHTML='<div class="notice">Thank you! Your feedback has been saved in this browser.</div>';renderFeedback();renderAdminIfOpen()}
function renderFeedback(){$('feedbackList').innerHTML=feedback.length?feedback.slice(0,8).map(f=>`<div class="panel"><strong>${esc(f.name)}</strong> <span style="color:#e5a72d">${'★'.repeat(f.rating)}${'☆'.repeat(5-f.rating)}</span><p style="margin-bottom:5px">${esc(f.comment)}</p><span class="muted small">${esc(f.date)}</span></div>`).join(''):'<div class="panel empty">No feedback submitted yet.</div>'}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function escAttr(s){return esc(s).replace(/"/g,'&quot;')}
if(currentUser)$('loginNav').textContent=currentUser.name.split(' ')[0];searchFlights();
</script>
</body>
</html>
