<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>InsureEasy | Insurance Management</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f3f6fb;color:#17243a}header{background:#12345a;color:white;padding:18px 6%;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}header h1{margin:0;font-size:25px}nav{display:flex;gap:7px;flex-wrap:wrap}button{border:0;border-radius:8px;padding:10px 14px;cursor:pointer;font-weight:600;background:#e7eef8;color:#17385e}nav button{background:transparent;color:white}nav button:hover,nav button.active{background:#2d5f91}.page{display:none;max-width:1100px;margin:28px auto;padding:0 18px}.page.active{display:block}.hero,.card{background:white;border-radius:15px;padding:25px;margin-bottom:18px;box-shadow:0 5px 20px #17243a10}.hero{background:linear-gradient(120deg,#12345a,#2877a9);color:white;padding:42px}.hero h2{font-size:34px;margin:0 0 12px}.primary{background:#1676a8;color:white}.secondary{background:#eaf1f8;color:#17385e}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:15px}.field{margin:12px 0}.field label{display:block;font-weight:bold;margin-bottom:6px}input,select,textarea{width:100%;padding:11px;border:1px solid #ccd6e2;border-radius:8px;font:inherit}textarea{min-height:90px}.muted{color:#65758a}.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}.stat{background:#edf5fb;padding:18px;border-radius:10px}.stat strong{display:block;font-size:24px;color:#176d9e}table{width:100%;border-collapse:collapse;margin-top:12px}th,td{text-align:left;padding:12px;border-bottom:1px solid #e4eaf0}th{background:#edf3f8}.pill{display:inline-block;padding:5px 9px;border-radius:20px;background:#e2f5e9;color:#197344;font-size:12px}.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:15px}.small{font-size:13px}footer{text-align:center;padding:25px;color:#728096}@media(max-width:600px){header{padding:16px}.hero h2{font-size:27px}nav{width:100%}nav button{padding:8px}}
</style>
</head>
<body>
<header><h1>🛡️ InsureEasy</h1><nav>
<button class="active" onclick="showPage('home',this)">Home</button><button onclick="showPage('plans',this)">Insurance Plans</button><button onclick="showPage('apply',this)">Apply</button><button onclick="showPage('claims',this)">Claims</button><button onclick="showPage('policies',this)">My Policies</button><button onclick="showPage('support',this)">Support</button><button onclick="showPage('admin',this)">Admin</button>
</nav></header>
<main>
<section id="home" class="page active"><div class="hero"><h2>Protection made simple.</h2><p>Explore insurance plans, apply online and manage your policies in one place.</p><button class="primary" onclick="showPage('plans')">Explore Plans →</button></div><div class="stats"><div class="stat"><strong>3</strong>Insurance categories</div><div class="stat"><strong>24/7</strong>Online access</div><div class="stat"><strong>Easy</strong>Claim requests</div></div><div class="card"><h2>Why choose InsureEasy?</h2><div class="grid"><div><h3>Simple applications</h3><p class="muted">Submit your details through an easy online form.</p></div><div><h3>Policy management</h3><p class="muted">View policy information and application status.</p></div><div><h3>Claim assistance</h3><p class="muted">Register and track insurance claims.</p></div></div></div></section>
<section id="plans" class="page"><div class="card"><h2>Insurance Plans</h2><p class="muted">Choose a plan category to view sample coverage options.</p><div class="grid">
<div class="card"><h3>Health Insurance</h3><p>Hospitalisation and medical expense protection.</p><h2>₹8,000/year</h2><button class="primary" onclick="choosePlan('Health Insurance')">Apply now</button></div>
<div class="card"><h3>Life Insurance</h3><p>Financial protection for your family.</p><h2>₹12,000/year</h2><button class="primary" onclick="choosePlan('Life Insurance')">Apply now</button></div>
<div class="card"><h3>Vehicle Insurance</h3><p>Protection against eligible vehicle-related losses.</p><h2>₹5,000/year</h2><button class="primary" onclick="choosePlan('Vehicle Insurance')">Apply now</button></div>
</div></div></section>
<section id="apply" class="page"><div class="card"><h2>Insurance Application</h2><form onsubmit="submitApplication(event)"><div class="grid"><div class="field"><label>Full name</label><input id="appName" required></div><div class="field"><label>Email</label><input id="appEmail" type="email" required></div><div class="field"><label>Mobile number</label><input id="appMobile" pattern="[0-9]{10}" maxlength="10" required placeholder="10-digit number"></div><div class="field"><label>Insurance type</label><select id="appPlan"><option>Health Insurance</option><option>Life Insurance</option><option>Vehicle Insurance</option></select></div><div class="field"><label>Date of birth</label><input id="appDob" type="date" required></div><div class="field"><label>Coverage amount (₹)</label><input id="appCover" type="number" min="10000" required></div></div><div class="field"><label>Address</label><textarea id="appAddress" required></textarea></div><button class="primary">Submit Application</button></form><p id="appMsg" class="muted"></p></div></section>
<section id="claims" class="page"><div class="card"><h2>Register an Insurance Claim</h2><form onsubmit="submitClaim(event)"><div class="grid"><div class="field"><label>Policy / application ID</label><input id="claimPolicy" required></div><div class="field"><label>Claim type</label><select id="claimType"><option>Medical expenses</option><option>Life insurance</option><option>Vehicle damage</option><option>Other</option></select></div><div class="field"><label>Claim amount (₹)</label><input id="claimAmount" type="number" min="1" required></div></div><div class="field"><label>Description of incident</label><textarea id="claimDesc" required></textarea></div><button class="primary">Submit Claim</button></form><p id="claimMsg" class="muted"></p></div><div class="card"><h3>Claim tracking</h3><div class="field"><label>Enter claim ID</label><input id="trackId" placeholder="Example: CLM1001"></div><button class="secondary" onclick="trackClaim()">Track Claim</button><p id="trackResult"></p></div></section>
<section id="policies" class="page"><div class="card"><h2>My Policies & Applications</h2><p class="muted">Your submitted applications are shown below on this browser.</p><div id="policyList">No applications submitted yet.</div></div></section>
<section id="support" class="page"><div class="card"><h2>Customer Support</h2><p>For policy questions, claim assistance or application support, send a message.</p><form onsubmit="supportMsg(event)"><div class="field"><label>Name</label><input required></div><div class="field"><label>Email</label><input type="email" required></div><div class="field"><label>Message</label><textarea required></textarea></div><button class="primary">Send Message</button></form><p id="supportOut" class="muted"></p></div></section>
<section id="admin" class="page"><div class="card"><h2>Admin Login</h2><p class="muted">Demo credentials: admin / admin123</p><form onsubmit="adminLogin(event)"><div class="field"><label>Username</label><input id="adminUser" required></div><div class="field"><label>Password</label><input id="adminPass" type="password" required></div><button class="primary">Login</button></form><p id="adminError"></p></div><div id="adminPanel" class="card" style="display:none"><h2>Admin Dashboard</h2><div class="stats"><div class="stat"><strong id="totalApps">0</strong>Applications</div><div class="stat"><strong id="totalClaims">0</strong>Claims</div></div><h3>Applications</h3><div id="adminApps"></div><h3>Claims</h3><div id="adminClaims"></div></div></section>
</main><footer>InsureEasy Insurance Management System | Internet Programming Lab Demo</footer>
<script>
let apps=JSON.parse(localStorage.getItem('ieApps')||'[]'),claims=JSON.parse(localStorage.getItem('ieClaims')||'[]');
function showPage(id,btn){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');if(id==='policies')renderPolicies();window.scrollTo(0,0)}
function choosePlan(p){document.getElementById('appPlan').value=p;showPage('apply')}
function submitApplication(e){e.preventDefault();let a={id:'POL'+(1001+apps.length),name:appName.value,email:appEmail.value,mobile:appMobile.value,plan:appPlan.value,dob:appDob.value,cover:appCover.value,address:appAddress.value,status:'Under Review'};apps.push(a);localStorage.setItem('ieApps',JSON.stringify(apps));appMsg.textContent='Application submitted successfully. Your reference ID is '+a.id; e.target.reset()}
function submitClaim(e){e.preventDefault();let c={id:'CLM'+(1001+claims.length),policy:claimPolicy.value,type:claimType.value,amount:claimAmount.value,desc:claimDesc.value,status:'Received'};claims.push(c);localStorage.setItem('ieClaims',JSON.stringify(claims));claimMsg.textContent='Claim registered. Your claim ID is '+c.id;e.target.reset()}
function trackClaim(){let c=claims.find(x=>x.id.toLowerCase()===trackId.value.trim().toLowerCase());trackResult.textContent=c?'Claim '+c.id+' status: '+c.status:'No matching claim found.'}
function renderPolicies(){policyList.innerHTML=apps.length?'<table><tr><th>Reference</th><th>Plan</th><th>Coverage</th><th>Status</th></tr>'+apps.map(a=>`<tr><td>${a.id}</td><td>${a.plan}</td><td>₹${Number(a.cover).toLocaleString('en-IN')}</td><td><span class="pill">${a.status}</span></td></tr>`).join('')+'</table>':'No applications submitted yet.'}
function adminLogin(e){e.preventDefault();if(adminUser.value==='admin'&&adminPass.value==='admin123'){adminPanel.style.display='block';adminError.textContent='';renderAdmin()}else adminError.textContent='Invalid login details.'}
function renderAdmin(){totalApps.textContent=apps.length;totalClaims.textContent=claims.length;adminApps.innerHTML=apps.length?'<table><tr><th>ID</th><th>Applicant</th><th>Plan</th><th>Status</th><th>Update</th></tr>'+apps.map((a,i)=>`<tr><td>${a.id}</td><td>${a.name}</td><td>${a.plan}</td><td>${a.status}</td><td><select onchange="updateApp(${i},this.value)"><option>Under Review</option><option>Approved</option><option>Rejected</option></select></td></tr>`).join('')+'</table>':'No applications yet.';adminClaims.innerHTML=claims.length?'<table><tr><th>ID</th><th>Policy</th><th>Type</th><th>Status</th><th>Update</th></tr>'+claims.map((c,i)=>`<tr><td>${c.id}</td><td>${c.policy}</td><td>${c.type}</td><td>${c.status}</td><td><select onchange="updateClaim(${i},this.value)"><option>Received</option><option>In Progress</option><option>Approved</option><option>Rejected</option></select></td></tr>`).join('')+'</table>':'No claims yet.'}
function updateApp(i,s){apps[i].status=s;localStorage.setItem('ieApps',JSON.stringify(apps));renderAdmin()}
function updateClaim(i,s){claims[i].status=s;localStorage.setItem('ieClaims',JSON.stringify(claims));renderAdmin()}
function supportMsg(e){e.preventDefault();supportOut.textContent='Your support message has been recorded in this demo.';e.target.reset()}
</script></body></html>
