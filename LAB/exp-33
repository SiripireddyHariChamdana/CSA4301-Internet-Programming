<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>KodaikanalEats</title>
<style>
:root{--g:#245b48;--d:#183c31;--c:#f7f5ef;--o:#e58b52}*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:var(--c);color:#24352e}header{background:white;position:sticky;top:0;z-index:3;box-shadow:0 2px 12px #0001}nav{max-width:1100px;margin:auto;padding:17px 22px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px}.logo{font-size:23px;font-weight:bold;color:var(--g)}.logo span{color:var(--o)}nav a{margin-left:16px;text-decoration:none;color:#34483f;font-weight:bold;font-size:14px}.hero{padding:75px 22px;color:white;background:linear-gradient(90deg,#102c24dd,#102c2466),url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1500&q=80') center/cover}.wrap{max-width:1100px;margin:auto}.eyebrow{letter-spacing:3px;text-transform:uppercase;color:#f5bd91;font-size:12px;font-weight:bold}h1{font-size:clamp(38px,6vw,62px);max-width:650px;margin:15px 0}.hero p{max-width:570px;line-height:1.6}.search{display:flex;flex-wrap:wrap;gap:9px;background:white;padding:10px;border-radius:12px;max-width:780px;margin-top:25px}.search input,.search select{flex:1;min-width:160px}input,select,textarea{padding:12px;border:1px solid #dce3dc;border-radius:8px;font:inherit}button{background:var(--g);color:white;border:0;border-radius:8px;padding:12px 18px;font-weight:bold;cursor:pointer}button:hover{background:var(--d)}.section{max-width:1100px;margin:auto;padding:52px 22px}.head{margin-bottom:22px}h2{color:var(--d);font-size:30px;margin:0 0 8px}.muted{color:#68756e;line-height:1.5}.filters{display:flex;gap:9px;flex-wrap:wrap;margin:18px 0 22px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:19px}.card,.panel{background:white;border-radius:14px;overflow:hidden;box-shadow:0 5px 20px #1b39240c}.card img{width:100%;height:185px;object-fit:cover}.body{padding:16px}.body h3{margin:0 0 8px;color:var(--d)}.meta{font-size:13px;color:#68756e;margin:7px 0}.rating{color:#bd6a26;font-weight:bold}.bottom{display:flex;justify-content:space-between;align-items:center;margin-top:14px}.light{background:#edf3ef;color:var(--g)}.offer{background:#eaf0e9;border-radius:15px;padding:28px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}.offer strong{font-size:23px;color:var(--d)}.two{display:grid;grid-template-columns:1fr 1fr;gap:20px}.panel{padding:23px}form{display:grid;gap:12px}label{font-size:13px;font-weight:bold;color:#43564c}label input,label select,label textarea{display:block;width:100%;margin-top:5px}.pair{display:grid;grid-template-columns:1fr 1fr;gap:12px}footer{background:var(--d);color:#e9f0e9;text-align:center;padding:30px}.small{font-size:12px;color:#68756e}@media(max-width:800px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.grid,.two,.pair{grid-template-columns:1fr}.hero{padding:55px 20px}.section{padding:38px 18px}nav a{margin-left:0;margin-right:12px}}
</style></head><body>
<header><nav><div class="logo">Kodaikanal<span>Eats</span></div><div><a href="#home">Home</a><a href="#restaurants">Restaurants</a><a href="#offers">Offers</a><a href="#contact">Contact</a></div></nav></header>
<section class="hero" id="home"><div class="wrap"><div class="eyebrow">A taste of the hills</div><h1>Find your next favourite table.</h1><p>Explore Kodaikanal's cosy cafés, local favourites and memorable dining spots. Discover a place, browse its menu and reserve your table.</p><div class="search"><input id="search" placeholder="Search restaurant or location"><select id="heroCuisine"><option value="">All cuisines</option><option>South Indian</option><option>Italian</option><option>Chinese</option><option>Multi-cuisine</option></select><button onclick="filterPlaces()">Find restaurants</button></div></div></section>
<section class="section" id="restaurants"><div class="head"><h2>Explore restaurants</h2><p class="muted">Handpicked places to enjoy in Kodaikanal.</p><span id="count" class="small"></span></div><div class="filters"><select id="cuisine" onchange="filterPlaces()"><option value="">All cuisines</option><option>South Indian</option><option>Italian</option><option>Chinese</option><option>Multi-cuisine</option></select><select id="location" onchange="filterPlaces()"><option value="">All locations</option><option>Lake Road</option><option>Coakers Walk</option><option>Town Centre</option></select><select id="rating" onchange="filterPlaces()"><option value="0">Any rating</option><option value="4">4.0+ rating</option><option value="4.5">4.5+ rating</option></select></div><div class="grid" id="grid"></div></section>
<section class="section" id="offers"><div class="offer"><div><div class="eyebrow">Special offers</div><strong>Make your hill-station meal extra special.</strong><p class="muted">Ask participating restaurants about today's dining deals.</p></div><button onclick="document.getElementById('restaurants').scrollIntoView({behavior:'smooth'})">Explore places</button></div></section>
<section class="section" id="booking"><div class="head"><h2>Reserve a table</h2><p class="muted">Choose a restaurant and preferred dining time.</p></div><div class="two"><div class="panel"><h3>Table reservation</h3><form id="bookingForm"><label>Restaurant<select id="restaurant" required></select></label><div class="pair"><label>Your name<input id="name" required placeholder="Full name"></label><label>Phone number<input id="phone" required type="tel" placeholder="Mobile number"></label></div><div class="pair"><label>Date<input id="date" required type="date"></label><label>Dining time<select id="time" required><option value="">Select time</option><option>12:00 PM</option><option>1:00 PM</option><option>2:00 PM</option><option>6:00 PM</option><option>7:00 PM</option><option>8:00 PM</option><option>9:00 PM</option></select></label></div><label>Number of guests<select id="guests"><option>1</option><option selected>2</option><option>3</option><option>4</option><option>5</option><option>6</option></select></label><button>Confirm reservation</button></form><p id="msg"></p></div><div class="panel"><h3>Reservation details</h3><p class="muted">Your booking summary will appear here after submission.</p><div id="confirmation" class="small">No reservation made yet.</div><hr><h3>Dining tip</h3><p class="muted">Popular dining times can fill quickly during weekends and holidays. Contact the restaurant directly to verify availability.</p></div></div></section>
<section class="section" id="contact"><div class="head"><h2>Contact us</h2><p class="muted">Questions or suggestions? Send our team a message.</p></div><div class="panel"><form id="contactForm"><div class="pair"><label>Name<input required placeholder="Your name"></label><label>Email<input required type="email" placeholder="you@example.com"></label></div><label>Message<textarea rows="4" required placeholder="How can we help?"></textarea></label><button>Send message</button></form><p id="contactMsg"></p></div></section>
<footer><div class="logo" style="color:white">Kodaikanal<span>Eats</span></div><p>Discover local flavours. Reserve your favourite table.</p><span class="small" style="color:#c7d5cb">Demo website • Restaurant details and availability are illustrative.</span></footer>
<script>
const places=[
{name:"Hilltop Bistro",c:"Multi-cuisine",l:"Lake Road",r:4.6,p:"₹₹",d:"A relaxed dining spot with scenic hill-town charm.",m:"Soups, grilled sandwiches, pasta and local meals.",i:"https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=900&q=80"},
{name:"Little Italy",c:"Italian",l:"Coakers Walk",r:4.5,p:"₹₹₹",d:"Comforting Italian favourites in a cosy setting.",m:"Pizza, pasta and desserts.",i:"https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=900&q=80"},
{name:"Annapoorna Kitchen",c:"South Indian",l:"Town Centre",r:4.3,p:"₹",d:"A friendly stop for traditional South Indian food.",m:"Idli, dosa, meals, vada and filter coffee.",i:"https://images.unsplash.com/photo-1585937421612-70a008356fbe?auto=format&fit=crop&w=900&q=80"},
{name:"Pepper Wok",c:"Chinese",l:"Lake Road",r:4.1,p:"₹₹",d:"A casual place for flavourful Asian-inspired dishes.",m:"Noodles, fried rice, soups and starters.",i:"https://images.unsplash.com/photo-1552566626-52f8b828add9?auto=format&fit=crop&w=900&q=80"},
{name:"The Garden Table",c:"Multi-cuisine",l:"Coakers Walk",r:4.7,p:"₹₹₹",d:"A welcoming restaurant for a leisurely meal.",m:"Continental plates, local specials and desserts.",i:"https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=900&q=80"},
{name:"Spice Trail Cafe",c:"South Indian",l:"Town Centre",r:4.0,p:"₹₹",d:"Casual dining with familiar regional flavours.",m:"Regional snacks, biryani and beverages.",i:"https://images.unsplash.com/photo-1559339352-11d035aa65de?auto=format&fit=crop&w=900&q=80"}];
function render(items){document.getElementById('count').textContent=items.length+' restaurants';document.getElementById('grid').innerHTML=items.map(x=>`<article class="card"><img src="${x.i}" alt="${x.name}"><div class="body"><h3>${x.name}</h3><div class="meta">${x.c} • ${x.l}</div><div class="meta"><span class="rating">★ ${x.r}</span> &nbsp; ${x.p}</div><p class="meta">${x.d}</p><p class="small"><b>Popular menu:</b> ${x.m}</p><div class="bottom"><span class="small">Kodaikanal</span><button class="light" onclick="choose('${x.name}')">Book table</button></div></div></article>`).join('')}
function filterPlaces(){let q=document.getElementById('search').value.toLowerCase(),c=document.getElementById('cuisine').value||document.getElementById('heroCuisine').value,l=document.getElementById('location').value,min=+document.getElementById('rating').value;render(places.filter(x=>(x.name.toLowerCase().includes(q)||x.l.toLowerCase().includes(q)||x.c.toLowerCase().includes(q))&&(!c||x.c===c)&&(!l||x.l===l)&&x.r>=min))}
function choose(n){document.getElementById('restaurant').value=n;document.getElementById('booking').scrollIntoView({behavior:'smooth'})}
places.forEach(x=>document.getElementById('restaurant').add(new Option(x.name,x.name)));render(places);
let date=document.getElementById('date');date.min=new Date().toISOString().slice(0,10);
document.getElementById('bookingForm').addEventListener('submit',e=>{e.preventDefault();let b={restaurant:restaurant.value,name:name.value,date:date.value,time:time.value,guests:guests.value,phone:phone.value};let old=JSON.parse(localStorage.getItem('kodaikanalBookings')||'[]');old.push(b);localStorage.setItem('kodaikanalBookings',JSON.stringify(old));document.getElementById('msg').textContent='Reservation request saved in this browser!';document.getElementById('confirmation').innerHTML=`<b>${b.name}</b><p>${b.restaurant}</p><p>${b.date} • ${b.time}</p><p>${b.guests} guest(s) • ${b.phone}</p><b>Demo confirmation. Please contact the restaurant to verify your table.</b>`;e.target.reset()});
document.getElementById('contactForm').addEventListener('submit',e=>{e.preventDefault();document.getElementById('contactMsg').textContent='Thank you! This demo contact form has been submitted.';e.target.reset()});
</script></body></html>
