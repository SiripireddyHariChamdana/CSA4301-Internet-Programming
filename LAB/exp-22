<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#eff5f2"><title>CleanCity — Smarter waste collection</title>
<style>
:root{--ink:#20352f;--muted:#71817a;--bg:#eff5f2;--paper:#fff;--green:#21634b;--teal:#279184;--pale:#e1f0e9;--orange:#d08350;--line:#dfe9e3}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.6 Arial,sans-serif}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button,.btn{border:0;border-radius:6px;padding:11px 15px;background:var(--green);color:white;cursor:pointer;font-weight:bold;display:inline-block}button:hover,.btn:hover{background:#174734}.outline{background:transparent;color:var(--green);border:1px solid var(--green)}header{position:sticky;top:0;z-index:5;background:#fffF;border-bottom:1px solid var(--line)}nav,.wrap{max-width:1160px;margin:auto}nav{min-height:70px;padding:12px 22px;display:flex;align-items:center;justify-content:space-between;gap:17px}.brand{font-size:21px;font-weight:900;color:var(--green)}.brand span{color:var(--teal)}.links{display:flex;gap:16px;flex-wrap:wrap}.links a{font-size:13px;font-weight:bold;color:#53685e}.view{display:none;min-height:72vh}.view.active{display:block}.hero{max-width:1160px;margin:18px auto 0;min-height:370px;border-radius:9px;padding:45px 6%;display:flex;align-items:center;background:linear-gradient(105deg,#163d31e8,#163d3155),url('https://images.unsplash.com/photo-1532996122724-e3c354a0b15b?auto=format&fit=crop&w=1800&q=85') center/cover;color:white}.hero h1{font:500 clamp(40px,6vw,67px)/1.03 Georgia,serif;margin:13px 0}.hero p{max-width:580px;color:#e2eee8}.hero .eyebrow{color:#d4ebbb}.hero .outline{color:white;border-color:white}.eyebrow{text-transform:uppercase;letter-spacing:1.6px;font-size:11px;color:var(--teal);font-weight:bold}.wrap{padding:43px 22px}.title{font:500 clamp(30px,4vw,43px)/1.1 Georgia,serif;margin:7px 0}.sub{color:var(--muted);max-width:760px}.row{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:17px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.stat,.panel,.card{background:white;border:1px solid var(--line);border-radius:8px;padding:18px}.stat strong{font-size:27px;color:var(--green)}.field{display:block;width:100%;padding:11px;margin-top:5px;border:1px solid #d3e0d9;border-radius:5px;background:white;color:var(--ink)}label{display:block;font-size:13px;font-weight:bold;margin:10px 0}.two{display:grid;grid-template-columns:1fr 1fr;gap:18px}.toolbar{display:flex;gap:9px;flex-wrap:wrap;margin:16px 0}.toolbar input{flex:1;min-width:180px}.notice{background:#e7f2eb;border-left:3px solid var(--teal);padding:12px;margin:12px 0}.meta{font-size:12px;color:var(--muted)}.badge{background:#e3f1e8;color:#27724d;border-radius:20px;padding:4px 9px;font-size:11px;font-weight:bold}.badge.warn{background:#fff0d7;color:#805e22}.map{height:310px;position:relative;overflow:hidden;border:1px solid #d1e0d4;border-radius:8px;background:linear-gradient(135deg,#dcebd7,#f3efd9 50%,#d1e2d9)}.map:before,.map:after{content:"";position:absolute;left:-10%;top:40%;width:120%;height:3px;background:#fff;transform:rotate(-18deg);box-shadow:0 40px #fff,0 80px #fff,0 120px #fff}.map:after{top:12%;transform:rotate(33deg);background:#b4cfb2;box-shadow:0 55px #b4cfb2,0 105px #b4cfb2}.pin{position:absolute;z-index:2;border:0;border-radius:50%;width:40px;height:40px;padding:0;background:var(--green);box-shadow:0 3px 8px #0003}.pin1{left:25%;top:32%}.pin2{left:64%;top:52%}.pin3{left:73%;top:23%}.map-caption{position:absolute;z-index:3;left:12px;bottom:12px;padding:7px 10px;background:#fffE;border-radius:4px;font-size:12px}.tablewrap{overflow:auto}table{border-collapse:collapse;width:100%;font-size:13px}th,td{text-align:left;padding:9px;border-bottom:1px solid var(--line)}th{background:#f1f7f3}.progress{height:8px;border-radius:8px;background:#e6ece8;overflow:hidden}.progress i{display:block;background:var(--teal);height:100%}.status{min-height:22px;color:#26714c;font-weight:bold}.empty{padding:14px;color:var(--muted)}.toast{position:fixed;right:20px;bottom:20px;background:#1f4939;color:white;padding:12px 16px;border-radius:5px;display:none;z-index:10}footer{background:#1d4435;color:#edf4ee;padding:22px}.foot{max-width:1160px;margin:auto;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}.foot a{text-decoration:underline;text-underline-offset:3px}@media(max-width:760px){.grid,.two{grid-template-columns:1fr 1fr}.links{gap:9px}.hero{min-height:330px}}@media(max-width:560px){nav{align-items:flex-start;flex-direction:column}.grid,.two{grid-template-columns:1fr}.wrap{padding:32px 16px}.hero{margin:10px;min-height:315px}}
</style></head><body>
<header><nav><a class="brand" href="#home">Clean<span>City</span></a><div class="links"><a href="#home">Overview</a><a href="#public">Public</a><a href="#driver">Driver</a><a href="#admin">Admin</a><a href="#reports">Reports</a></div></nav></header>
<main>
<section class="view" id="home"><div class="hero"><div><div class="eyebrow">Cleaner neighborhoods, smarter routes</div><h1>Small actions.<br>A cleaner city.</h1><p>Find collection points, report overflowing bins, and follow service updates. Drivers can review collection work and update truck loads.</p><div class="actions"><a class="btn" href="#public">Report an issue</a><a class="btn outline" href="#driver">Driver workspace</a></div></div></div><div class="wrap"><div class="row"><div><div class="eyebrow">A practical collection cycle</div><h2 class="title">Segregate. Collect. Improve.</h2></div></div><div class="grid"><article class="stat"><strong>01</strong><h3>Sort at the source</h3><p class="meta">Separate recyclables, organic waste, and residual waste where local services permit.</p></article><article class="stat"><strong>02</strong><h3>Report collection needs</h3><p class="meta">Send a demo report for a missed pickup or bin that needs attention.</p></article><article class="stat"><strong>03</strong><h3>Monitor service</h3><p class="meta">Track updates and review collection reports from the local demo dashboard.</p></article></div><div class="notice">CleanCity is a single-page demonstration. Map points, routes, reports, and complaint statuses are sample data saved locally.</div></div></section>
<section class="view" id="public"><div class="wrap"><div class="eyebrow">Community dashboard</div><h1 class="title">See a collection point or report an issue.</h1><div class="two"><div><div class="toolbar"><input id="binSearch" placeholder="Search area or bin ID"><button id="binSearchBtn">Find bins</button></div><div id="binList"></div><h2>Collection points map</h2><div class="map"><button class="pin pin1" data-bin="bin-1" aria-label="Bin 1">1</button><button class="pin pin2" data-bin="bin-2" aria-label="Bin 2">2</button><button class="pin pin3" data-bin="bin-3" aria-label="Bin 3">3</button><span class="map-caption">Illustrated local map · Select a marker</span></div></div><form id="complaintForm" class="panel"><h2>Report a collection issue</h2><label>Your name<input class="field" name="name" required></label><label>Contact email<input class="field" name="email" type="email" required></label><label>Location / street<input class="field" name="location" required></label><label>Issue type<select class="field" name="type"><option>Missed collection</option><option>Overflowing bin</option><option>Damaged bin</option><option>Illegal dumping</option></select></label><label>Details<textarea class="field" name="details" rows="3" required></textarea></label><button>Submit demo report</button><p class="status" id="complaintStatus"></p><p class="meta">Please do not include sensitive personal information.</p></form></div><div class="panel" style="margin-top:18px"><h2>My reports</h2><form id="complaintLookup" class="toolbar"><input name="email" type="email" placeholder="Email used for report" required><button>View report status</button></form><div id="myComplaints"></div></div></div></section>
<section class="view" id="driver"><div class="wrap"><div class="eyebrow">Collection crew</div><h1 class="title">Today's route & collection updates.</h1><div class="two"><div class="panel"><h2>Assigned route</h2><div id="driverRoute"></div><button id="openRoute" class="outline">Open route in maps</button></div><form id="loadForm" class="panel"><h2>Update truck collection</h2><label>Driver name<input class="field" name="driver" required></label><label>Vehicle / truck ID<input class="field" name="truck" required></label><label>Bin collected<select class="field" name="bin" id="driverBin"></select></label><label>Waste type<select class="field" name="waste"><option>Mixed waste</option><option>Recyclables</option><option>Organic waste</option><option>Residual waste</option></select></label><label>Collected load (kg)<input class="field" name="load" type="number" min="0" step="0.5" required></label><label>Collection note<input class="field" name="note"></label><button>Save collection update</button><p class="status" id="loadStatus"></p></form></div><div class="panel" style="margin-top:18px"><h2>Latest updates</h2><div id="driverUpdates"></div></div></div></section>
<section class="view" id="admin"><div class="wrap"><div class="eyebrow">Operations administration · demo</div><h1 class="title">Manage bins, routes, and drivers.</h1><div class="two"><form id="binForm" class="panel"><h2>Add a collection bin</h2><label>Bin ID<input class="field" name="id" required></label><label>Area / street<input class="field" name="area" required></label><label>Waste types<select class="field" name="type"><option>Mixed waste</option><option>Recyclables</option><option>Organic waste</option><option>Residual waste</option></select></label><label>Fill level (%)<input class="field" name="fill" type="number" min="0" max="100" value="0" required></label><label>Assigned route<input class="field" name="route" required></label><button>Add bin</button><p class="status" id="binStatus"></p></form><form id="routeForm" class="panel"><h2>Assign a driver & route</h2><label>Driver name<input class="field" name="driver" required></label><label>Truck ID<input class="field" name="truck" required></label><label>Route name<input class="field" name="route" required></label><label>Stops (bin IDs, comma separated)<textarea class="field" name="stops" rows="3" required></textarea></label><label>Dumping site<input class="field" name="site" required></label><button>Save assignment</button><p class="status" id="routeStatus"></p></form></div><div class="panel" style="margin-top:18px"><div class="row"><h2>Collection bins</h2><button id="resetDemo" class="outline">Reset demo data</button></div><div id="adminBins"></div></div><div class="panel" style="margin-top:18px"><h2>Public complaints</h2><div id="adminComplaints"></div></div></div></section>
<section class="view" id="reports"><div class="wrap"><div class="eyebrow">Collection analytics</div><h1 class="title">Service report.</h1><div class="grid"><div class="stat"><div class="meta">Total bins</div><strong id="totalBins">0</strong></div><div class="stat"><div class="meta">Load recorded</div><strong id="totalLoad">0 kg</strong></div><div class="stat"><div class="meta">Open complaints</div><strong id="openReports">0</strong></div></div><div class="two" style="margin-top:18px"><section class="panel"><h2>Bin status</h2><div id="binReport"></div></section><section class="panel"><h2>Recent collection entries</h2><div id="loadReport"></div><button id="downloadReport" class="outline">Download CSV report</button></section></div></div></section>
</main><footer><div class="foot"><a class="brand" style="color:white" href="#home">CleanCity</a><span>Better service, together.</span><span>Experiment 22 · <a href="../Exp-21/CareerBridge.html">← CareerBridge</a> · <a href="../Exp-23/BloodConnect.html">Next: BloodConnect →</a></span></div></footer><div class="toast" id="toast" role="status"></div>
<script>
const $=s=>document.querySelector(s),seedBins=[{id:"BIN-101",area:"Green Park · North Gate",type:"Recyclables",fill:35,route:"Route A"},{id:"BIN-102",area:"Market Street · Library",type:"Organic waste",fill:78,route:"Route A"},{id:"BIN-103",area:"Riverside Road · Bus stop",type:"Mixed waste",fill:62,route:"Route B"}],seedRoutes=[{driver:"Demo Driver",truck:"TRK-04",route:"Route A",stops:["BIN-101","BIN-102"],site:"North transfer station"}];
function load(k,f){try{return JSON.parse(localStorage.getItem("cleancity-"+k))??f}catch{return f}}function save(k,v){localStorage.setItem("cleancity-"+k,JSON.stringify(v))}let bins=load("bins",seedBins),routes=load("routes",seedRoutes),complaints=load("complaints",[]),loads=load("loads",[{driver:"Demo Driver",truck:"TRK-04",bin:"BIN-101",waste:"Recyclables",load:35,note:"Routine pickup",date:new Date().toLocaleString()}]);
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}function toast(s){const t=$("#toast");t.textContent=s;t.style.display="block";setTimeout(()=>t.style.display="none",2200)}
function render(){const q=$("#binSearch").value.trim().toLowerCase(),shown=bins.filter(b=>!q||`${b.id} ${b.area} ${b.type}`.toLowerCase().includes(q));$("#binList").innerHTML=shown.map(b=>`<article class="card" style="margin:9px 0"><div class="row"><b>${esc(b.id)}</b><span class="badge ${b.fill>=75?"warn":""}">${b.fill}% full</span></div><div>${esc(b.area)}</div><div class="meta">${esc(b.type)} · ${esc(b.route)}</div><div class="progress"><i style="width:${Math.min(100,Math.max(0,b.fill))}%"></i></div></article>`).join("")||'<p class="empty">No collection bins match.</p>';$("#driverBin").innerHTML=bins.map(b=>`<option value="${esc(b.id)}">${esc(b.id)} · ${esc(b.area)}</option>`).join("");const route=routes[0];$("#driverRoute").innerHTML=route?`<p><b>${esc(route.route)}</b> · ${esc(route.driver)} · ${esc(route.truck)}</p><ol>${route.stops.map(x=>{const b=bins.find(y=>y.id===x);return`<li>${esc(x)}${b?" · "+esc(b.area):""}</li>`}).join("")}</ol><p class="meta">Final destination: ${esc(route.site)}</p>`:'<p class="empty">No route assigned. Check with the administrator.</p>';$("#driverUpdates").innerHTML=loads.slice(-5).reverse().map(x=>`<div class="row"><div><b>${esc(x.bin)}</b> · ${esc(x.waste)} · ${x.load} kg<div class="meta">${esc(x.driver)} · ${esc(x.truck)} · ${esc(x.date)}</div></div></div>`).join("")||'<p class="empty">No collections recorded.</p>';$("#adminBins").innerHTML=bins.map(b=>`<div class="row"><span><b>${esc(b.id)}</b> · ${esc(b.area)} · ${esc(b.type)} · ${b.fill}% · ${esc(b.route)}</span><button class="outline" data-delete-bin="${esc(b.id)}">Remove</button></div>`).join("")||'<p class="empty">No bins recorded.</p>';$("#adminComplaints").innerHTML=complaints.map(c=>`<article class="card" style="margin:8px 0"><div class="row"><b>${esc(c.id)} · ${esc(c.type)}</b><select class="field" style="width:auto" data-complaint-status="${esc(c.id)}"><option ${c.status==="Received"?"selected":""}>Received</option><option ${c.status==="Assigned"?"selected":""}>Assigned</option><option ${c.status==="Resolved"?"selected":""}>Resolved</option></select></div><p>${esc(c.location)} · ${esc(c.details)}</p><div class="meta">${esc(c.email)} · ${esc(c.date)}</div></article>`).join("")||'<p class="empty">No public complaints.</p>';$("#totalBins").textContent=bins.length;$("#totalLoad").textContent=loads.reduce((n,x)=>n+Number(x.load),0)+" kg";$("#openReports").textContent=complaints.filter(c=>c.status!=="Resolved").length;$("#binReport").innerHTML=bins.map(b=>`<div style="padding:8px 0"><div class="row"><span>${esc(b.id)} · ${esc(b.area)}</span><b>${b.fill}%</b></div><div class="progress"><i style="width:${b.fill}%"></i></div></div>`).join("")||'<p class="empty">No bin data.</p>';$("#loadReport").innerHTML=loads.slice(-6).reverse().map(x=>`<div class="row">${esc(x.bin)} · ${x.load} kg<span class="meta">${esc(x.date)}</span></div>`).join("")||'<p class="empty">No load data.</p>';$("#myComplaints").innerHTML=$("#myComplaints").innerHTML||'<p class="empty">Enter your email above to check report status.</p>';save("bins",bins);save("routes",routes);save("complaints",complaints);save("loads",loads)}
$("#binSearch").addEventListener("input",render);$("#binSearchBtn").addEventListener("click",render);
$("#complaintForm").addEventListener("submit",e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target));d.id="CC-"+Date.now().toString().slice(-7);d.status="Received";d.date=new Date().toLocaleString();complaints.push(d);save("complaints",complaints);$("#complaintStatus").textContent=`Report ${d.id} received. Save this ID to check progress.`;e.target.reset();render()});
$("#complaintLookup").addEventListener("submit",e=>{e.preventDefault();const email=new FormData(e.target).get("email").toLowerCase(),list=complaints.filter(c=>c.email.toLowerCase()===email);$("#myComplaints").innerHTML=list.length?list.map(c=>`<div class="row"><div><b>${esc(c.id)} · ${esc(c.type)}</b><div class="meta">${esc(c.location)} · ${esc(c.date)}</div></div><span class="badge">${esc(c.status)}</span></div>`).join(""):'<p class="empty">No reports found for that email.</p>'});
$("#loadForm").addEventListener("submit",e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target));d.load=Number(d.load);d.date=new Date().toLocaleString();loads.push(d);const b=bins.find(x=>x.id===d.bin);if(b)b.fill=Math.max(0,b.fill-Math.min(30,d.load/5));save("loads",loads);save("bins",bins);$("#loadStatus").textContent="Collection and truck load update saved.";e.target.reset();render()});
$("#binForm").addEventListener("submit",e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target));if(bins.some(b=>b.id.toLowerCase()===d.id.toLowerCase())){$("#binStatus").textContent="That bin ID already exists.";return}d.fill=Number(d.fill);bins.push(d);save("bins",bins);$("#binStatus").textContent="Collection bin added.";e.target.reset();render()});
$("#routeForm").addEventListener("submit",e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target));d.stops=d.stops.split(",").map(x=>x.trim()).filter(Boolean);routes.unshift(d);save("routes",routes);$("#routeStatus").textContent="Driver route assignment saved.";e.target.reset();render()});
document.addEventListener("click",e=>{const b=e.target.closest("[data-delete-bin]");if(b){bins=bins.filter(x=>x.id!==b.dataset.deleteBin);save("bins",bins);render();return}const pin=e.target.closest("[data-bin]");if(pin){location.hash="#public";$("#binSearch").value=pin.dataset.bin;render()}});
$("#adminComplaints").addEventListener("change",e=>{const id=e.target.dataset.complaintStatus;if(!id)return;const c=complaints.find(x=>x.id===id);c.status=e.target.value;save("complaints",complaints);render()});
$("#openRoute").addEventListener("click",()=>{const r=routes[0];if(!r){toast("No route available.");return}const stops=r.stops.map(id=>bins.find(b=>b.id===id)?.area).filter(Boolean);const q=[...stops,r.site].join(" to ");window.open("https://maps.google.com/?q="+encodeURIComponent(q),"_blank","noopener")});
$("#downloadReport").addEventListener("click",()=>{const csv=["Date,Driver,Truck,Bin,Waste,Load kg,Note",...loads.map(x=>[x.date,x.driver,x.truck,x.bin,x.waste,x.load,x.note].map(v=>`"${String(v||"").replace(/"/g,'""')}"`).join(","))].join("\r\n"),a=document.createElement("a");a.href=URL.createObjectURL(new Blob([csv],{type:"text/csv"}));a.download="cleancity-collection-report.csv";a.click();URL.revokeObjectURL(a.href)});
$("#resetDemo").addEventListener("click",()=>{if(!confirm("Reset CleanCity data to the sample dashboard?"))return;bins=seedBins;routes=seedRoutes;complaints=[];loads=[];["bins","routes","complaints","loads"].forEach((k,i)=>save(k,[bins,routes,complaints,loads][i]));render()});
function route(){const id=location.hash.slice(1)||"home";if(!document.getElementById(id)?.classList.contains("view")){location.hash="#home";return}document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===id));render();window.scrollTo(0,0)}window.addEventListener("hashchange",route);render();route();
</script></body></html>
