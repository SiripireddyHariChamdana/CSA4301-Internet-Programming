19px}.wrap{padding:48px 23px}.title{font:500 clamp(31px,4.5vw,47px)/1.1 var(--serif);margin:7px 0}.sub{color:var(--muted);max-width:720px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.art-card{background:var(--paper);border:1px solid var(--line);overflow:hidden}.art-img{height:250px;background-size:cover;background-position:center;cursor:pointer}.art-card:nth-child(1) .art-img{background-image:url('https://images.unsplash.com/photo-1541961017774-22349e4a1262?auto=format&fit=crop&w=900&q=85')}.art-card:nth-child(2) .art-img{background-image:url('https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?auto=format&fit=crop&w=900&q=85')}.art-card:nth-child(3) .art-img{background-image:url('https://images.unsplash.com/photo-1577083552431-6e5fd01aa342?auto=format&fit=crop&w=900&q=85')}.art-card:nth-child(4) .art-img{background-image:url('https://images.unsplash.com/photo-1578301978693-85fa9c0320b9?auto=format&fit=crop&w=900&q=85')}.art-card:nth-child(5) .art-img{background-image:url('https://images.unsplash.com/photo-1571115764595-644a1f56a55c?auto=format&fit=crop&w=900&q=85')}.art-card:nth-child(6) .art-img{background-image:url('https://images.unsplash.com/photo-1579783901586-d88db74b4fe4?auto=format&fit=crop&w=900&q=85')}.art-copy{padding:15px}.art-copy h3{font:500 22px var(--serif);margin:4px 0}.meta{font-size:12px;color:var(--muted)}.chip{padding:4px 9px;border-radius:15px;background:#eee8dd;font-size:11px;color:#645743}.filters{display:flex;gap:8px;flex-wrap:wrap;margin:20px 0}.filters button{background:transparent;color:var(--brown);border:1px solid var(--line);padding:8px 13px}.filters button.active{background:var(--brown);color:white}.two{display:grid;grid-template-columns:1fr 1fr;gap:19px}.panel{background:var(--paper);border:1px solid var(--line);padding:22px}.portrait{min-height:350px;background:url('https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=1000&q=85') center/cover;border-radius:3px}.timeline{border-left:1px solid #aa9176;margin:20px 0}.milestone{padding:0 0 20px 20px;position:relative}.milestone:before{content:"";position:absolute;left:-5px;top:7px;width:9px;height:9px;border-radius:50%;background:var(--rust)}.milestone small{color:var(--rust)}.field{width:100%;margin-top:5px;padding:11px;border:1px solid #dcd4c9;background:white;color:var(--ink)}label{display:block;font-size:13px;font-weight:bold;margin:10px 0}.notice{background:#eee9df;padding:13px;border-left:3px solid var(--olive);margin:12px 0}.post{padding:17px 0;border-bottom:1px solid var(--line)}.post h3{font:500 23px var(--serif);margin:4px 0}.modal{position:fixed;inset:0;display:none;place-items:center;z-index:15;background:#171510df;padding:20px}.modal.open{display:grid}.modal-inner{max-width:920px;width:100%;max-height:92vh;background:var(--paper);padding:18px;overflow:auto;position:relative}.modal-inner img{width:100%;max-height:70vh;object-fit:contain;background:#e8e2d7}.modal-close{position:absolute;right:10px;top:10px;background:var(--brown);z-index:1}.status{min-height:22px;color:var(--olive)}footer{background:#332a23;color:#f5f0e9;padding:22px}.foot{max-width:1160px;margin:auto;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}.foot a{text-decoration:underline;text-underline-offset:3px}@media(max-width:760px){.grid,.two{grid-template-columns:1fr 1fr}.links{gap:10px}.art-img{height:200px}}@media(max-width:560px){nav{align-items:flex-start;flex-direction:column}.grid,.two{grid-template-columns:1fr}.wrap{padding:34px 17px}.hero{margin:10px;min-height:380px}.art-img{height:240px}}
</style></head>
<body><header><nav><a class="brand" href="#home">artistry<span>hub</span></a><div class="links"><a href="#home">Home</a><a href="#portfolio">Portfolio</a><a href="#about">Artist</a><a href="#journal">Journal</a><a href="#shop">Prints</a><a href="#contact">Contact</a></div></nav></header>
<main>
<section class="view" id="home"><div class="hero"><div class="hero-copy"><div class="eyebrow">Inside the world of Emily Harris</div><h1>Art that remembers how to dream.</h1><p>A collection of color, quiet moments, and imperfect landscapes. Explore selected works and follow the artist's evolving journey.</p><div class="actions"><a class="btn" href="#portfolio">Explore the portfolio</a><a class="btn outline" href="#about">Meet Emily</a></div></div></div><div class="wrap"><div class="row"><div><div class="eyebrow">Selected works</div><h2 class="title">A gallery of recent pieces.</h2></div><a class="btn outline" href="#portfolio">View all artwork</a></div><div class="grid" id="featured"></div></div><div class="wrap" style="padding-top:0"><div class="panel"><div class="eyebrow">Studio note</div><p style="font:italic 24px/1.5 Georgia;color:#513e32">“I paint toward the feeling of a place rather than its perfect outline.”</p><a class="btn" href="#journal">Read the studio journal</a></div></div></section>
<section class="view" id="portfolio"><div class="wrap"><div class="eyebrow">The collection · 2022–2026</div><h1 class="title">Works in color and conversation.</h1><p class="sub">Explore original paintings, prints, and works on paper. Select a piece to view it in a larger gallery.</p><div class="filters" id="filters"><button class="active" data-filter="All">All works</button><button data-filter="Painting">Painting</button><button data-filter="Works on paper">Works on paper</button><button data-filter="Study">Study</button></div><div class="grid" id="gallery"></div></div></section>
<section class="view" id="about"><div class="wrap"><div class="eyebrow">The artist</div><h1 class="title">Emily Harris makes room for feeling.</h1><div class="two"><div class="portrait" role="img" aria-label="Portrait representing artist Emily Harris"></div><div><p class="sub">Emily Harris is a contemporary painter whose work explores the relationship between memory, landscape, and everyday rituals. She grew up near the coast, where shifting weather and long walks first taught her to pay attention to light.</p><p class="sub">Her studio practice moves between oil, watercolor, and studies on paper. Each piece begins with a quiet observation: a window at dusk, a garden after rain, or the particular color of a remembered afternoon.</p><p class="sub">Emily's work has been shown in independent galleries and community exhibitions. She lives and works in a small sunlit studio filled with books, plants, and unfinished canvases.</p><h2>Selected milestones</h2><div class="timeline"><div class="milestone"><small>2026</small><div><b>Between Tides</b><div class="meta">Solo exhibition · Orchard Gallery</div></div></div><div class="milestone"><small>2024</small><div><b>Light, Kept</b><div class="meta">Group exhibition · North Street Arts</div></div></div><div class="milestone"><small>2022</small><div><b>New Grounds</b><div class="meta">Emerging artist showcase</div></div></div></div></div></div></div></section>
<section class="view" id="journal"><div class="wrap"><div class="eyebrow">Notes from the studio</div><h1 class="title">A practice, in progress.</h1><article class="post"><div class="eyebrow">Process · 5 min read</div><h3>The color of the last light</h3><p class="sub">How an ordinary walk home became a small collection of evening studies.</p></article><article class="post"><div class="eyebrow">Exhibitions · 3 min read</div><h3>Looking back at Between Tides</h3><p class="sub">A thank-you to the neighbors, fellow artists, and curious visitors who filled the gallery.</p></article><article class="post"><div class="eyebrow">In the studio · 4 min read</div><h3>Letting the paper decide</h3><p class="sub">A few watercolor experiments with texture, edges, and happy accidents.</p></article><div class="panel" style="margin-top:18px"><h2>Media & interviews</h2><p class="sub">Conversations about painting, place, and the creative process.</p><a class="btn outline" href="https://www.youtube.com/results?search_query=artist+studio+interview" target="_blank" rel="noopener">Explore artist interviews</a></div></div></section>
<section class="view" id="shop"><div class="wrap"><div class="eyebrow">Bring a little art home</div><h1 class="title">Prints & editions.</h1><p class="sub">Small-run print editions inspired by Emily's original works. Orders in this demonstration are not processed.</p><div class="grid" id="shopGrid"></div><div id="cartMessage" class="notice" hidden></div></div></section>
<section class="view" id="contact"><div class="wrap"><div class="eyebrow">Say hello</div><h1 class="title">For commissions, press, or a note from a fan.</h1><div class="two"><div class="panel"><h2>Studio contact</h2><p><a href="mailto:studio@emilyharris.example">studio@emilyharris.example</a></p><p class="sub">For exhibition inquiries, print questions, or commission availability, send a message and the studio will be in touch.</p><p class="chip">Instagram · <a href="https://www.instagram.com/" target="_blank" rel="noopener">Follow the studio</a></p><p class="chip">Newsletter · Studio notes and exhibition news</p><form id="newsletter"><label>Email for studio updates<input class="field" name="email" type="email" required></label><button class="outline">Subscribe</button><p class="status" id="newsletterStatus"></p></form></div><form class="panel" id="contactForm"><h2>Send a message</h2><label>Your name<input class="field" name="name" required></label><label>Email<input class="field" name="email" type="email" required></label><label>What would you like to discuss?<select class="field" name="topic"><option>General inquiry</option><option>Commission request</option><option>Press / interview</option><option>Print order</option></select></label><label>Message<textarea class="field" name="message" rows="4" required></textarea></label><button>Send inquiry</button><p class="status" id="contactStatus"></p><p class="meta">Demo form only; your message is not transmitted.</p></form></div></div></section>
