<div class="modal" id="lightbox" role="dialog" aria-modal="true" aria-label="Artwork details"><div class="modal-inner"><button class="modal-close" id="closeLightbox" aria-label="Close">Close ×</button><img id="lightboxImage" alt=""><h2 id="lightboxTitle"></h2><p id="lightboxDescription" class="sub"></p></div></div>
<script>
const $=s=>document.querySelector(s),works=[{id:1,title:"The Garden Remembers",type:"Painting",year:2026,medium:"Oil on linen",price:85,description:"A remembered garden at the end of summer, when the light becomes soft enough to keep.",image:"photo-1541961017774-22349e4a1262"},{id:2,title:"Blue Hour, North Window",type:"Painting",year:2025,medium:"Acrylic on canvas",price:95,description:"The familiar shapes of a room just after the sun has left.",image:"photo-1579783902614-a3fb3927b6a5"},{id:3,title:"A Map Made of Weather",type:"Works on paper",year:2025,medium:"Watercolor on paper",price:55,description:"A layered study of coastlines, passing clouds, and places held in memory.",image:"photo-1577083552431-6e5fd01aa342"},{id:4,title:"Still Light on the Table",type:"Painting",year:2024,medium:"Oil on linen",price:85,description:"An afternoon still life in muted greens and the last warm slice of sunlight.",image:"photo-1578301978693-85fa9c0320b9"},{id:5,title:"Small Study No. 8",type:"Study",year:2024,medium:"Graphite & watercolor",price:35,description:"A quick study of branches seen from the studio window after rain.",image:"photo-1571115764595-644a1f56a55c"},{id:6,title:"The Shape of Quiet",type:"Painting",year:2023,medium:"Acrylic on board",price:75,description:"Open space, soft earth, and the kind of silence that invites a breath.",image:"photo-1579783901586-d88db74b4fe4"}],imgSrc=w=>`https://images.unsplash.com/${w.image}?auto=format&fit=crop&w=1300&q=88`;
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function workCard(w,shop=false){return `<article class="art-card"><div class="art-img" role="img" aria-label="${esc(w.title)}" data-view="${w.id}" style="background-image:url('${imgSrc(w)}')"></div><div class="art-copy"><div class="meta">${esc(w.type)} · ${w.year} · ${esc(w.medium)}</div><h3>${esc(w.title)}</h3><p class="meta">${esc(w.description)}</p>${shop?`<div class="row"><b>$${w.price} · Open edition print</b><button data-buy="${w.id}">Add to inquiry</button></div>`:`<button class="outline" data-view="${w.id}">View detail</button>`}</div></article>`}
function renderGallery(filter="All"){const list=works.filter(w=>filter==="All"||w.type===filter);$("#gallery").innerHTML=list.map(w=>workCard(w)).join("")}
$("#featured").innerHTML=works.slice(0,3).map(w=>workCard(w)).join("");renderGallery();$("#shopGrid").innerHTML=works.slice(0,4).map(w=>workCard(w,true)).join("");
$("#filters").addEventListener("click",e=>{const b=e.target.closest("[data-filter]");if(!b)return;$("#filters").querySelectorAll("button").forEach(x=>x.classList.toggle("active",x===b));renderGallery(b.dataset.filter)});
document.addEventListener("click",e=>{const view=e.target.closest("[data-view]");if(view){const w=works.find(x=>x.id===Number(view.dataset.view));if(!w)return;$("#lightboxImage").src=imgSrc(w);$("#lightboxImage").alt=w.title;$("#lightboxTitle").textContent=`${w.title} · ${w.year} · ${w.medium}`;$("#lightboxDescription").textContent=w.description;$("#lightbox").classList.add("open");return}const buy=e.target.closest("[data-buy]");if(buy){const w=works.find(x=>x.id===Number(buy.dataset.buy));$("#cartMessage").hidden=false;$("#cartMessage").textContent=`Thanks for your interest in “${w.title}”. Contact studio@emilyharris.example to inquire. This demo does not process orders.`}});
$("#closeLightbox").addEventListener("click",()=>$("#lightbox").classList.remove("open"));$("#lightbox").addEventListener("click",e=>{if(e.target.id==="lightbox")$("#lightbox").classList.remove("open")});document.addEventListener("keydown",e=>{if(e.key==="Escape")$("#lightbox").classList.remove("open")});
function localForm(id,msg){$(id).addEventListener("submit",e=>{e.preventDefault();$(msg).textContent="Thank you. This demo stores no subscription or message on a server.";e.target.reset()})}localForm("#contactForm","#contactStatus");localForm("#newsletter","#newsletterStatus");
function route(){const id=location.hash.slice(1)||"home";if(!document.getElementById(id)?.classList.contains("view")){location.hash="#home";return}document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===id));window.scrollTo(0,0)}window.addEventListener("hashchange",route);route();
</script></body></html>
