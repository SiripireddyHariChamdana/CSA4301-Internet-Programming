<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f3f5ef"><title>RoadReady — Find trusted roadside help</title>
<style>
:root{--ink:#212c2a;--muted:#75817b;--bg:#f3f5ef;--paper:#fff;--green:#204d3d;--lime:#d8e9c9;--orange:#d47a4e;--line:#e1e8df}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.6 Arial,sans-serif}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button,.btn{border:0;border-radius:6px;padding:11px 15px;background:var(--green);color:white;cursor:pointer;font-weight:bold;display:inline-block}button:hover,.btn:hover{background:#153a2c}.outline{background:transparent;color:var(--green);border:1px solid var(--green)}.soft{background:var(--lime);color:var(--green)}header{position:sticky;top:0;background:#ffffffef;backdrop-filter:blur(8px);z-index:5;border-bottom:1px solid var(--line)}nav,.wrap{max-width:1160px;margin:auto}nav{padding:13px 22px;min-height:70px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{font-size:21px;font-weight:900;color:var(--green)}.brand span{color:var(--orange)}.links{display:flex;align-items:center;gap:17px;flex-wrap:wrap}.links a{font-size:13px;font-weight:bold;color:#4b5c54}.links a:hover{color:var(--orange)}.view{display:none;min-height:70vh}.view.active{display:block}.hero{max-width:1160px;margin:18px auto 0;border-radius:9px;min-height:385px;background:linear-gradient(100deg,#123a30e8,#123a3050),url('https://images.unsplash.com/photo-1486262715619-67b85e0b08d3?auto=format&fit=crop&w=1700&q=85') center/cover;color:#fff;display:flex;align-items:center}.hero-copy{padding:48px 7%;max-width:690px}.eyebrow{text-transform:uppercase;letter-spacing:1.6px;font-size:11px;color:var(--orange);font-weight:bold}.hero .eyebrow{color:#d5e8bd}.hero h1{font-size:clamp(39px,6.5vw,68px);line-height:1.02;margin:12px 0}.hero p{color:#e4ede8;max-width:510px}.hero .outline{color:white;border-color:white}.actions,.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.actions{margin-top:22px}.wrap{padding:44px 22px}.title{font-size:clamp(29px,4vw,43px);line-height:1.1;margin:7px 0}.sub{color:var(--muted);max-width:740px}.row{justify-content:space-between;margin-bottom:18px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.panel,.card{background:white;border:1px solid var(--line);border-radius:8px;padding:19px}.card h3{margin:4px 0}.rating{color:#b18232}.badge{background:#e6f3e7;color:#26714c;border-radius:16px;padding:4px 9px;font-size:11px;font-weight:bold}.badge.pending{background:#fff1d9;color:#8b631f}.meta{font-size:12px;color:var(--muted)}.field{display:block;width:100%;margin-top:5px;padding:11px;border:1px solid #d5dfd9;border-radius:5px;background:white;color:var(--ink)}label{display:block;font-size:13px;font-weight:bold;margin:10px 0}.toolbar{display:flex;gap:9px;flex-wrap:wrap;margin:18px 0}.toolbar input{flex:1;min-width:190px}.toolbar input,.toolbar select{padding:10px;border:1px solid #d5dfd9;border-radius:5px}.two{display:grid;grid-template-columns:1fr 1fr;gap:18px}.mapbox{height:310px;position:relative;overflow:hidden;border:1px solid #cddacf;border-radius:8px;background:linear-gradient(140deg,#dce9d9,#eef0df 52%,#cfdfd8)}.mapbox:before,.mapbox:after{content:"";position:absolute;width:130%;height:3px;left:-10%;top:42%;background:#fff;transform:rotate(-17deg);box-shadow:0 40px #fff,0 80px #fff,0 120px #fff}.mapbox:after{transform:rotate(32deg);top:20%;background:#b4c9ad;box-shadow:0 48px #b4c9ad,0 96px #b4c9ad}.map-pin{position:absolute;z-index:1;border:0;border-radius:50%;background:#d76543;color:white;width:38px;height:38px;padding:0;box-shadow:0 2px 8px #0004}.p1{left:28%;top:35%}.p2{left:62%;top:55%}.p3{left:75%;top:23%}.map-caption{position:absolute;z-index:2;bottom:12px;left:12px;background:#fffE;padding:8px 11px;border-radius:5px;font-size:12px}.status{color:#26714c;min-height:22px;font-weight:bold}.empty{padding:16px;color:var(--muted)}.review{border-top:1px solid var(--line);padding:10px 0}.toast{position:fixed;right:20px;bottom:20px;padding:12px 16px;background:var(--green);color:white;border-radius:5px;display:none;z-index:9}footer{background:#193a2e;color:#eef3ed;padding:23px}.foot{max-width:1160px;margin:auto;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}.foot a{text-decoration:underline;text-underline-offset:3px}@media(max-width:760px){.grid,.two{grid-template-columns:1fr 1fr}.links{gap:10px}.hero{min-height:350px}}@media(max-width:560px){nav{align-items:flex-start;flex-direction:column}.grid,.two{grid-template-columns:1fr}.wrap{padding:32px 16px}.hero{margin:10px;min-height:330px}}
</style></head>
<body><header><nav><a href="#home" class="brand">Road<span>Ready</span></a><div class="links"><a href="#home">Home</a><a href="#find">Find a mechanic</a><a href="#profile">My profile</a><a href="#mechanic">Mechanic portal</a><a href="#admin">Admin approval</a></div></nav></header>
<main>
<section class="view" id="home"><div class="hero"><div class="hero-copy"><div class="eyebrow">Help is closer than you think</div><h1>Roadside trouble?<br>Get moving again.</h1><p>Find nearby licensed mechanics, see their services and call for help. Explore approved businesses and share feedback after a repair.</p><div class="actions"><a class="btn" href="#find">Find nearby help</a><a class="btn outline" href="#mechanic">List your workshop</a></div></div></div><div class="wrap"><div class="row"><div><div class="eyebrow">Verified, local support</div><h2 class="title">How RoadReady works</h2></div></div><div class="grid"><article class="card"><div class="eyebrow">01 / Search</div><h3>Choose your location</h3><p class="meta">Search by town or area and narrow by the type of assistance you need.</p></article><article class="card"><div class="eyebrow">02 / Connect</div><h3>Contact a licensed mechanic</h3><p class="meta">Only businesses approved in this demo directory appear in public results.</p></article><article class="card"><div class="eyebrow">03 / Feedback</div><h3>Help other drivers</h3><p class="meta">Share a rating and a note about your experience after service.</p></article></div><div class="panel" style="margin-top:18px"><h2>Breakdown safety first</h2><p class="sub">Move to a safe place away from traffic if possible, turn on hazard lights, and contact local emergency services if anyone is in danger. RoadReady is a demonstration directory, not an emergency dispatch service.</p></div></div></section>
<section class="view" id="find"><div class="wrap"><div class="eyebrow">Approved local businesses</div><h1 class="title">Find a licensed mechanic.</h1><p class="sub">Search by area, select the repair you need, and open directions in your map app.</p><div class="toolbar"><input id="location" placeholder="Enter town or area" aria-label="Search location"><select id="serviceFilter"><option value="">All services</option><option>Battery & electrical</option><option>Tyre & puncture</option><option>Engine repair</option><option>Towing</option><option>Lockout help</option></select><button id="useLocation" class="outline">Use my location</button><button id="searchBtn">Search</button></div><div class="two"><div><p id="count" class="meta"></p><div class="grid" id="mechanicList" style="grid-template-columns:1fr"></div></div><div><h2>Nearby map preview</h2><div class="mapbox" aria-label="Illustrated location map"><button class="map-pin p1" data-mechanic="1" aria-label="Show mechanic">1</button><button class="map-pin p2" data-mechanic="2" aria-label="Show mechanic">2</button><button class="map-pin p3" data-mechanic="3" aria-label="Show mechanic">3</button><span class="map-caption">Illustrative map · Select a marker or open directions</span></div><p class="meta">Map markers are a local illustration. Directions use your chosen map app.</p></div></div></div></section>
<section class="view" id="profile"><div class="wrap"><div class="eyebrow">Driver account</div><h1 class="title">Your profile & feedback.</h1><div class="two"><form id="userForm" class="panel"><h2>Register / update profile</h2><label>Full name<input class="field" name="name" required></label><label>Email<input class="field" name="email" type="email" required></label><label>Mobile<input class="field" name="phone" type="tel" required></label><label>Home area<input class="field" name="area"></label><button>Save profile locally</button><p class="status" id="userMsg"></p></form><div class="panel"><h2>Post repair feedback</h2><form id="feedbackForm"><label>Mechanic<select class="field" id="feedbackMechanic" name="mechanic"></select></label><label>Your rating<select class="field" name="rating"><option value="5">★★★★★ — Excellent</option><option value="4">★★★★☆ — Good</option><option value="3">★★★☆☆ — Average</option><option value="2">★★☆☆☆ — Poor</option><option value="1">★☆☆☆☆ — Very poor</option></select></label><label>Your feedback<textarea class="field" name="text" rows="3" required></textarea></label><button>Submit feedback</button><p class="status" id="feedbackMsg"></p></form><div id="allFeedback"></div></div></div></div></section>
<section class="view" id="mechanic"><div class="wrap"><div class="eyebrow">For licensed workshops</div><h1 class="title">Get your business on the map.</h1><p class="sub">Submit your workshop details for administrator approval. Pending businesses do not appear in public search results.</p><div class="two"><form class="panel" id="businessForm"><h2>Register a mechanic business</h2><label>Owner / mechanic name<input class="field" name="owner" required></label><label>Business name<input class="field" name="name" required></label><label>Email<input class="field" name="email" type="email" required></label><label>Phone<input class="field" name="phone" type="tel" required></label><label>Service area<input class="field" name="area" required></label><label>Licensed services<select class="field" name="service"><option>Battery & electrical</option><option>Tyre & puncture</option><option>Engine repair</option><option>Towing</option><option>Lockout help</option></select></label><label>Business description<textarea class="field" name="description" rows="3" required></textarea></label><label>License / registration reference<input class="field" name="license" required></label><button>Submit for approval</button><p class="status" id="businessMsg"></p></form><div class="panel"><h2>Manage your business</h2><p class="sub">Update availability for a previously approved local business using its registered email.</p><form id="manageForm"><label>Business email<input class="field" name="email" type="email" required></label><label>Availability<select class="field" name="availability"><option>Available now</option><option>Available by appointment</option><option>Temporarily unavailable</option></select></label><button class="outline">Update status</button><p class="status" id="manageMsg"></p></form><p class="meta">All account and license data in this page are demonstration data saved in this browser.</p></div></div></div></section>
<section class="view" id="admin"><div class="wrap"><div class="eyebrow">Directory administration · demo</div><h1 class="title">Review mechanic applications.</h1><p class="sub">Approve licensed businesses before they become visible to drivers.</p><div class="panel"><div class="row"><h2>Applications</h2><button id="resetDemo" class="outline">Reset demo applications</button></div><div id="adminList"></div></div></div></section>
</main><footer><div class="foot"><a class="brand" style="color:white" href="#home">RoadReady</a><span>Licensed help, wherever the road takes you.</span><span>Experiment 25 · <a href="../Exp-26/TrafficSquad.html">Next: Traffic Squad →</a></span></div></footer><div class="toast" id="toast" role="status"></div>
<script>
const $=s=>document.querySelector(s),seed=[{id:"1",name:"Greenline Auto Care",owner:"Arun Kumar",area:"Chennai",service:"Battery & electrical",phone:"+91 98765 43210",email:"greenline@example.test",license:"TN-MECH-2104",description:"Mobile battery jump-starts and electrical diagnostics.",availability:"Available now",approved:true,rating:4.8,lat:13.0827,lng:80.2707},{id:"2",name:"City Tyre Rescue",owner:"Meena Rao",area:"Chennai",service:"Tyre & puncture",phone:"+91 98765 12345",email:"tyres@example.test",license:"TN-MECH-2180",description:"On-road puncture repairs, tyre changes, and roadside support.",availability:"Available by appointment",approved:true,rating:4.7,lat:13.0674,lng:80.2376},{id:"3",name:"Northside Towing",owner:"Dev Shah",area:"Bengaluru",service:"Towing",phone:"+91 99887 65432",email:"towing@example.test",license:"KA-MECH-1162",description:"Local vehicle recovery and towing for cars and small vans.",availability:"Available now",approved:true,rating:4.9,lat:12.9716,lng:77.5946}];
function load(k,fb){try{return JSON.parse(localStorage.getItem("roadready-"+k))??fb}catch{return fb}}function save(k,v){localStorage.setItem("roadready-"+k,JSON.stringify(v))}let businesses=load("businesses",seed),feedback=load("feedback",[]),user=load("user",null);
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}function toast(s){const t=$("#toast");t.textContent=s;t.style.display="block";setTimeout(()=>t.style.display="none",2200)}
function renderMechanics(){const q=$("#location").value.trim().toLowerCase(),hasCoordinates=/^-?\d+(\.\d+)?,\s*-?\d+(\.\d+)?$/.test(q),svc=$("#serviceFilter").value,list=businesses.filter(b=>b.approved&&(!q||hasCoordinates||b.area.toLowerCase().includes(q))&&(!svc||b.service===svc));$("#count").textContent=`${list.length} licensed mechanic${list.length===1?"":"s"} found${hasCoordinates?" near your current location":""}`;$("#mechanicList").innerHTML=list.length?list.map(b=>`<article class="card" id="biz-${b.id}"><div class="row"><span class="badge">${esc(b.availability||"Available by appointment")}</span><span class="rating">★ ${b.rating||"New"}</span></div><h3>${esc(b.name)}</h3><p class="meta">${esc(b.area)} · ${esc(b.service)}</p><p>${esc(b.description)}</p><p class="meta">Licensed · Ref ${esc(b.license)}</p><p><a href="tel:${esc(b.phone)}" class="btn">Call ${esc(b.phone)}</a> <a class="btn outline" target="_blank" rel="noopener" href="https://maps.google.com/?q=${encodeURIComponent(b.area+" "+b.name)}">Directions</a></p><div>${feedback.filter(f=>f.id===b.id).map(f=>`<div class="review"><b>${"★".repeat(f.rating)}</b> ${esc(f.text)} <span class="meta">— ${esc(f.name)}</span></div>`).join("")}</div></article>`).join(""):'<p class="empty">No approved mechanics match. Try another location or service.'}
function renderAdmin(){const pending=businesses.filter(b=>!b.approved);$("#adminList").innerHTML=pending.length?pending.map(b=>`<article class="card"><div class="row"><h3>${esc(b.name)}</h3><span class="badge pending">Pending approval</span></div><p>${esc(b.owner)} · ${esc(b.service)} · ${esc(b.area)}</p><p>${esc(b.description)}</p><p>License reference: <b>${esc(b.license)}</b> · <a href="mailto:${esc(b.email)}">${esc(b.email)}</a></p><button data-approve="${b.id}">Approve licensed business</button> <button class="outline" data-reject="${b.id}">Reject</button></article>`).join(""):'<p class="empty">No pending applications.</p>';$("#feedbackMechanic").innerHTML=businesses.filter(b=>b.approved).map(b=>`<option value="${b.id}">${esc(b.name)}</option>`).join("");$("#allFeedback").innerHTML=feedback.slice(-5).reverse().map(f=>`<div class="review"><b>${esc(f.name)}</b> · ${"★".repeat(f.rating)} — ${esc(f.text)}</div>`).join("")}
function route(){const id=location.hash.slice(1)||"home";if(!document.getElementById(id)?.classList.contains("view")){location.hash="#home";return}document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===id));if(id==="find")renderMechanics();if(id==="admin"||id==="profile")renderAdmin();window.scrollTo(0,0)}window.addEventListener("hashchange",route);
$("#searchBtn").addEventListener("click",renderMechanics);$("#location").addEventListener("input",renderMechanics);$("#serviceFilter").addEventListener("change",renderMechanics);
$("#useLocation").addEventListener("click",()=>{if(!navigator.geolocation){toast("Location access is not available in this browser.");return}navigator.geolocation.getCurrentPosition(pos=>{const {latitude,longitude}=pos.coords;$("#location").value=`${latitude.toFixed(3)}, ${longitude.toFixed(3)}`;toast("Location received. Showing approved directory businesses.");renderMechanics()},()=>toast("Could not access location. You can enter your area manually."),{timeout:8000})});
document.addEventListener("click",e=>{const b=e.target.closest("[data-approve]");if(b){const x=businesses.find(a=>a.id===b.dataset.approve);x.approved=true;save("businesses",businesses);renderAdmin();toast("Business approved and listed.");return}const r=e.target.closest("[data-reject]");if(r){businesses=businesses.filter(x=>x.id!==r.dataset.reject);save("businesses",businesses);renderAdmin();toast("Application rejected.");return}const pin=e.target.closest("[data-mechanic]");if(pin){document.getElementById("biz-"+pin.dataset.mechanic)?.scrollIntoView({behavior:"smooth",block:"center"})}});
$("#userForm").addEventListener("submit",e=>{e.preventDefault();user=Object.fromEntries(new FormData(e.target));save("user",user);$("#userMsg").textContent="Profile saved in this browser.";e.target.reset()});
$("#feedbackForm").addEventListener("submit",e=>{e.preventDefault();if(!user){$("#feedbackMsg").textContent="Save your driver profile before leaving feedback.";return}const d=new FormData(e.target);feedback.push({id:d.get("mechanic"),name:user.name,rating:Number(d.get("rating")),text:d.get("text")});save("feedback",feedback);$("#feedbackMsg").textContent="Thank you. Your feedback is saved locally.";e.target.reset();renderAdmin();renderMechanics()});
$("#businessForm").addEventListener("submit",e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target));businesses.push({...d,id:"biz-"+Date.now(),approved:false,rating:"New",availability:"Available by appointment",lat:0,lng:0});save("businesses",businesses);$("#businessMsg").textContent="Application submitted for admin approval.";e.target.reset()});
$("#manageForm").addEventListener("submit",e=>{e.preventDefault();const d=new FormData(e.target),b=businesses.find(x=>x.email.toLowerCase()===d.get("email").toLowerCase());if(!b){$("#manageMsg").textContent="No business found for that email.";return}b.availability=d.get("availability");save("businesses",businesses);$("#manageMsg").textContent="Business availability updated.";renderMechanics()});
$("#resetDemo").addEventListener("click",()=>{if(!confirm("Reset RoadReady directory and feedback to demo data?"))return;businesses=seed;feedback=[];save("businesses",businesses);save("feedback",feedback);renderAdmin()});
renderAdmin();route();
</script></body></html>
