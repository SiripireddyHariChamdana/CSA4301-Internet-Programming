<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>SmartBus Pass & Ticket System</title>
<style>
:root{--navy:#173b5e;--blue:#2876ad;--teal:#168b83;--gold:#f2b84b;--bg:#f3f7fb;--ink:#26384a}*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:var(--bg);color:var(--ink)}header{background:#fff;position:sticky;top:0;z-index:5;box-shadow:0 2px 12px #173b5e16}nav{max-width:1150px;margin:auto;padding:15px 22px;display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}.brand{font-size:22px;font-weight:800;color:var(--navy)}.brand span{color:var(--teal)}nav a{font-size:13px;font-weight:bold;text-decoration:none;color:#42576a;margin-left:13px}nav a:hover{color:var(--teal)}.hero{padding:65px 22px;background:linear-gradient(90deg,#102c47e8,#102c4770),url('https://images.unsplash.com/photo-1570125909232-eb263c188f7e?auto=format&fit=crop&w=1600&q=85') center/cover;color:#fff}.wrap{max-width:1150px;margin:auto}.tag{letter-spacing:3px;text-transform:uppercase;color:#f5c66f;font-size:12px;font-weight:bold}h1{font-size:clamp(36px,6vw,58px);max-width:680px;margin:14px 0}.hero p{max-width:650px;line-height:1.7}.btnrow{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}button{border:0;border-radius:8px;background:var(--blue);color:#fff;padding:11px 16px;font-weight:bold;cursor:pointer}button:hover{background:var(--navy)}.gold{background:var(--gold);color:#25384a}.section{max-width:1150px;margin:auto;padding:42px 22px}.head{margin-bottom:20px}h2{font-size:28px;color:var(--navy);margin:0 0 7px}h3{color:var(--navy);margin:0 0 12px}.muted{color:#687b8e;line-height:1.55}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card,.panel{background:white;border-radius:13px;padding:20px;box-shadow:0 5px 20px #173b5e0c}.card .ico{font-size:25px;margin-bottom:12px}.two{display:grid;grid-template-columns:1fr 1fr;gap:18px}form{display:grid;gap:11px}label{font-size:13px;font-weight:bold;color:#455a70}input,select,textarea{width:100%;display:block;margin-top:5px;padding:11px;border:1px solid #d8e2ec;border-radius:8px;font:inherit;background:white;color:var(--ink)}.pair{display:grid;grid-template-columns:1fr 1fr;gap:11px}.small{font-size:12px;color:#718398}.result{font-weight:bold;color:#16805f;margin-top:10px}.notice{padding:12px;background:#eef6f7;border-left:4px solid var(--teal);border-radius:7px;margin:10px 0}.tablewrap{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:13px}th,td{text-align:left;padding:10px;border-bottom:1px solid #e6edf3}th{background:#f0f5f9;color:var(--navy)}.pass{border:2px dashed #a6bacb;border-radius:12px;padding:17px;background:#f9fcff;margin-top:12px}.qr{width:112px;height:112px;border:7px solid white;outline:1px solid #d8e1e9;object-fit:contain;background:white}.badge{display:inline-block;padding:4px 8px;border-radius:20px;background:#e2f4ec;color:#17704f;font-size:11px;font-weight:bold}.hidden{display:none}footer{background:var(--navy);color:white;text-align:center;padding:27px}.footbrand{font-weight:bold;font-size:20px}@media(max-width:800px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.grid,.two,.pair{grid-template-columns:1fr}.section{padding:32px 17px}.hero{padding:48px 18px}nav a{margin:0 10px 0 0}}
</style></head><body>
<header><nav><div class="brand">Smart<span>Bus</span> Pass</div><div><a href="#home">Home</a><a href="#features">Features</a><a href="#user">User</a><a href="#admin">Admin</a><a href="#conductor">Conductor</a><a href="#tracking">ETA</a></div></nav></header>
<section class="hero" id="home"><div class="wrap"><div class="tag">One pass • Easier journeys</div><h1>Your bus pass and ticket, all in one place.</h1><p>Apply for student and route passes, renew monthly, buy e-tickets and view your QR pass. A simple demonstration of a digital bus transport system.</p><div class="btnrow"><button class="gold" onclick="document.getElementById('user').scrollIntoView({behavior:'smooth'})">Apply for a pass</button><button onclick="document.getElementById('tracking').scrollIntoView({behavior:'smooth'})">Check journey time</button></div></div></section>
<section class="section" id="features"><div class="head"><h2>System features</h2><p class="muted">Separate access for passengers, administrators and conductors.</p></div><div class="grid"><div class="card"><div class="ico">🎫</div><h3>Digital bus pass</h3><p class="muted">Student and route pass applications with validity and renewal details.</p></div><div class="card"><div class="ico">📱</div><h3>QR verification</h3><p class="muted">Generate a QR code for a pass and demonstrate conductor-side verification.</p></div><div class="card"><div class="ico">💳</div><h3>eWallet & eTicket</h3><p class="muted">Add demo wallet balance and purchase a bus e-ticket.</p></div><div class="card"><div class="ico">🚌</div><h3>Bus & route details</h3><p class="muted">Manage bus numbers, stops, route timings and fares.</p></div><div class="card"><div class="ico">📍</div><h3>Location update</h3><p class="muted">Conductor can submit a sample bus location and time.</p></div><div class="card"><div class="ico">⏱️</div><h3>Estimated arrival</h3><p class="muted">Estimate journey time using distance and average speed.</p></div></div></section>
<section class="section" id="user"><div class="head"><h2>User registration & services</h2><p class="muted">Register, add wallet money, apply for a pass, renew or buy a ticket.</p></div><div class="two"><div class="panel"><h3>User registration</h3><form id="registerForm"><div class="pair"><label>Candidate name<input id="uName" required placeholder="Full name"></label><label>Date of birth<input id="dob" type="date" required></label></div><label>Address<textarea id="address" rows="2" required placeholder="Residential address"></textarea></label><div class="pair"><label>Email<input id="email" type="email" required placeholder="Email address"></label><label>Phone<input id="phone" required placeholder="Mobile number"></label></div><label>User category<select id="category"><option>School student</option><option>College student</option><option>Working professional</option><option>General passenger</option></select></label><label>School / College / Organization<input id="institution" required placeholder="Institution or organization name"></label><label>Candidate photo<input id="photo" type="file" accept="image/*"></label><button>Register user</button></form><p id="registerMsg" class="result"></p></div><div class="panel"><h3>User login</h3><form id="userLogin"><label>Email<input type="email" required placeholder="Registered email"></label><label>Password<input type="password" required placeholder="Password"></label><button>Login (demo)</button></form><p id="userLoginMsg" class="result"></p><hr><h3>eWallet</h3><p class="muted">Demo wallet balance: <b id="wallet">₹0</b></p><form id="walletForm"><label>Add money (₹)<input id="walletAmount" type="number" min="1" required placeholder="Enter amount"></label><button>Add money</button></form><p id="walletMsg" class="result"></p></div></div>
<div class="two" style="margin-top:18px"><div class="panel"><h3>Apply for student / route pass</h3><form id="passForm"><label>Pass type<select id="passType"><option>Student Pass</option><option>Route Pass</option></select></label><div class="pair"><label>From<input id="from" required placeholder="Starting point"></label><label>To<input id="to" required placeholder="Destination"></label></div><div class="pair"><label>Validity period<select id="validity"><option>1 month</option><option>3 months</option><option>6 months</option><option>12 months</option></select></label><label>Pass month<input id="passMonth" type="month" required></label></div><label>School / Organization details<input id="passInstitution" placeholder="Name of school or workplace"></label><button>Submit pass application</button></form><p id="passMsg" class="result"></p><div id="passPreview"></div></div><div class="panel"><h3>Renew bus pass</h3><form id="renewForm"><label>Bus pass ID<input id="renewId" required placeholder="Enter pass ID"></label><label>Renewal period<select id="renewPeriod"><option value="1">1 month</option><option value="3">3 months</option><option value="6">6 months</option></select></label><button>Renew pass</button></form><p id="renewMsg" class="result"></p><hr><h3>Buy bus e-ticket</h3><form id="ticketForm"><label>Route<select id="ticketRoute"><option>Kodaikanal - Batlagundu</option><option>Kodaikanal - Dindigul</option><option>Kodaikanal - Palani</option></select></label><div class="pair"><label>Travel date<input id="travelDate" type="date" required></label><label>Passengers<input id="passengers" type="number" min="1" max="6" value="1" required></label></div><button>Buy e-ticket (demo)</button></form><p id="ticketMsg" class="result"></p></div></div></section>
<section class="section" id="admin"><div class="head"><h2>Admin dashboard</h2><p class="muted">Manage applications, conductors, buses and route information.</p></div><div class="two"><div class="panel"><h3>Admin login</h3><form id="adminLogin"><label>Username<input required placeholder="Admin username"></label><label>Password<input type="password" required placeholder="Password"></label><button>Login (demo)</button></form><p id="adminMsg" class="result"></p><hr><h3>Manage conductor login</h3><form id="conductorCreate"><label>Conductor name<input required placeholder="Conductor name"></label><label>Login ID<input required placeholder="Conductor ID"></label><label>Temporary password<input type="password" required></label><button>Create conductor account (demo)</button></form><p id="conductorCreateMsg" class="result"></p></div><div class="panel"><h3>Create bus details</h3><form id="busForm"><div class="pair"><label>Bus number<input required placeholder="TN-00-AB-0000"></label><label>Bus type<input required placeholder="Ordinary / Express"></label></div><label>Route name<input required placeholder="Route name"></label><button>Add bus</button></form><p id="busMsg" class="result"></p><hr><h3>Create route information</h3><form id="routeForm"><div class="pair"><label>From<input required placeholder="Starting stop"></label><label>To<input required placeholder="Destination"></label></div><div class="pair"><label>Departure time<input required type="time"></label><label>Arrival time<input required type="time"></label></div><label>Route stops (comma separated)<input required placeholder="Stop 1, Stop 2, Stop 3"></label><button>Add route</button></form><p id="routeMsg" class="result"></p></div></div><div class="panel" style="margin-top:18px"><h3>Bus pass applications</h3><div class="tablewrap"><table><thead><tr><th>Candidate</th><th>Pass type</th><th>Route</th><th>Validity</th><th>Fee</th><th>Status</th><th>Action</th></tr></thead><tbody id="applications"><tr><td colspan="7">No applications yet. Submit a pass application above.</td></tr></tbody></table></div></div></section>
<section class="section" id="conductor"><div class="head"><h2>Conductor dashboard</h2><p class="muted">Login, scan / enter QR pass details, verify tickets and update bus location.</p></div><div class="two"><div class="panel"><h3>Conductor login</h3><form id="conductorLogin"><label>Conductor ID<input required placeholder="Conductor ID"></label><label>Password<input type="password" required placeholder="Password"></label><button>Login (demo)</button></form><p id="conLoginMsg" class="result"></p><hr><h3>Verify bus pass / ticket</h3><form id="verifyForm"><label>Pass ID or ticket ID<input id="verifyId" required placeholder="Example: PASS-1001"></label><button>Verify ID</button></form><p id="verifyMsg" class="result"></p></div><div class="panel"><h3>Update bus location</h3><form id="locationForm"><label>Bus number<input required placeholder="Bus number"></label><div class="pair"><label>Current stop<input required placeholder="Current stop"></label><label>Next stop<input required placeholder="Next stop"></label></div><label>Update time<input type="time" required></label><button>Update location</button></form><p id="locationMsg" class="result"></p><div id="locationList" class="small"></div></div></div></section>
<section class="section" id="tracking"><div class="head"><h2>Calculate expected time to reach</h2><p class="muted">Enter the distance and average bus speed to estimate journey time.</p></div><div class="panel"><form id="etaForm"><div class="pair"><label>Distance (kilometres)<input id="distance" type="number" min="0.1" step="0.1" required placeholder="e.g. 24"></label><label>Average speed (km/hour)<input id="speed" type="number" min="1" step="1" value="30" required></label></div><button>Calculate expected time</button></form><p id="etaResult" class="result"></p><p class="small">Estimate = Distance ÷ Average speed. Actual travel time may vary due to traffic, weather and stops.</p></div></section>
<footer><div class="footbrand">SmartBus Pass & Ticket System</div><p>Digital bus passes • eTickets • QR verification • Route updates</p><span class="small" style="color:#c8d7e5">Academic front-end demonstration</span></footer>
<script>
let walletBalance=0,apps=[],passCounter=1000;
function bind(id,msg,success){document.getElementById(id).addEventListener('submit',e=>{e.preventDefault();document.getElementById(msg).textContent=success;e.target.reset()})}
bind('registerForm','registerMsg','User registration submitted in this demo.');
bind('userLogin','userLoginMsg','Demo login submitted. Authentication is not connected to a server.');
bind('adminLogin','adminMsg','Demo admin login submitted.');
bind('conductorCreate','conductorCreateMsg','Conductor account details submitted in this demo.');
bind('busForm','busMsg','Bus details added in this demo.');
bind('routeForm','routeMsg','Route information added in this demo.');
bind('conductorLogin','conLoginMsg','Conductor demo login submitted.');
document.getElementById('walletForm').addEventListener('submit',e=>{e.preventDefault();let n=Number(walletAmount.value);walletBalance+=n;document.getElementById('wallet').textContent='₹'+walletBalance;document.getElementById('walletMsg').textContent='₹'+n+' added to demo wallet.';e.target.reset()});
document.getElementById('passForm').addEventListener('submit',e=>{e.preventDefault();let type=passType.value,cat=document.getElementById('category').value,free=type==='Student Pass'&&cat==='School student',fee=free?0:(validity.value==='1 month'?250:validity.value==='3 months'?700:validity.value==='6 months'?1300:2400),id='PASS-'+(++passCounter),a={id,name:document.getElementById('uName').value||'Applicant',type,route:from.value+' → '+to.value,validity:validity.value,fee,status:'Pending'};apps.push(a);drawApps();document.getElementById('passMsg').textContent='Application submitted. Pass ID: '+id+'. Amount: '+(free?'FREE (government school student)': '₹'+fee);document.getElementById('passPreview').innerHTML=`<div class="pass"><b>BUS PASS APPLICATION</b><p>${a.type} • ${a.id}</p><p>${a.route}</p><p>Validity: ${a.validity} | Fee: ${free?'FREE':'₹'+fee}</p><span class="badge">Pending admin approval</span></div>`;e.target.reset()});
function drawApps(){let b=document.getElementById('applications');b.innerHTML=apps.map((a,i)=>`<tr><td>${a.name}</td><td>${a.type}</td><td>${a.route}</td><td>${a.validity}</td><td>${a.fee===0?'FREE':'₹'+a.fee}</td><td>${a.status}</td><td><button onclick="approve(${i})">Approve</button></td></tr>`).join('')}
function approve(i){apps[i].status='Approved';drawApps();document.getElementById('adminMsg').textContent='Pass application '+apps[i].id+' approved in this demo.'}
document.getElementById('renewForm').addEventListener('submit',e=>{e.preventDefault();let months=Number(renewPeriod.value),fee=months*250;if(walletBalance<fee){renewMsg.textContent='Insufficient demo wallet balance. Add ₹'+fee+' to renew.';return}walletBalance-=fee;document.getElementById('wallet').textContent='₹'+walletBalance;renewMsg.textContent=renewId.value+' renewed for '+months+' month(s). ₹'+fee+' deducted from demo wallet.';e.target.reset()});
document.getElementById('ticketForm').addEventListener('submit',e=>{e.preventDefault();let id='TKT-'+Date.now().toString().slice(-6),cost=Number(passengers.value)*80;if(walletBalance<cost){ticketMsg.textContent='Insufficient wallet balance. Add ₹'+cost+' to buy this demo ticket.';return}walletBalance-=cost;document.getElementById('wallet').textContent='₹'+walletBalance;ticketMsg.textContent='eTicket '+id+' booked for '+ticketRoute.value+' on '+travelDate.value+'. Fare ₹'+cost+' deducted.';e.target.reset()});
document.getElementById('verifyForm').addEventListener('submit',e=>{e.preventDefault();let id=verifyId.value.trim(),a=apps.find(x=>x.id===id);document.getElementById('verifyMsg').textContent=a?(a.status==='Approved'?'VALID: approved bus pass.':'PENDING: pass is not yet approved.'):(id.startsWith('TKT-')?'Ticket ID format accepted for demo. No central ticket record found.':'ID not found. Please check the pass / ticket ID.');});
document.getElementById('locationForm').addEventListener('submit',e=>{e.preventDefault();let v=e.target.querySelectorAll('input'),p=document.createElement('p');p.textContent='Bus '+v[0].value+': '+v[1].value+' → '+v[2].value+' (updated '+v[3].value+')';document.getElementById('locationList').prepend(p);document.getElementById('locationMsg').textContent='Bus location updated in this browser.';e.target.reset()});
document.getElementById('etaForm').addEventListener('submit',e=>{e.preventDefault();let mins=Number(distance.value)/Number(speed.value)*60,h=Math.floor(mins/60),m=Math.round(mins%60);document.getElementById('etaResult').textContent='Expected travel time: '+(h?h+' hour(s) ':'')+m+' minute(s).';});
</script></body></html>
