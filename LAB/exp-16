<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ComplainEase | Complaint Management</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f4f6fa;color:#26334a}header{background:#263f70;color:white;padding:17px 5%;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}h1{margin:0;font-size:25px}nav{display:flex;gap:5px;flex-wrap:wrap}button{border:0;border-radius:8px;padding:10px 14px;cursor:pointer;font-weight:bold;background:#e9eef8;color:#263f70}nav button{background:transparent;color:white}nav button.active,nav button:hover{background:#45639a}.page{display:none;max-width:1050px;margin:28px auto;padding:0 18px}.page.active{display:block}.hero{padding:40px 30px;border-radius:16px;background:linear-gradient(120deg,#263f70,#627fba);color:white}.hero h2{font-size:33px;margin:0 0 10px}.card{background:white;padding:22px;border-radius:14px;margin:16px 0;box-shadow:0 5px 18px #25395b10}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:15px}.field{margin:12px 0}.field label{display:block;font-weight:bold;margin-bottom:6px}input,select,textarea{width:100%;padding:11px;border:1px solid #cbd5e2;border-radius:8px;font:inherit}textarea{min-height:95px}.primary{background:#315b9c;color:white}.muted{color:#748096}.tag{display:inline-block;padding:5px 9px;border-radius:16px;background:#e8effb;color:#315b86;font-size:12px}.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}.stat{background:#edf2fa;padding:16px;border-radius:10px}.stat b{display:block;font-size:23px;color:#315b9c;margin-top:8px}table{width:100%;border-collapse:collapse;margin-top:12px}td,th{text-align:left;padding:11px;border-bottom:1px solid #e5eaf1}th{background:#edf2fa}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.status{font-weight:bold;color:#315b9c}footer{text-align:center;padding:25px;color:#7a879b}@media(max-width:600px){header{padding:15px}nav{width:100%}.hero h2{font-size:27px}}
</style></head><body>
<header><h1>📝 ComplainEase</h1><nav><button class="active" onclick="show('home',this)">Home</button><button onclick="show('submit',this)">Submit Complaint</button><button onclick="show('track',this)">Track Complaint</button><button onclick="show('my',this)">My Complaints</button><button onclick="show('admin',this)">Admin</button></nav></header>
<main>
<section id="home" class="page active"><div class="hero"><h2>Your concern matters.</h2><p>Submit complaints online, receive a reference number and track the progress until resolution.</p><button class="primary" onclick="show('submit')">Register a Complaint →</button></div><div class="card"><h2>How it works</h2><div class="grid"><div><h3>1. Submit</h3><p class="muted">Enter your details and describe the issue.</p></div><div><h3>2. Track</h3><p class="muted">Use your complaint ID to check its status.</p></div><div><h3>3. Resolve</h3><p class="muted">The support team reviews and updates your complaint.</p></div></div></div></section>
<section id="submit" class="page"><div class="card"><h2>Register a New Complaint</h2><form onsubmit="submitComplaint(event)"><div class="grid"><div class="field"><label>Full name</label><input id="name" required></div><div class="field"><label>Email address</label><input id="email" type="email" required></div><div class="field"><label>Mobile number</label><input id="mobile" pattern="[0-9]{10}" maxlength="10" required></div><div class="field"><label>Complaint category</label><select id="category"><option>Product / Service</option><option>Billing / Payment</option><option>Technical Issue</option><option>Staff Behaviour</option><option>Infrastructure</option><option>Other</option></select></div><div class="field"><label>Priority</label><select id="priority"><option>Normal</option><option>High</option><option>Urgent</option></select></div></div><div class="field"><label>Complaint subject</label><input id="subject" required></div><div class="field"><label>Describe your complaint</label><textarea id="description" required></textarea></div><button class="primary">Submit Complaint</button></form><p id="submitMsg"></p></div></section>
<section id="success" class="page"><div class="card"><h2>Complaint Submitted Successfully</h2><p>Your complaint reference number is:</p><h2 id="newId" class="status"></h2><p>Please save this number to track your complaint.</p><button class="primary" onclick="show('track')">Track Complaint</button></div></section>
<section id="track" class="page"><div class="card"><h2>Track Complaint Status</h2><form onsubmit="trackComplaint(event)"><div class="field"><label>Complaint reference number</label><input id="trackId" placeholder="Example: CE1001" required></div><button class="primary">Check Status</button></form><div id="trackResult"></div></div></section>
<section id="my" class="page"><div class="card"><h2>My Complaints</h2><p class="muted">Enter the email address used when submitting your complaint.</p><form onsubmit="myComplaints(event)"><div class="field"><label>Email address</label><input id="myEmail" type="email" required></div><button class="primary">View Complaints</button></form><div id="myRows"></div></div></section>
<section id="admin" class="page"><div class="card"><h2>Admin Login</h2><p class="muted">Demo credentials: admin / admin123</p><form onsubmit="adminLogin(event)"><div class="field"><label>Username</label><input id="adminUser" required></div><div class="field"><label>Password</label><input id="adminPass" type="password" required></div><button class="primary">Login</button></form><p id="adminMsg"></p></div><div id="adminPanel" class="card" style="display:none"><h2>Complaint Management Dashboard</h2><div class="stats"><div class="stat">Total complaints<b id="total">0</b></div><div class="stat">Pending<b id="pending">0</b></div><div class="stat">Resolved<b id="resolved">0</b></div></div><div class="grid"><div class="field"><label>Filter by status</label><select id="filterStatus" onchange="renderAdmin()"><option value="">All statuses</option><option>Submitted</option><option>Under Review</option><option>In Progress</option><option>Resolved</option><option>Rejected</option></select></div><div class="field"><label>Search by ID / customer</label><input id="adminSearch" oninput="renderAdmin()"></div></div><div id="adminRows"></div></div></section>
</main><footer>ComplainEase | Online Complaint Management System | Internet Programming Lab Demo</footer>
<script>
let complaints=JSON.parse(localStorage.getItem('complainEaseData')||'[]'),admin=false;
function save(){localStorage.setItem('complainEaseData',JSON.stringify(complaints))}
function show(id,btn){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');if(id==='admin'&&admin)renderAdmin();window.scrollTo(0,0)}
function submitComplaint(e){e.preventDefault();let c={id:'CE'+(1001+complaints.length),name:name.value,email:email.value,mobile:mobile.value,category:category.value,priority:priority.value,subject:subject.value,description:description.value,date:new Date().toLocaleDateString(),status:'Submitted',remarks:'Your complaint has been received.'};complaints.push(c);save();newId.textContent=c.id;e.target.reset();show('success')}
function trackComplaint(e){e.preventDefault();let c=complaints.find(x=>x.id.toLowerCase()===trackId.value.trim().toLowerCase());trackResult.innerHTML=c?`<div class="card"><h3>${c.subject}</h3><p><b>Complaint ID:</b> ${c.id}</p><p><b>Category:</b> ${c.category}</p><p><b>Date:</b> ${c.date}</p><p><b>Status:</b> <span class="status">${c.status}</span></p><p><b>Admin remarks:</b> ${c.remarks||'No remarks yet.'}</p></div>`:'<p>No complaint found. Please check the reference number.</p>'}
function myComplaints(e){e.preventDefault();let a=complaints.filter(c=>c.email.toLowerCase()===myEmail.value.trim().toLowerCase());myRows.innerHTML=a.length?'<table><tr><th>ID</th><th>Subject</th><th>Date</th><th>Status</th></tr>'+a.map(c=>`<tr><td>${c.id}</td><td>${c.subject}</td><td>${c.date}</td><td>${c.status}</td></tr>`).join('')+'</table>':'<p>No complaints found for this email.</p>'}
function adminLogin(e){e.preventDefault();if(adminUser.value==='admin'&&adminPass.value==='admin123'){admin=true;adminMsg.textContent='Login successful.';adminPanel.style.display='block';renderAdmin()}else adminMsg.textContent='Invalid username or password.'}
function renderAdmin(){total.textContent=complaints.length;pending.textContent=complaints.filter(c=>!['Resolved','Rejected'].includes(c.status)).length;resolved.textContent=complaints.filter(c=>c.status==='Resolved').length;let s=filterStatus.value,q=adminSearch.value.toLowerCase();let a=complaints.filter(c=>(!s||c.status===s)&&(!q||c.id.toLowerCase().includes(q)||c.name.toLowerCase().includes(q)));adminRows.innerHTML=a.length?'<table><tr><th>ID / Customer</th><th>Subject</th><th>Priority</th><th>Status</th><th>Update</th></tr>'+a.map(c=>`<tr><td>${c.id}<br>${c.name}<br>${c.email}</td><td>${c.subject}<br><small>${c.category}</small></td><td>${c.priority}</td><td>${c.status}</td><td><select onchange="updateComplaint('${c.id}',this.value)"><option ${c.status==='Submitted'?'selected':''}>Submitted</option><option ${c.status==='Under Review'?'selected':''}>Under Review</option><option ${c.status==='In Progress'?'selected':''}>In Progress</option><option ${c.status==='Resolved'?'selected':''}>Resolved</option><option ${c.status==='Rejected'?'selected':''}>Rejected</option></select><input placeholder="Admin remarks" value="${(c.remarks||'').replace(/"/g,'&quot;')}" onchange="updateRemarks('${c.id}',this.value)"></td></tr>`).join('')+'</table>':'<p>No complaints found.</p>'}
function updateComplaint(id,status){let c=complaints.find(x=>x.id===id);c.status=status;save();renderAdmin()}
function updateRemarks(id,value){let c=complaints.find(x=>x.id===id);c.remarks=value;save()}
</script></body></html>
