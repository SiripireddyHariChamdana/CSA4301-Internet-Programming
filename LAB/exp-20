<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RentRide | Vehicle Rental</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f5f8fb;color:#243447}header{background:#fff;border-bottom:1px solid #e1e8ef;position:sticky;top:0;z-index:4}.nav{max-width:1100px;margin:auto;padding:15px 22px;display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}.logo{font-size:23px;font-weight:800;color:#145c8e}.logo span{color:#f19a38}nav{display:flex;gap:6px;flex-wrap:wrap}nav button{border:0;background:transparent;padding:9px 11px;border-radius:8px;cursor:pointer;color:#33495c;font-weight:600}nav button.active,nav button:hover{background:#eaf4fb;color:#145c8e}main{max-width:1100px;margin:28px auto;padding:0 22px}.page{display:none}.page.active{display:block}.hero{padding:45px 38px;border-radius:20px;background:linear-gradient(115deg,#e4f2fc,#fff2df);display:grid;grid-template-columns:1.3fr .7fr;gap:20px;align-items:center}.hero h1{font-size:39px;line-height:1.12;color:#123e60;margin:0 0 12px}.hero p{color:#5c7183;line-height:1.6}.hero-art{text-align:center;font-size:90px}.btn{border:0;border-radius:9px;padding:11px 16px;background:#176b9d;color:white;font-weight:700;cursor:pointer}.btn.alt{background:#e8f2f8;color:#145c8e}.btn.warn{background:#e99537;color:#fff}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:22px}.card,.panel{background:#fff;border:1px solid #e0e8ef;border-radius:14px;padding:19px;box-shadow:0 4px 16px #183b5510}.card h3{margin:0 0 8px;color:#145c8e}.card p,.muted{color:#667b8c;line-height:1.5;font-size:14px}h2{margin:0 0 16px;color:#123e60}.sub{color:#667b8c;margin-top:-8px;margin-bottom:20px}.vehicles{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:15px}.vehicle{background:white;border:1px solid #e0e8ef;border-radius:14px;overflow:hidden}.vehicle .pic{height:120px;background:#eaf4fb;display:grid;place-items:center;font-size:62px}.vehicle .info{padding:16px}.price{font-weight:800;color:#145c8e;font-size:18px}form{display:grid;grid-template-columns:1fr 1fr;gap:14px}label{font-size:13px;font-weight:700;color:#42576a}input,select,textarea{width:100%;padding:11px;border:1px solid #cbd8e2;border-radius:8px;margin-top:6px;font:inherit}textarea{min-height:85px}.full{grid-column:1/-1}.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:14px}.notice{background:#e9f5ed;color:#176344;padding:12px;border-radius:9px;margin-top:13px;font-size:14px}table{width:100%;border-collapse:collapse;background:#fff}th,td{text-align:left;padding:12px;border-bottom:1px solid #e2e9ef;font-size:14px}th{background:#eaf4fb;color:#145c8e}.tag{background:#fff0da;color:#86551d;border-radius:20px;padding:4px 8px;font-size:12px}.empty{background:#fff;padding:20px;border:1px dashed #bdcbd7;border-radius:12px;color:#687d8d}footer{text-align:center;color:#788b9a;padding:25px;font-size:13px}@media(max-width:700px){.hero{grid-template-columns:1fr;padding:28px 22px}.hero h1{font-size:30px}.hero-art{font-size:65px}form{grid-template-columns:1fr}.full{grid-column:auto}main{margin-top:18px}}
</style></head>
<body>
<header><div class="nav"><div class="logo">Rent<span>Ride</span> 🚘</div><nav>
<button class="active" onclick="show('home',this)">Home</button><button onclick="show('browse',this)">Browse Vehicles</button><button onclick="show('booking',this)">Book Vehicle</button><button onclick="show('history',this)">My Bookings</button><button onclick="show('account',this)">Account</button><button onclick="show('admin',this)">Admin</button>
</nav></div></header>
<main>
<section id="home" class="page active"><div class="hero"><div><h1>Your journey, your vehicle.</h1><p>Find and rent cars, bikes and other vehicles for your trip. Choose your dates, compare rental prices and manage your bookings in one place.</p><button class="btn" onclick="show('browse')">Explore Vehicles</button></div><div class="hero-art">🚗 🛵 🚙</div></div><div class="cards"><div class="card"><h3>🚘 Wide vehicle choice</h3><p>Browse cars, bikes and SUVs with rental rates and availability.</p></div><div class="card"><h3>📅 Easy booking</h3><p>Select pickup and return dates and submit your rental request.</p></div><div class="card"><h3>🧾 Booking history</h3><p>View booking details, payment information and rental status.</p></div></div></section>
<section id="browse" class="page"><h2>Browse Vehicles</h2><p class="sub">Search available vehicles and select one to book.</p><div class="panel" style="margin-bottom:16px"><form id="filterForm"><label>Vehicle Type<select id="filterType"><option value="All">All types</option><option>Car</option><option>Bike</option><option>SUV</option><option>Van</option></select></label><label>Maximum Daily Budget (₹)<input id="maxPrice" type="number" min="0" placeholder="No limit"></label><div class="full"><button class="btn" type="submit">Apply Filters</button></div></form></div><div id="vehicleList" class="vehicles"></div></section>
<section id="booking" class="page"><h2>Book a Vehicle</h2><p class="sub">Enter your details and rental dates.</p><div class="panel"><form id="bookingForm"><label>Vehicle<select id="vehicleChoice" required></select></label><label>Full Name<input id="customer" required placeholder="Your name"></label><label>Email<input id="email" type="email" required placeholder="name@example.com"></label><label>Mobile Number<input id="mobile" required pattern="[0-9]{10}" placeholder="10-digit number"></label><label>Pickup Date<input id="pickup" type="date" required></label><label>Return Date<input id="dropoff" type="date" required></label><label>Pickup Location<input id="pickupLocation" required placeholder="Pickup location"></label><label>Payment Method<select id="payment"><option>UPI</option><option>Debit Card</option><option>Credit Card</option><option>Pay at Pickup</option></select></label><label class="full">Additional Requirements<textarea id="requirements" placeholder="Optional"></textarea></label><div class="full"><button class="btn" type="submit">Confirm Booking</button></div></form><div id="bookingMsg"></div></div></section>
<section id="history" class="page"><h2>My Bookings</h2><p class="sub">Enter the mobile number used for booking.</p><div class="panel"><label>Mobile Number<input id="historyMobile" placeholder="10-digit mobile number"></label><div class="actions"><button class="btn" onclick="findBookings()">Find Bookings</button><button class="btn alt" onclick="showAllBookings()">Show Demo Bookings</button></div></div><div id="historyResult" style="margin-top:18px"></div></section>
<section id="account" class="page"><h2>Customer Account</h2><p class="sub">Register or sign in using your details to identify your bookings.</p><div class="panel"><form id="accountForm"><label>Full Name<input id="accName" required></label><label>Mobile Number<input id="accMobile" required pattern="[0-9]{10}"></label><label class="full">Email<input id="accEmail" type="email" required></label><div class="full"><button class="btn" type="submit">Save Profile</button></div></form><div id="accountMsg"></div></div></section>
<section id="admin" class="page"><h2>Admin Dashboard</h2><p class="sub">Manage vehicle listings and rental bookings.</p><div class="panel"><label>Admin Password<input id="adminPass" type="password" placeholder="Enter admin password"></label><div class="actions"><button class="btn" onclick="adminLogin()">Login</button></div><p class="muted">Demo password: admin123</p><div id="adminMsg"></div></div><div id="adminArea" style="margin-top:18px"></div></section>
</main><footer>RentRide Vehicle Rental Demo · Booking and payment are simulated locally</footer>
<script>
const vehicles=[
{id:1,name:'Swift Hatchback',type:'Car',rate:1800,icon:'🚗',seats:5,desc:'Compact and comfortable city car'},
{id:2,name:'City Sedan',type:'Car',rate:2400,icon:'🚘',seats:5,desc:'Comfortable sedan for family trips'},
{id:3,name:'Royal Enfield Classic',type:'Bike',rate:900,icon:'🏍️',seats:2,desc:'Cruising bike for short journeys'},
{id:4,name:'Urban SUV',type:'SUV',rate:3200,icon:'🚙',seats:7,desc:'Spacious SUV for long trips'},
{id:5,name:'Family Van',type:'Van',rate:2800,icon:'🚐',seats:8,desc:'Large vehicle for group travel'},
{id:6,name:'City Scooter',type:'Bike',rate:500,icon:'🛵',seats:2,desc:'Easy-to-ride city scooter'}];
const getBookings=()=>JSON.parse(localStorage.getItem('rentRideBookings')||'[]');
const saveBookings=d=>localStorage.setItem('rentRideBookings',JSON.stringify(d));
function show(id,btn){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');if(id==='browse')renderVehicles();if(id==='booking')fillVehicleOptions();window.scrollTo(0,0)}
function renderVehicles(type='All',max=Infinity){const list=vehicles.filter(v=>(type==='All'||v.type===type)&&v.rate<=max);vehicleList.innerHTML=list.map(v=>`<div class="vehicle"><div class="pic">${v.icon}</div><div class="info"><h3>${v.name}</h3><p class="muted">${v.type} · ${v.seats} seats<br>${v.desc}</p><p class="price">₹${v.rate.toLocaleString('en-IN')} / day</p><button class="btn" onclick="selectVehicle(${v.id})">Book This Vehicle</button></div></div>`).join('')||'<div class="empty">No vehicles match your filters.</div>'}
function selectVehicle(id){show('booking');fillVehicleOptions();vehicleChoice.value=id}
function fillVehicleOptions(){vehicleChoice.innerHTML=vehicles.map(v=>`<option value="${v.id}">${v.name} — ₹${v.rate}/day</option>`).join('')}
filterForm.addEventListener('submit',e=>{e.preventDefault();renderVehicles(filterType.value,maxPrice.value?Number(maxPrice.value):Infinity)});
bookingForm.addEventListener('submit',e=>{e.preventDefault();const start=new Date(pickup.value+'T00:00:00'),end=new Date(dropoff.value+'T00:00:00');if(end<=start){bookingMsg.innerHTML='<div class="notice">Return date must be after pickup date.</div>';return}const v=vehicles.find(x=>x.id===Number(vehicleChoice.value));const days=Math.ceil((end-start)/86400000);const b={id:'RR'+Date.now().toString().slice(-7),vehicle:v.name,rate:v.rate,days,total:v.rate*days,customer:customer.value,email:email.value,mobile:mobile.value,pickup:pickup.value,dropoff:dropoff.value,location:pickupLocation.value,payment:payment.value,requirements:requirements.value,status:'Booking Requested',created:new Date().toLocaleString()};const d=getBookings();d.unshift(b);saveBookings(d);bookingMsg.innerHTML=`<div class="notice">Booking submitted! Booking ID: <b>${b.id}</b><br>${days} day(s) · Estimated total: <b>₹${b.total.toLocaleString('en-IN')}</b></div>`;e.target.reset();fillVehicleOptions()});
function bookingTable(items){if(!items.length)return '<div class="empty">No bookings found.</div>';return `<div class="panel"><table><tr><th>Booking ID / Customer</th><th>Vehicle / Dates</th><th>Total</th><th>Status</th></tr>${items.map(b=>`<tr><td><b>${b.id}</b><br>${b.customer}<br><span class="muted">${b.mobile}</span></td><td>${b.vehicle}<br>${b.pickup} to ${b.dropoff}<br><span class="muted">${b.location}</span></td><td>₹${b.total.toLocaleString('en-IN')}<br><span class="muted">${b.payment}</span></td><td><span class="tag">${b.status}</span></td></tr>`).join('')}</table></div>`}
function findBookings(){historyResult.innerHTML=bookingTable(getBookings().filter(b=>b.mobile===historyMobile.value.trim()))}
function showAllBookings(){historyResult.innerHTML=bookingTable(getBookings())}
accountForm.addEventListener('submit',e=>{e.preventDefault();localStorage.setItem('rentRideProfile',JSON.stringify({name:accName.value,mobile:accMobile.value,email:accEmail.value}));accountMsg.innerHTML='<div class="notice">Customer profile saved on this browser.</div>'});
function adminLogin(){if(adminPass.value!=='admin123'){adminMsg.innerHTML='<span style="color:#b33">Incorrect password.</span>';return}adminMsg.innerHTML='<div class="notice">Admin login successful.</div>';renderAdmin()}
function renderAdmin(){const d=getBookings();adminArea.innerHTML=`<div class="cards"><div class="card"><h3>${d.length}</h3><p>Total bookings</p></div><div class="card"><h3>₹${d.reduce((s,b)=>s+b.total,0).toLocaleString('en-IN')}</h3><p>Estimated booking value</p></div><div class="card"><h3>${d.filter(b=>b.status==='Booking Requested').length}</h3><p>Pending requests</p></div></div><div class="panel" style="margin-top:16px"><h3>Add Vehicle Listing</h3><form id="addVehicleForm"><label>Vehicle Name<input id="newName" required></label><label>Type<select id="newType"><option>Car</option><option>Bike</option><option>SUV</option><option>Van</option></select></label><label>Daily Rate (₹)<input id="newRate" type="number" min="1" required></label><label>Seats<input id="newSeats" type="number" min="1" value="5"></label><div class="full"><button class="btn">Add Vehicle</button></div></form></div><div class="panel" style="margin-top:16px"><h3>Manage Bookings</h3>${d.length?`<table><tr><th>Booking</th><th>Customer</th><th>Status</th><th>Action</th></tr>${d.map(b=>`<tr><td>${b.id}<br>${b.vehicle}</td><td>${b.customer}<br>${b.mobile}</td><td><select id="status-${b.id}"><option ${b.status==='Booking Requested'?'selected':''}>Booking Requested</option><option ${b.status==='Confirmed'?'selected':''}>Confirmed</option><option ${b.status==='Vehicle Picked Up'?'selected':''}>Vehicle Picked Up</option><option ${b.status==='Completed'?'selected':''}>Completed</option><option ${b.status==='Cancelled'?'selected':''}>Cancelled</option></select></td><td><button class="btn" onclick="updateBooking('${b.id}')">Update</button></td></tr>`).join('')}</table>`:'<p class="muted">No bookings yet.</p>'}</div>`;
document.getElementById('addVehicleForm').addEventListener('submit',e=>{e.preventDefault();vehicles.push({id:Math.max(...vehicles.map(v=>v.id))+1,name:newName.value,type:newType.value,rate:Number(newRate.value),seats:Number(newSeats.value),icon:'🚘',desc:'Newly listed rental vehicle'});renderAdmin();adminMsg.innerHTML='<div class="notice">Vehicle listing added.</div>'})}
function updateBooking(id){const d=getBookings(),b=d.find(x=>x.id===id);b.status=document.getElementById('status-'+id).value;saveBookings(d);renderAdmin();adminMsg.innerHTML='<div class="notice">Booking status updated.</div>'}
renderVehicles();fillVehicleOptions();
</script></body></html>
