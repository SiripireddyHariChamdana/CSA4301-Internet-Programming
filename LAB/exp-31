<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ko-Matha Dairy Farm</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f5f7f2;color:#25352b}
header{background:#214b35;color:white;padding:17px 5%;display:flex;align-items:center;justify-content:space-between;gap:15px;flex-wrap:wrap}
.logo{font-size:23px;font-weight:800}.logo small{display:block;font-size:11px;letter-spacing:1.5px;color:#d2e5d5;margin-top:4px}
nav,.subnav{display:flex;gap:6px;flex-wrap:wrap}nav button{background:transparent;color:white;border:1px solid #66836e;padding:9px 11px;border-radius:6px;cursor:pointer}nav button:hover,nav button.active{background:#477b53}
.subnav{background:#e8efe5;padding:9px 5%;border-bottom:1px solid #dce6d8}.subnav button{border:0;background:transparent;color:#315a3d;padding:8px 10px;cursor:pointer;border-radius:5px}.subnav button:hover{background:#d5e5d2}
main{max-width:1160px;margin:25px auto;padding:0 17px}.page{display:none}.page.active{display:block}
.hero{background:linear-gradient(120deg,#214b35,#6a9a58);color:white;padding:38px;border-radius:14px;margin-bottom:18px}.hero h1{font-size:32px;margin:0 0 12px}.hero p{max-width:760px;line-height:1.65;color:#eff8ec}
.card{background:white;border:1px solid #e2e9df;border-radius:11px;padding:22px;margin-bottom:17px;box-shadow:0 4px 14px #233d2610}
h2{color:#28563a;margin:0 0 16px}h3{color:#315d40;margin:0 0 9px}.muted{color:#718071;font-size:14px;line-height:1.55}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.three{grid-template-columns:repeat(3,minmax(0,1fr))}
.tile{border:1px solid #e2e9df;border-radius:9px;padding:17px;background:#fbfdf9}.tile p{margin-bottom:0}
.field{margin-bottom:13px}label{display:block;font-size:14px;font-weight:700;margin-bottom:7px}
input,select,textarea{width:100%;padding:11px;border:1px solid #cbd8c8;border-radius:6px;font:inherit;color:#25352b;background:white}textarea{min-height:90px;resize:vertical}
.btn{background:#39764a;color:white;border:0;padding:10px 15px;border-radius:6px;font-weight:700;cursor:pointer}.btn:hover{filter:brightness(.94)}.btn.light{background:#e7f0e4;color:#315d40}.btn.dark{background:#214b35}
.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:12px}
table{width:100%;border-collapse:collapse;margin-top:10px}th,td{text-align:left;padding:11px;border-bottom:1px solid #e7ece4;font-size:14px}th{background:#eff5ec;color:#315d40}
.tag{display:inline-block;background:#e7f0e4;color:#315d40;border-radius:20px;padding:4px 9px;font-size:12px;font-weight:700}
.product{display:flex;gap:14px;align-items:flex-start}.emoji{width:82px;height:82px;border-radius:10px;background:#edf4e9;display:grid;place-items:center;font-size:42px;flex-shrink:0}
.product p{margin:5px 0}.price{font-weight:800;color:#28563a}
.notice{padding:12px;background:#edf5e9;border-radius:7px;color:#3b6544;font-size:13px}
footer{text-align:center;padding:24px;color:#748173;font-size:13px}
@media(max-width:700px){.grid,.three{grid-template-columns:1fr}.hero{padding:25px}.hero h1{font-size:26px}header{align-items:flex-start}.product{flex-direction:column}}
</style>
</head>
<body>
<header>
 <div class="logo">🐄 Ko-Matha Dairy Farm<small>PURE • FRESH • FARM TO HOME</small></div>
 <nav>
  <button class="active" onclick="go('home',this)">Home</button>
  <button onclick="go('products',this)">Products</button>
  <button onclick="go('farm',this)">Our Farm</button>
  <button onclick="go('order',this)">Order Online</button>
  <button onclick="go('about',this)">About Us</button>
  <button onclick="go('contact',this)">Contact</button>
 </nav>
</header>
<div class="subnav">
 <button onclick="go('adminLogin')">Administrator</button>
 <button onclick="go('stock')">Stock Entry</button>
 <button onclick="go('reports')">Daily / Monthly / Yearly Reports</button>
 <button onclick="go('customers')">Customer Details</button>
 <button onclick="go('purchases')">Purchase Details</button>
 <button onclick="go('vendors')">Milk Vendors</button>
 <button onclick="go('cows')">Cow Maintenance</button>
</div>
<main>
<section id="home" class="page active">
 <div class="hero"><span class="tag">Fresh from our farm</span><h1>Wholesome Dairy, Delivered Fresh</h1><p>Welcome to Ko-Matha Dairy Farm. Explore fresh milk and traditional dairy products sourced from Indian A1 cow holders, with a focus on quality, care and convenient customer service.</p><div class="actions"><button class="btn" onclick="go('products')">Explore Products</button><button class="btn light" onclick="go('order')">Order Online</button></div></div>
 <div class="grid three">
  <div class="tile"><h3>🥛 Fresh Milk</h3><p class="muted">Fresh dairy goodness for your everyday needs.</p></div>
  <div class="tile"><h3>🌿 Farm Practices</h3><p class="muted">Learn about animal care and our quality practices.</p></div>
  <div class="tile"><h3>🚚 Convenient Orders</h3><p class="muted">Place an order and choose your preferred delivery date.</p></div>
 </div>
 <div class="card"><h2>Our Popular Products</h2><div class="grid" id="homeProducts"></div></div>
</section>

<section id="products" class="page"><div class="card"><h2>Our Dairy Products</h2><p class="muted">Choose from our range of fresh dairy products.</p><div class="grid" id="productList"></div></div></section>
<section id="farm" class="page"><div class="card"><h2>Our Farm</h2><p>Ko-Matha Dairy Farm aims to connect customers with wholesome dairy products and promote transparency about farm practices.</p><div class="grid"><div class="tile"><h3>Indian A1 Cow Holders</h3><p class="muted">We work with Indian cow holders as part of our milk sourcing approach.</p></div><div class="tile"><h3>Quality Practices</h3><p class="muted">Milk handling, cleanliness and careful storage are important parts of dairy quality management.</p></div><div class="tile"><h3>Animal Care</h3><p class="muted">Good feeding, clean shelter and regular care support healthy dairy operations.</p></div><div class="tile"><h3>Farm Technology</h3><p class="muted">Digital stock records and order tracking help organize farm operations.</p></div></div></div></section>
<section id="about" class="page"><div class="card"><h2>About Ko-Matha Dairy Farm</h2><p>Ko-Matha Dairy Farm is focused on supplying fresh milk and traditional dairy products while building a direct connection between the farm and its customers.</p><p class="muted">Our values include product quality, customer satisfaction, responsible sourcing, transparency and dependable service.</p><h3>Our Mission</h3><p class="muted">To make wholesome dairy products accessible through convenient ordering and organized farm operations.</p></div></section>
<section id="contact" class="page"><div class="card"><h2>Contact Us</h2><p class="muted">Send us your questions, suggestions or order enquiries.</p><form onsubmit="contactForm(event)"><div class="grid"><div class="field"><label>Name</label><input id="contactName" required></div><div class="field"><label>Email</label><input id="contactEmail" type="email" required></div><div class="field"><label>Phone</label><input id="contactPhone" required></div></div><div class="field"><label>Message</label><textarea id="contactMessage" required></textarea></div><button class="btn">Send Message</button></form><p id="contactResult" class="muted"></p></div></section>

<section id="order" class="page"><div class="card"><h2>Customer Online Purchase Order</h2><form onsubmit="placeOrder(event)"><div class="grid"><div class="field"><label>Customer name</label><input id="orderName" required></div><div class="field"><label>Phone number</label><input id="orderPhone" required></div><div class="field"><label>Email</label><input id="orderEmail" type="email"></div><div class="field"><label>Product</label><select id="orderProduct" onchange="updateOrderTotal()"></select></div><div class="field"><label>Quantity</label><input id="orderQty" type="number" min="1" value="1" required oninput="updateOrderTotal()"></div><div class="field"><label>Delivery date</label><input id="deliveryDate" type="date" required></div></div><div class="field"><label>Delivery address</label><textarea id="orderAddress" required></textarea></div><p id="orderTotal" class="price"></p><button class="btn">Place Order</button></form><p id="orderResult" class="muted"></p></div></section>

<section id="adminRegister" class="page"><div class="card"><h2>Administrator Registration</h2><form onsubmit="adminRegister(event)"><div class="grid"><div class="field"><label>Full name</label><input id="adminName" required></div><div class="field"><label>Email</label><input id="adminEmail" type="email" required></div><div class="field"><label>Username</label><input id="adminUsername" required></div><div class="field"><label>Password</label><input id="adminPassword" type="password" required></div></div><button class="btn">Register Administrator</button></form></div></section>
<section id="adminLogin" class="page"><div class="card"><h2>Administrator Login</h2><form onsubmit="adminLogin(event)"><div class="field"><label>Username</label><input id="loginUsername" required></div><div class="field"><label>Password</label><input id="loginPassword" type="password" required></div><button class="btn">Login</button></form><div class="actions"><button class="btn light" onclick="go('adminRegister')">Administrator Registration</button></div><p class="muted">Demo login: admin / admin123</p></div></section>
<section id="adminDashboard" class="page"><div class="card"><h2>Administrator Dashboard</h2><p class="muted">Manage stock, customer orders, vendors and cow records.</p><div class="grid three"><div class="tile"><h3 id="dashStock">0</h3><p class="muted">Stock entries</p></div><div class="tile"><h3 id="dashOrders">0</h3><p class="muted">Customer orders</p></div><div class="tile"><h3 id="dashVendors">0</h3><p class="muted">Milk vendors</p></div></div><div class="actions"><button class="btn" onclick="go('stock')">Stock Entry</button><button class="btn light" onclick="go('reports')">View Reports</button><button class="btn light" onclick="go('vendors')">Vendor Records</button></div></div></section>
<section id="stock" class="page"><div class="card"><h2>Stock Entry Form</h2><form onsubmit="addStock(event)"><div class="grid"><div class="field"><label>Product</label><select id="stockProduct"></select></div><div class="field"><label>Entry type</label><select id="stockType"><option>Production / Received</option><option>Sold / Dispatched</option><option>Wastage</option></select></div><div class="field"><label>Quantity</label><input id="stockQty" type="number" min="0.1" step="0.1" required></div><div class="field"><label>Unit</label><select id="stockUnit"><option>Litres</option><option>Kg</option><option>Packets</option></select></div><div class="field"><label>Date</label><input id="stockDate" type="date" required></div><div class="field"><label>Notes</label><input id="stockNotes"></div></div><button class="btn">Save Stock Entry</button></form><h3 style="margin-top:22px">Stock Records</h3><div id="stockTable"></div></div></section>
<section id="reports" class="page"><div class="card"><h2>Stock and Sales Reports</h2><div class="actions"><button class="btn light" onclick="showReport('daily')">Daily Report</button><button class="btn light" onclick="showReport('monthly')">Monthly Report</button><button class="btn light" onclick="showReport('yearly')">Yearly Report</button></div><div class="field" style="margin-top:15px"><label>Select date</label><input type="date" id="reportDate" onchange="showReport(currentReport)"></div><div id="reportOutput"></div></div></section>
<section id="customers" class="page"><div class="card"><h2>Customer Details</h2><p class="muted">Customer information is collected when an online order is placed.</p><div id="customerTable"></div></div></section>
<section id="purchases" class="page"><div class="card"><h2>Purchase Details</h2><div id="purchaseTable"></div></div></section>
<section id="vendors" class="page"><div class="card"><h2>Milk Vendor Details</h2><form onsubmit="addVendor(event)"><div class="grid"><div class="field"><label>Vendor name</label><input id="vendorName" required></div><div class="field"><label>Phone</label><input id="vendorPhone" required></div><div class="field"><label>Village / Address</label><input id="vendorAddress" required></div><div class="field"><label>Milk category</label><select id="vendorMilk"><option>Indian A1 cow milk</option><option>Other milk supply</option></select></div><div class="field"><label>Daily supply (litres)</label><input id="vendorSupply" type="number" min="0" step="0.1" required></div></div><button class="btn">Add Vendor</button></form><h3 style="margin-top:22px">Vendor Information</h3><div id="vendorTable"></div></div></section>
<section id="cows" class="page"><div class="card"><h2>Cow Detail Maintenance</h2><form onsubmit="addCow(event)"><div class="grid"><div class="field"><label>Cow ID</label><input id="cowId" required></div><div class="field"><label>Breed / Type</label><input id="cowBreed" placeholder="Indian cow breed" required></div><div class="field"><label>Age (years)</label><input id="cowAge" type="number" min="0" step="0.1" required></div><div class="field"><label>Milk yield per day (litres)</label><input id="cowYield" type="number" min="0" step="0.1" required></div><div class="field"><label>Health status</label><select id="cowHealth"><option>Healthy</option><option>Under observation</option><option>Veterinary care</option></select></div><div class="field"><label>Last check-up date</label><input id="cowCheck" type="date"></div></div><button class="btn">Save Cow Details</button></form><h3 style="margin-top:22px">Cow Records</h3><div id="cowTable"></div></div></section>
</main>
<footer>Ko-Matha Dairy Farm · Fresh Dairy Products · Farm to Home</footer>
<script>
const products=[{name:'Fresh Milk',price:60,unit:'litre',icon:'🥛',desc:'Fresh milk for everyday use.'},{name:'Curd',price:80,unit:'kg',icon:'🥣',desc:'Creamy traditional curd.'},{name:'Cova Sweet',price:350,unit:'kg',icon:'🍬',desc:'Traditional milk-based sweet.'},{name:'Butter',price:120,unit:'250 g',icon:'🧈',desc:'Rich dairy butter.'},{name:'Ghee',price:650,unit:'litre',icon:'🫙',desc:'Aromatic clarified butter.'}];
let db=loadDB(),currentReport='daily';
function loadDB(){try{return JSON.parse(localStorage.getItem('komathaDB'))||{admins:[],stock:[],orders:[],vendors:[],cows:[]}}catch(e){return {admins:[],stock:[],orders:[],vendors:[],cows:[]}}}
function save(){localStorage.setItem('komathaDB',JSON.stringify(db))}
function go(id,btn){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));let p=document.getElementById(id);if(p)p.classList.add('active');document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');window.scrollTo(0,0);if(id==='products')renderProducts();if(id==='order')setupOrder();if(id==='stock')renderStock();if(id==='reports'){reportDate.value=new Date().toISOString().slice(0,10);showReport(currentReport)}if(id==='customers')renderCustomers();if(id==='purchases')renderPurchases();if(id==='vendors')renderVendors();if(id==='cows')renderCows();if(id==='adminDashboard')renderDashboard()}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function renderProducts(){productList.innerHTML=products.map(p=>`<div class="tile product"><div class="emoji">${p.icon}</div><div><h3>${p.name}</h3><p class="muted">${p.desc}</p><p class="price">₹${p.price} / ${p.unit}</p><button class="btn light" onclick="go('order');setupOrder('${p.name}')">Order this product</button></div></div>`).join('')}
function setupOrder(selected){let s=document.getElementById('orderProduct');s.innerHTML=products.map(p=>`<option value="${p.name}" ${p.name===selected?'selected':''}>${p.name} — ₹${p.price}/${p.unit}</option>`).join('');deliveryDate.min=new Date().toISOString().slice(0,10);updateOrderTotal()}
function updateOrderTotal(){let p=products.find(x=>x.name===orderProduct.value)||products[0],q=Math.max(1,Number(orderQty.value)||1);orderTotal.textContent=`Estimated total: ₹${p.price*q.toFixed(2)} (delivery charges, if any, are not included)`; }
function placeOrder(e){e.preventDefault();let p=products.find(x=>x.name===orderProduct.value),q=Number(orderQty.value);db.orders.push({id:'KM'+Date.now().toString().slice(-7),name:orderName.value,phone:orderPhone.value,email:orderEmail.value,product:p.name,qty:q,unit:p.unit,total:p.price*q,date:new Date().toISOString().slice(0,10),delivery:deliveryDate.value,address:orderAddress.value,status:'Received'});save();orderResult.textContent='Order placed successfully. Your order ID is '+db.orders.at(-1).id+'.';e.target.reset();setupOrder()}
function contactForm(e){e.preventDefault();contactResult.textContent='Thank you. Your enquiry has been recorded.';e.target.reset()}
function adminRegister(e){e.preventDefault();if(db.admins.some(a=>a.username===adminUsername.value)){alert('Username already exists.');return}db.admins.push({name:adminName.value,email:adminEmail.value,username:adminUsername.value,password:adminPassword.value});save();alert('Administrator registered. Please log in.');go('adminLogin')}
function adminLogin(e){e.preventDefault();let ok=(loginUsername.value==='admin'&&loginPassword.value==='admin123')||db.admins.some(a=>a.username===loginUsername.value&&a.password===loginPassword.value);if(!ok){alert('Invalid login details.');return}alert('Login successful.');go('adminDashboard')}
function renderDashboard(){dashStock.textContent=db.stock.length;dashOrders.textContent=db.orders.length;dashVendors.textContent=db.vendors.length}
function addStock(e){e.preventDefault();db.stock.push({product:stockProduct.value,type:stockType.value,qty:Number(stockQty.value),unit:stockUnit.value,date:stockDate.value,notes:stockNotes.value});save();e.target.reset();stockDate.value=new Date().toISOString().slice(0,10);renderStock();alert('Stock entry saved.')}
function renderStock(){stockProduct.innerHTML=products.map(p=>`<option>${p.name}</option>`).join('');if(!stockDate.value)stockDate.value=new Date().toISOString().slice(0,10);stockTable.innerHTML=db.stock.length?`<table><tr><th>Date</th><th>Product</th><th>Entry type</th><th>Quantity</th><th>Notes</th></tr>${db.stock.slice().reverse().map(x=>`<tr><td>${esc(x.date)}</td><td>${esc(x.product)}</td><td>${esc(x.type)}</td><td>${x.qty} ${esc(x.unit)}</td><td>${esc(x.notes)}</td></tr>`).join('')}</table>`:'<p class="muted">No stock entries recorded.</p>'}
function showReport(period){currentReport=period||'daily';let d=reportDate.value||new Date().toISOString().slice(0,10),match=x=>period==='daily'?x.date===d:period==='monthly'?x.date.slice(0,7)===d.slice(0,7):x.date.slice(0,4)===d.slice(0,4),entries=db.stock.filter(match),orders=db.orders.filter(x=>match({date:x.date})),received=entries.filter(x=>x.type==='Production / Received').reduce((a,x)=>a+x.qty,0),out=entries.filter(x=>x.type==='Sold / Dispatched').reduce((a,x)=>a+x.qty,0),sales=orders.reduce((a,x)=>a+x.total,0);reportOutput.innerHTML=`<h3>${period[0].toUpperCase()+period.slice(1)} Report · ${period==='daily'?d:period==='monthly'?d.slice(0,7):d.slice(0,4)}</h3><div class="grid three"><div class="tile"><h3>${received}</h3><p class="muted">Stock received / produced</p></div><div class="tile"><h3>${out}</h3><p class="muted">Stock dispatched</p></div><div class="tile"><h3>₹${sales.toFixed(2)}</h3><p class="muted">Online order value</p></div></div><p class="muted">${entries.length} stock entries · ${orders.length} online orders</p>`}
function renderCustomers(){let map={};db.orders.forEach(o=>{if(!map[o.phone])map[o.phone]=o});let rows=Object.values(map);customerTable.innerHTML=rows.length?`<table><tr><th>Customer</th><th>Phone</th><th>Email</th><th>Address</th></tr>${rows.map(o=>`<tr><td>${esc(o.name)}</td><td>${esc(o.phone)}</td><td>${esc(o.email)}</td><td>${esc(o.address)}</td></tr>`).join('')}</table>`:'<p class="muted">Customer details will appear after an online order is placed.</p>'}
function renderPurchases(){purchaseTable.innerHTML=db.orders.length?`<table><tr><th>Order ID</th><th>Customer</th><th>Product</th><th>Qty</th><th>Total</th><th>Order date</th><th>Delivery date</th><th>Status</th></tr>${db.orders.slice().reverse().map(o=>`<tr><td>${o.id}</td><td>${esc(o.name)}</td><td>${esc(o.product)}</td><td>${o.qty} ${esc(o.unit)}</td><td>₹${o.total}</td><td>${o.date}</td><td>${o.delivery}</td><td>${o.status}</td></tr>`).join('')}</table>`:'<p class="muted">No customer purchases recorded yet.</p>'}
function addVendor(e){e.preventDefault();db.vendors.push({name:vendorName.value,phone:vendorPhone.value,address:vendorAddress.value,milk:vendorMilk.value,supply:Number(vendorSupply.value)});save();e.target.reset();renderVendors();alert('Vendor details saved.')}
function renderVendors(){vendorTable.innerHTML=db.vendors.length?`<table><tr><th>Vendor</th><th>Phone</th><th>Address</th><th>Milk category</th><th>Daily supply</th></tr>${db.vendors.map(v=>`<tr><td>${esc(v.name)}</td><td>${esc(v.phone)}</td><td>${esc(v.address)}</td><td>${esc(v.milk)}</td><td>${v.supply} L</td></tr>`).join('')}</table>`:'<p class="muted">No vendor records added.</p>'}
function addCow(e){e.preventDefault();if(db.cows.some(c=>c.id===cowId.value)){alert('Cow ID already exists.');return}db.cows.push({id:cowId.value,breed:cowBreed.value,age:cowAge.value,yield:cowYield.value,health:cowHealth.value,check:cowCheck.value});save();e.target.reset();renderCows();alert('Cow details saved.')}
function renderCows(){cowTable.innerHTML=db.cows.length?`<table><tr><th>Cow ID</th><th>Breed / Type</th><th>Age</th><th>Daily yield</th><th>Health</th><th>Last check-up</th></tr>${db.cows.map(c=>`<tr><td>${esc(c.id)}</td><td>${esc(c.breed)}</td><td>${esc(c.age)} years</td><td>${esc(c.yield)} L</td><td>${esc(c.health)}</td><td>${esc(c.check)}</td></tr>`).join('')}</table>`:'<p class="muted">No cow records added.</p>'}
homeProducts.innerHTML=products.slice(0,3).map(p=>`<div class="tile"><h3>${p.icon} ${p.name}</h3><p class="price">₹${p.price} / ${p.unit}</p><p class="muted">${p.desc}</p></div>`).join('');
setupOrder();renderProducts();
</script>
</body></html>
