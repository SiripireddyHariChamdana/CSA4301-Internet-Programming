<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#eff4f7">
<title>Current — Electricity account & bill payment</title>
<style>
:root{--ink:#202f3b;--muted:#687b88;--bg:#eff4f7;--white:#fff;--navy:#173d59;--blue:#287baa;--cyan:#dff0f5;--line:#dce5eb;--green:#24744d;--gold:#dda94c;--serif:Georgia,"Times New Roman",serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.6 Arial,sans-serif}a{color:inherit;text-decoration:none}button,input,select{font:inherit}button,.btn{border:0;border-radius:6px;padding:11px 15px;background:var(--blue);color:white;cursor:pointer;font-weight:bold;display:inline-block}button:hover,.btn:hover{background:var(--navy)}.outline{background:transparent;color:var(--navy);border:1px solid var(--line)}.danger{background:#a4413d}header{position:sticky;top:0;z-index:5;background:#fffF;border-bottom:1px solid var(--line)}nav{max-width:1160px;margin:auto;min-height:70px;padding:12px 23px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font-size:22px;font-weight:900;color:var(--navy);letter-spacing:-.7px}.brand span{color:var(--blue)}.links{display:flex;gap:18px;align-items:center;flex-wrap:wrap}.links a{font-size:13px;font-weight:bold;color:#506372}.links a:hover{color:var(--blue)}.user-chip{border-radius:20px;padding:5px 11px;background:var(--cyan);font-size:12px}.view{display:none;min-height:72vh}.view.active{display:block}.wrap{max-width:1160px;margin:auto;padding:45px 23px}.hero{background:linear-gradient(110deg,#133954,#276f90);color:#fff;border-radius:10px;padding:45px 6%;display:flex;align-items:center;justify-content:space-between;gap:25px}.hero h1{font:500 clamp(37px,5.5vw,59px)/1.04 var(--serif);margin:8px 0}.hero p{color:#d8eaf0;max-width:560px}.eyebrow{text-transform:uppercase;letter-spacing:1.6px;font-size:11px;color:var(--blue);font-weight:bold}.hero .eyebrow{color:#a7dce7}.hero .outline{color:#fff;border-color:#c5e0e9}.hero-art{font-size:90px;opacity:.85}.title{font:500 clamp(30px,4vw,43px)/1.12 var(--serif);margin:7px 0}.sub{color:var(--muted);max-width:740px}.row{display:flex;align-items:end;justify-content:space-between;gap:15px;flex-wrap:wrap;margin-bottom:19px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.stat,.panel{background:#fff;border:1px solid var(--line);border-radius:8px;padding:19px;box-shadow:0 4px 15px #1a3b5010}.stat .value{font-size:27px;font-weight:800;color:var(--navy);margin:6px 0}.stat .label{font-size:12px;color:var(--muted)}.two{display:grid;grid-template-columns:1fr 1fr;gap:19px}.field{width:100%;padding:11px;border:1px solid #d3dee6;border-radius:5px;background:white;color:var(--ink);margin-top:5px}label{display:block;font-size:13px;font-weight:bold;margin:10px 0}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px 12px}.notice{background:#e8f2f5;border-left:3px solid var(--blue);padding:12px;margin:12px 0}.warning{background:#fff4e2;border-left-color:#d39735;color:#72511d}.result{font-size:32px;font-weight:bold;color:var(--navy)}.meta{font-size:12px;color:var(--muted)}table{width:100%;border-collapse:collapse;font-size:13px}th,td{text-align:left;padding:10px;border-bottom:1px solid var(--line)}th{background:#f2f6f8;color:#405b6b}.table-wrap{overflow:auto}.slab{display:grid;grid-template-columns:1fr 110px;gap:10px;padding:9px 0;border-bottom:1px solid var(--line);align-items:center}.slab input{width:100%;padding:9px;border:1px solid #d3dee6;border-radius:4px}.receipt{border:1px dashed #829aa8;padding:18px;margin-top:16px;background:#fbfdff}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:15px}.tabs button{background:#e4edf1;color:var(--navy)}.tabs button.active{background:var(--navy);color:white}.toast{position:fixed;right:20px;bottom:20px;background:var(--navy);color:#fff;padding:12px 16px;border-radius:5px;display:none;z-index:10}.status{color:var(--green);font-weight:bold;min-height:22px}.empty{color:var(--muted);padding:16px}.bill-pill{background:#fff0d4;color:#835d20;border-radius:20px;padding:4px 9px;font-size:11px;font-weight:bold}footer{background:#17384e;color:#e8f0f3;padding:23px}.foot{max-width:1160px;margin:auto;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}.foot a{text-decoration:underline;text-underline-offset:3px}@media(max-width:760px){.grid{grid-template-columns:1fr}.two{grid-template-columns:1fr}.hero-art{display:none}.links{gap:10px}}@media(max-width:540px){nav{align-items:flex-start;flex-direction:column}.wrap{padding:34px 17px}.hero{padding:30px 22px}.form-grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<header><nav><a class="brand" href="#home">CURRENT<span> /</span> power</a><div class="links"><a href="#home">Home</a><a href="#dashboard">My account</a><a href="#register">Register</a><a href="#admin">Admin</a><span class="user-chip" id="userChip">Demo account</span></div></nav></header>
<main>
<section class="view" id="home"><div class="wrap"><div class="hero"><div><div class="eyebrow">Your electricity, made clear</div><h1>Know your bill.<br>Pay with confidence.</h1><p>View your two-month electricity bill, understand the unit calculation, and keep track of payment dates in one place.</p><div class="actions"><a class="btn" href="#dashboard">View demo bill</a><a class="btn outline" href="#register">Create an account</a></div></div><div class="hero-art" aria-hidden="true">ϟ</div></div><div class="row" style="margin-top:37px"><div><div class="eyebrow">Simple and transparent</div><h2 class="title">A clearer way to manage power.</h2></div></div><div class="grid"><article class="stat"><div class="eyebrow">01 / Understand</div><div class="value">₹</div><div class="label">See the progressive unit slabs used to calculate your bill.</div></article><article class="stat"><div class="eyebrow">02 / Keep track</div><div class="value">2 mo</div><div class="label">View the billing period, due date, and any late-payment fine.</div></article><article class="stat"><div class="eyebrow">03 / Stay current</div><div class="value">✓</div><div class="label">Generate a demo receipt and manage bill reminder preferences.</div></article></div><div class="notice warning"><b>Demo portal:</b> The account, bill, and payment details are stored only in this browser. No real payment is collected.</div></div></section>
<section class="view" id="register"><div class="wrap"><div class="eyebrow">New to Current?</div><h1 class="title">Register a demo account.</h1><p class="sub">Enter an account name and service number to create a local demo profile. No password or payment information is saved.</p><div class="two"><form id="registerForm" class="panel"><label>Customer name<input class="field" name="name" autocomplete="name" required></label><label>Electricity service number<input class="field" name="service" placeholder="e.g. 1234567890" required></label><label>Connection type<select class="field" name="type"><option>Domestic</option><option>Commercial</option></select></label><label>Email for bill reminders<input class="field" name="email" type="email" autocomplete="email" required></label><button>Create demo account</button><p class="status" id="registerStatus" role="status"></p></form><div class="panel"><h2>Returning customer?</h2><p class="sub">Sign in to your demo profile using your service number. This static page does not provide production authentication.</p><form id="loginForm"><label>Service number<input class="field" name="service" required></label><button class="outline">Open my account</button></form><p class="status" id="loginStatus" role="status"></p></div></div></div></section>
<section class="view" id="dashboard"><div class="wrap"><div class="row"><div><div class="eyebrow">Customer account</div><h1 class="title">Your electricity dashboard.</h1><p class="sub" id="customerGreeting">Welcome to the demo account.</p></div><span class="bill-pill" id="billStatus"></span></div><div class="grid"><article class="stat"><div class="label">Current bill</div><div class="value" id="billAmount">₹0</div><div class="meta" id="connectionSummary"></div></article><article class="stat"><div class="label">Billing period</div><div class="value" style="font-size:19px" id="periodSummary"></div><div class="meta">Updated every two months</div></article><article class="stat"><div class="label">Payment due</div><div class="value" style="font-size:21px" id="dueSummary"></div><div class="meta" id="fineSummary"></div></article></div><div class="two" style="margin-top:18px"><section class="panel"><div class="row"><div><div class="eyebrow">Understand the calculation</div><h2>Bill breakdown</h2></div></div><label>Units consumed in this period<input class="field" id="units" type="number" min="0" max="100000" value="275"></label><div id="billBreakdown"></div><p class="meta">Progressive slabs are charged only for units within each range, as specified in the lab brief.</p><a class="btn" href="#pay">Go to payment</a></section><section class="panel"><div class="eyebrow">Never miss a due date</div><h2>Bill reminders</h2><label><input id="emailReminder" type="checkbox"> Email me when a bill is due</label><label><input id="smsReminder" type="checkbox"> Text me when a bill is due</label><label><input id="autoPay" type="checkbox"> Enable demo automatic payment reminder</label><p class="meta">Preferences are saved in this browser. No messages or automatic payments are sent.</p><p id="preferenceStatus" class="status" role="status"></p></section></div><section class="panel" style="margin-top:18px"><div class="row"><div><div class="eyebrow">Your account</div><h2>Payment history</h2></div><a class="btn outline" href="#history">Full history</a></div><div id="recentHistory"></div></section></div></section>
<section class="view" id="pay"><div class="wrap"><div class="eyebrow">Demo payment</div><h1 class="title">Review and pay your bill.</h1><div class="two"><form id="paymentForm" class="panel"><h2>Payment method</h2><div class="tabs" id="paymentTabs"><button type="button" class="active" data-method="UPI / digital wallet">UPI / wallet</button><button type="button" data-method="Credit card">Credit card</button><button type="button" data-method="Debit card">Debit card</button><button type="button" data-method="Net banking">Net banking</button></div><label>Payment reference (optional)<input class="field" name="reference" placeholder="Demo reference only"></label><div class="notice warning">Do not enter real card, bank, or UPI details. This local demonstration never contacts a payment provider.</div><button id="payButton">Confirm demo payment</button><p class="status" id="paymentStatus" role="status"></p></form><div class="panel"><h2>Bill summary</h2><p class="meta" id="payCustomer"></p><p class="meta" id="payPeriod"></p><div class="result" id="payTotal"></div><p id="payFine" class="meta"></p><p class="sub">A printable demo receipt will be available after confirmation.</p></div></div><div id="receipt" class="receipt" hidden></div></div></section>
<section class="view" id="history"><div class="wrap"><div class="eyebrow">Account activity</div><h1 class="title">Payment history.</h1><div class="panel"><div class="table-wrap" id="historyTable"></div><a class="btn outline" href="#dashboard">Back to dashboard</a></div></div></section>
<section class="view" id="admin"><div class="wrap"><div class="eyebrow">Administration · local demo</div><h1 class="title">Billing settings.</h1><p class="sub">Adjust tariff rates and billing dates to see how customer calculations change. These controls are not protected by a real admin login.</p><div class="two"><section class="panel"><h2>Tariff slabs (₹ per unit)</h2><p class="meta">Enter the rate for each usage band. Rates apply progressively.</p><div id="rateEditor"></div><label>Late fee per overdue day (₹)<input class="field" id="lateRate" type="number" min="0" step="1"></label><button id="saveRates">Save tariff settings</button><p class="status" id="adminStatus" role="status"></p></section><section class="panel"><h2>Two-month billing period</h2><p class="meta">Set the billing period and payment deadline shown on the customer dashboard.</p><label>Period start<input class="field" id="periodStart" type="date"></label><label>Period end<input class="field" id="periodEnd" type="date"></label><label>Payment due date<input class="field" id="dueDate" type="date"></label><button id="savePeriod">Save billing dates</button><p class="status" id="periodStatus" role="status"></p><div class="notice">The initial tariff rates follow the Experiment 42 brief. Administrative changes are saved in this browser.</div></section></div></div></section>
</main>
<footer><div class="foot"><a class="brand" style="color:white" href="#home">CURRENT / power</a><span>Clear bills. Confident choices. · <a href="#admin">Billing settings</a></span><span>Experiment 42 · <a href="../Exp-41/RecipeBook.html">← Gather &amp; Grain</a> · <a href="../Exp-43/Placement.html">Next: placement exam →</a></span></div></footer><div class="toast" id="toast" role="status"></div>
<script>
const $=s=>document.querySelector(s),money=n=>"₹"+Number(n).toLocaleString("en-IN",{minimumFractionDigits:2,maximumFractionDigits:2}),today=new Date();
const defaultRates={Domestic:[1,2.5,4,6],Commercial:[2,4.5,6,7]};
function load(key,fallback){try{return JSON.parse(localStorage.getItem("current-"+key))??fallback}catch{return fallback}}
function save(key,value){localStorage.setItem("current-"+key,JSON.stringify(value))}
function dateOnly(d){return new Date(d.getFullYear(),d.getMonth(),d.getDate())}
function localDate(d){return`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`}
function initialPeriod(){const end=new Date(today.getFullYear(),today.getMonth(),0),start=new Date(end.getFullYear(),end.getMonth()-1,1),due=new Date(end.getFullYear(),end.getMonth()+1,15);return{start:localDate(start),end:localDate(end),due:localDate(due)}}
let rates=load("rates",defaultRates),lateRate=load("lateRate",10),period=load("period",initialPeriod()),account=load("account",null),history=load("history",[]),method="UPI / digital wallet",currentTotal=0;
function toast(s){const t=$("#toast");t.textContent=s;t.style.display="block";clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>t.style.display="none",2300)}
function lateDays(){const due=new Date(period.due+"T00:00:00"),now=dateOnly(today);return Math.max(0,Math.floor((now-due)/86400000))}
function calculate(units,type){const consumed=Math.max(0,Number(units)||0),bandLimits=[100,200,500,Infinity],bandNames=["First 100 units","101–200 units","201–500 units","Above 500 units"];let left=consumed,base=0,rows=[];for(let i=0;i<4;i++){const capacity=bandLimits[i]===Infinity?left:Math.max(0,Math.min(left,bandLimits[i]-(i?bandLimits[i-1]:0)));const amt=capacity*(Number(rates[type]?.[i])||0);base+=amt;rows.push({name:bandNames[i],units:capacity,rate:Number(rates[type]?.[i])||0,amount:amt});left-=capacity}const days=lateDays(),fine=days*Number(lateRate||0);return{units:consumed,base,fine,total:base+fine,days,rows}}
function periodText(){const f=d=>new Date(d+"T00:00:00").toLocaleDateString("en-IN",{day:"2-digit",month:"short",year:"numeric"});return `${f(period.start)} – ${f(period.end)}`}
function setUserChip(){$("#userChip").textContent=account?account.name:"Demo account";$("#customerGreeting").textContent=account?`Welcome, ${account.name}. Service number ${account.service}.`:"Welcome to the demo account. Register to personalize your bill."}
function renderBreakdown(){const calc=calculate($("#units").value,account?.type||"Domestic");currentTotal=calc.total;$("#billAmount").textContent=money(calc.total);$("#connectionSummary").textContent=`${account?.type||"Domestic"} connection · ${calc.units} units`;$("#periodSummary").textContent=periodText();$("#dueSummary").textContent=new Date(period.due+"T00:00:00").toLocaleDateString("en-IN",{day:"numeric",month:"short",year:"numeric"});$("#fineSummary").textContent=calc.days?`${calc.days} overdue day${calc.days===1?"":"s"} · ${money(calc.fine)} late fee`:"No late fee currently";$("#billStatus").textContent=calc.days?`Overdue by ${calc.days} day${calc.days===1?"":"s"}`:"Due soon";$("#billBreakdown").innerHTML=`<div class="table-wrap"><table><thead><tr><th>Usage band</th><th>Units</th><th>Rate</th><th>Charge</th></tr></thead><tbody>${calc.rows.filter(r=>r.units>0).map(r=>`<tr><td>${r.name}</td><td>${r.units}</td><td>${money(r.rate)}</td><td>${money(r.amount)}</td></tr>`).join("")}<tr><td colspan="3"><b>Energy charge</b></td><td><b>${money(calc.base)}</b></td></tr><tr><td colspan="3">Late fee (${calc.days} × ${money(lateRate)})</td><td>${money(calc.fine)}</td></tr><tr><td colspan="3"><b>Total due</b></td><td><b>${money(calc.total)}</b></td></tr></tbody></table></div>`;$("#payTotal").textContent=money(calc.total);$("#payFine").textContent=`Includes ${money(calc.fine)} late fee for ${calc.days} overdue days.`;$("#payCustomer").textContent=account?`${account.name} · service ${account.service} · ${account.type}`:"Demo customer · Domestic connection";$("#payPeriod").textContent=`Billing period: ${periodText()} · Due: ${period.due}`;renderHistory();return calc}
function renderHistory(){const el=$("#recentHistory"),table=$("#historyTable");const rows=history.map(x=>`<tr><td>${x.date}</td><td>${x.id}</td><td>${x.period}</td><td>${x.method}</td><td>${money(x.amount)}</td><td>Paid</td></tr>`);el.innerHTML=rows.length?`<div class="table-wrap"><table><thead><tr><th>Date</th><th>Receipt</th><th>Billing period</th><th>Method</th><th>Amount</th><th>Status</th></tr></thead><tbody>${rows.slice(0,3).join("")}</tbody></table></div>`:'<p class="empty">No demo payments yet.</p>';table.innerHTML=rows.length?`<table><thead><tr><th>Date</th><th>Receipt</th><th>Period</th><th>Method</th><th>Amount</th><th>Status</th></tr></thead><tbody>${rows.join("")}</tbody></table>`:'<p class="empty">No payments have been recorded.</p>'}
function renderRates(){const names=["First 100 units","101–200 units","201–500 units","Above 500 units"];$("#rateEditor").innerHTML=["Domestic","Commercial"].map(type=>`<h3>${type}</h3>${names.map((n,i)=>`<label class="slab"><span>${n}</span><input type="number" min="0" step="0.01" data-rate-type="${type}" data-rate-index="${i}" value="${rates[type][i]}"></label>`).join("")}`).join("");$("#lateRate").value=lateRate;$("#periodStart").value=period.start;$("#periodEnd").value=period.end;$("#dueDate").value=period.due}
function route(){const id=location.hash.slice(1)||"home";if(!document.getElementById(id)?.classList.contains("view")){location.hash="#home";return}document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===id));if(id==="dashboard"||id==="pay")renderBreakdown();if(id==="history")renderHistory();if(id==="admin")renderRates();window.scrollTo(0,0)}
window.addEventListener("hashchange",route);$("#units").addEventListener("input",renderBreakdown);
$("#registerForm").addEventListener("submit",e=>{e.preventDefault();const d=new FormData(e.target);account={name:d.get("name").trim(),service:d.get("service").trim(),type:d.get("type"),email:d.get("email").trim()};save("account",account);setUserChip();renderBreakdown();$("#registerStatus").textContent="Demo account created in this browser.";e.target.reset();location.hash="#dashboard"});
$("#loginForm").addEventListener("submit",e=>{e.preventDefault();const service=new FormData(e.target).get("service").trim();if(!account||account.service!==service){$("#loginStatus").textContent="No matching demo account. Register this service number first.";return}$("#loginStatus").textContent=`Welcome back, ${account.name}.`;setUserChip();location.hash="#dashboard"});
["emailReminder","smsReminder","autoPay"].forEach(id=>{const box=$("#"+id);box.checked=load(id,false);box.addEventListener("change",()=>{save(id,box.checked);$("#preferenceStatus").textContent="Reminder preference saved locally. No message is sent."})});
$("#paymentTabs").addEventListener("click",e=>{const b=e.target.closest("[data-method]");if(!b)return;method=b.dataset.method;$("#paymentTabs").querySelectorAll("button").forEach(x=>x.classList.toggle("active",x===b))});
$("#paymentForm").addEventListener("submit",e=>{e.preventDefault();const calc=renderBreakdown(),record={id:"DEMO-"+Date.now().toString().slice(-8),date:new Date().toLocaleDateString("en-IN"),period:periodText(),method,amount:calc.total,units:calc.units};history.unshift(record);save("history",history);$("#receipt").hidden=false;$("#receipt").innerHTML=`<div class="row"><div><div class="eyebrow">Demo payment receipt</div><h2>Payment recorded</h2></div><b>${record.id}</b></div><p><b>${account?.name||"Demo customer"}</b> · Service ${account?.service||"DEMO-0001"}</p><p>Billing period: ${record.period}</p><p>Units: ${record.units} · Payment method: ${record.method}</p><h2>Total paid: ${money(record.amount)}</h2><p class="meta">This is a local demo receipt. No funds were transferred.</p><button id="downloadReceipt">Download receipt</button> <button class="outline" id="printReceipt">Print</button>`;$("#paymentStatus").textContent="Demo payment recorded; no real payment was processed.";renderHistory();$("#receipt").scrollIntoView({behavior:"smooth"})});
$("#receipt").addEventListener("click",e=>{if(e.target.id==="printReceipt")window.print();if(e.target.id==="downloadReceipt"){const text=$("#receipt").innerText;const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([text],{type:"text/plain"}));a.download="current-demo-receipt.txt";a.click();URL.revokeObjectURL(a.href)}});
$("#saveRates").addEventListener("click",()=>{document.querySelectorAll("[data-rate-type]").forEach(input=>rates[input.dataset.rateType][Number(input.dataset.rateIndex)]=Math.max(0,Number(input.value)||0));lateRate=Math.max(0,Number($("#lateRate").value)||0);save("rates",rates);save("lateRate",lateRate);$("#adminStatus").textContent="Tariff and late-fee settings saved.";renderBreakdown()});
$("#savePeriod").addEventListener("click",()=>{const start=$("#periodStart").value,end=$("#periodEnd").value,due=$("#dueDate").value;if(!start||!end||!due||new Date(start)>new Date(end)){ $("#periodStatus").textContent="Enter a valid period: start date must be on or before end date, with a due date.";return}period={start,end,due};save("period",period);$("#periodStatus").textContent="Billing dates saved.";renderBreakdown()});
setUserChip();route();
</script>
</body>
</html>
