<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ram Infotech | Laptop Sales & Services</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f4f6fa;color:#263247}
header{background:#172b4d;color:#fff;padding:17px 5%;display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}
.logo{font-size:24px;font-weight:800}.logo small{display:block;font-size:11px;letter-spacing:1.5px;color:#c4d3e8;margin-top:4px}
nav,.subnav{display:flex;gap:6px;flex-wrap:wrap}nav button{background:transparent;color:#fff;border:1px solid #526986;padding:9px 11px;border-radius:6px;cursor:pointer;font-size:13px}nav button:hover,nav button.active{background:#356da8}
.subnav{background:#e8edf5;padding:9px 5%;border-bottom:1px solid #dce3ee}.subnav button{border:0;background:transparent;color:#24476e;padding:8px 10px;cursor:pointer;border-radius:5px;font-size:13px}.subnav button:hover{background:#d7e3f1}
main{max-width:1160px;margin:25px auto;padding:0 17px}.page{display:none}.page.active{display:block}
.hero{background:linear-gradient(120deg,#172b4d,#3576b5);color:#fff;padding:38px;border-radius:14px;margin-bottom:18px}.hero h1{font-size:32px;margin:0 0 12px}.hero p{max-width:790px;line-height:1.65;color:#e2edfa}
.card{background:#fff;border:1px solid #e1e6ee;border-radius:11px;padding:22px;margin-bottom:17px;box-shadow:0 4px 14px #1d355710}
h2{color:#1d3c63;margin:0 0 16px}h3{color:#294e78;margin:0 0 9px}.muted{color:#718096;font-size:14px;line-height:1.55}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.three{grid-template-columns:repeat(3,minmax(0,1fr))}
.tile{border:1px solid #e1e7ef;border-radius:9px;padding:17px;background:#fbfcfe}.tile p{margin-bottom:0}
.field{margin-bottom:13px}label{display:block;font-size:14px;font-weight:700;margin-bottom:7px}
input,select,textarea{width:100%;padding:11px;border:1px solid #cbd4e0;border-radius:6px;font:inherit;color:#263247;background:#fff}textarea{min-height:90px;resize:vertical}
.btn{background:#28649b;color:#fff;border:0;padding:10px 15px;border-radius:6px;font-weight:700;cursor:pointer}.btn:hover{filter:brightness(.94)}.btn.light{background:#e7eef7;color:#24476e}
.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:12px}
table{width:100%;border-collapse:collapse;margin-top:10px}th,td{text-align:left;padding:11px;border-bottom:1px solid #e6eaf0;font-size:14px;vertical-align:top}th{background:#eff3f8;color:#294e78}
.tag{display:inline-block;background:#e7eef7;color:#285783;border-radius:20px;padding:4px 9px;font-size:12px;font-weight:700}
.laptop{display:flex;gap:14px;align-items:flex-start}.device{width:90px;height:75px;background:#e9f0f8;border-radius:10px;display:grid;place-items:center;font-size:42px;flex-shrink:0}
.price{font-weight:800;color:#1e5b91}.status{padding:4px 8px;background:#eaf2fb;border-radius:15px;font-size:12px}
footer{text-align:center;padding:24px;color:#78869a;font-size:13px}
@media(max-width:700px){.grid,.three{grid-template-columns:1fr}.hero{padding:25px}.hero h1{font-size:26px}header{align-items:flex-start}.laptop{flex-direction:column}}
</style>
</head>
<body>
<header>
 <div class="logo">💻 RAM INFOTECH<small>LAPTOP SALES • SERVICE • SUPPORT</small></div>
 <nav>
  <button class="active" onclick="go('home',this)">Home</button><button onclick="go('store',this)">Online Store</button>
  <button onclick="go('services',this)">Services</button><button onclick="go('about',this)">About Us</button>
  <button onclick="go('faq',this)">FAQ</button><button onclick="go('contact',this)">Contact</button>
 </nav>
</header>
<div class="subnav">
 <button onclick="go('adminLogin')">Admin Login</button><button onclick="go('adminRegister')">Admin Registration</button>
 <button onclick="go('laptopDetails')">Laptop Details</button><button onclick="go('customerRecords')">Customer Information</button>
 <button onclick="go('rental')">Rental Agreement</button><button onclick="go('stock')">Stock Maintenance</button>
 <button onclick="go('serviceTrack')">Track Service</button>
</div>
<main>
<section id="home" class="page active">
 <div class="hero"><span class="tag">Your technology partner</span><h1>Find Your Perfect Laptop. Keep It Running.</h1><p>Welcome to Ram Infotech, your destination for laptop sales, repair services and reliable technical support. Explore laptop models, compare configurations, book a service and manage rental requests.</p><div class="actions"><button class="btn" onclick="go('store')">Explore Laptops</button><button class="btn light" onclick="go('bookService')">Book a Service</button><button class="btn light" onclick="go('rental')">Laptop Rental</button></div></div>
 <div class="grid three"><div class="tile"><h3>💻 Laptop Store</h3><p class="muted">Browse laptop models, specifications and prices.</p></div><div class="tile"><h3>🛠️ Service Center</h3><p class="muted">Book repairs and check service progress.</p></div><div class="tile"><h3>📦 Rental Options</h3><p class="muted">Request laptops for short-term or long-term use.</p></div></div>
 <div class="card"><h2>Featured Laptops</h2><div class="grid" id="featured"></div></div>
</section>
<section id="store" class="page"><div class="card"><h2>Online Laptop Store</h2><p class="muted">Select a laptop to view its configuration and place a purchase request.</p><div id="storeList" class="grid"></div></div></section>
<section id="laptopDetails" class="page"><div class="card"><h2>Laptop Details & Configuration</h2><div id="detailsList"></div></div></section>
<section id="purchase" class="page"><div class="card"><h2>Purchase Laptop</h2><form onsubmit="buyLaptop(event)"><div class="grid"><div class="field"><label>Customer name</label><input id="buyName" required></div><div class="field"><label>Email</label><input id="buyEmail" type="email" required></div><div class="field"><label>Phone</label><input id="buyPhone" required></div><div class="field"><label>Select laptop</label><select id="buyModel" onchange="updateBuyPrice()"></select></div></div><p id="buyPrice" class="price"></p><div class="field"><label>Delivery address</label><textarea id="buyAddress" required></textarea></div><button class="btn">Place Purchase Request</button></form><p id="buyResult" class="muted"></p></div></section>
<section id="services" class="page"><div class="card"><h2>Our Laptop Services</h2><div class="grid three"><div class="tile"><h3>🔧 Hardware Repair</h3><p class="muted">Screen, keyboard, battery, hinge and motherboard diagnosis.</p></div><div class="tile"><h3>⚙️ Software Support</h3><p class="muted">Operating system installation, driver setup and troubleshooting.</p></div><div class="tile"><h3>🧹 Maintenance</h3><p class="muted">Cleaning, overheating checks and performance optimization.</p></div><div class="tile"><h3>💾 Data Support</h3><p class="muted">Backup guidance and storage-related troubleshooting.</p></div><div class="tile"><h3>🔋 Battery Service</h3><p class="muted">Battery health inspection and replacement support.</p></div><div class="tile"><h3>🌐 Network Support</h3><p class="muted">Wi-Fi, connectivity and peripheral troubleshooting.</p></div></div><div class="actions"><button class="btn" onclick="go('bookService')">Schedule a Repair</button><button class="btn light" onclick="go('guides')">Troubleshooting Guides</button></div></div></section>
<section id="bookService" class="page"><div class="card"><h2>Schedule Laptop Service</h2><form onsubmit="bookService(event)"><div class="grid"><div class="field"><label>Customer name</label><input id="serviceName" required></div><div class="field"><label>Phone</label><input id="servicePhone" required></div><div class="field"><label>Email</label><input id="serviceEmail" type="email"></div><div class="field"><label>Laptop brand / model</label><input id="serviceModel" required></div><div class="field"><label>Service required</label><select id="serviceType"><option>Hardware Repair</option><option>Software Support</option><option>Cleaning and Maintenance</option><option>Battery Service</option><option>Network Support</option><option>Other</option></select></div><div class="field"><label>Preferred date</label><input id="serviceDate" type="date" required></div></div><div class="field"><label>Problem description</label><textarea id="serviceProblem" required></textarea></div><button class="btn">Book Service</button></form><p id="serviceResult" class="muted"></p></div></section>
<section id="serviceTrack" class="page"><div class="card"><h2>Track Service Status</h2><div class="field"><label>Enter service ID or phone number</label><input id="trackInput" placeholder="Example: SR123456"></div><button class="btn" onclick="trackService()">Track Service</button><div id="trackResult"></div><h3 style="margin-top:20px">All Service Requests</h3><div id="serviceTable"></div></div></section>
<section id="guides" class="page"><div class="card"><h2>Troubleshooting Guides</h2><div class="review"><h3>Laptop is running slowly</h3><p class="muted">Close unused applications, check available storage, restart the laptop and review startup applications.</p></div><div class="review"><h3>Laptop is overheating</h3><p class="muted">Keep air vents clear, use the laptop on a hard surface and avoid blocking cooling outlets.</p></div><div class="review"><h3>Wi-Fi is not connecting</h3><p class="muted">Restart the router and laptop, verify Wi-Fi is enabled and reconnect to the network.</p></div><div class="review"><h3>Battery is not charging</h3><p class="muted">Check the adapter and charging port. If the issue continues, request a battery inspection.</p></div></div></section>
<section id="about" class="page"><div class="card"><h2>About Ram Infotech</h2><p>Ram Infotech provides laptop sales and service support for customers looking for suitable devices and dependable maintenance.</p><p class="muted">Our mission is to make technology accessible through product choice, clear information, responsive service and customer-focused support.</p><div class="grid"><div class="tile"><h3>Our Mission</h3><p class="muted">Deliver useful technology solutions and quality customer service.</p></div><div class="tile"><h3>Our Commitment</h3><p class="muted">Provide clear laptop configurations, service updates and customer assistance.</p></div></div></div></section>
<section id="faq" class="page"><div class="card"><h2>Frequently Asked Questions</h2><div class="review"><h3>How can I purchase a laptop?</h3><p class="muted">Open Online Store, choose a model and submit the purchase request form.</p></div><div class="review"><h3>How do I book a repair?</h3><p class="muted">Open Services and select Schedule a Repair. Enter your laptop details and preferred date.</p></div><div class="review"><h3>How can I track my service?</h3><p class="muted">Use the service ID or phone number in the Track Service page.</p></div><div class="review"><h3>Can I rent a laptop?</h3><p class="muted">Yes. Submit a rental request with the required period and laptop details.</p></div><div class="review"><h3>How do I contact support?</h3><p class="muted">Use the Contact page to send an enquiry.</p></div></div></section>
<section id="contact" class="page"><div class="card"><h2>Contact Us</h2><form onsubmit="contactUs(event)"><div class="grid"><div class="field"><label>Name</label><input id="contactName" required></div><div class="field"><label>Email</label><input id="contactEmail" type="email" required></div><div class="field"><label>Phone</label><input id="contactPhone" required></div></div><div class="field"><label>Message</label><textarea id="contactMessage" required></textarea></div><button class="btn">Send Message</button></form><p id="contactResult" class="muted"></p></div></section>

<section id="adminRegister" class="page"><div class="card"><h2>Admin Registration</h2><form onsubmit="registerAdmin(event)"><div class="grid"><div class="field"><label>Full name</label><input id="adminName" required></div><div class="field"><label>Email</label><input id="adminEmail" type="email" required></div><div class="field"><label>Username</label><input id="adminUser" required></div><div class="field"><label>Password</label><input id="adminPass" type="password" required></div></div><button class="btn">Register Admin</button></form></div></section>
<section id="adminLogin" class="page"><div class="card"><h2>Admin Login</h2><form onsubmit="loginAdmin(event)"><div class="field"><label>Username</label><input id="loginUser" required></div><div class="field"><label>Password</label><input id="loginPass" type="password" required></div><button class="btn">Login</button></form><p class="muted">Demo login: admin / admin123</p><button class="btn light" onclick="go('adminRegister')">Admin Registration</button></div></section>
<section id="adminDashboard" class="page"><div class="card"><h2>Admin Dashboard</h2><div class="grid three"><div class="tile"><h3 id="countSales">0</h3><p class="muted">Purchase requests</p></div><div class="tile"><h3 id="countServices">0</h3><p class="muted">Service requests</p></div><div class="tile"><h3 id="countStock">0</h3><p class="muted">Stock records</p></div></div><div class="actions"><button class="btn" onclick="go('stock')">Manage Stock</button><button class="btn light" onclick="go('salesRecords')">Sales Records</button><button class="btn light" onclick="go('serviceRecords')">Service Records</button></div></div></section>
<section id="salesRecords" class="page"><div class="card"><h2>Customer Purchase Records</h2><div id="salesTable"></div></div></section>
<section id="serviceRecords" class="page"><div class="card"><h2>Customer Service Records</h2><div id="adminServiceTable"></div></div></section>
<section id="rental" class="page"><div class="card"><h2>Laptop Rental Agreement</h2><p class="muted">Submit a rental request with customer details, selected laptop and rental period.</p><form onsubmit="rentalRequest(event)"><div class="grid"><div class="field"><label>Customer name</label><input id="rentName" required></div><div class="field"><label>Phone</label><input id="rentPhone" required></div><div class="field"><label>Email</label><input id="rentEmail" type="email" required></div><div class="field"><label>Laptop model</label><select id="rentModel"></select></div><div class="field"><label>Rental start date</label><input id="rentStart" type="date" required></div><div class="field"><label>Rental end date</label><input id="rentEnd" type="date" required></div></div><div class="field"><label>Purpose of rental</label><textarea id="rentPurpose" required></textarea></div><label><input id="rentAgree" type="checkbox" required style="width:auto"> I agree to follow the rental terms and return the laptop in good condition.</label><div class="actions"><button class="btn">Submit Rental Request</button></div></form><p id="rentResult" class="muted"></p><h3 style="margin-top:20px">Rental Requests</h3><div id="rentalTable"></div></div></section>
<section id="stock" class="page"><div class="card"><h2>Shop Stock Maintenance</h2><form onsubmit="addStock(event)"><div class="grid"><div class="field"><label>Laptop model</label><select id="stockModel"></select></div><div class="field"><label>Configuration</label><input id="stockConfig" required placeholder="RAM / Storage / Processor"></div><div class="field"><label>Quantity received</label><input id="stockQty" type="number" min="1" required></div><div class="field"><label>Unit price (₹)</label><input id="stockPrice" type="number" min="0" required></div><div class="field"><label>Entry date</label><input id="stockDate" type="date" required></div><div class="field"><label>Supplier</label><input id="stockSupplier"></div></div><button class="btn">Add Stock</button></form><h3 style="margin-top:22px">Available Stock</h3><div id="stockTable"></div></div></section>
</main>
<footer>Ram Infotech · Laptop Sales, Rentals & Service Support</footer>
<script>
const laptops=[
{name:'Dell Inspiron 15',brand:'Dell',processor:'Intel Core i5',ram:'8 GB',storage:'512 GB SSD',display:'15.6-inch FHD',price:58990,icon:'💻',rating:'4.5/5',review:'Good everyday performance and display.'},
{name:'HP Pavilion 14',brand:'HP',processor:'Intel Core i5',ram:'16 GB',storage:'512 GB SSD',display:'14-inch FHD',price:64990,icon:'🖥️',rating:'4.4/5',review:'Lightweight design for study and work.'},
{name:'Lenovo IdeaPad Slim 3',brand:'Lenovo',processor:'AMD Ryzen 5',ram:'8 GB',storage:'512 GB SSD',display:'15.6-inch FHD',price:52990,icon:'💻',rating:'4.3/5',review:'Value-focused laptop for daily tasks.'},
{name:'ASUS VivoBook 15',brand:'ASUS',processor:'Intel Core i7',ram:'16 GB',storage:'1 TB SSD',display:'15.6-inch FHD',price:74990,icon:'💻',rating:'4.6/5',review:'Responsive performance for multitasking.'}
];
let db=loadDB();
function loadDB(){try{return JSON.parse(localStorage.getItem('ramInfotechDB'))||{admins:[],sales:[],services:[],rentals:[],stock:[]}}catch(e){return {admins:[],sales:[],services:[],rentals:[],stock:[]}}}
function save(){localStorage.setItem('ramInfotechDB',JSON.stringify(db))}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function go(id,btn){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));let el=document.getElementById(id);if(el)el.classList.add('active');document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');window.scrollTo(0,0);if(id==='store')renderStore();if(id==='laptopDetails')renderDetails();if(id==='purchase')setupLaptopSelect('buyModel');if(id==='rental'){setupLaptopSelect('rentModel');renderRentals()}if(id==='stock'){setupLaptopSelect('stockModel');renderStock()}if(id==='serviceTrack')renderServiceTable();if(id==='adminDashboard')renderAdmin();if(id==='salesRecords')renderSales();if(id==='serviceRecords')renderAdminServices()}
function laptopOptions(id){document.getElementById(id).innerHTML=laptops.map(l=>`<option value="${l.name}">${l.name}</option>`).join('')}
function setupLaptopSelect(id){laptopOptions(id);if(id==='buyModel')updateBuyPrice()}
function laptopCard(l){return `<div class="tile laptop"><div class="device">${l.icon}</div><div><h3>${l.name}</h3><p class="muted">${l.processor} · ${l.ram} RAM · ${l.storage}</p><p class="muted">${l.display}</p><p class="price">₹${l.price.toLocaleString('en-IN')}</p><p class="muted">Customer rating: ⭐ ${l.rating} — ${l.review}</p><button class="btn light" onclick="go('purchase');setupLaptopSelect('buyModel');buyModel.value='${l.name}';updateBuyPrice()">Buy Now</button></div></div>`}
function renderStore(){storeList.innerHTML=laptops.map(l=>laptopCard(l)).join('')}
function renderDetails(){detailsList.innerHTML=laptops.map(l=>`<div class="review"><h3>${l.name}</h3><table><tr><th>Brand</th><td>${l.brand}</td><th>Processor</th><td>${l.processor}</td></tr><tr><th>RAM</th><td>${l.ram}</td><th>Storage</th><td>${l.storage}</td></tr><tr><th>Display</th><td>${l.display}</td><th>Price</th><td>₹${l.price.toLocaleString('en-IN')}</td></tr></table></div>`).join('')}
function updateBuyPrice(){let l=laptops.find(x=>x.name===buyModel.value);buyPrice.textContent=l?'Selected price: ₹'+l.price.toLocaleString('en-IN'):''}
function buyLaptop(e){e.preventDefault();let l=laptops.find(x=>x.name===buyModel.value);let id='PO'+Date.now().toString().slice(-6);db.sales.push({id,name:buyName.value,email:buyEmail.value,phone:buyPhone.value,model:l.name,price:l.price,address:buyAddress.value,date:new Date().toLocaleDateString('en-IN')});save();buyResult.textContent='Purchase request submitted. Your request ID is '+id+'.';e.target.reset();setupLaptopSelect('buyModel')}
function bookService(e){e.preventDefault();let id='SR'+Date.now().toString().slice(-6);db.services.push({id,name:serviceName.value,phone:servicePhone.value,email:serviceEmail.value,model:serviceModel.value,type:serviceType.value,date:serviceDate.value,problem:serviceProblem.value,status:'Received'});save();serviceResult.textContent='Service request booked. Your service ID is '+id+'.';e.target.reset()}
function renderServiceTable(){serviceTable.innerHTML=db.services.length?`<table><tr><th>Service ID</th><th>Customer</th><th>Laptop</th><th>Service</th><th>Preferred date</th><th>Status</th></tr>${db.services.slice().reverse().map(s=>`<tr><td>${s.id}</td><td>${esc(s.name)}<br>${esc(s.phone)}</td><td>${esc(s.model)}</td><td>${esc(s.type)}</td><td>${esc(s.date)}</td><td><select onchange="changeServiceStatus('${s.id}',this.value)">${['Received','Under Diagnosis','Repair in Progress','Ready for Pickup','Completed'].map(x=>`<option ${s.status===x?'selected':''}>${x}</option>`).join('')}</select></td></tr>`).join('')}</table>`:'<p class="muted">No service requests yet.</p>'}
function trackService(){let q=trackInput.value.trim().toLowerCase(),s=db.services.find(x=>x.id.toLowerCase()===q||x.phone.toLowerCase()===q);trackResult.innerHTML=s?`<div class="tile" style="margin-top:15px"><h3>${s.id}</h3><p>Customer: ${esc(s.name)}</p><p>Laptop: ${esc(s.model)}</p><p>Service: ${esc(s.type)}</p><p>Status: <span class="status">${esc(s.status)}</span></p></div>`:'<p class="muted">No matching service request found.</p>'}
function changeServiceStatus(id,status){let s=db.services.find(x=>x.id===id);if(s){s.status=status;save();renderServiceTable()}}
function registerAdmin(e){e.preventDefault();if(db.admins.some(a=>a.user===adminUser.value)){alert('Username already registered.');return}db.admins.push({name:adminName.value,email:adminEmail.value,user:adminUser.value,pass:adminPass.value});save();alert('Admin registered. Please login.');go('adminLogin')}
function loginAdmin(e){e.preventDefault();let ok=(loginUser.value==='admin'&&loginPass.value==='admin123')||db.admins.some(a=>a.user===loginUser.value&&a.pass===loginPass.value);if(!ok){alert('Invalid username or password.');return}alert('Login successful.');go('adminDashboard')}
function renderAdmin(){countSales.textContent=db.sales.length;countServices.textContent=db.services.length;countStock.textContent=db.stock.length}
function renderSales(){salesTable.innerHTML=db.sales.length?`<table><tr><th>Request ID</th><th>Customer</th><th>Laptop</th><th>Price</th><th>Date</th></tr>${db.sales.map(s=>`<tr><td>${s.id}</td><td>${esc(s.name)}<br>${esc(s.phone)}</td><td>${esc(s.model)}</td><td>₹${s.price.toLocaleString('en-IN')}</td><td>${s.date}</td></tr>`).join('')}</table>`:'<p class="muted">No purchase requests recorded.</p>'}
function renderAdminServices(){adminServiceTable.innerHTML=db.services.length?`<table><tr><th>ID</th><th>Customer</th><th>Device</th><th>Problem</th><th>Status</th></tr>${db.services.map(s=>`<tr><td>${s.id}</td><td>${esc(s.name)} / ${esc(s.phone)}</td><td>${esc(s.model)}</td><td>${esc(s.problem)}</td><td>${esc(s.status)}</td></tr>`).join('')}</table>`:'<p class="muted">No service records.</p>'}
function rentalRequest(e){e.preventDefault();let id='RN'+Date.now().toString().slice(-6);db.rentals.push({id,name:rentName.value,phone:rentPhone.value,email:rentEmail.value,model:rentModel.value,start:rentStart.value,end:rentEnd.value,purpose:rentPurpose.value,status:'Request Received'});save();rentResult.textContent='Rental request submitted. Agreement request ID: '+id+'.';e.target.reset();renderRentals()}
function renderRentals(){rentalTable.innerHTML=db.rentals.length?`<table><tr><th>Agreement ID</th><th>Customer</th><th>Laptop</th><th>Rental period</th><th>Status</th></tr>${db.rentals.map(r=>`<tr><td>${r.id}</td><td>${esc(r.name)}<br>${esc(r.phone)}</td><td>${esc(r.model)}</td><td>${r.start} to ${r.end}</td><td>${esc(r.status)}</td></tr>`).join('')}</table>`:'<p class="muted">No rental requests submitted.</p>'}
function addStock(e){e.preventDefault();db.stock.push({model:stockModel.value,config:stockConfig.value,qty:Number(stockQty.value),price:Number(stockPrice.value),date:stockDate.value,supplier:stockSupplier.value});save();e.target.reset();setupLaptopSelect('stockModel');renderStock();alert('Stock entry saved.')}
function renderStock(){if(!stockDate.value)stockDate.value=new Date().toISOString().slice(0,10);stockTable.innerHTML=db.stock.length?`<table><tr><th>Model</th><th>Configuration</th><th>Quantity</th><th>Unit price</th><th>Date</th><th>Supplier</th></tr>${db.stock.map(s=>`<tr><td>${esc(s.model)}</td><td>${esc(s.config)}</td><td>${s.qty}</td><td>₹${s.price.toLocaleString('en-IN')}</td><td>${esc(s.date)}</td><td>${esc(s.supplier)}</td></tr>`).join('')}</table>`:'<p class="muted">No stock entries recorded.</p>'}
function contactUs(e){e.preventDefault();contactResult.textContent='Thank you. Your message has been recorded.';e.target.reset()}
featured.innerHTML=laptops.slice(0,2).map(l=>`<div class="tile"><h3>${l.icon} ${l.name}</h3><p class="muted">${l.processor} · ${l.ram} RAM · ${l.storage}</p><p class="price">₹${l.price.toLocaleString('en-IN')}</p></div>`).join('');
renderStore();
</script>
</body></html>
